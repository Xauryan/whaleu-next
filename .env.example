# Development-only example. Never use these credentials in a shared environment.
NODE_ENV=development
HTTP_HOST=127.0.0.1
PORT=3000
DATABASE_URL=postgresql://whaleu_dev:local_development_only@127.0.0.1:55432/whaleu_dev
PG_SSL_MODE=disable
PG_POOL_MAX=10
PG_CONNECTION_TIMEOUT_MS=5000
PG_STATEMENT_TIMEOUT_MS=10000
LOG_LEVEL=info

# In-app local processing only. These effect dispatchers remain manual by default.
# disabled | manual_only | automatic (explicit opt-in; never enables providers)
COMMUNITY_UPDATES_PROCESSING=manual_only
# Rating direct in-app notices: explicit event IDs, local disposable database only.
RATINGS_UPDATES_PROCESSING=disabled
COMMUNITY_UPDATES_INTERVAL_MS=5000
COMMUNITY_UPDATES_BATCH_SIZE=20

# Local post-jury settlement; does not activate external review or delivery.
SAFETY_JURY_PROCESSING=disabled
SAFETY_JURY_INTERVAL_MS=5000
SAFETY_JURY_BATCH_SIZE=20
SAFETY_REPORTS_PER_MINUTE=30
SAFETY_VOTES_PER_MINUTE=30
SAFETY_REPORT_READS_PER_MINUTE=120
SAFETY_TARGET_REQUESTS_PER_MINUTE=120

# Local fresh-source experience settlement only; never initializes old balances.
# Automatic processing is explicit opt-in and restricted to disposable/local databases.
EXPERIENCE_PROCESSING=manual_only
EXPERIENCE_INTERVAL_MS=5000
EXPERIENCE_BATCH_SIZE=20

# Internal fresh-post subscription component: explicit local CLI only, no automatic mode.
SUBSCRIPTION_COMPONENT_PROCESSING=manual_only

# Internal fresh-post like component: explicit local CLI only, no automatic mode.
LIKE_COMPONENT_PROCESSING=manual_only

# Internal fresh-post comment component: explicit local CLI only, no automatic mode.
COMMENT_COMPONENT_PROCESSING=manual_only

# Internal explicit local scoring only; no public route, ranking, or persistence.
HOT_SCORE_COMPUTATION=disabled

# Bounded view-history retention only. Startup + every 60s in the HTTP API.
# Manual/test application contexts never mount this scheduler. Disabling cleanup
# also blocks new HTTP view reporting; ordinary browsing stays available.
VIEW_REPORTING_RETENTION_PROCESSING=automatic

# Semantic search: requires optional pgvector install and current authorized
# source backfill. These defaults never resolve a key or call an inference API.
COMMUNITY_SEMANTIC_SEARCH=disabled
COMMUNITY_SEMANTIC_TRANSMISSION=disabled
COMMUNITY_SEMANTIC_TIMEOUT_MS=5000
# Enabling requires separately reviewed transmission to https://router.tumuer.me,
# non-floating deployment/model revision labels, and an environment secret named
# WHALEU_TUMUER_SEMANTIC_API_KEY. Never commit the key or paste it into logs.
# COMMUNITY_SEMANTIC_DEPLOYMENT_REVISION=
# COMMUNITY_SEMANTIC_EMBEDDING_REVISION=
# COMMUNITY_SEMANTIC_RERANKER_REVISION=

# Additional explicitly initialized public feedback topic for non-production local Review.
# Existing regional Review policy/operator configuration remains required.
# COMMUNITY_FEEDBACK_SPACE_ID=

# Human source-only Review: disabled unless explicitly provisioned.
# Deployment/operator procedure: docs/COMMUNITY_SOURCE_MANUAL_DEPLOYMENT.md
COMMUNITY_TEXT_REVIEW=disabled
# Production opt-in is a separate managed environment, not these development credentials.
# COMMUNITY_TEXT_REVIEW=source_manual
# COMMUNITY_TEXT_REVIEW_SPACE_ID=<existing regional space UUID>
# COMMUNITY_TEXT_REVIEW_REGION_ID=<matching operating-region UUID>
# COMMUNITY_TEXT_SOURCE_REVIEW_POLICY_ID=<new explicitly authorized policy UUID>
# COMMUNITY_TEXT_REVIEW_OPERATOR=manual:<actual hostname>:<actual OS username>
# source_manual rejects COMMUNITY_TEXT_REVIEW_POLICY_ID,
# COMMUNITY_RELATED_REVIEW_POLICY_ID and COMMUNITY_FEEDBACK_SPACE_ID: leave unset.
# Production requires NODE_ENV=production and PG_SSL_MODE=verify-full, secure
# database configuration and a valid trusted server certificate. No provider is enabled.
