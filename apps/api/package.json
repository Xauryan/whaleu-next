{
  "name": "@whaleu/api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "review:text": "node --import tsx src/community/text-review/cli.ts",
    "build": "tsc -p tsconfig.build.json && node scripts/smoke-official-account-operator.mjs",
    "typecheck": "node --max-old-space-size=3072 ../../node_modules/typescript/bin/tsc -p tsconfig.json --noEmit",
    "test": "npm run openapi:build && node --import tsx --test test/*.test.ts",
    "search:install-local": "node --env-file-if-exists=../../.env --import tsx src/community/search/semantic/install-cli.ts install-local",
    "test:semantic:integration": "node --import tsx --test --test-concurrency=1 test/semantic-integration/*.test.ts",
    "test:integration": "node --import tsx --test --test-concurrency=1 test/integration/*.test.ts",
    "dev": "node --watch --env-file-if-exists=../../.env --import tsx src/main.ts",
    "start": "node --env-file-if-exists=../../.env dist/main.js",
    "db:status": "node --env-file-if-exists=../../.env --import tsx src/database/migrate.ts status",
    "db:migrate": "node --env-file-if-exists=../../.env --import tsx src/database/migrate.ts up",
    "auth:epoch-status": "node --env-file-if-exists=../../.env --import tsx src/identity/session-epoch-cli.ts status",
    "auth:maintain": "node --env-file-if-exists=../../.env --import tsx src/identity/maintain.ts",
    "schools:migrate": "node --env-file-if-exists=../../.env --import tsx src/campus/school-identifiers/migrate.ts",
    "updates:process": "node --env-file-if-exists=../../.env --import tsx src/notifications/process-updates.ts",
    "juries:process": "node --env-file-if-exists=../../.env --import tsx src/safety/reporting/process-juries.ts",
    "experience:process": "node --env-file-if-exists=../../.env --import tsx src/experience/process-experience.ts",
    "subscriptions:process": "node --env-file-if-exists=../../.env --import tsx src/community/subscription-component/process-subscriptions.ts",
    "likes:process": "node --env-file-if-exists=../../.env --import tsx src/community/like-component/process-likes.ts",
    "openapi:generate": "npm run openapi:build && node .openapi-build/scripts/openapi.js",
    "openapi:check": "npm run openapi:build && node .openapi-build/scripts/openapi.js --check",
    "openapi:build": "tsc -p tsconfig.openapi.json",
    "comments:process": "node --env-file-if-exists=../../.env --import tsx src/community/comment-component/process-comments.ts",
    "hot-score:compute": "node --env-file-if-exists=../../.env --import tsx src/community/hot-score/compute-score.ts",
    "hot-feed:process": "node --env-file-if-exists=../../.env --import tsx src/community/hot-score/process-hot-feed.ts",
    "ratings:updates:process": "node --env-file-if-exists=../../.env --import tsx src/commands/process-rating-updates.ts",
    "ratings:subscriptions:process": "node --env-file-if-exists=../../.env --import tsx src/commands/process-rating-subscriptions.ts",
    "campus-tools": "node --import tsx src/campus-tools/cli.ts",
    "reading:process": "node --env-file-if-exists=../../.env --import tsx src/community/reading-formatting/process-reading.ts",
    "test:source-manual:production": "node --import tsx --test --test-concurrency=1 test/production-integration/text-source-manual-production.test.ts",
    "test:reading-worker:production": "node --import tsx --test --test-concurrency=1 test/production-integration/reading-worker-process-production.test.ts",
    "test:home-admission:production": "node --import tsx --test --test-concurrency=1 test/production-integration/home-policy-admission-cli.test.ts",
    "test:home-activation:production": "node --import tsx --test --test-concurrency=1 test/production-integration/home-publication-activation-cli.test.ts",
    "test:home-reading:production": "node --import tsx --test --test-concurrency=1 test/production-integration/home-reading-worker-production.test.ts"
  },
  "dependencies": {
    "@nestjs/common": "12.1.2",
    "@nestjs/core": "12.1.2",
    "@nestjs/platform-express": "12.1.2",
    "@nestjs/schedule": "12.0.2",
    "@nestjs/swagger": "12.0.2",
    "@nestjs/throttler": "6.7.1",
    "entities": "8.1.0",
    "helmet": "8.3.0",
    "pg": "8.23.1",
    "pino": "10.4.0",
    "reflect-metadata": "0.2.2",
    "rxjs": "7.8.2",
    "sharp": "0.35.5",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@nestjs/testing": "12.1.2",
    "@types/express": "5.0.6",
    "@types/pg": "8.23.1",
    "@types/supertest": "7.2.1",
    "playwright-core": "1.58.2",
    "supertest": "7.3.1"
  }
}
