<template name="account-moderation">
<view class="screen">
 <view class="title">{{mode === 'status' ? '账号状态' : mode === 'appeal' ? '私人处罚申诉' : mode === 'appeal-management' ? '私人申诉处理' : '账号处罚管理'}}</view>
 <view class="status" aria-role="status">{{status}}</view>
 <view wx:if="{{error}}" class="error" aria-role="alert">{{error}}</view>
 <view wx:if="{{receiptStatus}}" class="notice" aria-role="status">{{receiptStatus}}</view>
 <navigator wx:if="{{!hasSession}}" url="/pages/login/login">登录后继续 →</navigator>
 <button bindtap="onReload" disabled="{{busy}}">重新核验当前状态</button>
 <button wx:if="{{busy}}" bindtap="onStopWaiting">停止等待</button>
 <view wx:if="{{mode === 'status' &amp;&amp; accountStatus}}" class="card">
  <view class="section-title">{{accountStatus.effective === 'access_suspension' ? '封号中：大部分浏览与互动不可用' : accountStatus.effective === 'interaction_mute' ? '禁言中：可浏览，互动受限' : accountStatus.effective === 'clear' ? '当前无生效的禁言或封号' : '当前安全状态暂不能确认'}}</view>
  <view wx:if="{{accountStatus.coverage === 'unavailable'}}" class="notice">部分安全信息暂不可用；以下仅展示已知记录，不代表已恢复权限。</view>
  <view class="meta">核验时间（UTC）：{{accountStatus.checkedAt}}</view>
  <view class="notice">封号不会退出登录。仍可查看自己的处罚原因、系统通知和私人申诉。禁言与封号分别计时；解除或到期其中一项，不会解除另一项。</view>
  <view wx:for="{{accountStatus.current}}" wx:key="punishmentId" class="card">
   <view class="section-title">{{item.kind === 'interaction_mute' ? '禁言' : '封号'}} · {{item.state}}</view>
   <view selectable="true">原因：{{item.reason}}</view>
   <view>开始（UTC）：{{item.startsAt}}</view><view>结束（UTC）：{{item.endsAt || '永久，需有权管理员明确解除'}}</view>
   <navigator wx:if="{{item.canAppeal}}" url="/pages/safety-appeal/safety-appeal?punishmentId={{item.punishmentId}}">对此项处罚提出私人申诉 →</navigator>
   <navigator wx:if="{{item.openAppealId}}" url="/pages/safety-appeal/safety-appeal?appealId={{item.openAppealId}}">查看已有申诉 →</navigator>
  </view>
  <button bindtap="onHistory" disabled="{{busy || frozen}}">查看我的处罚历史</button>
 </view>
 <view wx:if="{{mode === 'appeal'}}" class="notice">申诉仅本人和当前有权的超级管理员可见，不会发布到公开反馈。申诉绑定具体处罚；提交不会自动解除处罚。</view>
 <view wx:if="{{mode === 'punishment-management' || mode === 'appeal-management'}}" class="notice">仅当前超级管理员可读取和处理。列表不显示匿名作者账号映射。这里不能新建任意账号处罚。</view>
 <view wx:for="{{punishments}}" wx:key="punishmentId" class="card">
  <view>{{item.kind === 'interaction_mute' ? '禁言' : '封号'}} · {{item.state}}</view><view>{{item.reason}}</view><view>{{item.endsAt || '永久'}}</view>
  <button data-id="{{item.punishmentId}}" bindtap="onSelectPunishment" disabled="{{busy || frozen}}">核验此项处罚</button>
 </view>
 <view wx:for="{{appeals}}" wx:key="appealId" class="card">
  <view>{{item.punishment.kind === 'interaction_mute' ? '禁言申诉' : '封号申诉'}} · {{item.state === 'pending' ? '待处理' : '已处理'}}</view><view>{{item.submittedAt}}</view>
  <button data-id="{{item.appealId}}" bindtap="onSelectAppeal" disabled="{{busy || frozen}}">查看申诉详情与结果</button>
 </view>
 <button wx:if="{{nextCursor}}" bindtap="onMore" disabled="{{busy || frozen}}">下一页</button>
 <view wx:if="{{selectedPunishment}}" class="card">
  <view class="section-title">{{selectedPunishment.kind === 'interaction_mute' ? '禁言' : '封号'}} · {{selectedPunishment.state}}</view>
  <view>原因：{{selectedPunishment.reason}}</view><view>开始（UTC）：{{selectedPunishment.startsAt}}</view><view>结束（UTC）：{{selectedPunishment.endsAt || '永久'}}</view>
  <view class="meta">处罚编号：{{selectedPunishment.punishmentId}} · 版本 {{selectedPunishment.revision}}</view>
  <view wx:if="{{mode === 'appeal' &amp;&amp; selectedPunishment.canAppeal}}">
   <textarea value="{{text}}" maxlength="4000" bindinput="onText" disabled="{{busy || frozen}}" placeholder="请填写私人申诉内容（最多 4000 字）" />
   <button bindtap="onRequestAppeal" disabled="{{busy || frozen || !text}}">核对并提交私人申诉</button>
  </view>
  <navigator wx:if="{{selectedPunishment.openAppealId}}" url="/pages/safety-appeal/safety-appeal?appealId={{selectedPunishment.openAppealId}}">查看已有申诉 →</navigator>
  <view wx:if="{{mode === 'punishment-management'}}">
   <button bindtap="onHistory" disabled="{{busy || frozen}}">查看该处罚所属账号的处罚历史</button>
   <view wx:if="{{canRelease}}"><textarea value="{{reason}}" maxlength="255" bindinput="onReason" disabled="{{busy || frozen}}" placeholder="解除此项处罚的理由" /><button bindtap="onRequestRelease" disabled="{{busy || frozen || !reason}}">核对并解除此项处罚</button></view>
  </view>
 </view>
 <view wx:if="{{selectedAppeal}}" class="card">
  <view class="section-title">{{selectedAppeal.state === 'pending' ? '申诉待处理' : '申诉已处理'}}</view>
  <view>处罚：{{selectedAppeal.punishment.kind === 'interaction_mute' ? '禁言' : '封号'}} · {{selectedAppeal.punishment.state}}</view><view>处罚原因：{{selectedAppeal.punishment.reason}}</view>
  <view>开始：{{selectedAppeal.punishment.startsAt}} · 结束：{{selectedAppeal.punishment.endsAt || '永久'}}</view>
  <view selectable="true">申诉内容：{{selectedAppeal.text}}</view>
  <view wx:if="{{selectedAppeal.decision}}">处理结果：{{selectedAppeal.decision.outcome === 'released' ? '已解除申诉绑定的处罚' : selectedAppeal.decision.outcome === 'upheld' ? '维持原处罚' : '原处罚已不再生效，结案'}}<view>理由：{{selectedAppeal.decision.reason}}</view><view>处理时间：{{selectedAppeal.decision.recordedAt}}</view></view>
  <view wx:if="{{canDecide}}">
   <textarea value="{{reason}}" maxlength="255" bindinput="onReason" disabled="{{busy || frozen}}" placeholder="填写处理理由，结果将私下通知申诉人" />
   <button data-decision="upheld" bindtap="onRequestDecision" disabled="{{busy || frozen || !reason}}">维持原处罚</button>
   <button data-decision="released" bindtap="onRequestDecision" disabled="{{busy || frozen || !reason}}">解除申诉绑定的处罚</button>
   <button data-decision="closed_no_longer_effective" bindtap="onRequestDecision" disabled="{{busy || frozen || !reason}}">原处罚已失效，结案</button>
  </view>
 </view>
 <view wx:for="{{history}}" wx:key="punishmentId" class="card"><view>{{item.kind === 'interaction_mute' ? '禁言' : '封号'}} · {{item.state}}</view><view>{{item.reason}}</view><view>{{item.startsAt}} 至 {{item.endsAt || '永久'}}</view><view wx:if="{{item.terminal}}">终止：{{item.terminal.cause}} · {{item.terminal.effectiveAt}} · {{item.terminal.reason || ''}}</view></view>
 <button wx:if="{{historyCursor}}" bindtap="onMoreHistory" disabled="{{busy || frozen}}">更多历史</button>
 <view wx:if="{{confirming &amp;&amp; confirming !== 'cancel'}}" class="card" aria-role="alert">
  <view class="section-title">确认{{confirming === 'submit_appeal' ? '提交私人申诉' : confirming === 'release' ? '解除这项处罚' : '处理这条申诉'}}？</view>
  <view wx:if="{{selectedPunishment}}">{{selectedPunishment.kind === 'interaction_mute' ? '禁言' : '封号'}} · {{selectedPunishment.punishmentId}} · 版本 {{selectedPunishment.revision}}</view>
  <view wx:if="{{selectedAppeal}}">申诉编号：{{selectedAppeal.appealId}}<view>决定：{{decision === 'released' ? '解除绑定的处罚' : decision === 'upheld' ? '维持原处罚' : '原处罚失效，结案'}}</view></view>
  <view>{{confirming === 'submit_appeal' ? text : reason}}</view>
  <view class="notice">只处理明确显示的处罚或申诉。解除封号后，如禁言仍有效，互动仍受限。原请求结果未确认前不会生成新请求。</view>
  <button bindtap="onSubmit" disabled="{{busy || frozen}}">确认</button><button bindtap="onClose" disabled="{{busy}}">返回修改</button>
 </view>
 <view wx:if="{{recordedReceipt}}" class="card">
  <view class="section-title">原请求的历史回执</view><view>{{recordedReceipt.requestId}} · {{recordedReceipt.action}} · {{recordedReceipt.outcome}}</view>
  <view wx:if="{{recordedReceipt.punishment}}">{{recordedReceipt.punishment.kind === 'interaction_mute' ? '禁言' : '封号'}} · {{recordedReceipt.punishment.punishmentId}} · 版本 {{recordedReceipt.punishment.revision}}</view>
  <view wx:if="{{recordedReceipt.appealId}}">申诉：{{recordedReceipt.appealId}}</view><view wx:if="{{recordedReceipt.decision}}">历史决定：{{recordedReceipt.decision}}</view>
  <view wx:if="{{recordedReceipt.recordedAt}}">记录时间：{{recordedReceipt.recordedAt}}</view>
  <view class="notice">这是原请求的既有结果，不代表当前权限或最新处罚。当前状态以上方重新核验结果为准。</view>
 </view>
 <view wx:if="{{frozen}}" class="card">
  <view class="section-title">原请求待确认</view><view>{{pendingAction}} · {{pendingPhase}}</view><view class="meta">{{pendingRequestId}}</view>
  <view wx:if="{{pendingCommand}}">
   <view wx:if="{{pendingCommand.punishment}}">冻结处罚：{{pendingCommand.punishment.kind === 'interaction_mute' ? '禁言' : '封号'}} · {{pendingCommand.punishment.punishmentId}} · 版本 {{pendingCommand.punishment.revision}}</view>
   <view wx:if="{{pendingCommand.appealId}}">冻结申诉：{{pendingCommand.appealId}}</view>
   <view wx:if="{{pendingCommand.text}}" selectable="true">原申诉内容：{{pendingCommand.text}}</view><view wx:if="{{pendingCommand.reason}}" selectable="true">原处理理由：{{pendingCommand.reason}}</view>
   <view wx:if="{{pendingCommand.decision}}">原决定：{{pendingCommand.decision === 'released' ? '解除绑定的处罚' : pendingCommand.decision === 'upheld' ? '维持原处罚' : '原处罚失效，结案'}}</view>
   <view class="meta" wx:if="{{pendingCommand.expectedStateVersion}}">冻结管理状态版本：{{pendingCommand.expectedStateVersion}}</view>
  </view>
  <view class="notice">查询不到回执不代表失败。离开页面或停止等待不会取消服务端处理；请保留本机数据，使用原账号查询。失去管理权限仍可恢复本账号原请求。</view>
  <button bindtap="onRecover" disabled="{{busy || !pendingRequestId}}">查询原请求回执</button><button bindtap="onRetry" disabled="{{busy || !pendingRequestId}}">查询并重试原请求</button><button bindtap="onCancelRequest" disabled="{{busy || !pendingRequestId}}">取消原请求</button>
 </view>
 <view wx:if="{{confirming === 'cancel'}}" class="card" aria-role="alert"><view>确认取消未完成的原请求？若已经完成，将返回既有结果，不会回滚。</view><button bindtap="onConfirmCancel" disabled="{{busy}}">确认取消原请求</button><button bindtap="onClose" disabled="{{busy}}">返回</button></view>
 <navigator url="/pages/account-status/account-status">账号状态 →</navigator><navigator url="/pages/system-notices/system-notices">我的系统通知 →</navigator><navigator url="/pages/safety-appeal/safety-appeal">我的私人申诉与结果 →</navigator>
</view>
</template>
