@import '../community/forms.wxss';
.announcement-title {
  display: block;
  font-size: 34rpx;
  font-weight: 600;
  white-space: pre-wrap;
  overflow-wrap: anywhere;
}
.announcement-body {
  display: block;
  margin-top: 24rpx;
  font-size: 30rpx;
  line-height: 1.7;
  white-space: pre-wrap;
  overflow-wrap: anywhere;
}
.announcement-highlight {
  border-left: 8rpx solid #597de1;
}
.announcement-modal {
  position: fixed;
  inset: 0;
  z-index: 200;
  background: rgba(20, 30, 50, 0.55);
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 32rpx;
}
.announcement-dialog {
  width: 100%;
  max-height: 88vh;
  background: white;
  border-radius: 24rpx;
  padding: 28rpx;
  box-sizing: border-box;
}
.announcement-scroll {
  height: 58vh;
}
