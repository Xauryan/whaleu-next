<template name="discussion-recovery"><view wx:if="{{interaction.frozen || interaction.receiptStatus || interaction.error}}" class="card"><view class="section-title">互动结果恢复</view><view class="status">{{interaction.status}}</view><view wx:if="{{interaction.error}}" class="error">{{interaction.error}}</view><view wx:if="{{interaction.frozen}}" class="notice">待确认：{{interaction.actionLabel}}。原目标、请求编号与意图已保存；确认前不能执行新的讨论点赞或置顶。</view><button wx:if="{{interaction.frozen}}" bindtap="onInteractionReceipt" disabled="{{interaction.busy}}">查询原互动回执</button><button wx:if="{{interaction.frozen}}" bindtap="onInteractionRetry" disabled="{{interaction.busy}}">重试完全相同的原互动</button><button wx:if="{{interaction.busy}}" bindtap="onInteractionCancel">停止等待（不撤销互动）</button><view wx:if="{{interaction.receiptStatus}}" class="status">{{interaction.receiptStatus}}</view><navigator wx:if="{{interaction.recoveryPostId &amp;&amp; !interaction.recoveryReplyId}}" class="link" url="/pages/community-thread/community-thread?postId={{interaction.recoveryPostId}}&amp;rootCommentId={{interaction.recoveryRootCommentId}}">打开原互动所在讨论 →</navigator><navigator wx:if="{{interaction.recoveryPostId &amp;&amp; interaction.recoveryReplyId}}" class="link" url="/pages/community-thread/community-thread?postId={{interaction.recoveryPostId}}&amp;rootCommentId={{interaction.recoveryRootCommentId}}&amp;replyId={{interaction.recoveryReplyId}}">打开原互动所在回复 →</navigator></view></template>
