page {
  background: var(--wu-bg);
  color: var(--wu-text);
  font-family: -apple-system, sans-serif;
}
.screen {
  padding: 36rpx 30rpx 72rpx;
}
.eyebrow {
  color: var(--wu-secondary);
  font-size: 22rpx;
  letter-spacing: 4rpx;
  font-weight: 600;
}
.title {
  font-size: 56rpx;
  letter-spacing: -1.5rpx;
  font-weight: 700;
  margin: 12rpx 0 16rpx;
}
.subtitle {
  font-size: 27rpx;
  line-height: 1.7;
  color: var(--wu-secondary);
}
.card {
  margin-top: 24rpx;
  padding: 28rpx;
  background: var(--wu-surface);
  border: 1rpx solid var(--wu-separator);
  border-radius: 22rpx;
}
.section-title {
  font-size: 31rpx;
  font-weight: 600;
  margin-bottom: 18rpx;
}
.label,
.author {
  font-size: 27rpx;
  font-weight: 600;
}
.meta {
  color: var(--wu-secondary);
  font-size: 23rpx;
  margin: 12rpx 0;
  line-height: 1.6;
}
.body {
  white-space: pre-wrap;
  word-break: break-all;
  font-size: 29rpx;
  line-height: 1.8;
  margin: 22rpx 0;
}
.notice,
.status,
.empty {
  font-size: 26rpx;
  line-height: 1.8;
  padding: 18rpx 0;
  color: var(--wu-secondary);
}
.error {
  font-size: 26rpx;
  line-height: 1.7;
  background: var(--wu-danger-bg);
  border-radius: 12rpx;
  color: var(--wu-danger);
  padding: 20rpx;
  margin: 16rpx 0;
}
.scope {
  padding: 24rpx;
  background: var(--wu-tint);
  border-radius: 16rpx;
  margin: 22rpx 0;
  font-size: 28rpx;
}
.chips,
.actions {
  display: flex;
  flex-wrap: wrap;
  gap: 14rpx;
  margin: 20rpx 0;
  align-items: center;
}
.chip {
  border: 1rpx solid var(--wu-separator);
  padding: 12rpx 22rpx;
  border-radius: 32rpx;
  font-size: 24rpx;
  color: var(--wu-secondary);
}
.chip.active {
  background: var(--wu-tint);
  border-color: var(--wu-accent);
  color: var(--wu-accent);
}
button {
  margin: 16rpx 0 0;
  font-size: 27rpx;
  border-radius: 20rpx;
}
button.primary {
  background: var(--wu-accent);
  color: white;
}
button.secondary {
  background: var(--wu-bg);
  color: var(--wu-text);
}
button.danger {
  background: var(--wu-danger);
  color: white;
}
button[disabled] {
  opacity: 0.55;
}
input,
textarea {
  width: 100%;
  box-sizing: border-box;
  background: var(--wu-bg);
  border: 1rpx solid var(--wu-separator);
  border-radius: 12rpx;
  font-size: 29rpx;
  padding: 20rpx;
}
input {
  height: 86rpx;
}
textarea {
  min-height: 310rpx;
  margin: 20rpx 0;
}
.link {
  color: var(--wu-accent);
  font-size: 26rpx;
  padding: 18rpx 0;
}
.image-grid {
  display: flex;
  flex-wrap: wrap;
  gap: 10rpx;
}
.image-grid image {
  width: 180rpx;
  height: 180rpx;
  border-radius: 12rpx;
}
.divider {
  height: 1rpx;
  background: var(--wu-separator);
  margin: 24rpx 0;
}
.confirm {
  background: var(--wu-danger-bg);
  border: 1rpx solid var(--wu-separator);
  border-radius: 16rpx;
  padding: 24rpx;
  margin: 22rpx 0;
}
.row {
  display: flex;
  justify-content: space-between;
  align-items: center;
  gap: 20rpx;
  margin: 18rpx 0;
}
.badge {
  font-size: 22rpx;
  border-radius: 8rpx;
  background: var(--wu-bg);
  padding: 5rpx 10rpx;
  color: var(--wu-secondary);
  margin-left: 12rpx;
}
.identity-private {
  margin-top: 20rpx;
  padding: 20rpx;
  border: 1rpx solid var(--wu-separator);
  border-radius: 12rpx;
  background: var(--wu-tint);
  color: var(--wu-text);
}
.identity-private .meta {
  color: var(--wu-secondary);
  word-break: break-all;
}
