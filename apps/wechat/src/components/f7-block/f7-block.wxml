<view class="f7-ios-theme f7-block-shell {{spacing === 'compact' ? 'f7-block-spacing-compact' : ''}}">
  <view wx:if="{{title || titleSlot}}" class="f7-block-title" aria-role="heading">
    <slot wx:if="{{titleSlot}}" name="title" />
    <text wx:else>{{title}}</text>
  </view>
  <view class="f7-block {{strong ? 'f7-block-strong' : ''}} {{inset ? 'f7-block-inset' : ''}} {{outline ? 'f7-block-outline' : ''}}">
    <slot />
  </view>
  <view wx:if="{{footer || footerSlot}}" class="f7-block-footer">
    <slot wx:if="{{footerSlot}}" name="footer" />
    <text wx:else>{{footer}}</text>
  </view>
</view>
