@import '../../design/framework7-ios.wxss';

:host {
  display: block;
}
.f7-block-shell {
  margin: var(--f7-block-margin-vertical) 0;
}
/* Explicit project adaptation; default spacing remains upstream's 35px. */
.f7-block-spacing-compact {
  --f7-block-margin-vertical: 16px;
}
.f7-block {
  box-sizing: border-box;
  position: relative;
  color: var(--f7-block-text-color);
  font-size: var(--f7-block-font-size);
  padding: 0 var(--f7-block-padding-horizontal);
}
.f7-block-strong {
  color: var(--f7-block-strong-text-color);
  background-color: var(--f7-block-strong-bg-color);
  padding-top: var(--f7-block-padding-vertical);
  padding-bottom: var(--f7-block-padding-vertical);
}
.f7-block-inset {
  margin-left: var(--f7-block-inset-side-margin);
  margin-right: var(--f7-block-inset-side-margin);
  border-radius: var(--f7-block-inset-border-radius);
}
.f7-block-outline::before,
.f7-block-outline::after {
  content: '';
  position: absolute;
  left: 0;
  width: 100%;
  height: 1px;
  background: var(--f7-block-outline-border-color);
  transform: scaleY(calc(1 / var(--f7-device-pixel-ratio)));
  pointer-events: none;
}
.f7-block-outline::before {
  top: 0;
  transform-origin: 50% 0%;
}
.f7-block-outline::after {
  bottom: 0;
  transform-origin: 50% 100%;
}
.f7-block-outline.f7-block-inset {
  border: 1px solid var(--f7-block-outline-border-color);
}
.f7-block-outline.f7-block-inset::before,
.f7-block-outline.f7-block-inset::after {
  display: none;
}
.f7-block-title {
  position: relative;
  overflow: hidden;
  margin: 0 var(--f7-block-padding-horizontal)
    var(--f7-block-title-margin-bottom);
  color: var(--f7-block-title-text-color);
  font-size: var(--f7-block-title-font-size);
  font-weight: var(--f7-block-title-font-weight);
  line-height: var(--f7-block-title-line-height);
  text-transform: var(--f7-block-title-text-transform);
  white-space: var(--f7-block-title-white-space);
  text-overflow: ellipsis;
}
.f7-block-footer {
  margin-top: var(--f7-block-footer-margin);
  padding: 0 var(--f7-block-padding-horizontal);
  color: var(--f7-block-footer-text-color);
  font-size: var(--f7-block-footer-font-size);
}
