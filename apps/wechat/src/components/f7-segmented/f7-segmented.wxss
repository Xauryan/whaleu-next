/* Framework7 v9.2.0 button/button.less Segmented Strong, MIT.
 * Native adaptation: controlled highlight geometry, no DOM sibling selectors;
 * 44px minimum hit target replaces upstream 34px button height.
 */
@import '../../design/framework7-ios.wxss';
:host {
  display: block;
}
.f7-segmented {
  position: relative;
  display: flex;
  align-items: stretch;
  padding: var(--f7-segmented-strong-padding);
  gap: var(--f7-segmented-strong-between-buttons);
  border-radius: calc(
    var(--f7-button-border-radius) + var(--f7-segmented-strong-padding)
  );
  background: var(--f7-segmented-strong-bg-color);
}
.f7-segment {
  position: relative;
  z-index: 1;
  flex: 1;
  width: 0;
  min-width: 0;
  min-height: 44px;
  margin: 0;
  padding: 0 10px;
  display: flex;
  align-items: center;
  justify-content: center;
  line-height: 1.2;
  border: 0;
  border-radius: var(--f7-button-border-radius);
  background: transparent;
  color: var(--f7-segmented-strong-button-text-color);
  font-family: -apple-system, BlinkMacSystemFont, sans-serif;
  font-size: var(--f7-button-font-size);
  font-weight: var(--f7-segmented-strong-button-font-weight);
}
.f7-segment::after {
  border: 0;
}
.f7-segment-active {
  color: var(--f7-segmented-strong-button-active-text-color);

  font-weight: var(--f7-segmented-strong-button-active-font-weight);
}
.f7-segment-pressed {
  background: var(--f7-segmented-strong-button-pressed-bg-color);
}
.f7-segment[disabled] {
  opacity: 0.55;
}

.f7-segment-highlight {
  position: absolute;
  top: 2px;
  bottom: 2px;
  border-radius: var(--f7-button-border-radius);
  background: var(--f7-segmented-strong-button-active-bg-color);
  box-shadow: var(--f7-segmented-strong-button-active-box-shadow);
  transition: left 200ms;
  pointer-events: none;
}
@media (prefers-reduced-motion: reduce) {
  .f7-segment-highlight {
    transition: none;
  }
}
