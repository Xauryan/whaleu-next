@import '../community/forms.wxss';
.body {
  white-space: pre-wrap;
  overflow-wrap: anywhere;
}
.private {
  border: 1px solid #e2c588;
  background: #fffaf0;
}
.recovery {
  border: 1px solid #e2a178;
}
.modal-mask {
  position: fixed;
  inset: 0;
  background: rgba(0, 0, 0, 0.4);
  z-index: 50;
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 32rpx;
}
.modal {
  width: 100%;
  max-height: 80vh;
  overflow: auto;
  background: #fff;
  padding: 28rpx;
  border-radius: 24rpx;
}
textarea {
  box-sizing: border-box;
  width: 100%;
  min-height: 140rpx;
}
