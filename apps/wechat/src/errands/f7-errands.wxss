 * Only errands consumers. Native textarea/media/navigation/confirmation layout
 * retain their platform contracts; no global page or isolated component override. */
@import '../design/framework7-ios.wxss';
.errand-page {
  min-height: 100vh;
  box-sizing: border-box;
  padding: 0 0 calc(24px + env(safe-area-inset-bottom));
  color: var(--f7-text-color);
  background: var(--f7-page-bg-color);
}
.errand-market,
.errand-detail {
  padding-bottom: calc(100px + env(safe-area-inset-bottom));
}
.errand-own {
  padding-bottom: calc(24px + env(safe-area-inset-bottom));
}
.errand-toolbar,
.errand-filterbar,
.errand-tabs,
.errand-choice-row,
.errand-inline-actions,
.errand-section-header,
.errand-image-label,
.errand-detail-actions,
.errand-private-heading,
.errand-order-heading,
.errand-order-meta,
.errand-media-count,
.errand-search-row,
.errand-fact,
.errand-contact-line,
.errand-notice-content {
  display: flex;
  align-items: center;
  gap: 8px;
}
.errand-toolbar {
  min-height: 52px;
  justify-content: space-between;
  padding: 0 16px;
}
.errand-toolbar-link,
.errand-icon-link,
.errand-admin-link {
  display: flex;
  align-items: center;
  gap: 4px;
  min-height: 44px;
  color: var(--f7-theme-color);
  font-size: 15px;
}
.errand-icon-link,
.errand-icon-button {
  width: 44px;
  flex-shrink: 0;
  justify-content: center;
}
.errand-campus-switch {
  margin: 0 16px;
}
.errand-campus-switch text {
  margin: 0 6px;
}
.errand-campus-picker,
.errand-sort-panel {
  padding: 0 16px 8px;
}
.errand-search-row wu-f7-input {
  flex: 1;
  min-width: 0;
}
.errand-search-row wu-f7-button {
  flex-shrink: 0;
}
.errand-campus-result {
  border-bottom: 1px solid var(--f7-list-item-border-color);
}
.errand-campus-result text {
  margin-right: 8px;
}
.errand-filterbar {
  justify-content: space-between;
  margin: 8px 16px;
}
.errand-tabs {
  flex: 1;
}
.errand-tabs wu-f7-button {
  flex: 1;
}
.errand-sort-toggle {
  flex-shrink: 0;
}
.errand-choice-row {
  flex-wrap: wrap;
}
.errand-choice-row > text {
  width: 100%;
  color: var(--f7-block-footer-text-color);
  font-size: 13px;
}
.errand-segment {
  display: flex;
  gap: 4px;
  margin: 8px 16px 16px;
}
.errand-segment wu-f7-button {
  flex: 1;
}
.errand-range-label {
  margin: 12px 16px 0;
  color: var(--f7-block-footer-text-color);
  font-size: 13px;
}
.errand-status-row {
  display: flex;
  align-items: center;
  justify-content: flex-end;
  margin: 0 16px;
}
.errand-status {
  flex: 1;
  color: var(--f7-block-footer-text-color);
  font-size: 14px;
  line-height: 1.5;
}
.errand-notices > .errand-status {
  margin: 8px 16px;
}
.errand-footnote {
  color: var(--f7-block-footer-text-color);
  font-size: 13px;
  line-height: 1.6;
  padding: 4px 0;
  overflow-wrap: anywhere;
}
.errand-page > .errand-footnote {
  margin: 8px 16px;
}
.errand-error {
  margin: 8px 16px;
  padding: 12px 16px;
  color: #ff3b30;
  border: 1px solid currentColor;
  border-radius: 8px;
  font-size: 14px;
  line-height: 1.5;
}
.errand-inline-actions {
  flex-wrap: wrap;
}
.errand-order-heading {
  align-items: flex-start;
  justify-content: space-between;
}
.errand-order-title {
  flex: 1;
  min-width: 0;
  font-size: 17px;
  font-weight: 600;
  line-height: 1.4;
  white-space: normal;
  overflow-wrap: anywhere;
}
.errand-reward {
  flex: 0 1 auto;
  max-width: 48%;
  color: var(--f7-theme-color);
  font-size: 21px;
  line-height: 1.4;
  font-weight: 600;
  white-space: normal;
  overflow-wrap: anywhere;
}
.errand-currency {
  margin-right: 2px;
  font-size: 0.65em;
  font-weight: 500;
}
.errand-order-status {
  display: inline-flex;
  padding: 2px 6px;
  margin: 8px 0 4px;
  border-radius: 4px;
  background: var(--f7-page-bg-color);
  color: var(--f7-block-footer-text-color);
  font-size: 12px;
}
.errand-order-status.state-pending {
  background: var(--f7-button-tonal-bg-color);
  color: var(--f7-theme-color);
}
.errand-order-excerpt {
  margin: 6px 0 10px;
  font-size: 15px;
  line-height: 21px;
  color: var(--f7-block-footer-text-color);
  white-space: normal;
  overflow-wrap: anywhere;
}
.errand-order-meta,
.errand-media-count {
  flex-wrap: wrap;
  gap: 4px;
  color: var(--f7-block-footer-text-color);
  font-size: 13px;
  line-height: 1.5;
}
.errand-media-count {
  margin-top: 6px;
}
.errand-order-open {
  margin: 0 16px 6px;
}
.errand-order-open wu-icon {
  margin-left: 8px;
}
.errand-bottom-bar {
  position: fixed;
  z-index: 10;
  bottom: 0;
  left: 0;
  right: 0;
  box-sizing: border-box;
  padding: 10px 16px calc(12px + env(safe-area-inset-bottom));
  background: var(--f7-block-strong-bg-color);
  border-top: 1px solid var(--f7-block-outline-border-color);
}
.errand-bottom-bar wu-f7-button {
  flex: 1;
}
.errand-bottom-bar wu-icon {
  margin-right: 6px;
}
.errand-empty {
  text-align: center;
}
.errand-empty view {
  margin: 8px 0;
  font-size: 17px;
}
.errand-empty text {
  color: var(--f7-block-footer-text-color);
  font-size: 14px;
}
.errand-load-more,
.errand-admin-link {
  margin: 8px 16px;
}
.errand-detail-heading {
  margin: 8px 16px 16px;
}
.errand-detail-title {
  font-size: 26px;
  line-height: 1.3;
  font-weight: 600;
  overflow-wrap: anywhere;
}
.errand-detail-reward {
  font-size: 32px;
  font-weight: 600;
  color: var(--f7-theme-color);
  margin-top: 14px;
  overflow-wrap: anywhere;
}
.errand-reward-caption {
  display: inline-block;
  margin-left: 8px;
  font-size: 13px;
  font-weight: 400;
  color: var(--f7-block-footer-text-color);
}
.errand-fact {
  font-size: 17px;
  white-space: normal;
  overflow-wrap: anywhere;
}
.errand-section-title {
  font-size: 17px;
  font-weight: 600;
  line-height: 20px;
}
.errand-body {
  margin-top: 10px;
  font-size: 15px;
  line-height: 1.6;
  white-space: pre-wrap;
  overflow-wrap: anywhere;
}
.errand-image-links {
  display: flex;
  flex-wrap: wrap;
  gap: 8px;
  margin-top: 12px;
}
.errand-media-button wu-icon {
  margin-right: 4px;
}
.errand-media-view {
  margin: 12px 16px;
}
.order-image {
  display: block;
  width: 100%;
  max-height: 65vh;
}
.target-qr {
  display: block;
  width: 210px;
  max-width: 100%;
  margin: 12px auto;
}
.errand-contact-name {
  margin-top: 10px;
  font-size: 17px;
}
.errand-contact-line {
  align-items: flex-start;
  padding: 8px 0;
  font-size: 15px;
  overflow-wrap: anywhere;
}
.errand-contact-line > text:first-child {
  width: 36px;
  flex-shrink: 0;
  color: var(--f7-block-footer-text-color);
}
.errand-contact-line > text:last-child {
  min-width: 0;
  flex: 1;
}
.errand-disclosure wu-icon,
.errand-disclosure text {
  margin-right: 6px;
}
.errand-optional,
.errand-field-count {
  color: var(--f7-block-footer-text-color);
  font-size: 12px;
}
.errand-order-history {
  font-size: 13px;
  color: var(--f7-block-footer-text-color);
  line-height: 1.8;
  overflow-wrap: anywhere;
}
/* Existing owner-managed native confirmation surface, not an F7 overlay port.
 * Its lifecycle, cancel behavior and irreversible gates are not replaced. */
.errand-modal-mask {
  position: fixed;
  inset: 0;
  z-index: 50;
  display: flex;
  align-items: flex-end;
  background: rgba(0, 0, 0, 0.4);
}
.errand-modal {
  box-sizing: border-box;
  width: 100%;
  max-height: 85vh;
  overflow-y: auto;
  padding: 10px 16px calc(16px + env(safe-area-inset-bottom));
  background: var(--f7-block-strong-bg-color);
  border-radius: 24px 24px 0 0;
}
.errand-sheet-handle {
  width: 36px;
  height: 4px;
  margin: 0 auto 16px;
  border-radius: 4px;
  background: var(--f7-block-outline-border-color);
}
.errand-sheet-title {
  font-size: 22px;
  font-weight: 600;
  margin-bottom: 10px;
}
.errand-modal wu-f7-input {
  margin: 8px 0;
}
.errand-modal .errand-primary {
  margin-top: 12px;
}
.errand-field-count {
  text-align: right;
}
/* Multiline WeChat editor remains native for IME/keyboard parity. */
.errand-composer textarea {
  box-sizing: border-box;
  width: 100%;
  border: 0;
  background: transparent;
  color: var(--f7-text-color);
  font-family: var(--f7-font-family);
  font-size: 16px;
  line-height: 1.6;
}
.errand-description-input {
  min-height: 100px;
  height: 128px;
  margin-top: 12px;
}
.errand-private-input {
  min-height: 96px;
  margin-top: 10px;
}
.errand-field-row {
  display: flex;
  align-items: center;
  gap: 8px;
  min-height: 52px;
}
.errand-field-row wu-f7-input {
  flex: 1;
  min-width: 0;
}
.errand-field-label {
  flex: 0 0 68px;
  font-size: 15px;
}
.errand-money-symbol {
  color: var(--f7-block-footer-text-color);
}
.errand-section-header,
.errand-image-label {
  justify-content: space-between;
}
.errand-image-slot {
  padding: 10px 0 4px;
  border-bottom: 1px solid var(--f7-block-outline-border-color);
}
.errand-image-label {
  font-size: 15px;
}
.errand-publish-area {
  margin: 12px 16px;
}
.errand-publish-area .errand-primary {
  margin-top: 10px;
}
.errand-notice-content {
  align-items: flex-start;
  gap: 12px;
}
.errand-notice-icon {
  position: relative;
  display: flex;
  align-items: center;
  justify-content: center;
  width: 36px;
  height: 36px;
  flex-shrink: 0;
  color: var(--f7-theme-color);
  background: var(--f7-button-tonal-bg-color);
  border-radius: 8px;
}
.errand-unread-dot {
  position: absolute;
  width: 6px;
  height: 6px;
  top: -1px;
  right: -1px;
  border-radius: 50%;
  background: var(--f7-theme-color);
}
.errand-notice-copy {
  flex: 1;
  min-width: 0;
  font-size: 14px;
  line-height: 1.6;
}
.errand-notice-title {
  margin: 2px 0 6px;
  font-size: 17px;
  font-weight: 500;
  line-height: 1.4;
}
.errand-notice-time,
.errand-notice-reference {
  color: var(--f7-block-footer-text-color);
  font-size: 12px;
  overflow-wrap: anywhere;
}
.errand-notice-time {
  margin-top: 8px;
}
.errand-notice-reason {
  white-space: pre-wrap;
  overflow-wrap: anywhere;
}
