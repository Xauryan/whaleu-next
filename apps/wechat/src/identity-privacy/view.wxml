<template name="identity-overlay"><view wx:if="{{identity}}" class="identity-private"><view class="label">开发者专用 · 真实账号</view><view class="meta">昵称：{{identity.nickname || '尚未设置'}}</view><view class="meta">账号 UID：{{identity.accountId}}</view><view class="meta">{{identity.studentNumberStatus === 'verified' ? '已验证学号：' + identity.studentNumber : (identity.studentNumberStatus === 'unverified' ? '学号尚未验证' : '学号权威来源尚未接入')}}</view><view class="meta">真实头像尚未接入。此资料仅供已授权开发者查看，访问已审计。</view></view></template>
