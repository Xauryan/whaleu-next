@import '../ratings/ratings.wxss';
.body {
  white-space: pre-wrap;
  overflow-wrap: anywhere;
}
.filter-picker {
  padding: 24rpx;
  border: 1rpx solid #c8d6e5;
  border-radius: 12rpx;
  margin: 16rpx 0;
}
input {
  border: 1rpx solid #cbd5e1;
  padding: 20rpx;
  margin: 16rpx 0;
}
.hot-comment {
  border-left: 4rpx solid #78a6cf;
  padding-left: 20rpx;
  margin: 20rpx 0;
}
