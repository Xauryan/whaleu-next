@import '../community/forms.wxss';
.screen {
  padding: 32rpx;
}
.row {
  display: flex;
  gap: 16rpx;
  align-items: center;
  flex-wrap: wrap;
}
.row .section-title {
  flex: 1;
}
.identity-banner {
  padding: 20rpx;
  background: var(--wu-tint);
  border-radius: 12rpx;
  white-space: pre-wrap;
  line-height: 1.7;
}
.history {
  height: 55vh;
  margin: 24rpx 0;
}
.message {
  max-width: 86%;
  padding: 20rpx;
  margin: 18rpx 0;
  border-radius: 16rpx;
  background: var(--wu-surface);
  border: 1rpx solid var(--wu-separator);
}
.message.self {
  margin-left: auto;
  background: var(--wu-tint);
}
.message .body {
  white-space: pre-wrap;
  overflow-wrap: anywhere;
}
.message .row {
  margin-top: 10rpx;
}
.preview {
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
  max-width: 100%;
  margin: 14rpx 0;
}
.confirm {
  padding: 24rpx;
  border: 1rpx solid var(--wu-danger);
  border-radius: 16rpx;
  background: var(--wu-danger-bg);
  margin: 20rpx 0;
}
.badge {
  padding: 4rpx 12rpx;
  background: var(--wu-tint);
  border-radius: 18rpx;
}
.card textarea {
  box-sizing: border-box;
  width: 100%;
  padding: 20rpx;
  border: 1rpx solid var(--wu-separator);
  border-radius: 12rpx;
  min-height: 150rpx;
}
.meta {
  overflow-wrap: anywhere;
}

.private-message-image {
  width: 100%;
  max-width: 560rpx;
}
