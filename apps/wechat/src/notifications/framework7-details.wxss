@import '../design/framework7-ios.wxss';

/* Page-local composition of the pinned Framework7 v9.2.0 native ports.
 * Existing content-first events, source namespaces and standalone actions stay
 * intact. No global tokens, new overlay, navigation or provider is introduced. */
.f7-notifications-page {
  background: var(--f7-page-bg-color);
  color: var(--f7-text-color);
}
.f7-notifications-page .notice-toolbar {
  gap: 8px;
  min-height: 44px;
}
.f7-notifications-page .notice-icon-button {
  display: block;
  width: auto;
  min-width: 44px;
  margin-left: auto;
  margin-right: 0;
}
.f7-notifications-page .notice-tabs {
  gap: 4px;
  border: 0;
}
.f7-notifications-page .notice-tab {
  padding: 0;
  line-height: normal;
  border: 0;
}
.f7-notifications-page .notice-event {
  border-color: var(--f7-list-item-border-color);
}
.f7-notifications-page .notice-actions {
  gap: 4px 8px;
}
.f7-notifications-page .notice-action,
.f7-notifications-page .notice-read,
.f7-notifications-page .notice-secondary {
  min-height: 44px;
}
.f7-notifications-page .notice-empty,
.f7-notifications-page .notice-footer {
  display: block;
  padding: 0;
  margin: 0;
}
.f7-notifications-page .notice-empty-content {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  gap: 9px;
  padding: 34px 0;
  text-align: center;
}
.f7-notifications-page.activity-notice-page .notice-empty {
  padding-top: 0;
}
.f7-notifications-page.activity-notice-page .notice-empty-content {
  padding-top: 54px;
}
.f7-notifications-page .social-open {
  display: block;
  width: 100%;
  margin: 0;
  padding: 0;
}
