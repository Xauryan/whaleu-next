page {
  background: var(--wu-surface, #fff);
  color: var(--wu-text, #1d1d1f);
}
.support-page {
  padding: 16rpx 36rpx calc(64rpx + env(safe-area-inset-bottom));
}
.support-page button,
.support-page navigator {
  box-sizing: border-box;
  min-height: 88rpx;
}
.support-page button {
  margin: 0;
  font-size: 29rpx;
  font-weight: 500;
  line-height: 1.4;
  padding: 22rpx 24rpx;
  border-radius: 24rpx;
}
.support-page button::after {
  border: 0;
}
.support-page button[disabled] {
  opacity: 0.42;
}
.support-page .primary,
.support-page .secondary {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 12rpx;
  text-align: center;
  border-radius: 24rpx;
  padding: 22rpx 24rpx;
  font-size: 29rpx;
  font-weight: 600;
  margin: 16rpx 0;
}
.support-page .primary {
  background: var(--wu-accent, #007aff);
  color: #fff;
}
.support-page .secondary {
  background: var(--wu-tint, #eaf3ff);
  color: var(--wu-accent, #007aff);
}
.support-page .quiet,
.support-page .row-button,
.support-page .copy-button,
.support-page .icon-button {
  background: transparent;
  color: var(--wu-accent, #007aff);
}
.support-page .quiet {
  width: 100%;
}
.support-page .icon-button {
  width: 88rpx;
  padding: 0;
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
}
.support-page .danger {
  background: var(--wu-danger, #b42318);
}
.support-page .danger-text {
  color: var(--wu-danger, #b42318);
}
.support-page .toolbar,
.support-page .section-heading,
.support-page .link-row,
.support-page .row-button {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 20rpx;
}
.support-page .section-heading {
  min-height: 68rpx;
}
.support-page .section-title {
  font-size: 34rpx;
  font-weight: 600;
  line-height: 1.35;
}
.support-page .section-heading .section-title {
  flex: 1;
}
.support-page .field-label {
  font-size: 28rpx;
  font-weight: 600;
}
.support-page .body-copy {
  font-size: 29rpx;
  line-height: 1.75;
  white-space: pre-wrap;
  overflow-wrap: anywhere;
  margin: 18rpx 0;
}
.support-page .hint,
.support-page .meta {
  color: var(--wu-secondary, #6e6e73);
  font-size: 25rpx;
  line-height: 1.6;
}
.support-page .meta {
  margin: 10rpx 0;
}
.support-page .disclosure {
  display: flex;
  gap: 12rpx;
  color: var(--wu-secondary, #6e6e73);
  font-size: 25rpx;
  line-height: 1.65;
  margin: 18rpx 0 24rpx;
  overflow-wrap: anywhere;
}
.support-page .disclosure wu-icon {
  flex-shrink: 0;
  margin-top: 4rpx;
}
.support-page .status {
  font-size: 25rpx;
  color: var(--wu-secondary, #6e6e73);
  margin: 16rpx 0;
  line-height: 1.6;
}
.support-page .error {
  background: var(--wu-danger-bg, #fff0ee);
  color: var(--wu-danger, #b42318);
  border-radius: 18rpx;
  padding: 22rpx 24rpx;
  font-size: 26rpx;
  line-height: 1.65;
  margin: 20rpx 0;
}
.support-page .reference {
  color: var(--wu-secondary, #6e6e73);
  font-size: 22rpx;
  line-height: 1.55;
  overflow-wrap: anywhere;
  margin: 14rpx 0;
}
.support-page .footnote {
  color: var(--wu-tertiary, #8e8e93);
  font-size: 23rpx;
  line-height: 1.6;
  margin-top: 36rpx;
}
.support-page .empty {
  text-align: center;
  padding: 80rpx 24rpx;
}
.support-page .empty .section-title {
  margin: 20rpx 0 12rpx;
  font-size: 31rpx;
}
.support-page .empty .hint {
  max-width: 520rpx;
  margin: 0 auto;
}
.support-page .empty.compact {
  padding: 46rpx 20rpx;
}
.support-page .identity-mark {
  display: flex;
  align-items: center;
  justify-content: center;
  border-radius: 50%;
  width: 74rpx;
  height: 74rpx;
  background: var(--wu-bg, #f5f5f7);
  flex-shrink: 0;
}
.support-page .identity-mark.large {
  width: 112rpx;
  height: 112rpx;
  margin: 8rpx auto 24rpx;
  background: var(--wu-tint, #eaf3ff);
  border-radius: 34rpx;
}
.support-page .state-label {
  color: var(--wu-secondary, #6e6e73);
  font-size: 24rpx;
  flex-shrink: 0;
}
.support-page .state-title {
  font-size: 42rpx;
  font-weight: 650;
  margin: 12rpx 0;
  letter-spacing: -1rpx;
}
.support-page .account-overview {
  padding: 28rpx 0 10rpx;
  text-align: center;
}
.support-page .account-overview .disclosure {
  text-align: left;
}
.support-page .case-row,
.support-page .case-section,
.support-page .recovery-section {
  padding: 28rpx 0;
  border-top: 1rpx solid var(--wu-separator, #e5e5ea);
  margin-top: 20rpx;
}
.support-page .time-row {
  display: flex;
  justify-content: space-between;
  gap: 24rpx;
  padding: 10rpx 0;
  font-size: 24rpx;
  color: var(--wu-secondary, #6e6e73);
}
.support-page .time-row text:first-child {
  flex-shrink: 0;
}
.support-page .time-row text:last-child {
  text-align: right;
}
.support-page .link-row {
  color: var(--wu-accent, #007aff);
  font-size: 29rpx;
  padding: 20rpx 0;
}
.support-page .service-links {
  margin-top: 28rpx;
}
.support-page .service-links .link-row {
  border-top: 1rpx solid var(--wu-separator, #e5e5ea);
  color: var(--wu-text, #1d1d1f);
}
.support-page .timeline-item {
  position: relative;
  margin: 20rpx 0 0 10rpx;
  padding: 8rpx 0 24rpx 32rpx;
  border-left: 2rpx solid var(--wu-separator, #e5e5ea);
}
.support-page .timeline-item .section-title {
  font-size: 29rpx;
}
.support-page .timeline-dot {
  position: absolute;
  left: -9rpx;
  top: 18rpx;
  width: 16rpx;
  height: 16rpx;
  border-radius: 50%;
  background: var(--wu-accent, #007aff);
}
.support-page .confirmation {
  background: var(--wu-bg, #f5f5f7);
  padding: 28rpx;
  margin: 28rpx -8rpx;
  border-radius: 26rpx;
}
.support-page .confirmation .body-copy {
  max-height: 560rpx;
  overflow: auto;
}
.support-page .original-request {
  border-left: 3rpx solid var(--wu-separator, #e5e5ea);
  padding-left: 20rpx;
  margin: 22rpx 0;
}
.support-page .privacy-line,
.support-page .link-leading {
  display: flex;
  align-items: center;
  gap: 16rpx;
}
.support-page .privacy-line {
  margin: 20rpx 0 12rpx;
  font-size: 25rpx;
  color: var(--wu-secondary, #6e6e73);
}
