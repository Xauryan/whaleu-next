/* Activity-only layout around isolated Framework7 v9.2.0 native components.
 * Retains native media/textarea and owner-controlled recovery. No shared tokens. */
.activity-page {
  min-height: 100vh;
  box-sizing: border-box;
  padding: 8px 16px calc(24px + env(safe-area-inset-bottom));
  background: var(--f7-page-bg-color);
  color: var(--f7-text-color);
  font-size: 16px;
}
.activity-toolbar,
.activity-toolbar-actions,
.activity-inline-actions,
.activity-heading-action,
.activity-filterbar,
.activity-pagination,
.activity-setting-row,
.activity-submit-buttons {
  display: flex;
  align-items: center;
  gap: 8px;
}
.activity-toolbar,
.activity-heading-action,
.activity-setting-row,
.activity-pagination {
  justify-content: space-between;
}
.activity-toolbar {
  min-height: 44px;
}
.activity-toolbar-actions {
  flex-shrink: 0;
  gap: 0;
}
.activity-icon-button {
  display: block;
  min-width: 44px;
  flex-shrink: 0;
}
.activity-text-button,
.activity-event-open {
  display: inline-block;
}
.activity-toolbar > .activity-text-button {
  flex-shrink: 0;
}
.activity-page-heading {
  padding: 16px 0 8px;
}
.activity-page-title {
  font-size: 32px;
  font-weight: 700;
  letter-spacing: -0.7px;
  line-height: 1.2;
  margin: 8px 0;
}
.activity-caption,
.activity-list-caption,
.activity-information {
  color: var(--f7-list-item-text-text-color);
  font-size: 14px;
  line-height: 1.6;
  overflow-wrap: anywhere;
}
.activity-footnote,
.activity-eyebrow,
.activity-fact-label,
.activity-event-organizer {
  color: var(--f7-list-item-subtitle-text-color);
  font-size: 12px;
  line-height: 1.5;
}
.activity-filterbar {
  min-height: 52px;
  margin: 8px 0;
}
.activity-filter-label {
  flex: 1;
  font-size: 15px;
  font-weight: 600;
}
.activity-status {
  margin: 12px 0;
  color: var(--f7-list-item-subtitle-text-color);
  font-size: 14px;
  line-height: 1.5;
  overflow-wrap: anywhere;
}
.activity-error {
  color: var(--f7-input-error-text-color);
  padding: 12px 0;
  font-size: 14px;
  line-height: 1.5;
  overflow-wrap: anywhere;
}
.activity-event-content {
  flex: 1;
  min-width: 0;
}
.activity-event-title {
  font-size: 18px;
  font-weight: 600;
  line-height: 1.4;
  margin: 6px 0;
  white-space: pre-wrap;
  overflow-wrap: anywhere;
}
.activity-event-symbol,
.activity-organizer-symbol,
.activity-upload-symbol {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 44px;
  height: 44px;
  border-radius: 8px;
  background: var(--f7-page-bg-color);
  flex-shrink: 0;
}
.activity-event-symbol {
  margin-bottom: 8px;
}
.activity-tags {
  display: flex;
  flex-wrap: wrap;
  gap: 6px;
  margin: 8px 0;
}
.activity-tag {
  background: var(--f7-page-bg-color);
  color: var(--f7-list-item-subtitle-text-color);
  border-radius: 4px;
  padding: 3px 6px;
  font-size: 12px;
  line-height: 1.4;
}
.activity-event-fact {
  display: flex;
  align-items: flex-start;
  gap: 6px;
  margin: 5px 0;
  color: var(--f7-list-item-subtitle-text-color);
  font-size: 14px;
  line-height: 1.5;
}
.activity-event-fact-label {
  min-width: 0;
  white-space: pre-wrap;
  overflow-wrap: anywhere;
}
.activity-pagination {
  justify-content: center;
  flex-wrap: wrap;
  margin: 8px 0;
}
.activity-empty {
  display: block;
  text-align: center;
  padding: 24px 0;
}
.activity-empty-title {
  font-size: 18px;
  font-weight: 600;
  margin: 12px 0 6px;
}
.activity-list-note,
.activity-contact-note {
  margin: 16px 0;
}
.activity-section-title {
  font-size: 17px;
  font-weight: 600;
  line-height: 1.5;
  margin-bottom: 8px;
}
.activity-disclosure,
.activity-primary,
.activity-secondary,
.activity-load-more {
  display: block;
  width: 100%;
}
.activity-disclosure-content {
  padding: 8px 0;
}
.activity-information > view {
  margin-top: 6px;
}
.activity-setting-row {
  min-height: 52px;
  gap: 12px;
}
.activity-setting-copy {
  flex: 1;
  min-width: 0;
}
.activity-setting-row wu-f7-toggle {
  flex-shrink: 0;
}
.activity-inline-actions {
  flex-wrap: wrap;
}
.activity-detail-heading {
  padding: 16px 0;
}
.activity-detail-title {
  font-size: 26px;
  font-weight: 700;
  line-height: 1.3;
  letter-spacing: -0.5px;
  margin: 12px 0 20px;
  white-space: pre-wrap;
  overflow-wrap: anywhere;
}
.activity-organizer {
  display: flex;
  align-items: center;
  gap: 10px;
}
.activity-organizer-name {
  font-size: 15px;
  font-weight: 500;
  overflow-wrap: anywhere;
}
.activity-fact {
  display: flex;
  align-items: flex-start;
  gap: 12px;
  padding: 12px 16px;
  font-size: 16px;
  line-height: 1.5;
}
.activity-fact + .activity-fact {
  border-top: 1px solid var(--f7-list-item-border-color);
}
.activity-fact-value {
  min-width: 0;
  white-space: pre-wrap;
  overflow-wrap: anywhere;
}
.activity-body {
  display: block;
  font-size: 16px;
  line-height: 1.8;
  white-space: pre-wrap;
  overflow-wrap: anywhere;
}
.activity-detail-media {
  margin: 8px -16px 0;
}
.activity-hero-image {
  display: block;
  width: 100%;
  height: auto;
}
.activity-media-unavailable {
  display: flex;
  align-items: center;
  gap: 8px;
  padding: 12px 0;
  color: var(--f7-list-item-subtitle-text-color);
  font-size: 14px;
}
.activity-detail-media .activity-media-unavailable {
  padding: 12px 16px;
}
.activity-gallery-strip {
  width: 100%;
  white-space: nowrap;
}
.activity-gallery-options {
  display: inline-flex;
  gap: 6px;
  padding: 8px 16px;
}
.activity-media-choice {
  flex-shrink: 0;
}
.activity-qr-image {
  display: block;
  width: 240px;
  max-width: 100%;
  margin: 16px auto;
}
.activity-organizer-option {
  display: block;
  width: 100%;
  margin: 4px 0;
}
.activity-organizer-option-name {
  min-width: 0;
  overflow-wrap: anywhere;
}
.activity-title-input,
.activity-form-field wu-f7-input,
.activity-option-input {
  display: block;
  width: 100%;
}
.activity-description-input {
  display: block;
  width: 100%;
  min-height: 110px;
  box-sizing: border-box;
  font-size: 16px;
  line-height: 1.7;
  padding: 8px 0;
  color: var(--f7-text-color);
}
.activity-input-count {
  color: var(--f7-list-item-text-text-color);
  font-size: 12px;
  text-align: right;
  margin: 4px 0;
}
.activity-form-section {
  padding: 12px 0;
}
.activity-field-label {
  display: flex;
  align-items: baseline;
  flex-wrap: wrap;
  gap: 8px;
  font-size: 15px;
  font-weight: 500;
}
.activity-field-hint {
  color: var(--f7-list-item-subtitle-text-color);
  font-size: 12px;
  font-weight: 400;
}
.activity-type-choices {
  display: flex;
  flex-wrap: wrap;
  gap: 8px;
  margin-top: 8px;
}
.activity-form-row {
  display: flex;
  align-items: flex-start;
  gap: 12px;
  padding: 12px 0;
}
.activity-form-field {
  flex: 1;
  min-width: 0;
}
.activity-submit-area {
  padding: 12px 0;
}
.activity-submit-area > .activity-primary,
.activity-submit-buttons {
  margin-top: 12px;
}
.activity-submit-buttons {
  flex-wrap: wrap;
}
.activity-submit-buttons > wu-f7-button {
  flex: 1;
  min-width: 144px;
}
.activity-upload-row {
  display: flex;
  gap: 12px;
  padding: 12px 0;
}
.activity-upload-content {
  flex: 1;
  min-width: 0;
}
.activity-upload-label {
  display: flex;
  align-items: baseline;
  flex-wrap: wrap;
  gap: 8px;
  font-size: 16px;
  font-weight: 500;
}
.activity-upload-actions {
  display: flex;
  gap: 8px;
  flex-wrap: wrap;
}
.activity-discard,
.activity-preview-image {
  padding: 12px 0;
}
.activity-saved-image {
  display: block;
  width: 100%;
  border-radius: 8px;
}
.activity-published-state {
  text-align: center;
  padding: 32px 0;
}

/* Native navigator remains platform-owned and retains a full activation target. */
navigator.activity-text-button {
  display: flex;
  align-items: center;
  min-height: 44px;
  color: var(--f7-theme-color);
  gap: 4px;
}
