.activity-page {
  min-height: 100vh;
  box-sizing: border-box;
  padding: 8rpx 36rpx calc(44rpx + env(safe-area-inset-bottom));
  background: var(--wu-surface);
  color: var(--wu-text);
}
.activity-page button {
  margin: 0;
  padding: 0;
  border: 0;
  border-radius: 0;
  background: transparent;
  color: inherit;
  font-size: 27rpx;
  line-height: 1.5;
  text-align: left;
}
.activity-page button::after {
  border: 0;
}
.activity-page button[disabled] {
  opacity: 0.42;
}
.activity-toolbar,
.activity-toolbar-actions,
.activity-inline-actions,
.activity-heading-action,
.activity-filterbar,
.activity-pagination,
.activity-setting-row,
.activity-disclosure,
.activity-submit-buttons {
  display: flex;
  align-items: center;
  gap: 20rpx;
}
.activity-toolbar,
.activity-heading-action,
.activity-disclosure,
.activity-setting-row,
.activity-pagination {
  justify-content: space-between;
}
.activity-toolbar {
  min-height: 88rpx;
}
.activity-toolbar-actions {
  gap: 0;
}
.activity-page .activity-icon-button {
  display: flex;
  justify-content: center;
  align-items: center;
  width: 78rpx;
  min-height: 88rpx;
  flex-shrink: 0;
}
.activity-page .activity-text-button,
.activity-page .activity-event-open {
  display: inline-flex;
  align-items: center;
  gap: 8rpx;
  min-height: 88rpx;
  color: var(--wu-accent);
  font-size: 26rpx;
}
.activity-page .activity-muted {
  color: var(--wu-secondary);
}
.activity-page .activity-danger {
  color: var(--wu-danger);
}
.activity-page-heading {
  padding: 20rpx 0 28rpx;
}
.activity-eyebrow {
  color: var(--wu-secondary);
  font-size: 24rpx;
}
.activity-page-title {
  font-size: 52rpx;
  font-weight: 700;
  letter-spacing: -1.8rpx;
  line-height: 1.2;
  margin: 8rpx 0 12rpx;
}
.activity-page .activity-compact-primary,
.activity-page .activity-primary,
.activity-page .activity-secondary {
  display: flex;
  align-items: center;
  justify-content: center;
  min-height: 92rpx;
  gap: 12rpx;
  padding: 16rpx 28rpx;
  box-sizing: border-box;
  border-radius: 22rpx;
  font-size: 28rpx;
  font-weight: 600;
  text-align: center;
}
.activity-page .activity-compact-primary {
  min-height: 88rpx;
  padding: 12rpx 24rpx;
  border-radius: 44rpx;
}
.activity-page .activity-primary,
.activity-page .activity-compact-primary {
  background: var(--wu-accent);
  color: #fff;
}
.activity-page .activity-secondary {
  background: var(--wu-bg);
  color: var(--wu-secondary);
}
.activity-caption {
  color: var(--wu-secondary);
  font-size: 25rpx;
  line-height: 1.65;
}
.activity-footnote {
  color: var(--wu-secondary);
  font-size: 23rpx;
  line-height: 1.6;
}
.activity-list-caption {
  color: var(--wu-secondary);
  font-size: 25rpx;
  padding-bottom: 18rpx;
  border-bottom: 1rpx solid var(--wu-separator);
}
.activity-filterbar {
  min-height: 88rpx;
  border-bottom: 1rpx solid var(--wu-separator);
}
.activity-filter-label {
  flex: 1;
  font-size: 28rpx;
  font-weight: 600;
}
.activity-status {
  color: var(--wu-secondary);
  font-size: 25rpx;
  line-height: 1.65;
  margin: 12rpx 0;
  overflow-wrap: anywhere;
}
.activity-error {
  color: var(--wu-danger);
  background: var(--wu-danger-bg);
  padding: 20rpx 24rpx;
  margin: 20rpx 0;
  border-radius: 18rpx;
  font-size: 26rpx;
  overflow-wrap: anywhere;
}
.activity-event {
  display: flex;
  gap: 24rpx;
  padding: 32rpx 0;
  border-bottom: 1rpx solid var(--wu-separator);
}
.activity-event-content {
  flex: 1;
  min-width: 0;
}
.activity-event-organizer {
  font-size: 24rpx;
  color: var(--wu-secondary);
  margin-bottom: 10rpx;
  overflow-wrap: anywhere;
}
.activity-event-title {
  font-size: 33rpx;
  font-weight: 600;
  line-height: 1.4;
  letter-spacing: -0.5rpx;
  overflow-wrap: anywhere;
  white-space: pre-wrap;
}
.activity-event-symbol {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 92rpx;
  height: 92rpx;
  border-radius: 24rpx;
  flex-shrink: 0;
  background: var(--wu-bg);
}
.activity-event-chevron {
  display: flex;
  align-items: center;
  flex-shrink: 0;
}
.activity-tags {
  display: flex;
  flex-wrap: wrap;
  gap: 10rpx 12rpx;
  margin: 16rpx 0;
}
.activity-tag {
  background: var(--wu-bg);
  color: var(--wu-secondary);
  font-size: 22rpx;
  line-height: 1.4;
  padding: 6rpx 13rpx;
  border-radius: 8rpx;
}
.activity-event-fact {
  display: flex;
  align-items: flex-start;
  gap: 12rpx;
  margin: 10rpx 0 0;
  color: var(--wu-secondary);
  font-size: 25rpx;
  line-height: 1.6;
}
.activity-event-fact-label {
  min-width: 0;
  overflow-wrap: anywhere;
  white-space: pre-wrap;
}
.activity-event-fact wu-icon {
  padding-top: 4rpx;
}
.activity-page .activity-event-open {
  min-height: 68rpx;
}
.activity-pagination {
  padding: 12rpx 0;
  justify-content: center;
  gap: 40rpx;
}
.activity-page .activity-load-more {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 100%;
  min-height: 104rpx;
  gap: 12rpx;
  color: var(--wu-accent);
}
.activity-empty {
  padding: 88rpx 22rpx 100rpx;
  text-align: center;
}
.activity-empty-title {
  font-size: 32rpx;
  font-weight: 600;
  margin: 22rpx 0 12rpx;
}
.activity-list-note {
  margin-top: 28rpx;
}
.activity-section {
  padding: 26rpx 0;
  border-top: 1rpx solid var(--wu-separator);
}
.activity-section-title {
  font-size: 31rpx;
  font-weight: 600;
  line-height: 1.5;
  margin-bottom: 12rpx;
}
.activity-page .activity-disclosure {
  width: 100%;
  min-height: 88rpx;
  font-size: 28rpx;
}
.activity-disclosure-content {
  padding: 8rpx 0 20rpx;
}
.activity-information {
  color: var(--wu-secondary);
  font-size: 25rpx;
  line-height: 1.7;
  overflow-wrap: anywhere;
}
.activity-information > view {
  margin-top: 10rpx;
}
.activity-setting-row {
  align-items: center;
  min-height: 104rpx;
  gap: 26rpx;
  padding: 14rpx 0;
}
.activity-setting-copy {
  flex: 1;
  min-width: 0;
}
.activity-setting-row switch {
  flex-shrink: 0;
}
.activity-recovery {
  background: var(--wu-bg);
  border-radius: 24rpx;
  padding: 26rpx;
  margin: 24rpx 0;
}
.activity-recovery .activity-primary {
  margin-top: 22rpx;
}
.activity-recovery .activity-inline-actions {
  justify-content: space-between;
}
.activity-detail-page {
  padding-top: 12rpx;
}
.activity-detail-heading {
  padding: 18rpx 0 30rpx;
}
.activity-detail-title {
  font-size: 46rpx;
  line-height: 1.32;
  letter-spacing: -1rpx;
  font-weight: 700;
  margin: 18rpx 0 30rpx;
  overflow-wrap: anywhere;
  white-space: pre-wrap;
}
.activity-organizer {
  display: flex;
  align-items: center;
  gap: 18rpx;
}
.activity-organizer-symbol {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 72rpx;
  height: 72rpx;
  flex-shrink: 0;
  border-radius: 50%;
  background: var(--wu-bg);
}
.activity-organizer-name {
  font-size: 27rpx;
  font-weight: 500;
  overflow-wrap: anywhere;
}
.activity-facts {
  padding: 8rpx 0 20rpx;
  border-top: 1rpx solid var(--wu-separator);
}
.activity-fact {
  display: flex;
  align-items: flex-start;
  gap: 22rpx;
  padding: 20rpx 0;
  font-size: 29rpx;
  line-height: 1.55;
}
.activity-fact wu-icon {
  padding-top: 8rpx;
}
.activity-fact-value {
  min-width: 0;
  white-space: pre-wrap;
  overflow-wrap: anywhere;
}
.activity-fact-label {
  font-size: 24rpx;
  color: var(--wu-secondary);
  margin-bottom: 5rpx;
}
.activity-body {
  display: block;
  font-size: 29rpx;
  line-height: 1.85;
  white-space: pre-wrap;
  overflow-wrap: anywhere;
}
.activity-detail-media {
  margin: 12rpx -36rpx 0;
}
.activity-hero-image {
  display: block;
  width: 100%;
  height: auto;
}
.activity-media-unavailable {
  display: flex;
  align-items: center;
  gap: 14rpx;
  padding: 24rpx 0;
  color: var(--wu-secondary);
  font-size: 25rpx;
}
.activity-detail-media .activity-media-unavailable {
  padding: 24rpx 36rpx;
}
.activity-gallery-strip {
  width: 100%;
  white-space: nowrap;
}
.activity-gallery-options {
  display: inline-flex;
  gap: 12rpx;
  padding: 18rpx 36rpx;
}
.activity-page .activity-media-choice {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  gap: 10rpx;
  flex-shrink: 0;
  min-height: 88rpx;
  padding: 14rpx 22rpx;
  background: var(--wu-bg);
  color: var(--wu-secondary);
  border-radius: 18rpx;
  font-size: 24rpx;
}
.activity-page .activity-media-choice.selected {
  color: var(--wu-accent);
  background: var(--wu-tint);
}
.activity-organizer-contact {
  padding: 30rpx 0;
  border-top: 1rpx solid var(--wu-separator);
}
.activity-organizer-contact .activity-primary {
  margin: 24rpx 0;
}
.activity-qr-image {
  display: block;
  width: 440rpx;
  max-width: 100%;
  margin: 30rpx auto 20rpx;
}
.activity-contact-note {
  padding: 28rpx 0;
}
.activity-organizer-picker {
  padding: 20rpx 0 28rpx;
}
.activity-page .activity-organizer-option {
  display: flex;
  align-items: center;
  gap: 18rpx;
  width: 100%;
  min-height: 96rpx;
  padding: 18rpx 20rpx;
  border-radius: 18rpx;
  font-size: 28rpx;
}
.activity-organizer-option-name {
  flex: 1;
  min-width: 0;
  overflow-wrap: anywhere;
}
.activity-page .activity-organizer-option.selected {
  background: var(--wu-tint);
  color: var(--wu-accent);
}
.activity-writing-canvas {
  padding: 24rpx 0;
  border-top: 1rpx solid var(--wu-separator);
}
.activity-title-input {
  font-size: 38rpx;
  font-weight: 600;
  line-height: 1.5;
  height: 74rpx;
  padding: 0;
}
.activity-description-input {
  display: block;
  width: 100%;
  min-height: 210rpx;
  font-size: 29rpx;
  line-height: 1.8;
  padding: 18rpx 0 8rpx;
}
.activity-input-count {
  color: var(--wu-tertiary);
  font-size: 22rpx;
  text-align: right;
  padding: 6rpx 0;
}
.activity-form-section {
  padding: 24rpx 0;
}
.activity-field-label {
  display: flex;
  align-items: baseline;
  gap: 16rpx;
  font-size: 27rpx;
  font-weight: 500;
}
.activity-field-hint {
  color: var(--wu-secondary);
  font-size: 22rpx;
  font-weight: 400;
}
.activity-type-choices {
  display: flex;
  gap: 16rpx;
  padding-top: 20rpx;
}
.activity-page .activity-choice {
  display: flex;
  align-items: center;
  justify-content: center;
  min-height: 88rpx;
  gap: 8rpx;
  padding: 12rpx 30rpx;
  border-radius: 44rpx;
  font-size: 27rpx;
  color: var(--wu-secondary);
  background: var(--wu-bg);
}
.activity-page .activity-choice.selected {
  color: var(--wu-accent);
  background: var(--wu-tint);
}
.activity-form-rows {
  padding: 8rpx 0;
}
.activity-form-row {
  display: flex;
  align-items: flex-start;
  gap: 22rpx;
  padding: 24rpx 0;
  border-top: 1rpx solid var(--wu-separator);
}
.activity-form-row wu-icon {
  padding-top: 6rpx;
}
.activity-form-field {
  flex: 1;
  min-width: 0;
}
.activity-form-field input {
  font-size: 28rpx;
  min-height: 70rpx;
  padding: 8rpx 0;
}
.activity-option-input {
  font-size: 26rpx;
  min-height: 80rpx;
  background: var(--wu-bg);
  border-radius: 14rpx;
  margin: 18rpx 0 12rpx;
  padding: 0 18rpx;
}
.activity-submit-area {
  padding: 24rpx 0 12rpx;
}
.activity-submit-area > .activity-primary,
.activity-submit-buttons {
  margin-top: 22rpx;
}
.activity-submit-buttons > button {
  flex: 1;
}
.activity-draft-media {
  padding: 26rpx 0;
  border-top: 1rpx solid var(--wu-separator);
}
.activity-upload-row {
  display: flex;
  gap: 20rpx;
  padding: 24rpx 0;
  border-bottom: 1rpx solid var(--wu-separator);
}
.activity-upload-symbol {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 112rpx;
  height: 112rpx;
  flex-shrink: 0;
  border-radius: 18rpx;
  background: var(--wu-bg);
}
.activity-cover-row .activity-upload-symbol {
  width: 140rpx;
  height: 156rpx;
}
.activity-upload-content {
  flex: 1;
  min-width: 0;
}
.activity-upload-label {
  display: flex;
  gap: 14rpx;
  align-items: baseline;
  font-size: 28rpx;
  font-weight: 500;
}
.activity-upload-actions {
  display: flex;
  gap: 24rpx;
  flex-wrap: wrap;
}
.activity-upload-actions .activity-text-button {
  min-height: 88rpx;
  font-size: 24rpx;
}
.activity-discard {
  padding: 12rpx 0;
}
.activity-preview-image {
  padding: 24rpx 0;
}
.activity-saved-image {
  display: block;
  width: 100%;
  border-radius: 20rpx;
}
.activity-published-state {
  text-align: center;
  padding: 70rpx 0 54rpx;
}
