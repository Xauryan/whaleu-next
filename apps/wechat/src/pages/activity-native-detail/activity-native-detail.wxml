<view class="page"><view class="error">{{error}}</view><view wx:if="{{activity}}"><view class="title">{{activity.content.title}}</view><view>主办方：{{activity.organizerLabel}}</view><view>类型：{{activity.content.types}}</view><view>时间：{{activity.content.activityTime || '未指定'}}</view><view>地点：{{activity.content.activityLocation || '未指定'}}</view><view>结束时间：{{activity.content.endAt || '未指定'}}</view><text selectable="true">{{activity.content.description}}</text><view class="card"><button wx:for="{{slots}}" wx:key="slot" data-slot="{{item.slot}}" bindtap="onImage">{{item.label}}</button><image wx:if="{{image.status === 'ready'}}" src="{{image.src}}" mode="widthFix"/><text>{{image.message}}</text></view><view wx:if="{{activity.organizerQr.status === 'available'}}"><button bindtap="onQr">查看主办方公开主二维码</button><image wx:if="{{qr.status === 'ready'}}" src="{{qr.src}}" mode="widthFix"/><text>{{qr.message}}</text></view><view wx:elif="{{activity.organizerQr.status === 'unavailable'}}">主办方二维码已经变化，当前不可展示</view><view wx:else>发布者未开启主办方二维码展示</view></view></view>
