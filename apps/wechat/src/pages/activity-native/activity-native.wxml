<view class="f7-ios-theme activity-page">
  <view class="activity-toolbar">
    <wu-f7-button class="activity-text-button activity-muted" bind:press="onLegacy" variant="plain">活动目录<wu-icon name="chevron-right" size="14" /></wu-f7-button>
    <view class="activity-toolbar-actions">
      <wu-f7-button class="activity-icon-button" bind:press="onMine" aria-label="我的发布" variant="plain"><wu-icon name="person" size="21" /></wu-f7-button>
      <wu-f7-button class="activity-icon-button" bind:press="onRefresh" disabled="{{busy}}" aria-label="刷新活动" variant="plain"><wu-icon name="refresh" size="20" /></wu-f7-button>
    </view>
  </view>
  <view class="f7-ios-theme activity-page-heading activity-heading-action">
    <view class="f7-ios-theme activity-page-title">{{mine ? '我的发布' : '发现活动'}}</view>
    <wu-f7-button class="activity-compact-primary" bind:press="onPublish" variant="fill"><wu-icon name="plus" tone="inverse" size="17" /><text>发布</text></wu-f7-button>
  </view>
  <view class="activity-list-caption">{{mine ? '由你发布并已公开的活动' : '由校内组织发布的活动'}}</view>
  <view wx:if="{{error}}" class="activity-error" aria-role="alert">{{error}}</view>
  <view wx:if="{{busy}}" class="activity-status" aria-role="status">正在加载活动…</view>
  <wu-f7-list strong="{{true}}" spacing="compact">
  <wu-f7-list-item wx:for="{{items}}" wx:key="id" class="activity-event activity-native-event" data-id="{{item.id}}" bind:press="onDetail" aria-role="button" aria-label="{{item.content.title}}" link="{{true}}">
    <view class="activity-event-content">
      <view class="activity-event-organizer">{{item.organizerLabel}}</view>
      <view class="activity-event-title">{{item.content.title}}</view>
      <view class="activity-tags"><text class="activity-tag" wx:for="{{item.content.types}}" wx:for-item="type" wx:key="*this">{{activityTypeLabels[type]}}</text></view>
      <view class="activity-event-fact"><wu-icon name="clock" size="16" /><text class="activity-event-fact-label">{{item.content.activityTime || '时间待公布'}}</text></view>
      <view class="activity-event-fact"><wu-icon name="location" size="16" /><text class="activity-event-fact-label">{{item.content.activityLocation || '地点待公布'}}</text></view>
    </view>
  </wu-f7-list-item>
  </wu-f7-list>
  <wu-f7-block wx:if="{{!busy && !error && !items.length}}" class="activity-empty" spacing="compact">
    <wu-icon name="calendar" size="40" />
    <view class="activity-empty-title">{{mine ? '还没有已发布的活动' : '新的活动正在路上'}}</view>
    <view class="activity-caption">{{mine ? '发布成功后，可以在这里找到。' : '稍后再来看看校内组织的活动。'}}</view>
  </wu-f7-block>
  <wu-f7-button wx:if="{{more}}" class="activity-load-more" bind:press="onMore" disabled="{{busy}}" variant="plain">查看更多活动<wu-icon name="chevron-down" size="14" /></wu-f7-button>
  <view wx:if="{{mine}}" class="activity-footnote activity-list-note">按最初发布账号展示；组织转让不改变记录归属。旧版活动未并入。</view>
</view>
