.page {
  padding: 28rpx;
  color: #17343b;
}
.title {
  font-size: 40rpx;
  font-weight: 600;
  margin-bottom: 24rpx;
}
.card {
  padding: 24rpx;
  background: #fff;
  border-radius: 18rpx;
  margin: 24rpx 0;
}
.actions {
  display: flex;
  flex-wrap: wrap;
  gap: 12rpx;
}
.error {
  color: #b42318;
}
input,
textarea {
  background: #f3f6fb;
  padding: 12rpx;
  margin: 12rpx 0;
}
image {
  width: 100%;
  margin-top: 16rpx;
}
button {
  margin: 12rpx 0;
}
