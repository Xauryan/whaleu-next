<view class="page">
 <view class="title">发布活动</view><text>选择已审核、本人当前管理的本校组织。内容和图片通过独立审核后才会公开。</text>
 <view class="actions"><button bindtap="onCatalog">新发布活动</button><button bindtap="onMine">本人发布历史</button></view>
 <view wx:if="{{error}}" class="error">{{error}}</view><view wx:if="{{status}}">{{status}}</view>
 <view wx:if="{{pending}}" class="card"><text>原请求 {{pendingId}} 已冻结，请先恢复或取消；重复点击不会重复发布。</text><button bindtap="onRecover" disabled="{{busy}}">检查审核并恢复发布</button><button bindtap="onRetry" disabled="{{busy}}">重试完全相同的原请求</button><button bindtap="onCancelOriginal" disabled="{{busy}}">取消原请求</button></view>
 <view wx:if="{{!id}}" class="card"><view>主办方</view><button wx:for="{{organizers}}" wx:key="organizationId" data-id="{{item.organizationId}}" bindtap="onOrganizer" disabled="{{busy || pending}}">{{item.name}} {{selected && selected.organizationId === item.organizationId ? '（已选择）' : ''}}</button><text wx:if="{{loaded && !organizers.length}}">没有可发布活动的组织，请先申请组织并获得真实管理身份。</text><button wx:if="{{moreOrganizers}}" bindtap="onMoreOrganizers">更多组织</button></view>
 <view wx:if="{{!draft || draft.state !== 'published'}}" class="card">
  <view>标题（最多50字）</view><input value="{{form.title}}" maxlength="50" data-field="title" bindinput="onField" disabled="{{busy || pending}}" />
  <view>活动类型（可多选）：{{form.types}}</view><view class="actions"><button data-type="online" bindtap="onType" disabled="{{busy || pending}}">线上</button><button data-type="offline" bindtap="onType" disabled="{{busy || pending}}">线下</button><button data-type="reward" bindtap="onType" disabled="{{busy || pending}}">有奖</button></view>
  <view>活动时间（自由文本，线下必填）</view><input value="{{form.activityTime}}" maxlength="200" data-field="activityTime" bindinput="onField" disabled="{{busy || pending}}" />
  <view>活动地点（自由文本，线下必填）</view><input value="{{form.activityLocation}}" maxlength="200" data-field="activityLocation" bindinput="onField" disabled="{{busy || pending}}" />
  <view>介绍（最多1000字）</view><textarea value="{{form.description}}" maxlength="1000" data-field="description" bindinput="onField" disabled="{{busy || pending}}" />
  <view>结束时间（选填，ISO时间含时区；留空为未指定）</view><input value="{{endAtInput}}" placeholder="2026-12-01T18:00:00+08:00" data-field="endAt" bindinput="onField" disabled="{{busy || pending}}" />
  <view>公开展示主办方主二维码</view><switch checked="{{form.showOrganizerQr}}" bindchange="onQr" disabled="{{busy || pending}}" /><text>开启后，同校读者可查看组织当前公开的主二维码。</text>
  <button wx:if="{{!id}}" bindtap="onCreate" disabled="{{busy || pending || !selected}}">创建活动草稿</button>
 </view>
 <view wx:if="{{draft && draft.state === 'draft'}}" class="card"><view>封面必填，详情图最多9张。图片审核就绪后保存到草稿。</view><view wx:for="{{slots}}" wx:key="slot"><text>{{item.label}}：{{item.configured ? '已选择' : '未选择'}} {{item.changed ? '（待保存）' : ''}}</text><view class="actions"><button data-slot="{{item.slot}}" bindtap="onUpload" disabled="{{busy || pending || upload.status === 'working'}}">上传/更换</button><button data-slot="{{item.slot}}" bindtap="onPreview" disabled="{{busy || pending || !item.configured || item.changed}}">查看已保存图片</button><button data-slot="{{item.slot}}" bindtap="onRemove" disabled="{{busy || pending}}">移除</button></view></view><text>{{upload.message}}</text><view wx:for="{{pendingImages}}" wx:key="slot"><text>{{item.slot}} 原上传待恢复</text><button data-slot="{{item.slot}}" data-revision="{{item.revision}}" data-action="recover" bindtap="onPendingImage">恢复图片</button><button data-slot="{{item.slot}}" data-revision="{{item.revision}}" data-action="cancel" bindtap="onPendingImage">取消原图片</button></view><button bindtap="onDiscardDraft" disabled="{{busy || pending || upload.status === 'working'}}">放弃未发布草稿</button><button bindtap="onSave" disabled="{{busy || pending || upload.status === 'working'}}">保存内容和图片</button><button bindtap="onPublish" disabled="{{busy || pending || dirty || upload.status === 'working'}}">提交审核并发布</button></view>
 <image wx:if="{{image.status === 'ready'}}" src="{{image.src}}" mode="widthFix" /><text>{{image.message}}</text>
 <button wx:if="{{draft && draft.state === 'published'}}" bindtap="onPublished">查看已发布活动</button>
</view>
