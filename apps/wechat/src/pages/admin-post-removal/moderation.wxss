page {
  background: var(--wu-surface, #fff);
  color: var(--wu-text, #1d1d1f);
}
.management-page {
  padding: 12rpx 36rpx calc(60rpx + env(safe-area-inset-bottom));
}
.management-page .page-heading {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 24rpx;
  padding: 16rpx 0 8rpx;
}
.management-page .title {
  font-size: 42rpx;
  font-weight: 650;
  line-height: 1.3;
  letter-spacing: -1rpx;
}
.management-page .scope {
  display: flex;
  align-items: flex-start;
  gap: 12rpx;
  color: var(--wu-secondary, #6e6e73);
  font-size: 25rpx;
  line-height: 1.65;
  margin: 16rpx 0 24rpx;
}
.management-page .scope wu-icon {
  flex-shrink: 0;
  margin-top: 3rpx;
}
.management-page .section-title {
  font-size: 32rpx;
  font-weight: 600;
  line-height: 1.45;
}
.management-page .section-label {
  color: var(--wu-secondary, #6e6e73);
  font-size: 24rpx;
  margin-bottom: 12rpx;
}
.management-page .section,
.management-page .case-row {
  padding: 28rpx 0;
  border-top: 1rpx solid var(--wu-separator, #e5e5ea);
}
.management-page .case-summary {
  padding: 24rpx 0 12rpx;
}
.management-page .identity-row {
  display: flex;
  align-items: center;
  gap: 20rpx;
}
.management-page .identity-mark {
  width: 80rpx;
  height: 80rpx;
  flex-shrink: 0;
  border-radius: 26rpx;
  background: var(--wu-bg, #f5f5f7);
  display: flex;
  align-items: center;
  justify-content: center;
}
.management-page .field-row {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  gap: 24rpx;
  padding: 12rpx 0;
  font-size: 26rpx;
  line-height: 1.6;
}
.management-page .field-row text:first-child {
  color: var(--wu-secondary, #6e6e73);
  flex-shrink: 0;
}
.management-page .field-row text:last-child {
  text-align: right;
  overflow-wrap: anywhere;
}
.management-page .body {
  font-size: 29rpx;
  line-height: 1.7;
  white-space: pre-wrap;
  overflow-wrap: anywhere;
  margin: 14rpx 0;
}
.management-page .notice,
.management-page .meta,
.management-page .status {
  color: var(--wu-secondary, #6e6e73);
  font-size: 25rpx;
  line-height: 1.65;
  margin: 14rpx 0;
  overflow-wrap: anywhere;
}
.management-page .status:empty {
  display: none;
}
.management-page .reference {
  color: var(--wu-secondary, #6e6e73);
  font-size: 23rpx;
  line-height: 1.6;
  overflow-wrap: anywhere;
  padding: 12rpx 0;
}
.management-page .error {
  color: var(--wu-danger, #b42318);
  background: var(--wu-danger-bg, #fff0ee);
  border-radius: 20rpx;
  padding: 20rpx 24rpx;
  margin: 18rpx 0;
  font-size: 26rpx;
  line-height: 1.65;
}
.management-page button,
.management-page navigator {
  min-height: 88rpx;
  box-sizing: border-box;
}
.management-page button {
  margin: 0;
  border-radius: 24rpx;
  padding: 22rpx 24rpx;
  font-size: 29rpx;
  font-weight: 500;
  line-height: 1.45;
  background: transparent;
  color: var(--wu-accent, #007aff);
}
.management-page button::after {
  border: 0;
}
.management-page button[disabled] {
  opacity: 0.42;
}
.management-page .primary {
  background: var(--wu-accent, #007aff);
  color: #fff;
  font-weight: 600;
  margin: 20rpx 0 12rpx;
}
.management-page .destructive {
  background: var(--wu-danger, #b42318);
  color: #fff;
}
.management-page .secondary {
  background: var(--wu-bg, #f5f5f7);
  margin: 12rpx 0;
  color: var(--wu-text, #1d1d1f);
}
.management-page .quiet {
  width: 100%;
}
.management-page .icon-button {
  width: 88rpx;
  height: 88rpx;
  flex-shrink: 0;
  padding: 0;
  display: flex;
  align-items: center;
  justify-content: center;
}
.management-page .disclosure,
.management-page .link {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 16rpx;
  width: 100%;
  padding: 20rpx 0;
  color: var(--wu-text, #1d1d1f);
  text-align: left;
  font-size: 27rpx;
}
.management-page .disclosure {
  color: var(--wu-secondary, #6e6e73);
}
.management-page .links {
  margin-top: 30rpx;
}
.management-page .links .link {
  border-top: 1rpx solid var(--wu-separator, #e5e5ea);
}
.management-page .confirmation {
  background: var(--wu-bg, #f5f5f7);
  padding: 28rpx;
  margin: 24rpx -8rpx;
  border-radius: 28rpx;
}
.management-page .confirmation .notice {
  color: var(--wu-text, #1d1d1f);
}
.management-page .confirmation .section-title {
  margin-bottom: 18rpx;
}
.management-page .punishment-controls {
  border-top: 1rpx solid var(--wu-separator, #e5e5ea);
  margin-top: 24rpx;
  padding-top: 24rpx;
  font-size: 26rpx;
  line-height: 1.7;
}
.management-page radio-group {
  display: flex;
  flex-direction: column;
  margin: 16rpx 0;
}
.management-page radio-group label {
  min-height: 80rpx;
  display: flex;
  align-items: center;
  gap: 14rpx;
}
.management-page radio {
  transform: scale(0.85);
}
.management-page input,
.management-page textarea {
  box-sizing: border-box;
  width: 100%;
  border-radius: 20rpx;
  padding: 22rpx 24rpx;
  background: var(--wu-bg, #f5f5f7);
  color: var(--wu-text, #1d1d1f);
  font-size: 28rpx;
  line-height: 1.6;
  margin: 16rpx 0;
}
.management-page input {
  height: 88rpx;
}
.management-page textarea {
  min-height: 184rpx;
}
.management-page .confirmation input,
.management-page .confirmation textarea {
  background: var(--wu-surface, #fff);
}
.management-page .field-label {
  font-size: 27rpx;
  font-weight: 600;
  margin-top: 24rpx;
}
.management-page .recovery {
  border-top: 1rpx solid var(--wu-separator, #e5e5ea);
  padding: 28rpx 0;
  margin-top: 18rpx;
}
.management-page .original-request {
  border-left: 3rpx solid var(--wu-separator, #e5e5ea);
  padding-left: 20rpx;
  margin: 18rpx 0;
}
.management-page .empty {
  padding: 60rpx 16rpx;
  text-align: center;
}
.management-page .empty .section-title {
  margin-top: 18rpx;
}
.management-page .row-heading {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 20rpx;
}
.management-page .read-state {
  font-size: 23rpx;
  color: var(--wu-secondary, #6e6e73);
}
.management-page .unread-dot {
  display: inline-block;
  width: 12rpx;
  height: 12rpx;
  background: var(--wu-accent, #007aff);
  border-radius: 50%;
  margin-right: 10rpx;
}
.management-page .inline-actions {
  display: flex;
  align-items: center;
  gap: 16rpx;
}
.management-page .inline-actions button {
  flex: 1;
}
.management-page .timeline-item {
  border-left: 2rpx solid var(--wu-separator, #e5e5ea);
  margin: 16rpx 0 16rpx 8rpx;
  padding: 4rpx 0 24rpx 24rpx;
}
.management-page .evidence {
  display: block;
  width: 100%;
  border-radius: 20rpx;
  margin-top: 20rpx;
}
.management-page .footnote {
  color: var(--wu-secondary, #6e6e73);
  font-size: 23rpx;
  line-height: 1.65;
  margin-top: 24rpx;
}
