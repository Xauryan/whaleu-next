<view class="screen"><view class="title">公告管理</view><view class="meta">{{management === 'fixed' ? regionName : management === 'global' ? '全局超级管理员' : '正在核验管理权限'}}</view><view class="status">{{status}}</view><view class="error">{{error}}</view><button bindtap="onRefresh" disabled="{{busy}}">重新读取</button><button wx:if="{{management !== 'none'}}" bindtap="onNew" disabled="{{busy || pending}}">新建公告</button><button wx:if="{{pending}}" bindtap="onRecovery">恢复原公告操作</button><view wx:for="{{items}}" wx:key="id" class="card"><text class="announcement-title">{{item.content.title}}</text><text class="meta">版本 {{item.content.versionLabel}} · {{item.state === 'draft' ? '私有上传准备' : item.state === 'active' ? '已启用' : '已停用'}}</text><button data-id="{{item.id}}" bindtap="onEdit" disabled="{{busy}}">编辑 / 停用启用</button></view><button wx:if="{{more}}" bindtap="onMore" disabled="{{busy}}">加载更多</button></view>
