@import '../../design/framework7-ios.wxss';

/* Existing page-native geometry is retained before F7 composition overrides. */
.campus-map {
  display: block;
  width: 100%;
  height: 520rpx;
  border-radius: 24rpx;
  overflow: hidden;
  background: var(--wu-bg);
}
.map-actions {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 24rpx;
  padding-top: 12rpx;
}
.tools-page .map-locate {
  display: flex;
  align-items: center;
  gap: 10rpx;
  min-height: 88rpx;
  padding: 12rpx 0;
  color: var(--wu-accent);
  background: transparent;
}
.place-detail {
  margin-top: 26rpx;
  padding: 12rpx 0 24rpx;
  border-bottom: 1rpx solid var(--wu-separator);
}
.place-detail-heading {
  display: flex;
  align-items: center;
  gap: 16rpx;
}
.place-detail .tool-description {
  margin-top: 16rpx;
}
.tools-page .place-row {
  display: flex;
  align-items: center;
  gap: 18rpx;
  width: 100%;
  min-height: 126rpx;
  padding: 20rpx 0;
  border-radius: 0;
  background: transparent;
}
.place-item + .place-item {
  border-top: 1rpx solid var(--wu-separator);
}
.place-pin {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 56rpx;
  height: 64rpx;
}
.is-selected .tool-row-title {
  color: var(--wu-accent);
}

.f7-campus-tool-screen {
  min-height: 100vh;
  box-sizing: border-box;
  padding: 1px 0 calc(24px + env(safe-area-inset-bottom));
  background: var(--f7-page-bg-color);
  color: var(--f7-text-color);
}
.f7-campus-tool-screen .tool-entry-title {
  padding: 0 0 12px;
  font-size: 22px;
  line-height: 1.4;
}
.f7-campus-tool-screen .tool-status,
.f7-campus-tool-screen .tool-footnote,
.f7-campus-tool-screen .tool-source,
.f7-campus-tool-screen .tool-count {
  color: var(--f7-block-footer-text-color);
  font-size: var(--f7-block-footer-font-size);
  line-height: 1.5;
}
.f7-campus-tool-screen .tool-error {
  color: var(--f7-input-error-text-color);
  font-size: var(--f7-block-footer-font-size);
}
.f7-campus-tool-screen .tool-section-title {
  font-size: var(--f7-block-title-font-size);
  font-weight: var(--f7-block-title-font-weight);
  line-height: var(--f7-block-title-line-height);
}
.f7-campus-tool-screen .tool-row-title {
  font-size: var(--f7-list-item-title-font-size);
  font-weight: var(--f7-list-item-title-font-weight);
  line-height: var(--f7-list-item-title-line-height);
}
.f7-campus-tool-screen .tool-row-detail {
  margin-top: 4px;
  color: var(--f7-list-item-footer-text-color);
  font-size: var(--f7-list-item-footer-font-size);
  line-height: var(--f7-list-item-footer-line-height);
}
.f7-campus-tool-screen .tool-text-button,
.f7-campus-tool-screen .tool-primary,
.f7-campus-tool-screen .tool-secondary,
.f7-campus-tool-screen .tool-icon-button {
  display: block;
  min-height: 0;
  padding: 0;
  border-radius: 0;
  background: transparent;
  color: inherit;
}
.f7-campus-tool-screen .tool-icon-button {
  flex: 0 0 44px;
  width: 44px;
}
.f7-campus-tool-screen .tool-recovery {
  gap: 12px;
  padding: 8px 0;
}
.f7-campus-tool-screen .tool-recovery navigator {
  display: flex;
  align-items: center;
  min-height: 44px;
  color: var(--f7-theme-color);
  font-size: 15px;
}
.f7-campus-tool-screen .tool-source-footer {
  padding-top: 8px;
  gap: 12px;
}
.f7-campus-tool-screen .tool-navigation {
  margin-top: 16px;
  padding-top: 12px;
  border-color: var(--f7-list-item-border-color);
}
.f7-campus-tool-screen .tool-home {
  min-height: 44px;
  color: var(--f7-theme-color);
  font-size: 14px;
}
.f7-campus-tool-screen .tool-preview {
  background: var(--f7-page-bg-color);
}
.f7-campus-tool-screen .preview-controls .tool-secondary {
  flex: 1;
}
.f7-tool-action-label {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 6px;
}
.f7-campus-tool-screen .campus-map {
  width: calc(100% - 32px);
  margin: 0 16px;
  border-radius: 8px;
}
.f7-campus-tool-screen .map-actions,
.f7-campus-tool-screen .map-content > .tool-footnote,
.f7-campus-tool-screen .place-detail,
.f7-campus-tool-screen .tool-section-heading {
  margin-left: 16px;
  margin-right: 16px;
}
.f7-campus-tool-screen .map-locate {
  display: block;
  min-height: 0;
  padding: 0;
}
.f7-campus-tool-screen .place-row {
  display: block;
  min-height: 0;
  padding: 0;
}
.f7-campus-tool-screen .place-item + .place-item {
  border-top: 0;
}
.f7-campus-tool-screen .place-pin {
  width: 24px;
  height: 32px;
}
.f7-campus-tool-screen .tool-row-title.is-selected {
  color: var(--f7-theme-color);
}
