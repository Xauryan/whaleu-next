<view class="tools-page tools-research-page f7-ios-theme f7-campus-tool-screen">
  <wu-f7-block spacing="compact">
  <view wx:if="{{entry &amp;&amp; entry.title !== '科研资源'}}" class="tool-entry-title">{{entry.title}}</view>
  <view wx:if="{{status &amp;&amp; status !== '当前已确认的工具资料'}}" class="tool-status" aria-role="status">{{status}}</view>
  <view wx:if="{{error}}" class="tool-error" aria-role="alert">{{error}}</view>
  <view wx:if="{{authRecovery}}" class="tool-recovery">
    <navigator class="tool-primary" url="/pages/login/login">重新登录</navigator>
    <wu-f7-button class="tool-text-button" bind:press="onContinueGuest">以访客继续</wu-f7-button>
  </view>
  </wu-f7-block>
  <wu-f7-block wx:if="{{entry &amp;&amp; entry.state === 'enabled'}}" class="research-content" spacing="compact" strong="{{true}}" inset="{{true}}">
    <view class="research-symbol" aria-hidden="true"><wu-icon name="book" size="32" /></view>
    <view class="tool-description research-description">{{entry.description}}</view>
    <view wx:if="{{entry.compatibility}}" class="research-compatibility"><view class="tool-eyebrow">适用说明</view><view>{{entry.compatibility}}</view></view>
    <wu-f7-list spacing="compact">
    <wu-f7-list-item wx:if="{{entry.image}}" class="research-preview-link" data-binding="{{entry.image.bindingId}}" bind:press="onPreview" link="{{true}}" title-slot="{{true}}" media="{{true}}" aria-label="{{entry.image.alt}}" last="{{true}}"><view slot="media"><wu-icon name="image" size="21" /></view><text slot="title">{{entry.image.alt}}</text></wu-f7-list-item>
    </wu-f7-list>
    <view wx:if="{{externalHost}}" class="research-host"><wu-icon name="lock" size="14" /><text>{{externalHost}}</text></view>
    <wu-f7-button wx:if="{{entry.link}}" class="tool-primary research-copy" bind:press="onCopy" disabled="{{busy}}" variant="fill" size="large">复制资源链接</wu-f7-button>
    <view wx:if="{{entry.link}}" class="tool-footnote research-copy-note">复制后在浏览器打开，不会安装软件。</view>
  </wu-f7-block>
  <view wx:if="{{image.expanded}}" class="tool-preview" aria-role="dialog" aria-label="图片预览">
    <view class="preview-heading">
      <view class="preview-heading-copy"><view class="preview-title">{{image.alt}}</view><view class="preview-count">{{image.selected + 1}} / {{image.total}}</view></view>
      <wu-f7-button class="tool-icon-button" aria-label="关闭预览" bind:press="onCloseImage"><wu-icon name="close" size="22" /></wu-f7-button>
    </view>
    <view class="preview-stage">
      <image wx:if="{{image.src}}" class="preview-image" src="{{image.src}}" mode="aspectFit" data-source="{{image.src}}" data-view-id="{{image.viewId}}" binderror="onImageError" />
      <view wx:if="{{image.message}}" class="preview-message" aria-role="status">{{image.message}}</view>
      <wu-f7-button wx:if="{{image.status === 'unavailable'}}" class="tool-primary preview-retry" bind:press="onImageRetry" variant="fill" size="large">重试当前图片</wu-f7-button>
    </view>
    <view class="preview-controls"><wu-f7-button class="tool-secondary" bind:press="onImagePrevious" disabled="{{image.selected === 0}}" variant="tonal">上一张</wu-f7-button><wu-f7-button class="tool-secondary" bind:press="onImageNext" disabled="{{image.selected + 1 >= image.total}}" variant="tonal">下一张</wu-f7-button></view>
  </view>
  <wu-f7-block spacing="compact">
  <view class="tool-source-footer">
  <view wx:if="{{provenance}}" class="tool-source">
    <view>{{provenance.maintainer}} · {{provenance.attribution}}</view>
    <view>发布于 {{provenance.publishedAt}}</view>
    <view wx:if="{{provenance.validity.kind === 'finite'}}">有效期至 {{provenance.validity.expiresAt}}</view>
  </view>
    <wu-f7-button class="tool-icon-button" aria-label="刷新当前工具" bind:press="onRefresh" disabled="{{busy}}" loading="{{busy}}"><wu-icon name="refresh" size="20" /></wu-f7-button>
  </view>
  <view class="tool-navigation">
    <wu-f7-button class="tool-text-button" bind:press="onBack">返回上一页</wu-f7-button>
    <navigator class="tool-home" url="/pages/campus-tools/campus-tools" open-type="reLaunch">全部校园工具<wu-icon name="chevron-right" tone="accent" size="13" /></navigator>
  </view>
  </wu-f7-block>
</view>
