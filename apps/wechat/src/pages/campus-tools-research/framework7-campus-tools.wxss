@import '../../design/framework7-ios.wxss';

/* Existing page-native geometry is retained before F7 composition overrides. */
.research-symbol {
  display: flex;
  align-items: center;
  width: 80rpx;
  height: 96rpx;
  margin: 8rpx 0 22rpx;
}
.research-description {
  font-size: 30rpx;
}
.research-compatibility {
  margin-top: 32rpx;
  padding: 24rpx 0;
  border-top: 1rpx solid var(--wu-separator);
  color: var(--wu-secondary);
  font-size: 26rpx;
  line-height: 1.7;
}
.research-compatibility .tool-eyebrow {
  margin-bottom: 10rpx;
  color: var(--wu-text);
  font-size: 26rpx;
  font-weight: 500;
}
.tools-page .research-preview-link {
  display: flex;
  align-items: center;
  gap: 18rpx;
  width: 100%;
  min-height: 108rpx;
  padding: 24rpx 0;
  border-radius: 0;
  border-top: 1rpx solid var(--wu-separator);
  border-bottom: 1rpx solid var(--wu-separator);
  background: transparent;
}
.research-preview-link text {
  flex: 1;
  min-width: 0;
  font-size: 27rpx;
  overflow-wrap: anywhere;
}
.research-host {
  display: flex;
  gap: 10rpx;
  align-items: center;
  margin-top: 26rpx;
  color: var(--wu-secondary);
  font-size: 23rpx;
  overflow-wrap: anywhere;
}
.tools-page .research-copy {
  margin-top: 40rpx;
  width: 100%;
}
.research-copy-note {
  text-align: center;
  font-size: 22rpx;
}

.f7-campus-tool-screen {
  min-height: 100vh;
  box-sizing: border-box;
  padding: 1px 0 calc(24px + env(safe-area-inset-bottom));
  background: var(--f7-page-bg-color);
  color: var(--f7-text-color);
}
.f7-campus-tool-screen .tool-entry-title {
  padding: 0 0 12px;
  font-size: 22px;
  line-height: 1.4;
}
.f7-campus-tool-screen .tool-status,
.f7-campus-tool-screen .tool-footnote,
.f7-campus-tool-screen .tool-source,
.f7-campus-tool-screen .tool-count {
  color: var(--f7-block-footer-text-color);
  font-size: var(--f7-block-footer-font-size);
  line-height: 1.5;
}
.f7-campus-tool-screen .tool-error {
  color: var(--f7-input-error-text-color);
  font-size: var(--f7-block-footer-font-size);
}
.f7-campus-tool-screen .tool-section-title {
  font-size: var(--f7-block-title-font-size);
  font-weight: var(--f7-block-title-font-weight);
  line-height: var(--f7-block-title-line-height);
}
.f7-campus-tool-screen .tool-row-title {
  font-size: var(--f7-list-item-title-font-size);
  font-weight: var(--f7-list-item-title-font-weight);
  line-height: var(--f7-list-item-title-line-height);
}
.f7-campus-tool-screen .tool-row-detail {
  margin-top: 4px;
  color: var(--f7-list-item-footer-text-color);
  font-size: var(--f7-list-item-footer-font-size);
  line-height: var(--f7-list-item-footer-line-height);
}
.f7-campus-tool-screen .tool-text-button,
.f7-campus-tool-screen .tool-primary,
.f7-campus-tool-screen .tool-secondary,
.f7-campus-tool-screen .tool-icon-button {
  display: block;
  min-height: 0;
  padding: 0;
  border-radius: 0;
  background: transparent;
  color: inherit;
}
.f7-campus-tool-screen .tool-icon-button {
  flex: 0 0 44px;
  width: 44px;
}
.f7-campus-tool-screen .tool-recovery {
  gap: 12px;
  padding: 8px 0;
}
.f7-campus-tool-screen .tool-recovery navigator {
  display: flex;
  align-items: center;
  min-height: 44px;
  color: var(--f7-theme-color);
  font-size: 15px;
}
.f7-campus-tool-screen .tool-source-footer {
  padding-top: 8px;
  gap: 12px;
}
.f7-campus-tool-screen .tool-navigation {
  margin-top: 16px;
  padding-top: 12px;
  border-color: var(--f7-list-item-border-color);
}
.f7-campus-tool-screen .tool-home {
  min-height: 44px;
  color: var(--f7-theme-color);
  font-size: 14px;
}
.f7-campus-tool-screen .tool-preview {
  background: var(--f7-page-bg-color);
}
.f7-campus-tool-screen .preview-controls .tool-secondary {
  flex: 1;
}
.f7-tool-action-label {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 6px;
}
.f7-campus-tool-screen .research-description {
  font-size: var(--f7-block-font-size);
  line-height: 1.6;
}
.f7-campus-tool-screen .research-preview-link {
  display: block;
  min-height: 0;
  padding: 0;
  border: 0;
}
.f7-campus-tool-screen .research-preview-link text {
  font-size: var(--f7-list-item-title-font-size);
}
.f7-campus-tool-screen .research-copy {
  margin-top: 20px;
  width: 100%;
}
