<view class="page">
  <view class="title">{{entry ? entry.title : '校园工具'}}</view>
  <view class="status" aria-role="status">{{status}}</view>
  <view wx:if="{{error}}" class="error" aria-role="alert">{{error}}</view>
  <view wx:if="{{authRecovery}}" class="card"><navigator url="/pages/login/login">重新登录</navigator><button bindtap="onContinueGuest">明确以访客继续</button></view>
  <button bindtap="onRefresh" disabled="{{busy}}" loading="{{busy}}">刷新当前工具</button>
  <view wx:if="{{entry &amp;&amp; entry.state === 'enabled'}}">
    <view wx:for="{{entry.groups}}" wx:for-item="group" wx:key="id" class="card">
      <button data-id="{{group.id}}" bindtap="onToggleGroup">{{group.title}} · {{expandedGroups[group.id] ? '收起' : '展开'}}</button>
      <view wx:if="{{expandedGroups[group.id]}}">
        <view wx:if="{{!group.slots.length}}" class="hint">本组已确认暂无图片</view>
        <button wx:for="{{group.slots}}" wx:for-item="slot" wx:key="bindingId" data-binding="{{slot.bindingId}}" bindtap="onPreview">查看图片：{{slot.alt}}</button>
      </view>
    </view>
  </view>
  <view wx:if="{{image.expanded}}" class="preview">
    <view>{{image.alt}}（{{image.selected + 1}} / {{image.total}}）</view>
    <view aria-role="status">{{image.message}}</view>
    <image wx:if="{{image.src}}" src="{{image.src}}" mode="aspectFit" data-source="{{image.src}}" data-view-id="{{image.viewId}}" binderror="onImageError" />
    <button wx:if="{{image.status === 'unavailable'}}" bindtap="onImageRetry">重试当前图片</button>
    <view class="row"><button bindtap="onImagePrevious" disabled="{{image.selected === 0}}">上一张</button><button bindtap="onImageNext" disabled="{{image.selected + 1 >= image.total}}">下一张</button></view>
    <button bindtap="onCloseImage">关闭预览</button>
  </view>
  <view wx:if="{{provenance}}" class="hint">资料维护：{{provenance.maintainer}} · {{provenance.attribution}}<view>发布时间：{{provenance.publishedAt}}</view><view wx:if="{{provenance.validity.kind === 'finite'}}">有效期至：{{provenance.validity.expiresAt}}</view></view>
  <button bindtap="onBack">返回</button>
  <navigator class="link" url="/pages/campus-tools/campus-tools" open-type="reLaunch">返回校园工具首页</navigator>
</view>
