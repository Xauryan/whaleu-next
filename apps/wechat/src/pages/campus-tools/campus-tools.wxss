.page {
  padding: 32rpx;
  color: #18354b;
}
.title {
  font-size: 42rpx;
  font-weight: 700;
  margin-bottom: 16rpx;
}
.subtitle {
  font-size: 32rpx;
  font-weight: 600;
  margin: 12rpx 0;
}
.card {
  background: #fff;
  border-radius: 20rpx;
  padding: 24rpx;
  margin: 20rpx 0;
}
.hint {
  font-size: 25rpx;
  color: #61758a;
  line-height: 1.6;
  margin: 12rpx 0;
}
.status {
  line-height: 1.6;
}
.error {
  color: #a42135;
  padding: 20rpx;
  background: #fff0f0;
  border-radius: 12rpx;
}
.description {
  white-space: pre-wrap;
  line-height: 1.7;
}
button {
  margin-top: 16rpx;
  font-size: 28rpx;
}
.row {
  display: flex;
  align-items: center;
  gap: 12rpx;
}
.row button {
  flex: 1;
}
.campus-map {
  width: 100%;
  height: 560rpx;
}
.preview {
  position: fixed;
  inset: 0;
  z-index: 10;
  padding: 32rpx;
  background: #eef2f8;
  display: flex;
  flex-direction: column;
  justify-content: center;
}
.preview image {
  width: 100%;
  height: 65vh;
}
.link {
  display: block;
  margin: 24rpx 0;
  color: #195a93;
}
