<view class="account-page f7-ios-theme f7-identity-screen">
  <wu-f7-list strong="{{true}}" inset="{{true}}" spacing="compact">
    <wu-f7-list-item title="当前浏览校园" footer-slot="{{true}}">
      <view slot="footer" class="current-campus-name"> {{selectedName}} </view>
    </wu-f7-list-item>
  </wu-f7-list>
  <wu-f7-block spacing="compact">
    <view class="privacy-note">
      切换后浏览对应校园的内容，不会改变学生认证或身份校区。
    </view>
  </wu-f7-block>
  <wu-f7-list strong="{{true}}" inset="{{true}}" spacing="compact">
    <view class="identity-input-row">
      <wu-f7-input
        id="campus-search"
        value="{{q}}"
        placeholder="搜索学校或校区"
        maxlength="100"
        confirm-type="search"
        disabled="{{loading || saving}}"
        bind:input="onQuery"
        bind:confirm="onSearch"
        label="学校或校区"
        clearable="{{false}}"
      />
    </view>
    <view class="identity-input-row">
      <wu-f7-input
        id="district-search"
        class="input"
        value="{{district}}"
        placeholder="缩小搜索范围"
        maxlength="100"
        confirm-type="search"
        disabled="{{loading || saving}}"
        bind:input="onDistrict"
        bind:confirm="onSearch"
        label="地区（选填）"
        clearable="{{false}}"
      />
    </view>
  </wu-f7-list>
  <wu-f7-block spacing="compact">
    <wu-f7-button
      class="primary"
      disabled="{{!hasSession || !configured || loading || saving}}"
      loading="{{loading}}"
      bind:press="onSearch"
      variant="fill"
      size="large"
    >
      搜索校园
    </wu-f7-button>
    <view class="status-line" aria-role="status"> {{status}} </view>
    <view wx:if="{{error}}" class="error" aria-role="alert"> {{error}} </view>
    <view wx:if="{{requestId}}" class="request-id" selectable="true">
      问题编号：{{requestId}}
    </view>
    <wu-f7-button
      wx:if="{{loading || saving}}"
      class="quiet"
      bind:press="onCancelOperation"
      variant="plain"
      size="normal"
    >
      {{saving ? '停止等待保存结果' : '取消加载'}}
    </wu-f7-button>
    <wu-f7-button
      wx:if="{{!loading &amp;&amp; !saving &amp;&amp; (!loaded || error)}}"
      class="secondary"
      disabled="{{!hasSession || !configured}}"
      bind:press="onReload"
      variant="tonal"
      size="normal"
    >
      重新加载
    </wu-f7-button>
    <navigator
      wx:if="{{!hasSession}}"
      class="text-link"
      url="/pages/login/login"
      open-type="reLaunch"
    >
      前往登录
    </navigator>
  </wu-f7-block>
  <block wx:if="{{loaded}}">
    <wu-f7-block spacing="compact">
      <view wx:if="{{!items.length &amp;&amp; !loading}}" class="empty-state">
        <wu-icon name="search" tone="muted" size="32" />
        <view class="section-title"> 没有找到校园 </view>
        <view class="body-copy"> 试试其他名称，或清空地区后再搜索。 </view>
      </view>
    </wu-f7-block>
    <view wx:if="{{items.length}}" class="section-label">
      {{total}} 个搜索结果
    </view>
    <wu-f7-list strong="{{true}}" inset="{{true}}" spacing="compact">
      <view wx:for="{{items}}" wx:key="id">
        <wu-f7-list-item
          class="choice {{candidateId === item.id ? 'selected' : ''}}"
          data-id="{{item.id}}"
          disabled="{{!item.isActive || loading || saving || needsReload || searchDirty}}"
          bind:press="onChoose"
          link="{{true}}"
          title="{{item.fullName}}"
          after="{{candidateId === item.id ? '已选' : ''}}"
          aria-label="{{item.fullName + '，' + item.institutionName + '，' + item.district + (selectedId === item.id ? '，当前校园' : '') + (!item.isActive ? '，暂不可选择' : '') + (candidateId === item.id ? '，已选' : '')}}"
          footer-slot="{{true}}"
        >
          <view slot="footer" class="choice-meta">
            <view> {{item.institutionName}} · {{item.district}} </view>
            <view wx:if="{{item.shortName}}"> {{item.shortName}} </view>
            <view wx:if="{{selectedId === item.id}}"> 当前校园 </view>
            <view wx:if="{{!item.isActive}}"> 暂不可选择 </view>
          </view>
        </wu-f7-list-item>
      </view>
    </wu-f7-list>
    <wu-f7-block spacing="compact">
      <view class="pagination">
        <wu-f7-button
          class="quiet"
          disabled="{{!hasPrevious || loading || saving || searchDirty}}"
          bind:press="onPrevious"
          variant="plain"
          size="normal"
        >
          上一页
        </wu-f7-button>
        <text class="page-count"> 第 {{page}} 页 </text>
        <wu-f7-button
          class="quiet"
          disabled="{{!hasNext || loading || saving || searchDirty}}"
          bind:press="onNext"
          variant="plain"
          size="normal"
        >
          下一页
        </wu-f7-button>
      </view>
    </wu-f7-block>
    <wu-f7-block spacing="compact">
      <view wx:if="{{searchDirty}}" class="caption">
        搜索条件已修改，请重新搜索。
      </view>
    </wu-f7-block>
    <wu-f7-block
      wx:if="{{candidateId}}"
      class="confirmation"
      strong="{{true}}"
      inset="{{true}}"
      spacing="compact"
    >
      <view class="caption"> 即将切换至 </view>
      <view class="section-title"> {{candidateName}} </view>
      <view class="body-copy"> 仅更新浏览校园，不会申请或变更学生认证。 </view>
      <wu-f7-button
        class="primary"
        loading="{{saving}}"
        disabled="{{candidateId === selectedId || loading || saving || needsReload || searchDirty}}"
        bind:press="onSave"
        variant="fill"
        size="large"
      >
        确认切换
      </wu-f7-button>
      <wu-f7-button
        class="secondary"
        disabled="{{saving}}"
        bind:press="onCancelSelection"
        variant="tonal"
        size="normal"
      >
        取消选择
      </wu-f7-button>
    </wu-f7-block>
  </block>
  <wu-f7-list strong="{{true}}" inset="{{true}}" spacing="compact">
    <navigator class="link-row" url="/pages/community-feed/community-feed">
      <wu-f7-list-item title-slot="{{true}}" after-slot="{{true}}">
        <text class="link-label" slot="title"> 去校园看看 </text>
        <wu-icon name="chevron-right" size="16" tone="muted" slot="after" />
      </wu-f7-list-item>
    </navigator>
  </wu-f7-list>
  <wu-f7-block spacing="compact">
    <navigator class="text-link" open-type="navigateBack">
      返回上一页
    </navigator>
  </wu-f7-block>
</view>
