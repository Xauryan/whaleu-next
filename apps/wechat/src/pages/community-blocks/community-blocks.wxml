<import src="../public-profile/personal-recovery.wxml" />
<view class="blocks-page f7-ios-theme personal-native">
  <view class="blocks-header">
    <view class="blocks-note">仅管理你发起的拉黑</view>
    <wu-f7-button class="blocks-refresh" disabled="{{busy || block.busy}}" loading="{{busy}}" aria-label="刷新拉黑列表" bind:press="onReload" variant="plain">
      <wu-icon name="refresh" tone="accent" size="21" />
    </wu-f7-button>
  </view>
  <view class="blocks-note">解除不会改变对方的设置。</view>
  <view wx:if="{{busy || !loaded}}" class="status" aria-role="status">{{status}}</view>
  <view wx:if="{{error}}" class="error" aria-role="alert">{{error}}</view>
  <wu-f7-button wx:if="{{busy}}" class="blocks-text-button" bind:press="onCancel" variant="plain">停止等待</wu-f7-button>
  <navigator wx:if="{{!hasSession}}" class="blocks-login" url="/pages/login/login">
    登录后查看
    <wu-icon name="chevron-right" tone="accent" size="16" />
  </navigator>
  <template is="block-recovery" data="{{block}}" />
  <wu-f7-list strong="{{true}}" inset="{{true}}" spacing="compact">
    <view wx:for="{{items}}" wx:key="relationshipId" class="blocked-person">
      <view class="blocked-avatar">
        <wu-icon name="person" tone="muted" size="25" />
      </view>
      <view class="blocked-information">
        <view class="blocked-name">{{item.display.kind === 'unavailable' ? '公开身份暂不可用' : item.display.displayName}}</view>
        <view wx:if="{{item.display.kind === 'snapshot'}}" class="blocked-snapshot">拉黑时的名称</view>
        <view class="blocked-date">{{item.blockedAt}}</view>
      </view>
      <wu-f7-button class="blocked-unblock" data-id="{{item.relationshipId}}" disabled="{{busy || block.busy || block.frozen || !item.canUnblock}}" loading="{{block.busy &amp;&amp; block.activeRelationshipId === item.relationshipId}}" bind:press="onUnblock" variant="tonal">{{block.busy &amp;&amp; block.activeRelationshipId === item.relationshipId ? '正在解除' : '解除拉黑'}}</wu-f7-button>
      <view wx:if="{{block.activeRelationshipId === item.relationshipId &amp;&amp; block.error}}" class="error blocked-error" aria-role="alert">{{block.error}}</view>
    </view>
  </wu-f7-list>
  <wu-f7-block wx:if="{{loaded &amp;&amp; !items.length}}" class="blocks-empty" strong="{{true}}" inset="{{true}}" spacing="compact">
    <wu-icon name="blocked-user" tone="muted" size="42" />
    <view>还没有拉黑任何人</view>
  </wu-f7-block>
  <wu-f7-button wx:if="{{canLoadMore}}" class="blocks-text-button" disabled="{{busy || block.busy}}" bind:press="onMore" variant="plain">加载更多</wu-f7-button>
  <view class="blocks-footnote">分身内容不会仅因背后账号被拉黑而隐藏。</view>
  <navigator class="blocks-back" url="/pages/community-feed/community-feed">
    回到社区
    <wu-icon name="chevron-right" tone="accent" size="16" />
  </navigator>
</view>
