@import '../../community/forms.wxss';

.formation-composer {
  margin-top: 24rpx;
  padding-top: 18rpx;
  border-top: 1rpx solid #e0eaee;
}
.formation-composer .label {
  margin: 24rpx 0 14rpx;
}
.formation-composer input + input {
  margin-top: 14rpx;
}
.formation-disclosure {
  color: #6f5944;
  background: #fff8ef;
  border-radius: 12rpx;
  padding: 20rpx;
  margin-top: 18rpx;
  font-size: 25rpx;
  line-height: 1.8;
}
