<import src="../../community/trading-summary.wxml" />
<import src="../../identity-privacy/view.wxml" /><import src="../../community/discussion-recovery.wxml" />
<template name="root-comment"><view class="author">{{item.author.displayName}}<text class="badge">{{item.author.kind === 'anonymous' ? '匿名' : '公开身份'}}</text><text wx:if="{{item.isPinned}}" class="badge">楼主置顶</text><text wx:if="{{item.viewer.isSelf}}" class="badge">我</text></view><view class="meta">{{item.createdAt}} · {{item.likeCount}} 赞 · {{item.replyCount}} 条回复</view><view class="body">{{item.text}}</view><template wx:if="{{identityOverlay.developerEnabled}}" is="identity-overlay" data="{{identity:identityOverlay.items[item.id]}}" /><view class="image-grid"><image wx:for="{{item.images}}" wx:for-item="media" wx:key="assetId" src="{{media.displayUrl}}" mode="aspectFill" /></view><button data-id="{{item.id}}" bindtap="onLikeComment" disabled="{{busy || interaction.busy || interaction.frozen}}">{{item.viewer.isLiked ? '取消点赞' : '点赞评论'}}</button><button wx:if="{{item.viewer.canPin}}" data-id="{{item.id}}" bindtap="onPinComment" disabled="{{busy || interaction.busy || interaction.frozen}}">{{item.isPinned ? '取消置顶' : '置顶根评论'}}</button><navigator wx:if="{{post.viewer.canComment}}" class="link" url="/pages/community-compose/community-compose?postId={{post.id}}&amp;copyCommentId={{item.id}}">复制文字 +1（先确认） →</navigator><button wx:if="{{item.viewer.canDelete}}" data-id="{{item.id}}" bindtap="onDeleteComment" disabled="{{busy || interaction.busy}}">删除我的评论</button><view wx:for="{{item.replyPreview.items}}" wx:for-item="reply" wx:key="id" class="reply-preview"><navigator class="link" url="/pages/community-thread/community-thread?postId={{post.id}}&amp;rootCommentId={{item.id}}&amp;replyId={{reply.id}}">{{reply.author.displayName}} 回复 {{reply.target.status === 'available' ? reply.target.author.displayName : '当前不可查看的对象'}}：{{reply.text}}</navigator><view class="image-grid"><image wx:for="{{reply.images}}" wx:for-item="media" wx:key="assetId" src="{{media.thumbnailUrl}}" mode="aspectFill" /></view><template wx:if="{{identityOverlay.developerEnabled}}" is="identity-overlay" data="{{identity:identityOverlay.items[reply.id]}}" /></view><button wx:if="{{item.replyPreview.nextCursor}}" data-id="{{item.id}}" bindtap="onMoreReplies" disabled="{{busy}}">继续加载此评论的回复</button><navigator class="link" url="/pages/community-thread/community-thread?postId={{post.id}}&amp;rootCommentId={{item.id}}">查看全部 {{item.replyCount}} 条回复 / 回复此评论 →</navigator></template>
<view class="screen"><view class="eyebrow">WHALEU · 校园讨论</view><view class="title">帖子与评论</view><view class="status" aria-role="status">{{status}}</view><view wx:if="{{identityOverlay.notice}}" class="notice">{{identityOverlay.notice}}</view><view wx:if="{{error}}" class="error" aria-role="alert">{{error}}</view><button class="secondary" bindtap="onReload" disabled="{{busy}}" loading="{{busy}}">重新加载帖子与评论</button><button wx:if="{{busy}}" bindtap="onCancel">停止等待</button><navigator wx:if="{{!hasSession}}" class="link" url="/pages/login/login">登录后查看详情</navigator>
  <view wx:if="{{post}}" class="card"><view class="author">{{post.author.displayName}}<text class="badge">{{post.author.kind === 'anonymous' ? '匿名' : '公开身份'}}</text><text wx:if="{{post.viewer.isSelf}}" class="badge">我</text></view><view class="meta">{{post.space.name}} · {{post.publishedAt}}</view><view class="body"><text selectable="true">{{post.text}}</text></view><template wx:if="{{identityOverlay.developerEnabled}}" is="identity-overlay" data="{{identity:identityOverlay.items[post.id]}}" /><view class="image-grid"><image wx:for="{{post.images}}" wx:key="assetId" src="{{item.displayUrl}}" mode="aspectFill" /></view><view class="meta">{{post.likeCount}} 赞 · {{post.commentCount}} 条根评论 · {{post.replyCount}} 条回复 · 共 {{post.discussionCount}} 条讨论</view><button class="secondary" bindtap="onLike" disabled="{{busy || needsReload}}">{{post.viewer.isLiked ? '取消点赞' : '点赞'}}</button><button wx:if="{{post.viewer.canDelete}}" bindtap="onDeletePost" disabled="{{busy}}">删除我的帖子</button><navigator wx:if="{{post.viewer.canComment}}" class="link" url="/pages/community-compose/community-compose?postId={{post.id}}">写评论（先确认有效展示身份） →</navigator><view wx:else class="notice">此帖当前不可评论。登录、手机号、身份与评论权限均以服务端为准。</view></view>
  <view wx:if="{{post.trading}}" class="card">
    <template is="trading-summary" data="{{listing:post.trading,tradingLabels}}" />
    <view class="notice">急出与售出／解决是独立状态。撤销已解决会保留原急出模式。当前仅作者可修改状态，群推送与付款、担保、配送均未接入。</view>
    <button wx:if="{{post.trading.viewer.canSetResolution}}" bindtap="onTradingResolution" disabled="{{busy || needsReload || tradingMutation.busy || tradingMutation.frozen}}">{{post.trading.resolution === 'resolved' ? '撤销已解决／恢复出售' : '标记售出／已解决'}}</button>
    <button open-type="share" disabled="{{busy || !loaded}}">分享交易详情</button>
    <button bindtap="onTradingContacts" disabled="{{busy || !tradingContacts.enabled || tradingContacts.busy}}" loading="{{tradingContacts.busy}}">查看发布者公开联系方式</button>
    <view class="notice">{{tradingContacts.status}}</view><view wx:if="{{tradingContacts.error}}" class="error">{{tradingContacts.error}}</view>
    <view wx:if="{{tradingContacts.contacts}}">
      <view wx:if="{{tradingContacts.contacts.wechat}}"><text selectable="true">微信：{{tradingContacts.contacts.wechat}}</text><button data-field="wechat" bindtap="onCopyTradingContact" disabled="{{tradingContacts.busy}}">复制微信</button></view>
      <view wx:if="{{tradingContacts.contacts.qq}}"><text selectable="true">QQ：{{tradingContacts.contacts.qq}}</text><button data-field="qq" bindtap="onCopyTradingContact" disabled="{{tradingContacts.busy}}">复制 QQ</button></view>
      <view wx:if="{{tradingContacts.contacts.phone}}"><text selectable="true">电话：{{tradingContacts.contacts.phone}}</text><button data-field="phone" bindtap="onCopyTradingContact" disabled="{{tradingContacts.busy}}">复制电话</button></view>
      <view class="meta">只显示与复制发布者填写的原文，不自动拨号或打开网址。联系方式不代表已认证。</view>
    </view>
  </view>
  <view wx:if="{{tradingMutation.frozen || tradingMutation.receiptStatus || tradingMutation.error}}" class="card">
    <view class="section-title">交易状态结果恢复</view><view class="notice">{{tradingMutation.actionLabel}} · {{tradingMutation.status}}</view><view wx:if="{{tradingMutation.error}}" class="error">{{tradingMutation.error}}</view><view class="status">{{tradingMutation.receiptStatus}}</view>
    <view wx:if="{{tradingMutation.frozen}}"><button bindtap="onTradingReceipt" disabled="{{tradingMutation.busy}}">查询原状态回执</button><button bindtap="onTradingRetry" disabled="{{tradingMutation.busy}}">重试完全相同的状态请求</button><navigator wx:if="{{tradingMutation.recoveryPostId &amp;&amp; tradingMutation.recoveryPostId !== postId}}" class="link" url="/pages/community-detail/community-detail?postId={{tradingMutation.recoveryPostId}}">打开原交易 →</navigator></view><button wx:if="{{tradingMutation.busy}}" bindtap="onTradingCancel">停止等待（不撤销请求）</button>
  </view>
  <view wx:if="{{formationView.active}}" class="card">
    <view class="section-title">组队</view><view wx:if="{{formationIdentityOverlay.notice}}" class="notice">{{formationIdentityOverlay.notice}}</view><view class="status">{{formationView.status}}</view><view wx:if="{{formationView.error}}" class="error">{{formationView.error}}</view>
    <view wx:if="{{formationView.formation}}">
      <view class="body">{{formationView.formation.theme}}</view><view class="meta">{{formationView.formation.memberCount}} / {{formationView.formation.capacity}} 人（包含发起者） · {{formationView.formation.status === 'full' ? '已满员' : formationView.formation.status === 'open' ? '可加入' : '暂不可用'}}</view>
      <view wx:for="{{formationView.formation.members}}" wx:key="id" class="roster-member"><text>{{item.author.displayName}}</text><text class="badge">{{item.isCreator ? '发起者' : '成员'}}</text><text wx:if="{{item.author.kind === 'anonymous'}}" class="badge">匿名身份</text><text wx:if="{{item.viewer.isSelf}}" class="badge">我</text><view class="meta">{{item.joinedAt}}</view><template wx:if="{{formationIdentityOverlay.developerEnabled}}" is="identity-overlay" data="{{identity:formationIdentityOverlay.items[item.id]}}" /></view>
      <view class="notice">名单按发起者、加入时间排序。部分成员可能因当前查看权限不展示，人数仍计入席位。</view>
      <view wx:if="{{formationView.canJoin &amp;&amp; !formationView.frozen}}">
        <view class="section-title">加入组队</view><view class="notice">加入后使用你的公开个人资料展示。请填写至少一种你愿意分享的联系方式，不会自动使用认证手机号。</view>
        <input data-field="wechat" bindinput="onFormationContact" value="{{formationView.contacts.wechat}}" maxlength="-1" placeholder="微信（选填）" disabled="{{formationView.busy}}" />
        <input data-field="qq" bindinput="onFormationContact" value="{{formationView.contacts.qq}}" maxlength="-1" placeholder="QQ（选填）" disabled="{{formationView.busy}}" />
        <input data-field="phone" bindinput="onFormationContact" value="{{formationView.contacts.phone}}" maxlength="-1" placeholder="电话（选填）" disabled="{{formationView.busy}}" />
        <view class="notice">{{formationView.disclosure}}</view><label><switch bindchange="onFormationConsent" checked="{{formationView.contactConsent}}" disabled="{{formationView.busy}}" />我同意以公开身份加入，并向有权限的成员分享以上联系方式</label>
        <button bindtap="onFormationJoin" disabled="{{formationView.busy || !formationView.contactConsent}}" loading="{{formationView.busy}}">确认加入（占用一个席位）</button>
      </view>
      <button wx:if="{{formationContacts.enabled}}" bindtap="onFormationContacts" disabled="{{formationContacts.busy || formationView.busy}}">查看成员分享的联系方式</button>
    </view>
    <view wx:if="{{formationView.blocker}}" class="notice">{{formationView.blocker}}</view><view class="status">{{formationView.receiptStatus}}</view><view class="notice">{{formationView.ownStatus}}</view>
    <view wx:if="{{formationView.frozen}}"><button bindtap="onFormationReceipt" disabled="{{formationView.busy}}">查询原加入回执</button><button bindtap="onFormationRetry" disabled="{{formationView.busy}}">重试完全相同的加入请求</button><button bindtap="onFormationOwn" disabled="{{formationView.busy}}">检查本账号成员记录</button><navigator wx:if="{{formationView.recoveryPostId &amp;&amp; formationView.recoveryPostId !== postId}}" class="link" url="/pages/community-detail/community-detail?postId={{formationView.recoveryPostId}}">打开原组队的恢复入口 →</navigator></view>
    <button wx:if="{{formationView.busy}}" bindtap="onFormationCancel">停止等待（不撤销加入）</button>
    <view wx:if="{{formationContacts.error}}" class="error">{{formationContacts.error}}</view><view class="notice">{{formationContacts.status}}</view>
    <view wx:if="{{formationContacts.open}}" class="formation-contact-backdrop" bindtap="onDismissFormationContacts"></view>
    <view wx:if="{{formationContacts.open}}" class="contact-panel" aria-role="dialog" aria-label="组队成员分享的联系方式">
      <view class="section-title">成员分享的联系方式</view><button bindtap="onDismissFormationContacts">关闭并清除本页显示</button>
      <view wx:for="{{formationContacts.rows}}" wx:key="membershipId"><view>{{item.displayName}} · {{item.isCreator ? '发起者' : '成员'}}</view>
        <view wx:if="{{item.contacts.wechat}}">微信：{{item.contacts.wechat}}<button data-id="{{item.membershipId}}" data-field="wechat" bindtap="onCopyFormationContact" disabled="{{formationContacts.busy}}">重新核验权限并复制微信</button></view>
        <view wx:if="{{item.contacts.qq}}">QQ：{{item.contacts.qq}}<button data-id="{{item.membershipId}}" data-field="qq" bindtap="onCopyFormationContact" disabled="{{formationContacts.busy}}">重新核验权限并复制 QQ</button></view>
        <view wx:if="{{item.contacts.phone}}">电话：{{item.contacts.phone}}<button data-id="{{item.membershipId}}" data-field="phone" bindtap="onCopyFormationContact" disabled="{{formationContacts.busy}}">重新核验权限并复制电话</button></view>
      </view><view class="notice">只复制填写的原文，不自动拨号或打开链接。已复制到系统剪贴板的内容不随本页清除。</view>
    </view>
  </view>
  <view wx:if="{{pollView.active}}" class="card">
    <view class="section-title">投票</view><view class="status" aria-role="status">{{pollView.status}}</view><view wx:if="{{pollView.error}}" class="error" aria-role="alert">{{pollView.error}}</view>
    <view wx:if="{{pollView.poll}}">
      <view class="body">{{pollView.poll.question}}</view><view class="meta">{{pollView.poll.selectionMode === 'single' ? '单选 · 点选即提交' : '多选 · 选好后确认提交'}} · {{pollView.poll.expired ? '已结束' : '进行中'}}</view>
      <view class="meta">{{pollView.poll.deadline ? '截止时间：' + pollView.poll.deadline : '无预定截止时间'}}</view>
      <view wx:for="{{pollView.rows}}" wx:key="id" class="poll-option">
        <button class="secondary" data-id="{{item.id}}" bindtap="onPollOption" disabled="{{pollView.busy || !pollView.canVote || pollView.frozen}}">{{item.selected ? '✓ ' : ''}}{{item.label}}</button>
        <view wx:if="{{pollView.revealResults}}"><view class="poll-track"><view class="poll-bar" style="width: {{item.percent}}%;"></view></view><view class="meta">{{item.count}} 次选择 · {{item.percent}}%（占全部选择）</view></view>
      </view>
      <view wx:if="{{pollView.revealResults}}" class="meta">{{pollView.poll.voterCount}} 人投票 · {{pollView.poll.selectionCount}} 次选择。多选时一人可产生多次选择，百分比以全部选择次数为分母。</view>
      <view wx:else class="meta">投票后或结束后展示结果。选项汇总对有权阅读此帖的人可通过接口获取，此展示顺序不代表结果保密。</view>
      <button wx:if="{{pollView.poll.selectionMode === 'multiple' &amp;&amp; pollView.canVote}}" class="primary" bindtap="onPollSubmit" disabled="{{pollView.busy || !pollView.canSubmit}}">确认提交所选选项（不可修改）</button>
    </view>
    <view wx:if="{{pollView.blocker}}" class="notice">{{pollView.blocker}}</view><view wx:if="{{pollView.receiptStatus}}" class="status">{{pollView.receiptStatus}}</view>
    <view wx:if="{{pollView.frozen}}"><button class="primary" bindtap="onPollReceipt" disabled="{{pollView.busy}}">查询原投票回执</button><button class="secondary" bindtap="onPollRetry" disabled="{{pollView.busy}}">重试完全相同的原投票</button><button class="secondary" bindtap="onPollOwnStatus" disabled="{{pollView.busy}}">检查此账号是否已有投票</button><navigator wx:if="{{pollView.recoveryPostId &amp;&amp; pollView.recoveryPostId !== post.id}}" class="link" url="/pages/community-detail/community-detail?postId={{pollView.recoveryPostId}}">打开原投票所在帖子 →</navigator></view>
    <view wx:if="{{pollView.ownStatus}}" class="notice">{{pollView.ownStatus}}</view><button wx:if="{{pollView.busy}}" bindtap="onPollCancel">停止等待（不撤销投票）</button><view class="notice">作者也可投票；每个账号仅有一次，不支持修改或撤回。关闭页面、返回或换账号后，未确认的原请求仍保留在原账号下。</view>
  </view>
  <view wx:if="{{deleteTarget}}" class="confirm"><view class="section-title">确认删除自己的{{deleteTarget.kind === 'post' ? '帖子' : '评论'}}？</view><view class="notice">删除后不再展示。停止网络等待不代表撤销删除；未确认时需要重新加载。</view><button class="danger" bindtap="onConfirmDelete" disabled="{{busy}}">确认删除</button><button class="secondary" bindtap="onDismissDelete" disabled="{{busy}}">保留内容</button></view>
  <template is="discussion-recovery" data="{{interaction}}" />
  <view wx:if="{{locatedComment}}" class="card"><view class="section-title">定位的根评论</view><view class="notice">单独定位不会跳过前面的根评论或改变下方分页</view><navigator class="link" url="/pages/community-thread/community-thread?postId={{post.id}}&amp;rootCommentId={{locatedComment.id}}">{{locatedComment.author.displayName}}：{{locatedComment.text}} →</navigator><navigator wx:if="{{locatedReplyId}}" class="link" url="/pages/community-thread/community-thread?postId={{post.id}}&amp;rootCommentId={{locatedComment.id}}&amp;replyId={{locatedReplyId}}">打开定位到的回复 →</navigator></view>
  <view wx:if="{{loaded}}" class="card"><view class="section-title">根评论 · {{sort === 'likes' ? '按赞数' : '按时间'}}{{order === 'desc' ? '从高到低 / 从新到旧' : '从低到高 / 从早到晚'}}</view><view class="chips"><button data-sort="likes" data-order="desc" bindtap="onOrder" disabled="{{busy}}">赞数优先</button><button data-sort="likes" data-order="asc" bindtap="onOrder" disabled="{{busy}}">赞数升序</button><button data-sort="time" data-order="desc" bindtap="onOrder" disabled="{{busy}}">最新优先</button><button data-sort="time" data-order="asc" bindtap="onOrder" disabled="{{busy}}">最早优先</button></view><view class="notice">置顶评论始终优先；下方每条先展示最早两条回复。排序发生变化时需重新加载。</view><view wx:if="{{!comments.length}}" class="empty">暂无可查看的评论</view><view wx:for="{{comments}}" wx:key="id"><view class="divider"></view><template is="root-comment" data="{{item,post,busy,interaction,identityOverlay}}" /></view><button wx:if="{{canLoadMore}}" class="secondary" bindtap="onMore" disabled="{{busy}}">加载更多评论</button></view>
  <navigator class="link" url="/pages/community-feed/community-feed">回到校园社区 →</navigator><view class="notice">回复支持定位、逐页阅读、点赞与作者删除。图片上传、点赞历史、订阅和通知仍待接入。</view>
</view>
