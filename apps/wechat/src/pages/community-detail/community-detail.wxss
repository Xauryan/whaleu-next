@import '../../experience/public-display.wxss';
@import '../../community/forms.wxss';

.poll-track {
  height: 12rpx;
  margin-top: 14rpx;
  border-radius: 8rpx;
  background: #edf3f5;
  overflow: hidden;
}
.poll-bar {
  height: 100%;
  background: #4a9789;
  border-radius: 8rpx;
}

.roster-member {
  border-top: 1rpx solid #e0eaee;
  padding: 18rpx 0;
}
.formation-contact-backdrop {
  position: fixed;
  inset: 0;
  background: rgba(17, 40, 48, 0.48);
  z-index: 190;
}
.contact-panel {
  position: fixed;
  top: 12vh;
  left: 28rpx;
  right: 28rpx;
  max-height: 74vh;
  overflow-y: auto;
  padding: 28rpx;
  background: white;
  border-radius: 24rpx;
  z-index: 200;
  white-space: pre-wrap;
  word-break: break-all;
  box-shadow: 0 20rpx 70rpx rgba(17, 40, 48, 0.2);
}

.private-gallery-backdrop {
  position: fixed;
  inset: 0;
  background: rgba(17, 40, 48, 0.48);
  z-index: 210;
}
.private-gallery-panel {
  position: fixed;
  top: 8vh;
  left: 24rpx;
  right: 24rpx;
  max-height: 84vh;
  padding: 24rpx;
  background: white;
  border-radius: 24rpx;
  z-index: 220;
}
.private-gallery-content {
  height: 48vh;
}
.private-gallery-thumb {
  width: 180rpx;
  max-height: 260rpx;
}
.private-image-expanded {
  width: 100%;
}
.private-gallery-slot {
  display: inline-block;
  width: 180rpx;
  margin: 8rpx;
  vertical-align: top;
}
.private-gallery-slot-expanded {
  display: block;
  width: 100%;
  margin: 8rpx 0;
}

.private-image-inline {
  width: 360rpx;
  max-width: 100%;
}
