<import src="../../experience/public-display.wxml" />
<view class="screen collection-screen f7-ios-theme f7-collection-screen">
  <wu-f7-block class="f7-collection-header" spacing="compact">
    <view class="tabs collection-tabs">
      <navigator class="tab" url="/pages/community-saved/community-saved">收藏</navigator>
      <view class="tab active">赞过</view>
      <navigator class="tab" url="/pages/community-mine/community-mine">发布</navigator>
    </view>
    <view class="toolbar">
      <text class="scope-caption">最近点赞<text wx:if="{{visibleLikedCount !== null}}"> · {{visibleLikedCount}} 条可查看</text></text>
      <wu-f7-button class="icon-button" aria-label="刷新点赞" disabled="{{busy}}" loading="{{busy}}" bind:press="onReload">
        <wu-icon name="refresh" size="19" />
      </wu-f7-button>
    </view>
    <view wx:if="{{busy || !loaded}}" class="status" aria-role="status">{{status}}</view>
    <view wx:if="{{error}}" class="error" aria-role="alert">{{error}}</view>
    <wu-f7-button wx:if="{{busy}}" class="quiet-button" bind:press="onCancel" variant="tonal">停止加载</wu-f7-button>
    <navigator wx:if="{{!hasSession}}" class="login-link" url="/pages/login/login">登录后查看点赞<wu-icon name="chevron-right" tone="accent" size="15" /></navigator>
    <view wx:if="{{loaded &amp;&amp; visibleLikedCountStatus === 'unavailable'}}" class="notice">准确总数暂不可用，不影响查看已核验的记录。</view>
  </wu-f7-block>
  <wu-f7-block wx:for="{{items}}" wx:key="likeId" class="content-row liked-item" strong="{{true}}" inset="{{true}}" spacing="compact">
    <view class="row-top">
      <view class="author">
        <text wx:if="{{item.preview.author.kind === 'named'}}" data-id="{{item.likeId}}" bindtap="onAuthor">{{item.preview.author.displayName}}</text>
        <text wx:else>{{item.preview.author.displayName}}</text>
        <text wx:if="{{item.preview.author.kind === 'anonymous'}}" class="identity-label">分身</text>
        <text wx:if="{{item.preview.isSelf}}" class="identity-label">我</text>
      </view>
      <text class="content-kind">{{item.kind === 'post' ? '主题' : '回复'}}</text>
    </view>
    <template wx:if="{{item.preview.author.kind === 'named'}}" is="public-experience-display" data="{{display:item.preview.author.experienceDisplay,colors:experienceColorStyles}}" />
    <view class="body content-body">{{item.preview.text}}</view>
    <view wx:if="{{item.preview.images.length}}" class="media-state"><wu-icon name="image" size="16" />图片暂不可用</view>
    <view class="row-actions">
      <view class="meta liked-time"><wu-icon name="heart-filled" tone="accent" size="15" />{{item.likedAtLabel || '点赞时间未知'}}</view>
      <navigator wx:if="{{item.kind === 'post'}}" class="detail-link" url="/pages/community-detail/community-detail?postId={{item.postId}}">查看主题<wu-icon name="chevron-right" tone="accent" size="13" /></navigator>
      <navigator wx:elif="{{item.kind === 'comment'}}" class="detail-link" url="/pages/community-detail/community-detail?postId={{item.postId}}&amp;rootCommentId={{item.rootCommentId}}">定位回复<wu-icon name="chevron-right" tone="accent" size="13" /></navigator>
      <navigator class="detail-link" url="/pages/community-thread/community-thread?postId={{item.postId}}&amp;rootCommentId={{item.rootCommentId}}&amp;replyId={{item.targetId}}" wx:else>定位回复<wu-icon name="chevron-right" tone="accent" size="13" /></navigator>
    </view>
  </wu-f7-block>
  <view wx:if="{{loaded &amp;&amp; visibleLikedCount === 0 &amp;&amp; continuation === 'end'}}" class="empty">
    <wu-icon name="heart" size="34" />
    <view class="empty-title">当前没有可查看的点赞</view>
  </view>
  <view wx:elif="{{continuation === 'scan_pending'}}" class="notice">还有历史记录待核验，请继续查看。暂未显示记录不代表历史为空。</view>
  <view wx:elif="{{continuation === 'end'}}" class="end-label">已到本次浏览末尾</view>
  <view class="pagination">
    <wu-f7-button wx:if="{{canPrevious}}" class="secondary" disabled="{{busy}}" bind:press="onPrevious" variant="tonal">上一页</wu-f7-button>
    <text wx:if="{{pageNumber}}">第 {{pageNumber}} 页</text>
    <wu-f7-button wx:if="{{canLoadMore}}" class="secondary" disabled="{{busy}}" bind:press="onMore" variant="tonal">{{continuation === 'scan_pending' ? '继续查看' : '下一页'}}</wu-f7-button>
  </view>
  <wu-f7-list class="reading-notes" strong="{{true}}" inset="{{true}}" spacing="compact">
    <wu-f7-list-item class="disclosure" bind:press="onToggleInfo" link="{{true}}" title-slot="{{true}}" aria-label="点赞说明" last="{{true}}">
      <view slot="title" class="f7-disclosure-label">点赞说明<wu-icon name="{{showInfo ? 'chevron-up' : 'chevron-down'}}" size="13" /></view>
    </wu-f7-list-item>
    <view wx:if="{{showInfo}}" class="meta f7-reading-copy">仅你自己可查看，只包含仍可查看的社区主题与回复。每次翻页重新核验，新点赞或状态变化请刷新。其他业务的点赞历史暂未接入。</view>
  </wu-f7-list>
</view>
