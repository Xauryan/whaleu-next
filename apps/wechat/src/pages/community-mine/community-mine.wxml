<import src="../../experience/public-display.wxml" />
<import src="../../community/trading-summary.wxml" />
<view class="screen"><navigator wx:if="{{hasSession}}" class="link" url="/pages/public-profile/public-profile">我的公开主页 →</navigator><navigator wx:if="{{hasSession}}" class="link" url="/pages/community-liked/community-liked">我的点赞历史 →</navigator><navigator class="link" url="/pages/report-progress/report-progress">举报与陪审结果恢复 →</navigator><navigator class="link" url="/pages/system-notices/system-notices">我的系统通知 →</navigator><navigator class="link" url="/pages/community-blocks/community-blocks">我的拉黑与结果恢复 →</navigator><navigator class="link" url="/pages/community-saved/community-saved">我的收藏与收藏结果恢复 →</navigator><navigator wx:if="{{savedRecoveryPostId}}" class="link" url="/pages/community-detail/community-detail?postId={{savedRecoveryPostId}}">恢复原收藏或更新偏好请求 →</navigator><view class="eyebrow">WHALEU · 我的发布</view><view class="title">每一次发布都有回音</view><view class="subtitle">全部发布展示状态，我的交易展示当前可查看的公开内容。被隐藏或删除的内容不会通过此入口恢复展示。</view><navigator class="link" url="/pages/community-compose/community-compose">检查本账号待确认的帖子、评论或回复 →</navigator><navigator wx:if="{{formationRecoveryPostId}}" class="link" url="/pages/community-detail/community-detail?postId={{formationRecoveryPostId}}">恢复本账号待确认的加入组队 →</navigator><navigator wx:if="{{ballotRecoveryPostId}}" class="link" url="/pages/community-detail/community-detail?postId={{ballotRecoveryPostId}}">恢复本账号待确认的投票 →</navigator><navigator wx:if="{{discussionRecoveryPostId}}" class="link" url="/pages/community-thread/community-thread?postId={{discussionRecoveryPostId}}&amp;rootCommentId={{discussionRecoveryRootCommentId}}">恢复待确认的讨论点赞或置顶 →</navigator><navigator wx:if="{{tradingRecoveryPostId}}" class="link" url="/pages/community-detail/community-detail?postId={{tradingRecoveryPostId}}">恢复本账号待确认的交易状态 →</navigator><view class="chips"><button class="chip {{!onlyTrading ? 'active' : ''}}" bindtap="onAllPublications">全部发布记录</button><button class="chip {{onlyTrading ? 'active' : ''}}" bindtap="onOwnTrading">我的交易（含急出）</button></view><view wx:if="{{onlyTrading}}" class="chips"><view class="chip {{!tradingSubtype ? 'active' : ''}}" data-key="" bindtap="onTradingSubtype">全部交易</view><view wx:for="{{tradingCategories}}" wx:key="key" class="chip {{tradingSubtype === item.key ? 'active' : ''}}" data-key="{{item.key}}" bindtap="onTradingSubtype">{{item.label}}</view></view><view class="status" aria-role="status">{{status}}</view><view wx:if="{{error}}" class="error" aria-role="alert">{{error}}</view><button class="secondary" bindtap="onReload" disabled="{{busy}}" loading="{{busy}}">重新加载发布记录</button><button wx:if="{{busy}}" bindtap="onCancel">停止等待</button><navigator wx:if="{{!hasSession}}" class="link" url="/pages/login/login">登录后查看</navigator><view wx:for="{{publications}}" wx:key="id" class="card"><view class="label">{{item.status === 'published' ? '已发布' : (item.status === 'hidden' ? '已隐藏' : '已删除')}}</view><view class="meta">{{item.publishedAt}}</view><navigator wx:if="{{item.status === 'published'}}" class="link" url="/pages/community-detail/community-detail?postId={{item.id}}">查看帖子 →</navigator><view wx:else class="notice">此记录不包含正文、图片或身份资料</view></view><view wx:for="{{tradingPosts}}" wx:key="id" class="card"><view class="author"><text wx:if="{{item.author.kind === 'named'}}" class="link" data-id="{{item.id}}" bindtap="onAuthor">{{item.author.displayName}} →</text><text wx:else>{{item.author.displayName}}</text><template wx:if="{{item.author.kind === 'named'}}" is="public-experience-display" data="{{display:item.author.experienceDisplay,colors:experienceColorStyles}}" /></view><view class="body">{{item.text}}</view><template is="trading-summary" data="{{listing:item.trading,tradingLabels}}" /><view class="image-grid"><image wx:for="{{item.images}}" wx:for-item="media" wx:key="assetId" src="{{media.thumbnailUrl}}" mode="aspectFill" /></view><navigator class="link" url="/pages/community-detail/community-detail?postId={{item.id}}">查看交易详情 →</navigator></view><view wx:if="{{loaded &amp;&amp; !publications.length &amp;&amp; !tradingPosts.length}}" class="empty">暂无发布记录</view><button wx:if="{{canLoadMore}}" class="secondary" bindtap="onMore" disabled="{{busy}}">加载更多</button><navigator class="link" url="/pages/community-feed/community-feed">返回校园社区 →</navigator></view>
