<import src="../community-hot/rating-link-card.wxml" />
<import src="../../experience/public-display.wxml" />
<import src="../../identity-privacy/view.wxml" />
<import src="../../community/trading-summary.wxml" />
<import src="./saved-recovery.wxml" />
<view class="screen collection-screen f7-ios-theme f7-collection-screen">
  <wu-f7-block class="f7-collection-header" spacing="compact">
    <view class="tabs collection-tabs">
      <view class="tab active">收藏</view>
      <navigator class="tab" url="/pages/community-liked/community-liked">赞过</navigator>
      <navigator class="tab" url="/pages/community-mine/community-mine">发布</navigator>
    </view>
    <view class="toolbar">
      <text class="scope-caption">最近收藏<text wx:if="{{loaded}}"> · {{visibleSavedCount}} 条可查看</text></text>
      <wu-f7-button class="icon-button" aria-label="刷新收藏" disabled="{{busy || savedMutation.busy}}" loading="{{busy}}" bind:press="onReload">
        <wu-icon name="refresh" size="19" />
      </wu-f7-button>
    </view>
    <view wx:if="{{busy || !loaded}}" class="status" aria-role="status">{{status}}</view>
    <view wx:if="{{identityOverlay.notice}}" class="notice">{{identityOverlay.notice}}</view>
    <view wx:if="{{error}}" class="error" aria-role="alert">{{error}}</view>
    <wu-f7-button wx:if="{{busy}}" class="quiet-button" bind:press="onCancel" variant="tonal">停止加载</wu-f7-button>
    <navigator wx:if="{{!hasSession}}" class="login-link" url="/pages/login/login">登录后查看收藏<wu-icon name="chevron-right" tone="accent" size="15" /></navigator>
  </wu-f7-block>
  <template is="saved-recovery" data="{{savedMutation}}" />
  <wu-f7-block wx:for="{{items}}" wx:key="saveEpochId" class="content-row saved-item" strong="{{true}}" inset="{{true}}" spacing="compact">
    <view class="row-top">
      <view class="author">
        <text wx:if="{{item.post.author.kind === 'named'}}" data-id="{{item.post.id}}" bindtap="onAuthor">{{item.post.author.displayName}}</text>
        <text wx:else>{{item.post.author.displayName}}</text>
        <text wx:if="{{item.post.author.kind === 'anonymous'}}" class="identity-label">分身</text>
        <text wx:if="{{item.post.viewer.isSelf}}" class="identity-label">我</text>
      </view>
      <text class="meta">{{item.savedAtLabel}}</text>
    </view>
    <template wx:if="{{item.post.author.kind === 'named'}}" is="public-experience-display" data="{{display:item.post.author.experienceDisplay,colors:experienceColorStyles}}" />
    <navigator class="body content-body" url="/pages/community-detail/community-detail?postId={{item.post.id}}">{{item.post.text}}</navigator>
    <template is="rating-target-link-card" data="{{component:item.post.component,postId:item.post.id,busy}}" />
    <template wx:if="{{identityOverlay.developerEnabled}}" is="identity-overlay" data="{{identity:identityOverlay.items[item.post.id]}}" />
    <view wx:if="{{item.post.trading}}" class="attachment">
      <template wx:if="{{item.post.trading}}" is="trading-summary" data="{{listing:item.post.trading,tradingLabels}}" />
    </view>
    <view wx:if="{{item.post.component.kind === 'poll'}}" class="attachment">
      <view class="attachment-label">投票 · {{item.post.component.poll.expired ? '已结束' : '进入主题参与'}}</view>
      <view>{{item.post.component.poll.question}}</view>
    </view>
    <view wx:if="{{item.post.component.kind === 'formation'}}" class="attachment">
      <view class="attachment-label">一起组队 · {{item.post.component.formation.memberCount}} / {{item.post.component.formation.capacity}} 人</view>
      <view>{{item.post.component.formation.theme}}</view>
    </view>
    <view wx:if="{{item.post.images.length}}" class="media-state"><wu-icon name="image" size="16" />图片暂不可用</view>
    <view class="meta">{{item.post.space.name}}</view>
    <view class="row-actions">
      <view class="stats">
        <view><wu-icon name="heart" size="17" />{{item.post.likeCount}}</view>
        <view aria-label="{{item.post.discussionCount === null ? '回复数量暂不可用' : item.post.discussionCount + ' 条回复'}}"><wu-icon name="message" size="17" />{{item.post.discussionCount === null ? '—' : item.post.discussionCount}}</view>
        <view><wu-icon name="bookmark" tone="accent" size="17" />{{item.post.saveCount}}</view>
      </view>
      <wu-f7-button class="text-button muted" data-id="{{item.post.id}}" disabled="{{busy || savedMutation.busy || savedMutation.frozen || !item.post.viewer.canSave}}" bind:press="onUnsave">取消收藏</wu-f7-button>
    </view>
    <navigator class="detail-link" url="/pages/community-detail/community-detail?postId={{item.post.id}}">查看主题与更新设置<wu-icon name="chevron-right" tone="accent" size="13" /></navigator>
  </wu-f7-block>
  <view wx:if="{{loaded &amp;&amp; !items.length}}" class="empty">
    <wu-icon name="bookmark" size="34" />
    <view class="empty-title">暂无当前可查看的收藏</view>
  </view>
  <wu-f7-button wx:if="{{canLoadMore}}" class="more-button" disabled="{{busy || savedMutation.busy}}" bind:press="onMore" variant="tonal">加载更多收藏</wu-f7-button>
  <navigator class="utility-row" url="/pages/community-updates/community-updates">
    <wu-icon name="bell" size="20" />
    <text>收藏的更新</text>
    <wu-icon name="chevron-right" size="14" />
  </navigator>
  <wu-f7-list class="reading-notes" strong="{{true}}" inset="{{true}}" spacing="compact">
    <wu-f7-list-item class="disclosure" bind:press="onToggleInfo" link="{{true}}" title-slot="{{true}}" aria-label="收藏说明" last="{{true}}">
      <view slot="title" class="f7-disclosure-label">收藏说明<wu-icon name="{{showInfo ? 'chevron-up' : 'chevron-down'}}" size="13" /></view>
    </wu-f7-list-item>
    <view wx:if="{{showInfo}}" class="meta f7-reading-copy">按最近收藏排序，只展示当前可查看的主题，包含急出交易。切换浏览校园不会删除收藏。条数与顺序可能随其他设备的操作变化，请刷新确认。<view>社区更新仅展示服务端已生成的站内记录；新更新是否生成取决于当前环境能力。收藏开关仅控制新根回复，外部通知尚未接入，开启偏好不代表订阅同意或设备授权。</view></view>
  </wu-f7-list>
  <navigator class="back-link" url="/pages/community-feed/community-feed">回到社区</navigator>
</view>
