@import '../../design/framework7-ios.wxss';

.f7-collection-screen {
  min-height: 100vh;
  box-sizing: border-box;
  padding: 1px 0 calc(24px + env(safe-area-inset-bottom));
  background: var(--f7-page-bg-color);
  color: var(--f7-text-color);
}
.f7-collection-screen.hot-screen {
  padding-bottom: calc(76px + env(safe-area-inset-bottom));
}
.f7-collection-screen .toolbar {
  min-height: 52px;
  gap: 12px;
}
.f7-collection-screen .scope-caption,
.f7-collection-screen .meta,
.f7-collection-screen .notice,
.f7-collection-screen .status,
.f7-collection-screen .source-label,
.f7-collection-screen .content-kind,
.f7-collection-screen .identity-label,
.f7-collection-screen .post-meta,
.f7-collection-screen .post-time,
.f7-collection-screen .media-state,
.f7-collection-screen .media-unavailable {
  color: var(--f7-block-footer-text-color);
  font-size: var(--f7-block-footer-font-size);
  line-height: 1.5;
}
.f7-collection-screen .error {
  color: var(--f7-input-error-text-color);
  font-size: var(--f7-block-footer-font-size);
}
.f7-collection-screen .hot-scope-name {
  font-size: 20px;
  font-weight: 600;
}
.f7-collection-screen .post-card,
.f7-collection-screen .content-row,
.f7-collection-screen .publication-row,
.f7-collection-screen .pending-section,
.f7-collection-screen .f7-saved-recovery {
  display: block;
  padding: 0;
  margin: 0;
  border: 0;
  border-radius: 0;
  background: transparent;
}
.f7-collection-screen .author,
.f7-collection-screen .publication-status {
  color: var(--f7-list-item-title-text-color);
  font-size: var(--f7-list-item-title-font-size);
  font-weight: var(--f7-list-item-title-font-weight);
  line-height: var(--f7-list-item-title-line-height);
}
.f7-collection-screen .content-body,
.f7-collection-screen .post-body {
  color: var(--f7-text-color);
  font-size: var(--f7-block-font-size);
  line-height: 1.6;
  margin: 12px 0;
}
.f7-collection-screen .attachment,
.f7-collection-screen .post-attachment,
.f7-collection-screen .media-unavailable {
  background: var(--f7-page-bg-color);
  border-radius: 8px;
  padding: 12px;
  margin: 12px 0;
}
.f7-collection-screen .icon-button,
.f7-collection-screen .category-pill,
.f7-collection-screen .segment,
.f7-collection-screen .chip,
.f7-collection-screen .text-button,
.f7-collection-screen .secondary,
.f7-collection-screen .quiet-button,
.f7-collection-screen .cancel-button,
.f7-collection-screen .more-button,
.f7-collection-screen .disclosure {
  display: block;
  min-height: 0;
  padding: 0;
  margin: 0;
  border: 0;
  border-radius: 0;
  box-shadow: none;
  background: transparent;
  color: inherit;
}
.f7-collection-screen .icon-button {
  flex: 0 0 44px;
  width: 44px;
}
.f7-collection-screen .category-list,
.f7-collection-screen .segmented,
.f7-collection-screen .chips {
  display: flex;
  align-items: center;
  gap: 8px;
  padding: 0;
  border-radius: 0;
  background: transparent;
}
.f7-collection-screen .category-pill,
.f7-collection-screen .chip {
  flex-shrink: 0;
}
.f7-collection-screen .collection-tabs {
  gap: 32px;
  border-color: var(--f7-list-item-border-color);
}
.f7-collection-screen .tab {
  min-height: 44px;
  font-size: 15px;
  color: var(--f7-block-footer-text-color);
}
.f7-collection-screen .tab.active {
  color: var(--f7-theme-color);
}
.f7-collection-screen .tab.active::after {
  background: var(--f7-theme-color);
}
.f7-collection-screen .detail-link,
.f7-collection-screen .post-open,
.f7-collection-screen .quiet-link,
.f7-collection-screen .login-link,
.f7-collection-screen .back-link,
.f7-collection-screen .hot-back {
  min-height: 44px;
  color: var(--f7-theme-color);
  font-size: 14px;
}
.f7-collection-screen .utility-row {
  min-height: 52px;
  color: var(--f7-text-color);
  border-color: var(--f7-list-item-border-color);
  font-size: 15px;
}
.f7-collection-screen > .utility-row,
.f7-collection-screen > .more-button,
.f7-collection-screen > .hot-pagination,
.f7-collection-screen > .pagination,
.f7-collection-screen > .notice,
.f7-collection-screen > .status,
.f7-collection-screen > .error,
.f7-collection-screen > .login-link,
.f7-collection-screen > .quiet-button {
  margin-left: 24px;
  margin-right: 24px;
}
.f7-collection-screen .hot-pagination,
.f7-collection-screen .pagination {
  gap: 12px;
}
.f7-collection-screen .hot-pagination .secondary,
.f7-collection-screen .pagination .secondary {
  flex: 1;
}
.f7-collection-screen .reading-notes {
  margin: 0;
}
.f7-disclosure-label {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 8px;
}
.f7-collection-screen .f7-reading-copy {
  margin: 0;
  padding: 0 16px 16px;
}
.f7-publication-layout {
  display: flex;
  gap: 12px;
}
.f7-collection-screen .publication-symbol,
.f7-collection-screen .anonymous-avatar {
  background: var(--f7-page-bg-color);
}
.f7-collection-screen .publication-symbol {
  width: 36px;
  height: 36px;
  flex-basis: 36px;
  border-radius: 8px;
}
.f7-collection-screen .empty-title {
  color: var(--f7-text-color);
  font-size: 17px;
}
