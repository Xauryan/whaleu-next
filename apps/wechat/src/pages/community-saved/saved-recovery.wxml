<template name="saved-recovery">
  <wu-f7-block wx:if="{{savedMutation.frozen || savedMutation.receiptStatus || savedMutation.error}}" class="card f7-saved-recovery" strong="{{true}}" inset="{{true}}" spacing="compact">
    <view class="section-title">收藏与设置结果恢复</view>
    <view class="notice">{{savedMutation.actionLabel}} · {{savedMutation.status}}</view>
    <view wx:if="{{savedMutation.error}}" class="error">{{savedMutation.error}}</view>
    <view class="status">{{savedMutation.receiptStatus}}</view>
    <view wx:if="{{savedMutation.frozen}}">
      <wu-f7-button disabled="{{savedMutation.busy}}" bind:press="onSavedReceipt">查询原请求回执</wu-f7-button>
      <wu-f7-button disabled="{{savedMutation.busy}}" bind:press="onSavedRetry">重试完全相同的原请求</wu-f7-button>
      <navigator wx:if="{{savedMutation.recoveryPostId}}" class="link" url="/pages/community-detail/community-detail?postId={{savedMutation.recoveryPostId}}">原主题与恢复入口<wu-icon name="chevron-right" tone="accent" size="13" /></navigator>
    </view>
    <wu-f7-button wx:if="{{savedMutation.busy}}" bind:press="onSavedCancel">停止等待（不撤销请求）</wu-f7-button>
    <view class="notice">未确认的请求不会被相反意图覆盖；关闭页面、换账号或重启后，仍保留在原账号下。回执只确认当时的请求，当前状态需重新读取。</view>
  </wu-f7-block>
</template>
