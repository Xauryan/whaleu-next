@import '../../community/forms.wxss';
.search-input {
  box-sizing: border-box;
  width: 100%;
  min-height: 96rpx;
  padding: 20rpx;
  background: #f2f6f8;
  border-radius: 12rpx;
  line-height: 1.7;
}

.filter-label,
.hit-kind {
  font-weight: 600;
  margin: 16rpx 0;
}
.date-filters {
  display: flex;
  flex-wrap: wrap;
  gap: 12rpx;
}
.snippet {
  white-space: pre-wrap;
  overflow: hidden;
  display: -webkit-box;
  -webkit-line-clamp: 3;
  -webkit-box-orient: vertical;
  line-height: 1.7;
  margin: 16rpx 0;
  word-break: break-word;
}
.match {
  background: #fff0b3;
  color: #473500;
  font-weight: 600;
}
.post-summary {
  color: #536b76;
  font-size: 26rpx;
  line-height: 1.6;
  margin: 12rpx 0;
}
