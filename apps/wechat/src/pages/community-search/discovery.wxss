@import '../../community/forms.wxss';
@import '../../experience/public-display.wxss';
page {
  background: var(--wu-surface);
  color: var(--wu-text);
}
.screen {
  padding: 12rpx 32rpx calc(56rpx + env(safe-area-inset-bottom));
}
button {
  margin: 0;
  border: 0;
  box-shadow: none;
  font-weight: 500;
}
button::after {
  border: 0;
}
button[disabled] {
  opacity: 0.42;
}
.toolbar,
.row-top,
.row-actions,
.section-toolbar {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 20rpx;
}
.toolbar {
  min-height: 88rpx;
}
.scope-caption {
  min-width: 0;
  color: var(--wu-secondary);
  font-size: 25rpx;
  line-height: 1.5;
}
.icon-button {
  display: flex;
  flex: 0 0 80rpx;
  justify-content: center;
  align-items: center;
  width: 80rpx;
  min-height: 88rpx;
  padding: 0;
  border-radius: 0;
  background: transparent;
}
.text-button {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  gap: 8rpx;
  min-height: 88rpx;
  margin: 0;
  padding: 0 6rpx;
  border-radius: 0;
  background: transparent;
  color: var(--wu-accent);
  font-size: 26rpx;
  line-height: 1.45;
}
.text-button.muted {
  color: var(--wu-secondary);
}
.tab-scroll {
  width: 100%;
  white-space: nowrap;
}
.tabs {
  display: flex;
  align-items: center;
  gap: 32rpx;
  border-bottom: 1rpx solid var(--wu-separator);
}
.tab {
  display: flex;
  position: relative;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
  min-height: 92rpx;
  padding: 0 2rpx;
  margin: 0;
  background: transparent;
  color: var(--wu-secondary);
  border-radius: 0;
  font-size: 28rpx;
  font-weight: 500;
}
.tab.active {
  color: var(--wu-text);
  font-weight: 650;
}
.tab.active::after {
  content: '';
  position: absolute;
  bottom: 8rpx;
  width: 28rpx;
  height: 5rpx;
  border-radius: 5rpx;
  background: var(--wu-accent);
}
.collection-tabs {
  justify-content: center;
  gap: 72rpx;
}
.meta,
.source-label {
  color: var(--wu-secondary);
  font-size: 23rpx;
  line-height: 1.55;
  margin: 8rpx 0;
  overflow-wrap: anywhere;
}
.source-label {
  color: var(--wu-tertiary);
}
.content-row {
  padding: 30rpx 0 24rpx;
  border-bottom: 1rpx solid var(--wu-separator);
}
.row-top {
  align-items: baseline;
  gap: 14rpx;
}
.author {
  min-width: 0;
  color: var(--wu-text);
  font-size: 26rpx;
  font-weight: 600;
  overflow-wrap: anywhere;
}
.identity-label,
.content-kind {
  font-size: 22rpx;
  color: var(--wu-secondary);
  font-weight: 400;
}
.identity-label {
  margin-left: 12rpx;
}
.content-kind {
  flex-shrink: 0;
}
.body,
.content-body {
  display: block;
  color: var(--wu-text);
  font-size: 30rpx;
  line-height: 1.65;
  white-space: pre-wrap;
  word-break: break-word;
  margin: 18rpx 0;
}
.content-body {
  display: -webkit-box;
  -webkit-line-clamp: 4;
  -webkit-box-orient: vertical;
  overflow: hidden;
}
.row-actions {
  min-height: 76rpx;
}
.detail-link,
.link,
.login-link {
  display: inline-flex;
  align-items: center;
  gap: 8rpx;
  color: var(--wu-accent);
  font-size: 25rpx;
  min-height: 76rpx;
  padding: 0;
}
.login-link {
  width: 100%;
  justify-content: center;
  padding: 20rpx 0;
}
.stats,
.stats > view {
  display: flex;
  align-items: center;
  gap: 8rpx;
  font-size: 23rpx;
  color: var(--wu-secondary);
}
.stats {
  gap: 26rpx;
}
.attachment {
  margin: 18rpx 0;
  padding: 22rpx 24rpx;
  border-radius: 18rpx;
  background: var(--wu-bg);
  font-size: 28rpx;
  line-height: 1.55;
}
.attachment:empty {
  display: none;
}
.attachment-label {
  color: var(--wu-secondary);
  font-size: 23rpx;
  margin-bottom: 8rpx;
}
.attachment .scope {
  padding: 0;
  margin: 0 0 12rpx;
  color: var(--wu-secondary);
  background: transparent;
  font-size: 23rpx;
}
.attachment .section-title {
  font-size: 34rpx;
  margin: 8rpx 0;
}
.attachment .body {
  font-size: 25rpx;
  margin: 8rpx 0 0;
}
.media-state {
  display: flex;
  align-items: center;
  gap: 12rpx;
  color: var(--wu-secondary);
  font-size: 24rpx;
  padding: 16rpx 0;
}
.card {
  padding: 24rpx;
  margin: 18rpx 0;
  border: 0;
  border-radius: 18rpx;
  background: var(--wu-bg);
}
.card .section-title {
  font-size: 28rpx;
  margin-bottom: 12rpx;
}
.card button {
  background: var(--wu-elevated);
  font-size: 25rpx;
  min-height: 88rpx;
}
.notice,
.status {
  font-size: 25rpx;
  line-height: 1.6;
  color: var(--wu-secondary);
  padding: 16rpx 0;
}
.status:empty {
  display: none;
}
.error {
  font-size: 25rpx;
  line-height: 1.6;
  padding: 20rpx 22rpx;
  border-radius: 16rpx;
  margin: 14rpx 0;
}
.empty {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 10rpx;
  padding: 82rpx 24rpx;
  text-align: center;
  font-size: 25rpx;
  color: var(--wu-secondary);
}
.empty-title {
  font-size: 31rpx;
  font-weight: 600;
  color: var(--wu-text);
  margin: 10rpx 0;
}
.quiet-button,
.more-button {
  background: var(--wu-bg);
  color: var(--wu-text);
  border-radius: 18rpx;
  min-height: 88rpx;
  font-size: 26rpx;
  margin: 16rpx 0;
}
.pagination {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 24rpx;
  margin: 26rpx 0;
  color: var(--wu-secondary);
  font-size: 23rpx;
}
.pagination button {
  flex: 1;
  min-height: 88rpx;
  margin: 0;
  padding: 0 16rpx;
  background: var(--wu-bg);
  border-radius: 16rpx;
  font-size: 25rpx;
}
.pagination:empty {
  display: none;
}
.reading-notes {
  margin-top: 24rpx;
}
.disclosure {
  display: flex;
  align-items: center;
  justify-content: space-between;
  width: 100%;
  min-height: 88rpx;
  padding: 0;
  border-radius: 0;
  background: transparent;
  text-align: left;
  font-size: 25rpx;
  color: var(--wu-secondary);
}
.reading-notes .meta {
  line-height: 1.75;
}
.reading-notes .meta > view {
  margin-top: 12rpx;
}
.utility-row {
  display: flex;
  align-items: center;
  gap: 20rpx;
  min-height: 96rpx;
  border-bottom: 1rpx solid var(--wu-separator);
  color: var(--wu-text);
  font-size: 27rpx;
}
.utility-row > text {
  flex: 1;
  min-width: 0;
}
.back-link {
  display: block;
  text-align: center;
  min-height: 88rpx;
  padding: 20rpx 0;
  font-size: 25rpx;
  color: var(--wu-accent);
}
.chips {
  gap: 12rpx;
  margin: 14rpx 0;
}
.chip {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  min-height: 76rpx;
  box-sizing: border-box;
  border: 0;
  border-radius: 16rpx;
  padding: 0 22rpx;
  margin: 0;
  background: var(--wu-bg);
  font-size: 24rpx;
  color: var(--wu-secondary);
}
.chip.active {
  background: var(--wu-tint);
  color: var(--wu-accent);
  border: 0;
  font-weight: 600;
}
.nowrap {
  flex-wrap: nowrap;
}
.search-row {
  display: flex;
  align-items: center;
  gap: 18rpx;
}
.search-field {
  display: flex;
  align-items: center;
  gap: 14rpx;
  flex: 1;
  min-width: 0;
  padding: 0 22rpx;
  background: var(--wu-bg);
  border-radius: 22rpx;
}
.search-field input {
  flex: 1;
  min-width: 0;
  height: 84rpx;
  border: 0;
  background: transparent;
  padding: 0;
  font-size: 28rpx;
}
.section-heading {
  font-size: 31rpx;
  font-weight: 650;
  letter-spacing: -0.5rpx;
  color: var(--wu-text);
}
.filter-heading {
  font-size: 25rpx;
  font-weight: 600;
  margin: 26rpx 0 10rpx;
}
