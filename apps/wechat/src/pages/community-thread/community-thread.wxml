<import src="../../profile/named-avatar.wxml" />
<import src="../../experience/public-display.wxml" />
<import src="../../community/report-recovery.wxml" />
<import src="../../community/block-recovery.wxml" />
<import src="../../identity-privacy/view.wxml" />
<import src="../../community/discussion-recovery.wxml" />
<template name="reply-row">
<view class="thread-reply {{reply.id === requestedReplyId ? 'located' : ''}}">
<view class="author author-line">
<button wx:if="{{reply.author.kind === 'named'}}" size="mini" data-kind="reply" data-id="{{reply.id}}" bindtap="onAuthorAvatar" disabled="{{busy || needsReload || block.busy || block.frozen}}" class="avatar-button" aria-label="查看公开头像"><wu-icon name="person" size="23" tone="muted" /></button>
<text wx:if="{{reply.author.kind === 'named'}}" class="author-name" data-kind="reply" data-id="{{reply.id}}" bindtap="onAuthor">{{reply.author.displayName}}</text>
<text wx:else>{{reply.author.displayName}}</text>
<template wx:if="{{reply.author.kind === 'named'}}" is="public-experience-display" data="{{display:reply.author.experienceDisplay,colors:experienceColorStyles}}" />
<text wx:if="{{reply.author.kind === 'anonymous'}}" class="badge">分身</text>
<text wx:if="{{reply.viewer.isSelf}}" class="badge">我</text>
</view>
<view class="meta">{{reply.createdAt}} · {{reply.likeCount}} 赞</view>
<view class="meta">回复 <button wx:if="{{reply.target.status === 'available' &amp;&amp; reply.target.author.kind === 'named'}}" size="mini" data-kind="reply_target" data-id="{{reply.id}}" bindtap="onAuthorAvatar" disabled="{{busy || needsReload || block.busy || block.frozen}}" class="avatar-button" aria-label="查看公开头像"><wu-icon name="person" size="23" tone="muted" /></button>
<text wx:if="{{reply.target.status === 'available' &amp;&amp; reply.target.author.kind === 'named'}}" class="author-name" data-kind="reply_target" data-id="{{reply.id}}" bindtap="onAuthor">{{reply.target.author.displayName}}</text>
<text wx:else>{{reply.target.status === 'available' ? reply.target.author.displayName : '当前不可查看的对象'}}</text>
<template wx:if="{{reply.target.status === 'available' &amp;&amp; reply.target.author.kind === 'named'}}" is="public-experience-display" data="{{display:reply.target.author.experienceDisplay,colors:experienceColorStyles}}" />
</view>
<wu-source-text wx:if="{{reply.readingBody &amp;&amp; reply.readingBody.classification === 'reviewedSource'}}" presentation="{{reply.readingBody.value}}" disabled="{{busy || needsReload || block.busy || block.frozen || report.busy || report.frozen || interaction.busy || interaction.frozen}}" /><view wx:else class="body">{{reply.text}}</view>
<button wx:if="{{reply.images.length}}" class="secondary" data-kind="reply" data-id="{{reply.id}}" bindtap="onSelectGallery" disabled="{{busy || needsReload || block.busy || block.frozen || report.busy || report.frozen || interaction.busy || interaction.frozen}}">查看回复图片（{{reply.images.length}} 张）</button>
<template wx:if="{{identityOverlay.developerEnabled}}" is="identity-overlay" data="{{identity:identityOverlay.items[reply.id]}}" />
<wu-f7-button class="more-button" data-menu="{{'reply:' + reply.id}}" bind:press="onToggleThreadMenu" aria-label="回复的更多操作"><wu-icon name="more" size="20" /></wu-f7-button>
<view wx:if="{{uiExpandedMenu === 'reply:' + reply.id}}" class="context-menu">
<wu-f7-button wx:if="{{!reply.viewer.isSelf}}" data-id="{{reply.id}}" bind:press="onReportReply" disabled="{{busy || report.busy || report.frozen}}">举报此内容</wu-f7-button>
<wu-f7-button wx:if="{{!reply.viewer.isSelf}}" data-kind="reply" data-id="{{reply.id}}" bind:press="onPrivateMessage" disabled="{{busy || needsReload || block.busy || block.frozen}}">{{reply.author.kind === 'anonymous' ? '以本帖分身私信' : '以公开身份私信'}}</wu-f7-button>
<wu-f7-button wx:if="{{!reply.viewer.isSelf}}" data-kind="reply" data-id="{{reply.id}}" bind:press="onAdminDiscussionRemoval" disabled="{{busy || needsReload || block.busy || block.frozen || report.busy || report.frozen || interaction.busy || interaction.frozen}}">管理员删除此回复（先核验权限）</wu-f7-button>
<navigator class="link" url="/pages/report-progress/report-progress?kind=reply&amp;id={{reply.id}}">举报进度 →</navigator>
<navigator wx:if="{{reply.author.kind === 'named' &amp;&amp; !busy &amp;&amp; !needsReload &amp;&amp; !block.busy &amp;&amp; !block.frozen}}" class="link" url="/pages/profile-moderation/profile-moderation?kind=reply&amp;id={{reply.id}}">处理昵称（先核验权限） →</navigator>
<navigator wx:if="{{reply.author.kind === 'named' &amp;&amp; !busy &amp;&amp; !needsReload &amp;&amp; !block.busy &amp;&amp; !block.frozen}}" class="link" bindtap="onAvatarModerationNavigate" url="/pages/profile-avatar-moderation/profile-avatar-moderation?kind=reply&amp;id={{reply.id}}">清除当前自定义头像（先核验权限） →</navigator>
<wu-f7-button wx:if="{{reply.author.kind === 'named' &amp;&amp; !reply.viewer.isSelf}}" class="secondary" data-id="{{reply.id}}" bind:press="onBlockReply" disabled="{{busy || block.busy || block.frozen}}" variant="tonal">拉黑此公开身份作者</wu-f7-button>
</view>
<wu-f7-button class="text-action" data-id="{{reply.id}}" bind:press="onLikeReply" disabled="{{busy || interaction.busy || interaction.frozen}}">{{reply.viewer.isLiked ? '取消点赞' : '点赞回复'}}</wu-f7-button>
<navigator wx:if="{{post.viewer.canComment}}" class="link" url="/pages/community-compose/community-compose?postId={{post.id}}&amp;rootCommentId={{root.id}}&amp;targetReplyId={{reply.id}}{{viewSpaceQuery}}">回复 {{reply.author.displayName}}</navigator>
<view wx:if="{{uiExpandedMenu === 'reply:' + reply.id}}" class="context-menu"><navigator wx:if="{{post.viewer.canComment &amp;&amp; reply.text &amp;&amp; reply.target.status === 'available' &amp;&amp; reply.target.kind === 'comment'}}" class="link" url="/pages/community-compose/community-compose?postId={{post.id}}&amp;rootCommentId={{root.id}}&amp;copyReplyId={{reply.id}}{{viewSpaceQuery}}">复制文字 +1（保留原回复对象） →</navigator>
<navigator wx:if="{{post.viewer.canComment &amp;&amp; reply.text &amp;&amp; reply.target.status === 'available' &amp;&amp; reply.target.kind === 'reply'}}" class="link" url="/pages/community-compose/community-compose?postId={{post.id}}&amp;rootCommentId={{root.id}}&amp;targetReplyId={{reply.target.id}}&amp;copyReplyId={{reply.id}}{{viewSpaceQuery}}">复制文字 +1（保留原回复对象） →</navigator>
<wu-f7-button wx:if="{{reply.viewer.canDelete}}" data-id="{{reply.id}}" bind:press="onDeleteReply" disabled="{{busy || interaction.busy}}">删除我的回复</wu-f7-button></view>
</view>
</template>
<view class="screen thread-screen f7-ios-theme f7-composer-screen">
<template is="report-recovery" data="{{report}}" />
<template is="block-recovery" data="{{block}}" />
<view class="thread-heading"><text>回复</text><wu-f7-button class="refresh-button" bind:press="onReload" disabled="{{busy || interaction.busy}}" aria-label="刷新回复"><wu-icon name="refresh" size="20" /></wu-f7-button></view>
<view wx:if="{{busy || !loaded || needsReload}}" class="status">{{status}}</view>
<view wx:if="{{error}}" class="error">{{error}}</view>

<wu-f7-button wx:if="{{busy}}" bind:press="onCancel">停止等待</wu-f7-button>
<view wx:if="{{identityOverlay.notice}}" class="notice">{{identityOverlay.notice}}</view>
<template is="discussion-recovery" data="{{interaction}}" />
<wu-f7-block wx:if="{{root &amp;&amp; post}}" class="card" spacing="compact">
<view class="section-title">原回复 <text wx:if="{{root.isPinned}}" class="badge">楼主置顶</text>
</view>
<view class="author author-line">
<button wx:if="{{root.author.kind === 'named'}}" size="mini" data-kind="comment" data-id="{{root.id}}" bindtap="onAuthorAvatar" disabled="{{busy || needsReload || block.busy || block.frozen}}" class="avatar-button" aria-label="查看公开头像"><wu-icon name="person" size="23" tone="muted" /></button>
<text wx:if="{{root.author.kind === 'named'}}" class="author-name" data-kind="comment" data-id="{{root.id}}" bindtap="onAuthor">{{root.author.displayName}}</text>
<text wx:else>{{root.author.displayName}}</text>
<template wx:if="{{root.author.kind === 'named'}}" is="public-experience-display" data="{{display:root.author.experienceDisplay,colors:experienceColorStyles}}" />
<text wx:if="{{root.author.kind === 'anonymous'}}" class="badge">分身</text>
</view>
<wu-source-text wx:if="{{root.readingBody &amp;&amp; root.readingBody.classification === 'reviewedSource'}}" presentation="{{root.readingBody.value}}" disabled="{{busy || needsReload || block.busy || block.frozen || report.busy || report.frozen || interaction.busy || interaction.frozen}}" /><view wx:else class="body">{{root.text}}</view>
<button wx:if="{{root.images.length}}" class="secondary" data-kind="comment" data-id="{{root.id}}" bindtap="onSelectGallery" disabled="{{busy || needsReload || block.busy || block.frozen || report.busy || report.frozen || interaction.busy || interaction.frozen}}">查看回复图片（{{root.images.length}} 张）</button>
<template wx:if="{{identityOverlay.developerEnabled}}" is="identity-overlay" data="{{identity:identityOverlay.items[root.id]}}" />
<view class="meta">{{root.likeCount}} 赞 · {{root.replyCount === null ? '—' : root.replyCount}} 条回复</view>
<wu-f7-button class="more-button" data-menu="{{'root'}}" bind:press="onToggleThreadMenu" aria-label="回复的更多操作"><wu-icon name="more" size="20" /></wu-f7-button>
<view wx:if="{{uiExpandedMenu === 'root'}}" class="context-menu">
<wu-f7-button wx:if="{{!root.viewer.isSelf}}" bind:press="onReportRoot" disabled="{{busy || report.busy || report.frozen}}">举报此内容</wu-f7-button>
<wu-f7-button wx:if="{{!root.viewer.isSelf}}" data-kind="comment" data-id="{{root.id}}" bind:press="onPrivateMessage" disabled="{{busy || needsReload || block.busy || block.frozen}}">{{root.author.kind === 'anonymous' ? '以本帖分身私信' : '以公开身份私信'}}</wu-f7-button>
<wu-f7-button wx:if="{{!root.viewer.isSelf}}" data-kind="comment" data-id="{{root.id}}" bind:press="onAdminDiscussionRemoval" disabled="{{busy || needsReload || block.busy || block.frozen || report.busy || report.frozen || interaction.busy || interaction.frozen}}">管理员删除此回复（先核验权限）</wu-f7-button>
<navigator class="link" url="/pages/report-progress/report-progress?kind=comment&amp;id={{root.id}}">举报进度 →</navigator>
<navigator wx:if="{{root.author.kind === 'named' &amp;&amp; !busy &amp;&amp; !needsReload &amp;&amp; !block.busy &amp;&amp; !block.frozen}}" class="link" url="/pages/profile-moderation/profile-moderation?kind=comment&amp;id={{root.id}}">处理昵称（先核验权限） →</navigator>
<navigator wx:if="{{root.author.kind === 'named' &amp;&amp; !busy &amp;&amp; !needsReload &amp;&amp; !block.busy &amp;&amp; !block.frozen}}" class="link" bindtap="onAvatarModerationNavigate" url="/pages/profile-avatar-moderation/profile-avatar-moderation?kind=comment&amp;id={{root.id}}">清除当前自定义头像（先核验权限） →</navigator>
<wu-f7-button wx:if="{{root.author.kind === 'named' &amp;&amp; !root.viewer.isSelf}}" bind:press="onBlockRoot" disabled="{{busy || block.busy || block.frozen}}">拉黑此公开身份作者</wu-f7-button>
</view>
<wu-f7-button class="text-action" bind:press="onLikeRoot" disabled="{{busy || interaction.busy || interaction.frozen}}">{{root.viewer.isLiked ? '取消点赞' : '点赞'}}</wu-f7-button>
<view wx:if="{{uiExpandedMenu === 'root'}}" class="context-menu"><wu-f7-button wx:if="{{root.viewer.canPin}}" bind:press="onPinRoot" disabled="{{busy || interaction.busy || interaction.frozen}}">{{root.isPinned ? '取消置顶' : '置顶根回复'}}</wu-f7-button><view class="notice">每个主题可置顶一条回复；更换前请先取消原置顶。</view></view>
<view class="thread-reply-bar"><navigator wx:if="{{post.viewer.canComment}}" class="link" url="/pages/community-compose/community-compose?postId={{post.id}}&amp;rootCommentId={{root.id}}{{viewSpaceQuery}}">回复 {{root.author.displayName}}</navigator></view>

</wu-f7-block>
<wu-f7-block wx:if="{{locatedReply}}" class="card" spacing="compact">
<view class="section-title">单独定位的回复</view>
<template is="reply-row" data="{{reply:locatedReply,post,root,busy,needsReload,block,report,interaction,identityOverlay,requestedReplyId,experienceColorStyles,viewSpaceQuery,uiExpandedMenu}}" />
</wu-f7-block>
<wu-f7-block wx:if="{{contextReplies.length}}" class="card" spacing="compact">
<view class="section-title">定位到的回复</view>

<view wx:for="{{contextReplies}}" wx:key="id">
<template is="reply-row" data="{{reply:item,post,root,busy,needsReload,block,report,interaction,identityOverlay,requestedReplyId,experienceColorStyles,viewSpaceQuery,uiExpandedMenu}}" />
</view>
</wu-f7-block>
<wu-f7-block wx:if="{{loaded}}" class="card" spacing="compact">
<view class="section-title">全部回复</view>
<view wx:if="{{!replies.length}}" class="empty">暂无可查看的回复</view>
<view wx:for="{{replies}}" wx:key="id">
<view class="divider">
</view>
<template is="reply-row" data="{{reply:item,post,root,busy,needsReload,block,report,interaction,identityOverlay,requestedReplyId,experienceColorStyles,viewSpaceQuery,uiExpandedMenu}}" />
</view>
<wu-f7-button wx:if="{{canLoadMore}}" bind:press="onMore" disabled="{{busy}}">加载更多回复</wu-f7-button>
</wu-f7-block>
<view wx:if="{{deleteReplyId}}" class="confirm">
<view class="section-title">确认删除自己的回复？</view>
<view class="notice">其他回复仍保留。停止等待不代表撤销删除；结果未知时请重新加载。</view>
<button class="danger" bindtap="onConfirmDelete" disabled="{{busy}}">确认删除</button>
<button bindtap="onDismissDelete" disabled="{{busy}}">保留回复</button>
</view>
<view wx:if="{{post.isRelatedCampusSync}}" class="badge">来自 {{post.sourceRegion.name}} · 关联学校同步</view>
<wu-f7-list spacing="compact"><wu-f7-list-item wx:if="{{post}}" class="thread-more-toggle" data-menu="post" bind:press="onToggleThreadMenu" link="{{true}}" last="{{true}}" aria-label="主题的更多操作"><view class="f7-composer-disclosure"><text>主题的更多操作</text><wu-icon name="chevron-right" size="14" tone="muted" /></view></wu-f7-list-item></wu-f7-list>
<view wx:if="{{uiExpandedMenu === 'post'}}" class="context-menu"><wu-f7-block wx:if="{{post &amp;&amp; post.author.kind === 'named' &amp;&amp; !post.viewer.isSelf}}" class="card" spacing="compact">
<view class="author author-line">帖子作者：<button wx:if="{{post.author.kind === 'named'}}" size="mini" data-kind="post" data-id="{{post.id}}" bindtap="onAuthorAvatar" disabled="{{busy || needsReload || block.busy || block.frozen}}" class="avatar-button" aria-label="查看公开头像"><wu-icon name="person" size="23" tone="muted" /></button>
<text wx:if="{{post.author.kind === 'named'}}" class="author-name" data-kind="post" data-id="{{post.id}}" bindtap="onAuthor">{{post.author.displayName}} →</text>
<text wx:else>{{post.author.displayName}}</text>
<template wx:if="{{post.author.kind === 'named'}}" is="public-experience-display" data="{{display:post.author.experienceDisplay,colors:experienceColorStyles}}" />
</view>
<wu-f7-button bind:press="onBlockPost" disabled="{{busy || needsReload || block.busy || block.frozen}}">拉黑此公开身份帖子作者</wu-f7-button>
</wu-f7-block>
<wu-f7-block wx:if="{{post}}" class="card" spacing="compact">
<button wx:if="{{post.images.length}}" class="secondary" data-kind="post" data-id="{{post.id}}" bindtap="onSelectGallery" disabled="{{busy || needsReload || block.busy || block.frozen || report.busy || report.frozen || interaction.busy || interaction.frozen}}">查看帖子图片（{{post.images.length}} 张）</button>
<wu-f7-button wx:if="{{!post.viewer.isSelf}}" bind:press="onReportPost" disabled="{{busy || report.busy || report.frozen}}">举报帖子</wu-f7-button>
<wu-f7-button wx:if="{{!post.viewer.isSelf}}" data-kind="post" data-id="{{post.id}}" bind:press="onPrivateMessage" disabled="{{busy || needsReload || block.busy || block.frozen}}">{{post.author.kind === 'anonymous' ? '以本帖分身私信' : '以公开身份私信'}}</wu-f7-button>
<wu-f7-button wx:if="{{!post.viewer.isSelf &amp;&amp; post.author.kind === 'named' &amp;&amp; post.allowAnonymousDm}}" data-kind="post" data-id="{{post.id}}" data-mode="anonymous" bind:press="onPrivateMessage" disabled="{{busy || needsReload || block.busy || block.frozen}}">以本帖分身私信此作者</wu-f7-button>
<navigator class="link" url="/pages/report-progress/report-progress?kind=post&amp;id={{post.id}}">帖子举报进度与陪审 →</navigator>
<navigator wx:if="{{post.author.kind === 'named' &amp;&amp; !busy &amp;&amp; !needsReload &amp;&amp; !block.busy &amp;&amp; !block.frozen}}" class="link" url="/pages/profile-moderation/profile-moderation?kind=post&amp;id={{post.id}}">处理昵称（先核验权限） →</navigator>
<navigator wx:if="{{post.author.kind === 'named' &amp;&amp; !busy &amp;&amp; !needsReload &amp;&amp; !block.busy &amp;&amp; !block.frozen}}" class="link" bindtap="onAvatarModerationNavigate" url="/pages/profile-avatar-moderation/profile-avatar-moderation?kind=post&amp;id={{post.id}}">清除当前自定义头像（先核验权限） →</navigator>
</wu-f7-block>
</view>
<navigator wx:if="{{post}}" class="link" url="/pages/community-detail/community-detail?postId={{post.id}}&amp;rootCommentId={{root.id}}{{viewSpaceQuery}}">查看主题</navigator>
<navigator class="link" url="/pages/community-mine/community-mine">我的发布与恢复 →</navigator>
<navigator wx:if="{{!hasSession}}" class="link" url="/pages/login/login">登录后继续</navigator>
  <view wx:if="{{mediaGallery.groupId}}" class="private-gallery-backdrop" bindtap="onGalleryDismiss" catchtouchmove="onGalleryTouchMove">
</view>
  <view wx:if="{{mediaGallery.groupId}}" class="private-gallery-panel" aria-role="dialog" aria-label="{{mediaGallery.title}}" catchtouchmove="onGalleryTouchMove">
    <view class="section-title">{{mediaGallery.title}}{{mediaGallery.total ? ' · ' + mediaGallery.total + ' 张' : ''}}</view>
    <button bindtap="onGalleryDismiss">关闭并清除图片</button>
    <scroll-view scroll-y="{{true}}" class="private-gallery-content">
      <view wx:for="{{mediaGallery.slots}}" wx:key="index" class="private-gallery-slot {{mediaGallery.expanded ? 'private-gallery-slot-expanded' : ''}}">
        <image wx:if="{{item.status === 'ready' &amp;&amp; item.localSrc}}" src="{{item.localSrc}}" data-index="{{item.index}}" data-src="{{item.localSrc}}" data-view-id="{{item.viewId}}" mode="widthFix" class="{{mediaGallery.expanded ? 'private-image-expanded' : 'private-gallery-thumb'}}" bindtap="onGalleryOpen" binderror="onGalleryError" show-menu-by-longpress="{{false}}" />
        <view wx:else class="notice">第 {{item.index + 1}} 张：{{item.status === 'loading' ? '正在安全读取' : '暂不可用'}}</view>
        <button wx:if="{{item.status === 'unavailable'}}" data-index="{{item.index}}" bindtap="onGalleryRetry">重试此图</button>
      </view>
      <view wx:if="{{mediaGallery.status === 'unavailable'}}" class="notice">图片暂不可用，请关闭图片并重新加载当前讨论</view>
    </scroll-view>
    <view wx:if="{{mediaGallery.expanded}}" class="chips">
      <button data-index="{{mediaGallery.selected - 1}}" bindtap="onGalleryOpen" disabled="{{mediaGallery.selected === 0}}">上一张</button>
      <button data-index="{{mediaGallery.selected + 1}}" bindtap="onGalleryOpen" disabled="{{mediaGallery.selected + 1 &gt;= mediaGallery.total}}">下一张</button>
      <button bindtap="onGalleryClose">返回缩略图</button>
    </view>
    <view wx:elif="{{mediaGallery.total &gt; 3}}" class="chips">
      <button data-start="{{mediaGallery.start - 3}}" bindtap="onGalleryWindow" disabled="{{mediaGallery.start &lt; 3}}">上一组</button>
      <button data-start="{{mediaGallery.start + 3}}" bindtap="onGalleryWindow" disabled="{{mediaGallery.start + 3 &gt;= mediaGallery.total}}">下一组</button>
    </view>
    <view class="notice">仅保留当前选中的一组图片；关闭、刷新或离开页面会清除显示。</view>
  </view>
<template is="named-avatar-preview" data="{{avatar:namedAvatar}}" />
</view>
