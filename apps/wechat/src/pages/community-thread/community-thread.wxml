<import src="../../experience/public-display.wxml" />
<import src="../../community/report-recovery.wxml" />
<import src="../../community/block-recovery.wxml" />
<import src="../../identity-privacy/view.wxml" /><import src="../../community/discussion-recovery.wxml" />
<template name="reply-row"><view class="{{reply.id === requestedReplyId ? 'located' : ''}}"><view class="author"><text wx:if="{{reply.author.kind === 'named'}}" class="link" data-kind="reply" data-id="{{reply.id}}" bindtap="onAuthor">{{reply.author.displayName}} →</text><text wx:else>{{reply.author.displayName}}</text><template wx:if="{{reply.author.kind === 'named'}}" is="public-experience-display" data="{{display:reply.author.experienceDisplay,colors:experienceColorStyles}}" /><text class="badge">{{reply.author.kind === 'anonymous' ? '匿名' : '公开身份'}}</text><text wx:if="{{reply.viewer.isSelf}}" class="badge">我</text></view><view class="meta">{{reply.createdAt}} · {{reply.likeCount}} 赞</view><view class="meta">回复 <text wx:if="{{reply.target.status === 'available' &amp;&amp; reply.target.author.kind === 'named'}}" class="link" data-kind="reply_target" data-id="{{reply.id}}" bindtap="onAuthor">{{reply.target.author.displayName}} →</text><text wx:else>{{reply.target.status === 'available' ? reply.target.author.displayName : '当前不可查看的对象'}}</text><template wx:if="{{reply.target.status === 'available' &amp;&amp; reply.target.author.kind === 'named'}}" is="public-experience-display" data="{{display:reply.target.author.experienceDisplay,colors:experienceColorStyles}}" /></view><view class="body">{{reply.text}}</view><button wx:if="{{reply.images.length}}" class="secondary" data-kind="reply" data-id="{{reply.id}}" bindtap="onSelectGallery" disabled="{{busy || needsReload || block.busy || block.frozen || report.busy || report.frozen || interaction.busy || interaction.frozen}}">查看回复图片（{{reply.images.length}} 张）</button><template wx:if="{{identityOverlay.developerEnabled}}" is="identity-overlay" data="{{identity:identityOverlay.items[reply.id]}}" /><button wx:if="{{!reply.viewer.isSelf}}" data-id="{{reply.id}}" bindtap="onReportReply" disabled="{{busy || report.busy || report.frozen}}">举报此内容</button><button wx:if="{{!reply.viewer.isSelf}}" data-kind="reply" data-id="{{reply.id}}" bindtap="onPrivateMessage" disabled="{{busy || needsReload || block.busy || block.frozen}}">{{reply.author.kind === 'anonymous' ? '以本帖分身私信' : '以公开身份私信'}}</button><navigator class="link" url="/pages/report-progress/report-progress?kind=reply&amp;id={{reply.id}}">举报进度 →</navigator><button wx:if="{{reply.author.kind === 'named' &amp;&amp; !reply.viewer.isSelf}}" class="secondary" data-id="{{reply.id}}" bindtap="onBlockReply" disabled="{{busy || block.busy || block.frozen}}">拉黑此公开身份作者</button><button class="secondary" data-id="{{reply.id}}" bindtap="onLikeReply" disabled="{{busy || interaction.busy || interaction.frozen}}">{{reply.viewer.isLiked ? '取消点赞' : '点赞回复'}}</button><navigator wx:if="{{post.viewer.canComment}}" class="link" url="/pages/community-compose/community-compose?postId={{post.id}}&amp;rootCommentId={{root.id}}&amp;targetReplyId={{reply.id}}">回复 {{reply.author.displayName}} →</navigator><navigator wx:if="{{post.viewer.canComment &amp;&amp; reply.text &amp;&amp; reply.target.status === 'available' &amp;&amp; reply.target.kind === 'comment'}}" class="link" url="/pages/community-compose/community-compose?postId={{post.id}}&amp;rootCommentId={{root.id}}&amp;copyReplyId={{reply.id}}">复制文字 +1（保留原回复对象） →</navigator><navigator wx:if="{{post.viewer.canComment &amp;&amp; reply.text &amp;&amp; reply.target.status === 'available' &amp;&amp; reply.target.kind === 'reply'}}" class="link" url="/pages/community-compose/community-compose?postId={{post.id}}&amp;rootCommentId={{root.id}}&amp;targetReplyId={{reply.target.id}}&amp;copyReplyId={{reply.id}}">复制文字 +1（保留原回复对象） →</navigator><button wx:if="{{reply.viewer.canDelete}}" data-id="{{reply.id}}" bindtap="onDeleteReply" disabled="{{busy || interaction.busy}}">删除我的回复</button></view></template>
<view class="screen"><template is="report-recovery" data="{{report}}" /><template is="block-recovery" data="{{block}}" /><view class="eyebrow">WHALEU · 校园讨论</view><view class="title">评论与回复</view><view class="status">{{status}}</view><view wx:if="{{error}}" class="error">{{error}}</view><button bindtap="onReload" disabled="{{busy || interaction.busy}}">重新加载讨论</button><button wx:if="{{busy}}" bindtap="onCancel">停止等待</button><view wx:if="{{identityOverlay.notice}}" class="notice">{{identityOverlay.notice}}</view><template is="discussion-recovery" data="{{interaction}}" />
<view wx:if="{{root &amp;&amp; post}}" class="card"><view class="section-title">根评论 <text wx:if="{{root.isPinned}}" class="badge">楼主置顶</text></view><view class="author"><text wx:if="{{root.author.kind === 'named'}}" class="link" data-kind="comment" data-id="{{root.id}}" bindtap="onAuthor">{{root.author.displayName}} →</text><text wx:else>{{root.author.displayName}}</text><template wx:if="{{root.author.kind === 'named'}}" is="public-experience-display" data="{{display:root.author.experienceDisplay,colors:experienceColorStyles}}" /><text class="badge">{{root.author.kind === 'anonymous' ? '匿名' : '公开身份'}}</text></view><view class="body">{{root.text}}</view><button wx:if="{{root.images.length}}" class="secondary" data-kind="comment" data-id="{{root.id}}" bindtap="onSelectGallery" disabled="{{busy || needsReload || block.busy || block.frozen || report.busy || report.frozen || interaction.busy || interaction.frozen}}">查看评论图片（{{root.images.length}} 张）</button><template wx:if="{{identityOverlay.developerEnabled}}" is="identity-overlay" data="{{identity:identityOverlay.items[root.id]}}" /><view class="meta">{{root.likeCount}} 赞 · {{root.replyCount}} 条回复</view><button wx:if="{{!root.viewer.isSelf}}" bindtap="onReportRoot" disabled="{{busy || report.busy || report.frozen}}">举报此内容</button><button wx:if="{{!root.viewer.isSelf}}" data-kind="comment" data-id="{{root.id}}" bindtap="onPrivateMessage" disabled="{{busy || needsReload || block.busy || block.frozen}}">{{root.author.kind === 'anonymous' ? '以本帖分身私信' : '以公开身份私信'}}</button><navigator class="link" url="/pages/report-progress/report-progress?kind=comment&amp;id={{root.id}}">举报进度 →</navigator><button wx:if="{{root.author.kind === 'named' &amp;&amp; !root.viewer.isSelf}}" bindtap="onBlockRoot" disabled="{{busy || block.busy || block.frozen}}">拉黑此公开身份作者</button><button bindtap="onLikeRoot" disabled="{{busy || interaction.busy || interaction.frozen}}">{{root.viewer.isLiked ? '取消点赞' : '点赞根评论'}}</button><button wx:if="{{root.viewer.canPin}}" bindtap="onPinRoot" disabled="{{busy || interaction.busy || interaction.frozen}}">{{root.isPinned ? '取消置顶' : '置顶根评论'}}</button><navigator wx:if="{{post.viewer.canComment}}" class="link" url="/pages/community-compose/community-compose?postId={{post.id}}&amp;rootCommentId={{root.id}}">回复 {{root.author.displayName}} →</navigator><view class="notice">每帖只能置顶一条根评论。更换前须先取消原置顶；仅帖子作者可操作。</view></view>
<view wx:if="{{contextReplies.length}}" class="card"><view class="section-title">定位到的回复</view><view class="notice">此回复单独定位，不会跳过前面的回复或改变下方分页位置</view><view wx:for="{{contextReplies}}" wx:key="id"><template is="reply-row" data="{{reply:item,post,root,busy,needsReload,block,report,interaction,identityOverlay,requestedReplyId,experienceColorStyles}}" /></view></view>
<view wx:if="{{loaded}}" class="card"><view class="section-title">全部回复 · 时间从早到晚</view><view wx:if="{{!replies.length}}" class="empty">暂无可查看的回复</view><view wx:for="{{replies}}" wx:key="id"><view class="divider"></view><template is="reply-row" data="{{reply:item,post,root,busy,needsReload,block,report,interaction,identityOverlay,requestedReplyId,experienceColorStyles}}" /></view><button wx:if="{{canLoadMore}}" bindtap="onMore" disabled="{{busy}}">加载更多回复</button></view>
<view wx:if="{{deleteReplyId}}" class="confirm"><view class="section-title">确认删除自己的回复？</view><view class="notice">其他回复仍保留。停止等待不代表撤销删除；结果未知时请重新加载。</view><button class="danger" bindtap="onConfirmDelete" disabled="{{busy}}">确认删除</button><button bindtap="onDismissDelete" disabled="{{busy}}">保留回复</button></view>
<view wx:if="{{post &amp;&amp; post.author.kind === 'named' &amp;&amp; !post.viewer.isSelf}}" class="card"><view class="author">帖子作者：<text wx:if="{{post.author.kind === 'named'}}" class="link" data-kind="post" data-id="{{post.id}}" bindtap="onAuthor">{{post.author.displayName}} →</text><text wx:else>{{post.author.displayName}}</text><template wx:if="{{post.author.kind === 'named'}}" is="public-experience-display" data="{{display:post.author.experienceDisplay,colors:experienceColorStyles}}" /></view><button bindtap="onBlockPost" disabled="{{busy || needsReload || block.busy || block.frozen}}">拉黑此公开身份帖子作者</button></view><view wx:if="{{post}}" class="card"><button wx:if="{{post.images.length}}" class="secondary" data-kind="post" data-id="{{post.id}}" bindtap="onSelectGallery" disabled="{{busy || needsReload || block.busy || block.frozen || report.busy || report.frozen || interaction.busy || interaction.frozen}}">查看帖子图片（{{post.images.length}} 张）</button><button wx:if="{{!post.viewer.isSelf}}" bindtap="onReportPost" disabled="{{busy || report.busy || report.frozen}}">举报帖子</button><button wx:if="{{!post.viewer.isSelf}}" data-kind="post" data-id="{{post.id}}" bindtap="onPrivateMessage" disabled="{{busy || needsReload || block.busy || block.frozen}}">{{post.author.kind === 'anonymous' ? '以本帖分身私信' : '以公开身份私信'}}</button><button wx:if="{{!post.viewer.isSelf &amp;&amp; post.author.kind === 'named' &amp;&amp; post.allowAnonymousDm}}" data-kind="post" data-id="{{post.id}}" data-mode="anonymous" bindtap="onPrivateMessage" disabled="{{busy || needsReload || block.busy || block.frozen}}">以本帖分身私信此作者</button><navigator class="link" url="/pages/report-progress/report-progress?kind=post&amp;id={{post.id}}">帖子举报进度与陪审 →</navigator></view><navigator wx:if="{{post}}" class="link" url="/pages/community-detail/community-detail?postId={{post.id}}&amp;rootCommentId={{root.id}}">回到帖子与根评论 →</navigator><navigator class="link" url="/pages/community-mine/community-mine">我的发布与恢复 →</navigator><navigator wx:if="{{!hasSession}}" class="link" url="/pages/login/login">登录后继续</navigator>
  <view wx:if="{{mediaGallery.groupId}}" class="private-gallery-backdrop" bindtap="onGalleryDismiss" catchtouchmove="onGalleryTouchMove"></view>
  <view wx:if="{{mediaGallery.groupId}}" class="private-gallery-panel" aria-role="dialog" aria-label="{{mediaGallery.title}}" catchtouchmove="onGalleryTouchMove">
    <view class="section-title">{{mediaGallery.title}}{{mediaGallery.total ? ' · ' + mediaGallery.total + ' 张' : ''}}</view>
    <button bindtap="onGalleryDismiss">关闭并清除图片</button>
    <scroll-view scroll-y="{{true}}" class="private-gallery-content">
      <view wx:for="{{mediaGallery.slots}}" wx:key="index" class="private-gallery-slot {{mediaGallery.expanded ? 'private-gallery-slot-expanded' : ''}}">
        <image wx:if="{{item.status === 'ready' &amp;&amp; item.localSrc}}" src="{{item.localSrc}}" data-index="{{item.index}}" data-src="{{item.localSrc}}" data-view-id="{{item.viewId}}" mode="widthFix" class="{{mediaGallery.expanded ? 'private-image-expanded' : 'private-gallery-thumb'}}" bindtap="onGalleryOpen" binderror="onGalleryError" show-menu-by-longpress="{{false}}" />
        <view wx:else class="notice">第 {{item.index + 1}} 张：{{item.status === 'loading' ? '正在安全读取' : '暂不可用'}}</view>
        <button wx:if="{{item.status === 'unavailable'}}" data-index="{{item.index}}" bindtap="onGalleryRetry">重试此图</button>
      </view>
      <view wx:if="{{mediaGallery.status === 'unavailable'}}" class="notice">图片暂不可用，请关闭图片并重新加载当前讨论</view>
    </scroll-view>
    <view wx:if="{{mediaGallery.expanded}}" class="chips">
      <button data-index="{{mediaGallery.selected - 1}}" bindtap="onGalleryOpen" disabled="{{mediaGallery.selected === 0}}">上一张</button>
      <button data-index="{{mediaGallery.selected + 1}}" bindtap="onGalleryOpen" disabled="{{mediaGallery.selected + 1 >= mediaGallery.total}}">下一张</button>
      <button bindtap="onGalleryClose">返回缩略图</button>
    </view>
    <view wx:elif="{{mediaGallery.total > 3}}" class="chips">
      <button data-start="{{mediaGallery.start - 3}}" bindtap="onGalleryWindow" disabled="{{mediaGallery.start < 3}}">上一组</button>
      <button data-start="{{mediaGallery.start + 3}}" bindtap="onGalleryWindow" disabled="{{mediaGallery.start + 3 >= mediaGallery.total}}">下一组</button>
    </view>
    <view class="notice">仅保留当前选中的一组图片；关闭、刷新或离开页面会清除显示。</view>
  </view>
</view>
