<import src="../../experience/public-display.wxml" />
<import src="../../identity-privacy/view.wxml" />
<view class="notice-page f7-ios-theme f7-notifications-page">
  <view class="notice-toolbar">
    <view wx:if="{{loaded}}" class="notice-count">
      {{unreadCount}} 条未读
    </view>
    <wu-f7-button class="notice-icon-button" disabled="{{busy}}" loading="{{busy}}" aria-label="刷新帖子互动" bind:press="onReload">
      <wu-icon name="refresh" size="21" />
    </wu-f7-button>
  </view>
  <view wx:if="{{uiStatus}}" class="notice-state" aria-role="status">
    {{uiStatus}}
  </view>
  <view wx:if="{{error}}" class="notice-state notice-error" aria-role="alert">
    {{error}}
  </view>
  <view wx:if="{{identityOverlay.notice}}" class="notice-state">
    {{identityOverlay.notice}}
  </view>
  <wu-f7-button wx:if="{{busy}}" class="notice-secondary" bind:press="onCancel">
    停止等待
  </wu-f7-button>
  <navigator wx:if="{{!hasSession}}" class="notice-action" url="/pages/login/login">
    登录后查看
  </navigator>
  <wu-f7-list spacing="compact" class="notice-list">
    <view wx:for="{{items}}" wx:key="noticeId" class="notice-event">
      <view class="notice-symbol">
        <wu-icon name="reply" tone="accent" size="23" />
        <view wx:if="{{!item.readAt}}" class="notice-unread" aria-label="未读" />
      </view>
      <view class="notice-content">
        <block wx:if="{{item.status === 'available'}}">
          <view class="notice-byline">
            <text class="notice-author">
              {{item.preview.author.displayName}}
            </text>
            <template wx:if="{{item.preview.author.kind === 'named'}}" is="public-experience-display" data="{{display:item.preview.author.experienceDisplay,colors:experienceColorStyles}}" />
            <text class="notice-identity">
              {{item.preview.author.kind === 'anonymous' ? '分身' : '公开身份'}}
            </text>
          </view>
          <view class="notice-context">
            {{item.reason === 'saved' ? '收藏的帖子有新回复' : item.kind === 'root' ? '回复了你的主题' : '回复了你的回复'}}
          </view>
          <view class="notice-body">
            {{item.preview.text}}
          </view>
          <template wx:if="{{identityOverlay.developerEnabled}}" is="identity-overlay" data="{{identity:identityOverlay.items[item.target.replyId || item.target.commentId]}}" />
          <view wx:if="{{item.preview.images.length}}" class="notice-hint">
            图片暂不可查看
          </view>
        </block>
        <view class="notice-state" wx:else>
          这条回复暂不可查看
        </view>
        <view class="notice-time">
          {{item.timeLabel}} · {{item.readAt ? '已读' : '未读'}}
        </view>
        <view class="notice-actions">
          <block wx:if="{{item.status === 'available'}}">
            <wu-f7-button class="notice-action" data-id="{{item.noticeId}}" disabled="{{busy}}" bind:press="onOpen">
              查看回复
              <wu-icon name="chevron-right" tone="accent" size="14" />
            </wu-f7-button>
          </block>
          <wu-f7-button wx:if="{{!item.readAt}}" class="notice-read" data-id="{{item.noticeId}}" disabled="{{busy}}" bind:press="onRead">
            标为已读
          </wu-f7-button>
        </view>
      </view>
    </view>
  </wu-f7-list>
  <wu-f7-block wx:if="{{loaded &amp;&amp; !items.length}}" class="notice-empty" spacing="compact">
    <view class="notice-empty-content">
      <wu-icon name="message" tone="muted" size="34" />
      <text class="notice-empty-title">
        还没有帖子互动
      </text>
      <text class="notice-empty-detail">
        新的回复会显示在这里
      </text>
    </view>
  </wu-f7-block>
  <wu-f7-button wx:if="{{canLoadMore}}" class="notice-action" disabled="{{busy}}" bind:press="onMore">
    查看更多
  </wu-f7-button>
  <wu-f7-block class="notice-footer" spacing="compact">
    <view class="notice-footer-content">
      <view class="notice-hint">
        查看回复不会自动标为已读。
      </view>
      <view class="notice-links">
        <navigator class="notice-secondary" url="/pages/community-saved/community-saved">
          我的收藏
        </navigator>
        <navigator class="notice-secondary" url="/pages/community-feed/community-feed">
          浏览帖子
        </navigator>
        <navigator class="notice-secondary" url="/pages/major-discussion-notices/major-discussion-notices">
          专业互动
        </navigator>
        <navigator class="notice-secondary" url="/pages/window-discussion-notices/window-discussion-notices">
          食堂互动
        </navigator>
        <navigator class="notice-secondary" url="/pages/rating-updates/rating-updates">
          评分互动
        </navigator>
      </view>
    </view>
  </wu-f7-block>
</view>
