@import '../../community/forms.wxss';
page { background: var(--wu-surface); }
.screen { min-height: 100vh; padding: 24rpx 32rpx calc(64rpx + env(safe-area-inset-bottom)); background: var(--wu-surface); }
.entry-heading { font-size: 36rpx; font-weight: 600; padding: 16rpx 0 28rpx; }
.card { border: 0; border-radius: 0; padding: 0; margin-top: 30rpx; }
.section-title { color: var(--wu-secondary); font-size: 25rpx; font-weight: 400; margin: 0 0 8rpx; }
.choice { display: flex; align-items: center; justify-content: space-between; width: 100%; min-height: 100rpx; margin: 0; padding: 22rpx 0; text-align: left; font-size: 30rpx; font-weight: 400; line-height: 1.5; color: var(--wu-text); background: transparent; border-radius: 0; border-bottom: 1rpx solid var(--wu-separator); }
.choice::after, button::after { border: 0; }
.choice.active { color: var(--wu-text); font-weight: 600; }
.choice[disabled] { background: transparent; color: var(--wu-secondary); }
.destination { margin: 36rpx 0 16rpx; font-size: 24rpx; color: var(--wu-secondary); text-align: center; }
button.primary { margin-top: 24rpx; min-height: 88rpx; line-height: 88rpx; border-radius: 44rpx; font-size: 30rpx; }
button.secondary { background: transparent; color: var(--wu-secondary); font-size: 26rpx; }

@import '../community-compose/framework7-composer.wxss';
