<view class="screen course-product f7-ios-theme f7-course-product has-dock">
  <view class="product-heading product-toolbar"
    ><wu-f7-button
      class="plain-button"
      data-panel="info"
      bind:press="onTogglePanel"
      aria-label="课程回复说明"
      variant="plain"
    >
      <wu-icon name="more" size="20" /> </wu-f7-button
  ></view>
  <view wx:if="{{uiPanel === 'info'}}" class="product-disclosure"
    ><view class="meta">回复不展示作者身份。每条回复只能赞一次，不能取消。</view
    ><navigator
      wx:if="{{courseId}}"
      class="link"
      url="/pages/course-rating-detail/course-rating-detail?courseId={{courseId}}"
      >课程详情</navigator
    ><navigator class="link" url="/pages/course-ratings/course-ratings"
      >课程目录</navigator
    ></view
  >
  <wu-f7-block spacing="compact">
    <view wx:if="{{!loaded || busy}}" class="status">{{status}}</view
    ><view wx:if="{{error}}" class="notice error">{{error}}</view
    ><view wx:if="{{receiptStatus}}" class="notice">{{receiptStatus}}</view>
    <navigator wx:if="{{!hasSession}}" class="link" url="/pages/login/login"
      >登录后查看回复</navigator
    >
  </wu-f7-block>
  <view class="product-toolbar"
    ><wu-f7-button
      class="plain-button"
      wx:if="{{hasSession}}"
      bind:press="onRefresh"
      disabled="{{busy}}"
      variant="plain"
    >
      刷新</wu-f7-button
    ><wu-f7-button
      class="plain-button"
      wx:if="{{busy}}"
      bind:press="onCancelWait"
      variant="plain"
    >
      停止等待
    </wu-f7-button></view
  >
  <view wx:if="{{frozen}}" class="product-recovery">
    <view class="section-title">上次操作结果待确认</view
    ><view class="notice"
      >请查询或重试原请求。退出页面不会取消已发送的操作。</view
    >
    <view wx:if="{{recoveryCourseId}}" class="meta"
      >原课程：{{recoveryCourseId}}</view
    >
    <block wx:if="{{recoveryOperation === 'course.comment.publish.v1'}}"
      ><text class="comment-body" selectable="{{true}}"
        >{{recoveryBody}}</text
      ></block
    >
    <view
      wx:if="{{recoveryOperation === 'course.comment.like.v1'}}"
      class="meta"
      >原点赞回复：{{recoveryCommentId}}</view
    >
    <wu-f7-button bind:press="onRecover" disabled="{{busy}}" variant="tonal"
      >查询原回执</wu-f7-button
    ><wu-f7-button
      bind:press="onRetry"
      disabled="{{busy || confirming === 'cancel'}}"
      variant="tonal"
    >
      查询并重试</wu-f7-button
    ><wu-f7-button
      bind:press="onRequestCancellation"
      disabled="{{busy || confirming === 'cancel'}}"
      variant="tonal"
    >
      查询能否取消
    </wu-f7-button>
    <view wx:if="{{receiptMissing}}" class="notice"
      >暂未查到结果，不代表已取消。请保留原请求。</view
    >
  </view>
  <view wx:if="{{confirming === 'cancel'}}" class="modal-mask"
    ><view class="modal"
      ><view class="section-title">取消上次操作？</view
      ><view class="notice"
        >若操作已完成，将返回原结果，不会撤销。断网时仍保留原请求。</view
      ><wu-f7-button
        bind:press="onConfirmCancellation"
        disabled="{{busy}}"
        variant="tonal"
      >
        确认请求取消</wu-f7-button
      ><wu-f7-button
        bind:press="onCloseConfirmation"
        disabled="{{busy}}"
        variant="tonal"
      >
        保留原请求
      </wu-f7-button></view
    ></view
  >
  <block wx:if="{{courseId}}">
    <view class="product-tabs"
      ><wu-f7-button
        class="{{sort === 'likes' ? 'selected' : ''}}"
        data-sort="likes"
        bind:press="onSort"
        disabled="{{busy}}"
        variant="{{sort === 'likes' ? 'fill' : 'tonal'}}"
      >
        热门</wu-f7-button
      ><wu-f7-button
        class="{{sort === 'time' ? 'selected' : ''}}"
        data-sort="time"
        bind:press="onSort"
        disabled="{{busy}}"
        variant="{{sort === 'time' ? 'fill' : 'tonal'}}"
      >
        最新
      </wu-f7-button></view
    >
    <view wx:if="{{restartRequired}}" class="notice"
      >列表已更新，请刷新后继续。</view
    >
    <block wx:if="{{loaded}}">
      <view wx:if="{{items.length === 0}}" class="empty">还没有课程回复</view>
      <view wx:for="{{items}}" wx:key="id" class="product-comment"
        ><text class="comment-body" selectable="{{true}}">{{item.body}}</text
        ><view class="product-inline-actions"
          ><view class="meta">{{timeLabels[item.id]}}</view
          ><wu-f7-button
            class="plain-button"
            data-id="{{item.id}}"
            bind:press="onConfirmLike"
            disabled="{{busy || frozen || confirming}}"
            variant="plain"
          >
            赞 {{item.likes}}
          </wu-f7-button></view
        ></view
      >
      <wu-f7-button
        wx:if="{{canNext}}"
        bind:press="onNext"
        disabled="{{busy}}"
        variant="tonal"
      >
        加载下一页</wu-f7-button
      ><view wx:if="{{!canNext &amp;&amp; items.length}}" class="meta"
        >已显示全部回复</view
      >
      <view wx:if="{{!frozen}}">
        <view class="product-dock"
          ><wu-f7-button
            class="primary"
            data-panel="compose"
            bind:press="onTogglePanel"
            disabled="{{busy || confirming}}"
            variant="fill"
            size="large"
          >
            写回复
          </wu-f7-button></view
        >
        <view
          wx:if="{{uiPanel === 'compose' &amp;&amp; !confirming}}"
          class="modal-mask"
          ><view class="modal"
            ><view class="product-heading"
              ><view class="section-title">写回复</view
              ><wu-f7-button
                class="plain-button"
                bind:press="onClosePanel"
                variant="plain"
              >
                收起
              </wu-f7-button></view
            ><textarea
              class="comment-input"
              value="{{body}}"
              maxlength="8000"
              bindinput="onBody"
              disabled="{{busy || confirming}}"
              placeholder="分享你的上课体验"
            /><view class="meta">{{bodyBytes}} / 8000 字节 · 按原文提交</view
            ><wu-f7-button
              class="primary"
              bind:press="onConfirmPublish"
              disabled="{{busy || !canPublish || confirming}}"
              variant="fill"
              size="large"
            >
              核对回复
            </wu-f7-button></view
          ></view
        >
      </view>
    </block>
  </block>
  <view wx:if="{{confirming === 'publish'}}" class="modal-mask"
    ><view class="modal"
      ><view class="section-title">确认发表</view
      ><text class="comment-body" selectable="{{true}}">{{body}}</text
      ><view class="notice">结果未确认前不能替换原文或重复提交。</view
      ><wu-f7-button
        class="primary"
        bind:press="onSubmit"
        disabled="{{busy || frozen}}"
        variant="fill"
        size="large"
      >
        确认发表</wu-f7-button
      ><wu-f7-button
        bind:press="onCloseConfirmation"
        disabled="{{busy}}"
        variant="tonal"
      >
        返回修改
      </wu-f7-button></view
    ></view
  >
  <view
    wx:if="{{confirming === 'like' &amp;&amp; selectedComment}}"
    class="modal-mask"
    ><view class="modal"
      ><view class="section-title">赞这条回复？</view
      ><text class="comment-body" selectable="{{true}}"
        >{{selectedComment.body}}</text
      ><view class="notice">点赞后不能取消，每条回复仅可赞一次。</view
      ><wu-f7-button
        class="primary"
        bind:press="onSubmit"
        disabled="{{busy || frozen}}"
        variant="fill"
        size="large"
      >
        确认点赞</wu-f7-button
      ><wu-f7-button
        bind:press="onCloseConfirmation"
        disabled="{{busy}}"
        variant="tonal"
      >
        返回回复
      </wu-f7-button></view
    ></view
  >
</view>
