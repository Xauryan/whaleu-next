<import src="../../course-ratings/framework7-product.wxml" />
<view class="screen course-product f7-ios-theme f7-course-product has-dock">
  <view class="product-heading product-toolbar"
    ><wu-f7-button
      class="plain-button"
      data-panel="info"
      bind:press="onTogglePanel"
      aria-label="课程信息"
      variant="plain"
    >
      <wu-icon name="more" size="20" /> </wu-f7-button
  ></view>
  <wu-f7-block class="product-state" spacing="compact"
    ><template
      is="product-course-status"
      data="{{status,error,receiptStatus,hasSession,frozen,recoveryCourseId,recoveryScores,busy,restartRequired,loaded}}"
  /></wu-f7-block>
  <block wx:if="{{loaded &amp;&amp; detail}}">
    <view class="product-hero"
      ><view class="title">{{detail.course.name}}</view
      ><view class="meta"
        >{{detail.course.campusLabel}} · 院系 {{detail.course.department}}</view
      ><view
        wx:if="{{detail.course.category !== null || detail.course.nature !== null}}"
        class="meta"
        ><text wx:if="{{detail.course.category !== null}}"
          >{{detail.course.category}}</text
        ><text wx:if="{{detail.course.nature !== null}}">
          · {{detail.course.nature}}</text
        ></view
      ><template
        is="product-course-summary"
        data="{{summary:detail.course.summary}}"
    /></view>
    <view wx:if="{{uiPanel === 'info'}}" class="product-disclosure"
      ><view class="section-title">课程信息</view
      ><view class="meta"
        >课程代码：{{detail.course.code === null ? '未提供' :
        detail.course.code}}</view
      ><view class="meta">来源校区：{{detail.course.sourceCampusKey}}</view
      ><view class="meta">目录版本：{{detail.catalogRevision}}</view
      ><view class="meta">以上为目录信息，不代表评分权限。</view></view
    >
    <view class="product-section">
      <view class="section-title">我的评分</view>
      <view
        wx:if="{{frozen &amp;&amp; (!recoveryCourseId || recoveryCourseId === detail.course.id)}}"
        class="notice"
        >上次评分结果待确认，请先查询。</view
      >
      <block wx:elif="{{detail.myScore.kind === 'recorded'}}"
        ><view class="product-score-grid"
          ><view class="product-score-axis"
            ><view class="value">{{detail.myScore.gradeScore}}</view
            ><view class="label">得分</view></view
          ><view class="product-score-axis"
            ><view class="value">{{detail.myScore.abilityScore}}</view
            ><view class="label">能力</view></view
          ><view class="product-score-axis"
            ><view class="value">{{detail.myScore.overallScore}}</view
            ><view class="label">综合</view></view
          ></view
        ><view class="meta">已提交，首次评分不能修改或删除。</view></block
      >
      <view wx:elif="{{detail.myScore.kind === 'unavailable'}}" class="notice"
        >暂未确认你的历史评分，请稍后重试。</view
      >
      <view wx:else class="meta">还没有为这门课评分</view>
      <view wx:if="{{blocker}}" class="notice">{{blocker}}</view>
    </view>
    <navigator
      class="link"
      url="/pages/course-comments/course-comments?courseId={{detail.course.id}}"
      ><view class="product-section-heading"
        ><view class="section-title">课程回复</view
        ><wu-icon name="chevron-right" size="20" /></view
      ><view class="meta">看看大家的上课体验</view></navigator
    >
    <view wx:if="{{canScore}}" class="product-dock"
      ><view class="meta">每门课仅一次</view
      ><wu-f7-button
        class="primary"
        data-panel="score"
        bind:press="onTogglePanel"
        disabled="{{busy || frozen}}"
        variant="fill"
        size="large"
      >
        为课程评分
      </wu-f7-button></view
    >
    <view wx:if="{{canScore}}"
      ><view
        wx:if="{{uiPanel === 'score' &amp;&amp; !confirming}}"
        class="modal-mask"
        ><view class="modal">
          <view class="product-heading"
            ><view class="section-title">{{detail.course.name}}</view
            ><wu-f7-button
              class="plain-button"
              bind:press="onClosePanel"
              variant="plain"
            >
              收起
            </wu-f7-button></view
          >
          <view class="meta">三个维度分别评分，提交后不能修改或删除。</view>
          <view class="section-title"
            >得分 · {{gradeScore === null ? '请选择' : gradeScore}}</view
          ><view class="course-scores"
            ><wu-f7-button
              wx:for="{{scores}}"
              wx:key="*this"
              data-axis="gradeScore"
              data-score="{{item}}"
              class="{{gradeScore === item ? 'score-selected' : ''}}"
              bind:press="onScore"
              disabled="{{busy || confirming}}"
              variant="{{gradeScore === item ? 'fill' : 'tonal'}}"
            >
              {{item}}
            </wu-f7-button></view
          >
          <view class="section-title"
            >能力 · {{abilityScore === null ? '请选择' : abilityScore}}</view
          ><view class="course-scores"
            ><wu-f7-button
              wx:for="{{scores}}"
              wx:key="*this"
              data-axis="abilityScore"
              data-score="{{item}}"
              class="{{abilityScore === item ? 'score-selected' : ''}}"
              bind:press="onScore"
              disabled="{{busy || confirming}}"
              variant="{{abilityScore === item ? 'fill' : 'tonal'}}"
            >
              {{item}}
            </wu-f7-button></view
          >
          <view class="section-title"
            >综合 · {{overallScore === null ? '请选择' : overallScore}}</view
          ><view class="course-scores"
            ><wu-f7-button
              wx:for="{{scores}}"
              wx:key="*this"
              data-axis="overallScore"
              data-score="{{item}}"
              class="{{overallScore === item ? 'score-selected' : ''}}"
              bind:press="onScore"
              disabled="{{busy || confirming}}"
              variant="{{overallScore === item ? 'fill' : 'tonal'}}"
            >
              {{item}}
            </wu-f7-button></view
          >
          <wu-f7-button
            class="primary"
            bind:press="onConfirm"
            disabled="{{busy || !canSubmit || confirming}}"
            variant="fill"
            size="large"
          >
            核对评分
          </wu-f7-button>
        </view></view
      ></view
    >
    <view wx:if="{{confirming}}" class="modal-mask"
      ><view class="modal"
        ><view class="section-title">确认首次评分</view
        ><view class="body">{{detail.course.name}}</view
        ><view class="product-score-grid"
          ><view class="product-score-axis"
            ><view class="value">{{gradeScore}}</view
            ><view class="label">得分</view></view
          ><view class="product-score-axis"
            ><view class="value">{{abilityScore}}</view
            ><view class="label">能力</view></view
          ><view class="product-score-axis"
            ><view class="value">{{overallScore}}</view
            ><view class="label">综合</view></view
          ></view
        ><view class="notice"
          >提交后不能修改或删除。若结果未确认，请查询或重试原请求。</view
        ><wu-f7-button
          class="primary"
          bind:press="onSubmit"
          disabled="{{busy || frozen}}"
          variant="fill"
          size="large"
        >
          确认提交</wu-f7-button
        ><wu-f7-button
          bind:press="onCloseConfirmation"
          disabled="{{busy || frozen}}"
          variant="tonal"
        >
          返回调整
        </wu-f7-button></view
      ></view
    >
  </block>
  <view class="product-end"
    ><navigator class="link" url="/pages/course-ratings/course-ratings"
      >课程目录</navigator
    ></view
  >
</view>
