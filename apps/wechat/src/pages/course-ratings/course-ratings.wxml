<import src="../../course-ratings/framework7-product.wxml" />
<view class="screen course-product f7-ios-theme f7-course-product">
  <view class="product-heading product-toolbar"
    ><wu-f7-button
      class="plain-button"
      data-panel="more"
      bind:press="onTogglePanel"
      aria-label="更多课程功能"
      variant="plain"
    >
      <wu-icon name="more" size="20" /> </wu-f7-button
  ></view>
  <view wx:if="{{uiPanel === 'more'}}" class="product-disclosure"
    ><navigator class="link" url="/pages/course-comments/course-comments"
      >查询上次回复操作</navigator
    ><view class="meta">每门课仅可评分一次，提交后不能修改或删除。</view></view
  >
  <view class="product-search"
    ><wu-f7-input
      class="course-field"
      value="{{searchDraft}}"
      maxlength="80"
      placeholder="搜索课程"
      bind:input="onSearchInput"
      bind:confirm="onSearch"
      disabled="{{busy}}"
    /><wu-f7-button bind:press="onSearch" disabled="{{busy}}" variant="tonal"
      >搜索</wu-f7-button
    ></view
  >
  <view class="product-section-heading"
    ><picker
      range="{{departmentLabels}}"
      value="{{departmentIndex}}"
      bindchange="onDepartment"
      disabled="{{busy}}"
      ><view class="filter-picker"
        >{{departmentLabels[departmentIndex]}}
        <wu-icon name="chevron-down" size="16" /></view></picker
    ><wu-f7-button
      class="plain-button"
      data-panel="filters"
      bind:press="onTogglePanel"
      variant="plain"
    >
      类别筛选
    </wu-f7-button></view
  >
  <view wx:if="{{uiPanel === 'filters'}}" class="product-disclosure"
    ><wu-f7-input
      class="course-field"
      value="{{categoryDraft}}"
      maxlength="80"
      placeholder="填写完整类别，回车查询"
      bind:input="onCategoryInput"
      bind:confirm="onSearch"
      disabled="{{busy}}"
    /><view class="meta">院系和类别可选其一；选择后会清空另一项。</view></view
  >
  <view class="product-tabs"
    ><wu-f7-button
      class="{{sortDraft === 'rating' ? 'selected' : ''}}"
      data-sort="rating"
      bind:press="onSort"
      disabled="{{busy}}"
      variant="{{sortDraft === 'rating' ? 'fill' : 'tonal'}}"
    >
      综合评分</wu-f7-button
    ><wu-f7-button
      class="{{sortDraft === 'time' ? 'selected' : ''}}"
      data-sort="time"
      bind:press="onSort"
      disabled="{{busy}}"
      variant="{{sortDraft === 'time' ? 'fill' : 'tonal'}}"
    >
      最新
    </wu-f7-button></view
  >
  <wu-f7-block class="product-state" spacing="compact"
    ><template
      is="product-course-status"
      data="{{status,error,receiptStatus,hasSession,frozen,recoveryCourseId,recoveryScores,busy,restartRequired,loaded}}"
  /></wu-f7-block>
  <block wx:if="{{loaded}}">
    <view wx:if="{{appliedFilter}}" class="meta">{{appliedFilter}}</view>
    <wu-f7-list spacing="compact">
      <view wx:for="{{items}}" wx:key="id" class="product-list-row">
        <wu-f7-list-item
          class="product-row-open"
          data-id="{{item.id}}"
          bind:press="onCourse"
          disabled="{{busy}}"
          link="{{true}}"
          title="{{item.name}}"
          aria-label="{{item.name}}"
        />
        <view class="meta"
          >{{item.campusLabel}} · 院系 {{item.department}}<text
            wx:if="{{item.category !== null}}"
          >
            · {{item.category}}</text
          ></view
        >
        <view
          wx:if="{{item.nature !== null || item.code !== null}}"
          class="meta"
          ><text wx:if="{{item.nature !== null}}">{{item.nature}}</text
          ><text wx:if="{{item.code !== null}}"> · {{item.code}}</text></view
        >
        <template is="product-course-summary" data="{{summary:item.summary}}" />
      </view>
    </wu-f7-list>
    <view wx:if="{{!items.length}}" class="empty"
      >没有找到课程，试试其他关键词</view
    >
    <wu-f7-button
      wx:if="{{canNext}}"
      bind:press="onNext"
      disabled="{{busy}}"
      variant="tonal"
    >
      加载下一页
    </wu-f7-button>
  </block>
</view>
