<view class="f7-forms-screen f7-ios-theme directory-detail-screen" wx:if="{{!managed}}">
  <wu-f7-block spacing="compact">
    <view wx:if="{{busy || !loaded}}" class="status" aria-role="status">{{status}}</view>
    <view wx:if="{{error}}" class="error" aria-role="alert">{{error}}</view>
    <navigator wx:if="{{!hasSession}}" class="login-link" url="/pages/login/login">
      登录后查看详情
      <wu-icon name="chevron-right" tone="accent" size="15" />
    </navigator>
    <view class="toolbar">
      <text class="scope-caption">已核验目录</text>
      <wu-f7-button class="icon-button" aria-label="重新核验并加载详情" disabled="{{busy}}" loading="{{busy}}" bind:press="onRefresh">
        <wu-icon name="refresh" size="19" />
      </wu-f7-button>
    </view>
    <wu-f7-button wx:if="{{busy}}" class="quiet-button" bind:press="onCancel">停止加载</wu-f7-button>
  </wu-f7-block>
  <block wx:if="{{loaded &amp;&amp; detail}}">
    <wu-f7-block class="directory-profile" spacing="compact" inset="{{true}}" strong="{{true}}">
      <view class="directory-symbol">
        <wu-icon name="{{detail.platform === 'official' ? 'post' : 'people'}}" tone="accent" size="34" />
      </view>
      <view class="directory-name">{{detail.name}}</view>
      <view class="entry-labels">
        {{directoryKindLabels[detail.kind]}} · {{directoryPlatformLabels[detail.platform]}}
        <text wx:if="{{detail.badge.status === 'known' &amp;&amp; detail.badge.value === 'official'}}" class="badge">官方推广</text>
        <text wx:elif="{{detail.badge.status === 'known' &amp;&amp; detail.badge.value === 'partner'}}" class="badge">合作推广</text>
        <text wx:elif="{{detail.badge.status === 'unavailable'}}">推广标记待确认</text>
      </view>
    </wu-f7-block>
    <wu-f7-block class="detail-section" spacing="compact" inset="{{true}}" strong="{{true}}" title="关于这里">
      <view class="directory-text">{{detail.introText || '暂无文字介绍'}}</view>
      <view wx:if="{{detail.introImages.status === 'unavailable'}}" class="media-state">
        <wu-icon name="image" size="17" />
        介绍图片暂不可用
      </view>
    </wu-f7-block>
    <wu-f7-block wx:if="{{detail.platform === 'qq'}}" class="contact-section qq-group-layout" spacing="compact" inset="{{true}}" strong="{{true}}" title="加入 QQ 群">
      <view class="contact-row">
        <view>
          <view class="meta">群号</view>
          <view wx:if="{{detail.qqGroupNumber.status === 'known'}}" class="contact-value">{{detail.qqGroupNumber.value === null ? '未提供' : detail.qqGroupNumber.value}}</view>
          <view class="notice" wx:else>群号暂不可确认</view>
        </view>
        <wu-f7-button wx:if="{{canCopy}}" class="compact-primary" disabled="{{busy || copyBusy || !canCopy}}" loading="{{copyBusy}}" bind:press="onCopyQq" variant="fill">复制群号</wu-f7-button>
      </view>
      <view class="media-state">
        <wu-icon name="scan" size="20" />
        入群二维码{{detail.mainQr.status === 'absent' ? '未提供' : '暂不可用'}}
      </view>
    </wu-f7-block>
    <wu-f7-block wx:elif="{{detail.platform === 'wechat'}}" class="contact-section wechat-group-layout" spacing="compact" inset="{{true}}" strong="{{true}}" title="加入微信群">
      <view class="media-state">
        <wu-icon name="scan" size="20" />
        入群二维码{{detail.mainQr.status === 'absent' ? '未提供' : '暂不可用'}}
      </view>
      <view class="media-state">
        <wu-icon name="person" size="20" />
        管理员微信二维码{{detail.managerWechatImage.status === 'absent' ? '未提供' : '暂不可用'}}
      </view>
    </wu-f7-block>
    <wu-f7-block wx:elif="{{detail.platform === 'official'}}" class="contact-section official-account-layout" spacing="compact" inset="{{true}}" strong="{{true}}" title="关注公众号">
      <view class="media-state">
        <wu-icon name="scan" size="20" />
        关注二维码{{detail.mainQr.status === 'absent' ? '未提供' : '暂不可用'}}
      </view>
    </wu-f7-block>
    <wu-f7-block class="reading-notes" spacing="compact" inset="{{true}}" strong="{{true}}">
      <wu-f7-button class="disclosure" bind:press="onToggleInfo">
        更多资料
        <wu-icon name="{{showInfo ? 'chevron-up' : 'chevron-down'}}" size="13" />
      </wu-f7-button>
      <view wx:if="{{showInfo}}">
        <view wx:if="{{detail.platform !== 'official'}}" class="media-state">关联公众号二维码：{{detail.linkedOfficialAccountQr.status === 'absent' ? '未提供' : '暂不可用'}}</view>
        <view class="meta">仅展示身份校区所在地区的已核验资料，浏览校园不改变访问范围。</view>
        <view class="meta">创建于 {{detail.createdAtLabel || '未知时间'}}</view>
        <view class="meta">更新于 {{detail.updatedAtLabel || '未知时间'}}</view>
        <view class="meta">头像{{detail.avatar.status === 'absent' ? '未提供' : '暂不可用'}}；访问次数、管理员资料和管理功能暂不可用。</view>
        <view wx:if="{{detail.badge.status === 'known' &amp;&amp; detail.badge.value === 'official'}}" class="meta">官方推广标记不改变条目平台，也不代表已证明机构所有权。</view>
      </view>
    </wu-f7-block>
  </block>
  <wu-f7-block spacing="compact">
    <navigator class="utility-row" url="/pages/identity-campus/identity-campus">
      <wu-icon name="location" size="20" />
      <text>查看或选择身份校区</text>
      <wu-icon name="chevron-right" size="14" />
    </navigator>
    <navigator class="back-link" url="/pages/directory-hub/directory-hub?kind={{kind}}">返回校园目录</navigator>
  </wu-f7-block>
</view>
<view class="f7-forms-screen f7-ios-theme directory-detail-screen" wx:if="{{managed}}">
  <wu-f7-block spacing="compact">
    <view class="toolbar">
      <text class="scope-caption">本平台审核通过</text>
      <wu-f7-button class="icon-button" aria-label="重新核验并加载" disabled="{{nativeDetail.busy}}" loading="{{nativeDetail.busy}}" bind:press="onRefresh">
        <wu-icon name="refresh" size="19" />
      </wu-f7-button>
    </view>
    <view wx:if="{{error}}" class="error" aria-role="alert">{{error}}</view>
    <view wx:if="{{nativeDetail.error}}" class="error" aria-role="alert">{{nativeDetail.error}}</view>
  </wu-f7-block>
  <view wx:if="{{nativeDetail.publicDetail}}">
    <wu-f7-block class="directory-profile" spacing="compact" inset="{{true}}" strong="{{true}}">
      <view class="directory-symbol">
        <wu-icon name="people" tone="accent" size="34" />
      </view>
      <view class="directory-name">{{nativeDetail.publicDetail.data.name}}</view>
      <view class="entry-labels">{{directoryPlatformLabels[nativeDetail.publicDetail.data.platform]}}</view>
    </wu-f7-block>
    <wu-f7-block class="detail-section" spacing="compact" inset="{{true}}" strong="{{true}}" title="关于这里">
      <view class="directory-text">{{nativeDetail.publicDetail.data.introText}}</view>
    </wu-f7-block>
    <wu-f7-block wx:if="{{nativeDetail.publicDetail.data.platform === 'qq'}}" class="contact-section" spacing="compact" inset="{{true}}" strong="{{true}}" title="加入 QQ 群">
      <view class="meta">群号</view>
      <view class="contact-value" user-select="true">{{nativeDetail.publicDetail.data.qqGroupNumber}}</view>
    </wu-f7-block>
    <navigator wx:if="{{nativeDetail.publicDetail.management.available}}" class="utility-row" url="/pages/organization-editor/organization-editor?id={{nativeDetail.id}}">
      <wu-icon name="edit" size="20" />
      <text>管理此组织</text>
      <wu-icon name="chevron-right" size="14" />
    </navigator>
  </view>
  <wu-f7-list wx:for="{{nativeDetail.slots}}" wx:key="slot" class="media-slot" spacing="compact" inset="{{true}}" strong="{{true}}" title="{{item.label}}">
    <wu-f7-list-item class="media-preview" data-slot="{{item.slot}}" bind:press="onNativePreview" link="{{true}}" media="{{true}}" title-slot="{{true}}" last="{{true}}" aria-label="{{item.label + &quot;，查看已审核图片&quot;}}">
      <wu-icon name="image" tone="accent" size="24" slot="media" />
      <text slot="title">查看已审核图片</text>
    </wu-f7-list-item>
  </wu-f7-list>
  <view wx:if="{{nativeImage.message}}" class="notice" aria-role="status">{{nativeImage.message}}</view>
  <wu-f7-block wx:if="{{nativeImage.src}}" class="image-reader" spacing="compact" inset="{{true}}" strong="{{true}}">
    <image src="{{nativeImage.src}}" mode="widthFix" />
    <wu-f7-button class="quiet-button" bind:press="onNativeClose">关闭图片</wu-f7-button>
  </wu-f7-block>
</view>
