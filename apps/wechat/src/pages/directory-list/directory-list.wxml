<import src="../../directory/common.wxml" />
<view class="screen">
  <view class="eyebrow">WHALEU · {{directoryKindLabels[kind]}}</view><view class="title">{{categoryId ? '分类目录' : '跨分类名称搜索'}}</view>
  <view class="card"><input value="{{inputDraft}}" bindinput="onInput" bindconfirm="onSubmit" maxlength="200" placeholder="按条目名称搜索，最多 100 字" />
    <button bindtap="onSubmit" disabled="{{!configured || !hasSession}}">搜索名称</button><button class="secondary" bindtap="onClear">清除搜索</button>
    <view wx:if="{{submittedQuery}}" class="meta">已提交：{{submittedQuery}}</view>
  </view>
  <template is="directory-feedback" data="{{status,error,hasSession}}" />
  <button bindtap="onRefresh" disabled="{{busy}}" loading="{{busy}}">{{restartRequired ? '重新加载首批结果' : '刷新结果'}}</button><button wx:if="{{busy}}" bindtap="onCancel">停止读取</button>
  <view wx:for="{{entries}}" wx:key="id" class="card">
    <view class="section-title">{{item.name}}</view><template is="directory-entry-labels" data="{{item,directoryPlatformLabels}}" />
    <view class="directory-text">{{item.introPreview}}</view><button class="secondary" bindtap="onEntry" data-id="{{item.id}}" disabled="{{busy}}">查看详情 →</button>
  </view>
  <view wx:if="{{loaded &amp;&amp; !entries.length &amp;&amp; pageNumber === 1}}" class="empty">{{submittedQuery ? '没有匹配的名称' : '当前分类暂无条目'}}</view>
  <view wx:if="{{loaded}}" class="pagination"><button bindtap="onPrevious" disabled="{{busy || !canPrevious}}">上一页</button><text>第 {{pageNumber}} 页</text><button bindtap="onNext" disabled="{{busy || !canNext}}">下一页</button></view>
  <navigator class="link" url="/pages/directory-hub/directory-hub?kind={{kind}}">返回目录首页 →</navigator>
</view>
