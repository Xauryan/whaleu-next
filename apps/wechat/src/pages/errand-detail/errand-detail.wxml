<import src="../../errands/f7-common.wxml" />
<view class="errand-page errand-detail f7-ios-theme"><view class="errand-toolbar"><navigator class="errand-toolbar-link" url="/pages/errand-mine/errand-mine">我的跑腿<wu-icon name="chevron-right" size="14" /></navigator></view><template is="errand-status" data="{{status,error,receiptStatus,frozen,recoveryOperation,busy,confirmedOrderId}}" /><view wx:if="{{loaded &amp;&amp; detail}}"><view class="errand-detail-heading"><view class="errand-order-status state-{{detail.state}}">{{errandStateLabels[detail.state]}}</view><view class="errand-detail-title">{{detail.title}}</view><view class="errand-detail-reward"><text class="errand-currency">¥</text>{{detail.reward}}<text class="errand-reward-caption">跑腿报酬</text></view><view class="errand-footnote">{{detail.relation === 'publisher' ? '我发布的订单' : detail.relation === 'accepter' ? '我接取的订单' : '双方线下结算'}}</view></view><wu-f7-list class="errand-detail-facts" strong="{{true}}" inset="{{true}}" spacing="compact"><wu-f7-list-item title-slot="{{true}}" last="{{false}}"><view slot="title" class="errand-fact"><wu-icon name="location" size="19" /><text>{{detail.targetRegion.label}}</text></view></wu-f7-list-item><wu-f7-list-item title-slot="{{true}}" last="{{true}}"><view slot="title" class="errand-fact"><wu-icon name="clock" size="19" /><text>{{detail.expectedTimeText}}</text></view></wu-f7-list-item></wu-f7-list><wu-f7-block class="errand-detail-section" strong="{{true}}" inset="{{true}}" spacing="compact"><view class="errand-section-title">任务说明</view><view class="errand-body">{{detail.publicText}}</view></wu-f7-block><wu-f7-block wx:if="{{detail.publicMedia &amp;&amp; detail.publicMedia.length}}" class="errand-detail-section" strong="{{true}}" inset="{{true}}" spacing="compact"><view class="errand-section-title">公开图片</view><view class="errand-image-links"><wu-f7-button wx:for="{{detail.publicMedia}}" wx:key="bindingId" class="errand-media-button" data-value="{{item.slot}}" disabled="{{orderImage.status === 'loading'}}" bind:press="onPreviewOrderImage" variant="tonal"><wu-icon name="image" size="24" /><text>图片 {{index + 1}}</text></wu-f7-button></view></wu-f7-block><wu-f7-block wx:if="{{detail.relation !== 'none'}}" class="errand-detail-section errand-private-section" strong="{{true}}" inset="{{true}}" spacing="compact"><view class="errand-private-heading"><wu-icon name="lock" size="18" /><view class="errand-section-title">双方私密说明</view></view><view class="errand-body">{{detail.privateText || '未填写私密说明'}}</view><view class="errand-footnote">仅双方可见，订单结束后仍保留。</view></wu-f7-block><wu-f7-block wx:if="{{detail.relation !== 'none' &amp;&amp; detail.privateMedia &amp;&amp; detail.privateMedia.length}}" class="errand-detail-section" strong="{{true}}" inset="{{true}}" spacing="compact"><view class="errand-private-heading"><wu-icon name="lock" size="18" /><view class="errand-section-title">双方私密图片</view></view><view class="errand-image-links"><wu-f7-button wx:for="{{detail.privateMedia}}" wx:key="bindingId" class="errand-media-button" data-value="{{item.slot}}" disabled="{{orderImage.status === 'loading'}}" bind:press="onPreviewOrderImage" variant="tonal"><wu-icon name="image" size="24" /><text>私密图片 {{index + 1}}</text></wu-f7-button></view></wu-f7-block><view wx:if="{{orderImage.status !== 'idle'}}" class="errand-media-view"><view class="errand-footnote">{{orderImage.message}}</view><image wx:if="{{orderImage.src}}" src="{{orderImage.src}}" mode="widthFix" class="order-image" /><wu-f7-button class="errand-text-button" bind:press="onCloseOrderImage">关闭图片</wu-f7-button></view><wu-f7-block wx:if="{{detail.state === 'accepted' &amp;&amp; detail.relation !== 'none' &amp;&amp; detail.oppositeContact}}" class="errand-detail-section" strong="{{true}}" inset="{{true}}" spacing="compact"><view class="errand-section-title">联系{{detail.relation === 'publisher' ? '接单者' : '发布者'}}</view><view class="errand-contact-name">{{detail.oppositeContact.display.status === 'available' ? detail.oppositeContact.display.displayName : '对方展示名称暂不可用'}}</view><view wx:if="{{detail.oppositeContact.contacts.wechat}}" class="errand-contact-line"><text>微信</text><text>{{detail.oppositeContact.contacts.wechat}}</text></view><view wx:if="{{detail.oppositeContact.contacts.phone}}" class="errand-contact-line"><text>电话</text><text>{{detail.oppositeContact.contacts.phone}}</text></view><view class="errand-footnote">由对方自行填写，未经认证；订单结束后隐藏。</view></wu-f7-block><view wx:if="{{detail.relation !== 'none' &amp;&amp; detail.state !== 'accepted'}}" class="errand-footnote">联系方式仅在订单进行中显示。</view><wu-f7-block wx:if="{{targetServices.visible}}" class="errand-detail-section" strong="{{true}}" inset="{{true}}" spacing="compact"><view class="errand-section-title">{{targetServices.regionName}}跑腿互助群</view><view wx:if="{{targetServices.name}}" class="errand-contact-name">{{targetServices.name}}</view><view wx:if="{{targetServices.description}}" class="errand-body">{{targetServices.description}}</view><view class="errand-footnote">{{targetServices.message}}</view><wu-f7-button wx:if="{{targetServices.canPreview}}" class="errand-text-button" disabled="{{targetServices.busy || targetQr.status === 'loading'}}" bind:press="onPreviewTargetQr">查看群二维码</wu-f7-button><wu-f7-button class="errand-text-button errand-muted" disabled="{{targetServices.busy}}" loading="{{targetServices.busy}}" bind:press="onDismissTargetNotice">不再显示跑腿群提示</wu-f7-button><view class="errand-footnote">可在偏好设置中重新开启。</view></wu-f7-block><view wx:if="{{targetServices.error}}" class="errand-error">{{targetServices.error}}</view><view wx:if="{{targetQr.status !== 'idle'}}" class="errand-media-view"><view class="errand-footnote">{{targetQr.message}}</view><image wx:if="{{targetQr.src}}" src="{{targetQr.src}}" mode="widthFix" class="target-qr" /><wu-f7-button class="errand-text-button" bind:press="onCloseTargetQr">关闭群二维码</wu-f7-button></view><wu-f7-block class="errand-detail-section" strong="{{true}}" inset="{{true}}" spacing="compact"><wu-f7-button class="errand-disclosure" data-field="details" bind:press="onTogglePanel"><text>订单信息</text><wu-icon name="{{uiPanels.details ? 'chevron-up' : 'chevron-down'}}" size="14" /></wu-f7-button><view wx:if="{{uiPanels.details}}" class="errand-order-history"><view>发布地区：{{detail.sourceRegion.label}}</view><view>范围：{{detail.scope === 'home' ? '本地区' : detail.scope === 'related' ? '关联地区' : '跨地区'}}</view><view>发布于 {{detailTimes.createdAt}}</view><view wx:if="{{detail.acceptedAt}}">接单于 {{detailTimes.acceptedAt}}</view><view wx:if="{{detail.completedAt}}">完成于 {{detailTimes.completedAt}}</view><view wx:if="{{detail.cancelledAt}}">取消于 {{detailTimes.cancelledAt}}</view></view><wu-f7-button wx:if="{{detail.capabilities.delete}}" class="errand-text-button errand-danger" data-action="delete" disabled="{{busy || frozen}}" bind:press="onConfirm" tone="danger">删除订单</wu-f7-button></wu-f7-block><view wx:if="{{detail.relation === 'accepter'}}" class="errand-footnote">只有发布者可以取消或确认完成，请先与发布者沟通。</view><view wx:if="{{detail.capabilities.accept || detail.capabilities.cancel || detail.capabilities.complete}}" class="errand-bottom-bar errand-detail-actions"><wu-f7-button wx:if="{{detail.capabilities.cancel}}" class="errand-secondary" data-action="cancel" disabled="{{busy || frozen}}" bind:press="onConfirm" variant="tonal">取消订单</wu-f7-button><wu-f7-button wx:if="{{detail.capabilities.accept}}" class="errand-primary" disabled="{{busy || frozen}}" bind:press="onAccept" variant="fill" size="large">接取此订单</wu-f7-button><wu-f7-button wx:if="{{detail.capabilities.complete}}" class="errand-primary" data-action="complete" disabled="{{busy || frozen}}" bind:press="onConfirm" variant="fill" size="large">确认完成</wu-f7-button></view></view><view wx:if="{{acceptModal}}" class="errand-modal-mask"><view class="errand-modal"><view class="errand-sheet-handle" /><view class="errand-sheet-title">确认接单</view><view class="errand-footnote">至少填写一种联系方式。接单后只有发布者可以取消或确认完成，请确认能够完成任务。</view><view class="errand-footnote">{{historyStatus}}</view><wu-f7-button class="errand-text-button" disabled="{{busy}}" bind:press="onToggleLast">{{useLast ? '清空上次信息' : '使用上次成功接单信息'}}</wu-f7-button><wu-f7-input data-field="wechat" value="{{contacts.wechat}}" maxlength="-1" placeholder="微信 · 最多50字" disabled="{{busy || frozen}}" bind:input="onContact" /><wu-f7-input data-field="phone" value="{{contacts.phone}}" type="number" maxlength="11" placeholder="电话 · 最多11位数字" disabled="{{busy || frozen}}" bind:input="onContact" /><wu-f7-button class="errand-primary" disabled="{{busy || frozen}}" bind:press="onConfirmAccept" variant="fill" size="large">确认接单</wu-f7-button><wu-f7-button class="errand-text-button errand-muted" bind:press="onCloseAccept">暂不接单并清空</wu-f7-button></view></view><view wx:if="{{confirmAction}}" class="errand-modal-mask"><view class="errand-modal"><view class="errand-sheet-handle" /><view class="errand-sheet-title">{{confirmAction === 'cancel' ? '取消这个订单？' : confirmAction === 'complete' ? '订单已完成？' : '删除这个订单？'}}</view><view wx:if="{{confirmAction === 'cancel' &amp;&amp; detail &amp;&amp; detail.state === 'accepted'}}" class="errand-footnote">已有接单者，请先与对方协商。取消后双方不再显示对方联系方式。</view><view wx:if="{{confirmAction === 'complete'}}" class="errand-footnote">请确认工作已经完成。完成后隐藏双方联系方式，不产生线上付款。</view><view wx:if="{{confirmAction === 'delete'}}" class="errand-footnote">删除后订单与私密说明将不再显示；历史状态和审计记录仍保留。</view><wu-f7-button class="errand-primary {{confirmAction === 'complete' ? '' : 'errand-destructive'}}" disabled="{{busy || frozen}}" bind:press="onConfirmCommand" variant="fill" size="large" tone="{{confirmAction === 'complete' ? 'default' : 'danger'}}">确认{{confirmAction === 'cancel' ? '取消' : confirmAction === 'complete' ? '完成' : '删除'}}</wu-f7-button><wu-f7-button class="errand-text-button errand-muted" disabled="{{busy}}" bind:press="onDismiss">返回</wu-f7-button></view></view></view>
