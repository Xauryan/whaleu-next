<import src="../../errands/f7-common.wxml" />
<view class="errand-page errand-market f7-ios-theme"><view class="errand-toolbar"><navigator class="errand-toolbar-link" url="/pages/errand-mine/errand-mine">我的跑腿<wu-icon name="chevron-right" size="14" /></navigator><navigator class="errand-icon-link" url="/pages/errand-notices/errand-notices" aria-label="跑腿通知"><wu-icon name="bell" size="22" /></navigator></view><template is="errand-campus" data="{{regionLabel,campusQuery,campuses,busy,frozen,configured,uiPanels}}" /><view class="errand-filterbar"><view class="errand-tabs"><wu-f7-button class="errand-tab {{filter === 'all' ? 'active' : ''}}" data-field="filter" data-value="all" disabled="{{busy}}" bind:press="onChoice" variant="{{filter === 'all' ? 'tonal' : 'plain'}}">全部订单</wu-f7-button><wu-f7-button class="errand-tab {{filter === 'pending' ? 'active' : ''}}" data-field="filter" data-value="pending" disabled="{{busy}}" bind:press="onChoice" variant="{{filter === 'pending' ? 'tonal' : 'plain'}}">待接单</wu-f7-button></view><wu-f7-button class="errand-sort-toggle" data-field="sort" disabled="{{busy}}" bind:press="onTogglePanel">{{sort === 'reward' ? '报酬' : '时间'}}<wu-icon name="{{direction === 'asc' ? 'chevron-up' : 'chevron-down'}}" size="12" /></wu-f7-button></view><view wx:if="{{uiPanels.sort}}" class="errand-sort-panel"><view class="errand-choice-row"><text>排序方式</text><wu-f7-button class="errand-choice {{sort === 'created' ? 'selected' : ''}}" data-field="sort" data-value="created" disabled="{{busy}}" bind:press="onChoice" variant="{{sort === 'created' ? 'tonal' : 'plain'}}">发布时间</wu-f7-button><wu-f7-button class="errand-choice {{sort === 'reward' ? 'selected' : ''}}" data-field="sort" data-value="reward" disabled="{{busy}}" bind:press="onChoice" variant="{{sort === 'reward' ? 'tonal' : 'plain'}}">报酬</wu-f7-button></view><view class="errand-choice-row"><text>排列顺序</text><wu-f7-button class="errand-choice {{direction === 'desc' ? 'selected' : ''}}" data-field="direction" data-value="desc" disabled="{{busy}}" bind:press="onChoice" variant="{{direction === 'desc' ? 'tonal' : 'plain'}}">{{sort === 'reward' ? '报酬从高到低' : '最新发布优先'}}</wu-f7-button><wu-f7-button class="errand-choice {{direction === 'asc' ? 'selected' : ''}}" data-field="direction" data-value="asc" disabled="{{busy}}" bind:press="onChoice" variant="{{direction === 'asc' ? 'tonal' : 'plain'}}">{{sort === 'reward' ? '报酬从低到高' : '最早发布优先'}}</wu-f7-button></view></view><view wx:if="{{discoveryMode === 'own_only'}}" class="errand-footnote">跨地区浏览，仅显示自己最近三天的订单。分享链接仍可查看其他订单。</view><view wx:if="{{discoveryMode === 'home'}}" class="errand-range-label">最近三天 · 已显示 {{items.length}} 个订单</view><template is="errand-status" data="{{status,error,receiptStatus,frozen,recoveryOperation,busy,confirmedOrderId}}" /><view class="errand-order-list"><wu-f7-list wx:for="{{items}}" wx:key="id" class="errand-order-card" strong="{{true}}" inset="{{true}}" spacing="compact"><template is="errand-summary" data="{{order:item,errandStateLabels}}" /><wu-f7-button class="errand-order-open" data-id="{{item.id}}" disabled="{{busy}}" bind:press="onOrder"><text>查看详情</text><wu-icon name="arrow-right" size="17" /></wu-f7-button></wu-f7-list></view><wu-f7-block wx:if="{{loaded &amp;&amp; !items.length}}" class="errand-empty" strong="{{true}}" inset="{{true}}" spacing="compact"><wu-icon name="bag" size="34" /><view>还没有相关跑腿</view><text>可以换个校园看看，或发布你的需求。</text></wu-f7-block><wu-f7-button wx:if="{{canMore}}" class="errand-text-button errand-load-more" disabled="{{busy}}" bind:press="onMore">加载更多</wu-f7-button><navigator wx:if="{{adminAvailable}}" class="errand-admin-link" url="/pages/errand-admin/errand-admin">跑腿管理</navigator><view wx:if="{{regionId}}" class="errand-bottom-bar"><wu-f7-button wx:if="{{regionId}}" class="errand-primary" disabled="{{busy || frozen}}" bind:press="onCompose" variant="fill" size="large"><wu-icon name="plus" size="19" tone="inverse" /><text>发布跑腿</text></wu-f7-button></view></view>
