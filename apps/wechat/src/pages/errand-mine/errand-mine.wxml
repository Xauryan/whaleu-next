<import src="../../errands/f7-common.wxml" />
<view class="errand-page errand-market errand-own f7-ios-theme"><view class="errand-toolbar"><navigator class="errand-toolbar-link" url="/pages/errand-list/errand-list"><wu-icon name="bag" size="20" />跑腿广场</navigator><navigator class="errand-icon-link" url="/pages/errand-notices/errand-notices" aria-label="跑腿通知"><wu-icon name="bell" size="22" /></navigator></view><view class="errand-segment"><wu-f7-button class="{{relation === 'published' ? 'active' : ''}}" data-field="relation" data-value="published" disabled="{{busy}}" bind:press="onChoice" variant="{{relation === 'published' ? 'tonal' : 'plain'}}">我发布的</wu-f7-button><wu-f7-button class="{{relation === 'accepted' ? 'active' : ''}}" data-field="relation" data-value="accepted" disabled="{{busy}}" bind:press="onChoice" variant="{{relation === 'accepted' ? 'tonal' : 'plain'}}">我接取的</wu-f7-button></view><view class="errand-range-label">全部地区与状态</view><template is="errand-status" data="{{status,error,receiptStatus,frozen,recoveryOperation,busy,confirmedOrderId}}" /><view class="errand-order-list"><wu-f7-list wx:for="{{items}}" wx:key="id" class="errand-order-card" strong="{{true}}" inset="{{true}}" spacing="compact"><template is="errand-summary" data="{{order:item,errandStateLabels}}" /><wu-f7-button class="errand-order-open" data-id="{{item.id}}" disabled="{{busy}}" bind:press="onOrder"><text>查看详情</text><wu-icon name="arrow-right" size="17" /></wu-f7-button></wu-f7-list></view><wu-f7-block wx:if="{{loaded &amp;&amp; !items.length}}" class="errand-empty" strong="{{true}}" inset="{{true}}" spacing="compact"><wu-icon name="bag" size="34" /><view>{{relation === 'published' ? '还没有发布过跑腿' : '还没有接取过跑腿'}}</view><text>你的订单会保存在这里。</text></wu-f7-block><wu-f7-button wx:if="{{canMore}}" class="errand-text-button errand-load-more" disabled="{{busy}}" bind:press="onMore">加载更多</wu-f7-button></view>
