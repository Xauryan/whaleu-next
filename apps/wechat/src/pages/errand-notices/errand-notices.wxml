<view class="errand-page errand-notices f7-ios-theme"><view class="errand-toolbar"><navigator class="errand-toolbar-link" url="/pages/errand-mine/errand-mine">我的跑腿<wu-icon name="chevron-right" size="14" /></navigator><wu-f7-button class="errand-icon-button" aria-label="刷新通知" disabled="{{busy}}" bind:press="onRefresh"><wu-icon name="refresh" size="20" /></wu-f7-button></view><view wx:if="{{status &amp;&amp; status !== '已加载本账号的跑腿通知' &amp;&amp; status !== '已到跑腿通知末尾'}}" class="errand-status" aria-role="status">{{status}}</view><view wx:if="{{error}}" class="errand-error">{{error}}</view><view wx:if="{{loaded}}" class="errand-range-label">{{unreadCount ? unreadCount + ' 条未读' : '全部已读'}}</view><wu-f7-button class="errand-text-button" wx:if="{{busy}}" bind:press="onCancel">停止等待</wu-f7-button><wu-f7-block wx:for="{{items}}" wx:key="noticeId" class="errand-notice-row" strong="{{true}}" inset="{{true}}" spacing="compact"><view class="errand-notice-content"><view class="errand-notice-icon"><wu-icon name="{{item.kind === 'completed' ? 'check' : item.kind === 'accepted' ? 'bag' : 'shield'}}" size="21" /><view wx:if="{{!item.readAt}}" class="errand-unread-dot" /></view><view class="errand-notice-copy"><view wx:if="{{item.kind === 'accepted'}}" class="errand-notice-title">你发布的跑腿已有人接单</view><view wx:elif="{{item.kind === 'completed'}}" class="errand-notice-title">你接取的跑腿已由发布者确认完成</view><block wx:elif="{{item.kind === 'admin_deleted'}}"><view class="errand-notice-title">你发布的跑腿已被管理员删除</view><view class="errand-notice-reference">订单编号：{{item.orderId}}</view><view wx:if="{{item.deletionReason.status === 'provided'}}" class="errand-notice-reason">删除原因：{{item.deletionReason.value}}</view><view wx:else>管理员未填写删除原因</view><view class="errand-footnote">订单不可查看时，仍保留此处理记录。</view></block><block wx:elif="{{item.kind === 'feature_restricted'}}"><view class="errand-notice-title">跑腿功能限制记录</view><view>限制操作：{{item.action === 'publish' ? '发布跑腿' : item.action === 'accept' ? '接取跑腿' : '发布与接取跑腿'}}</view><view>适用范围：所有地区</view><view class="errand-notice-reference">限制编号：{{item.restrictionId}}</view><view>开始时间：{{timeLabels[item.noticeId] ? timeLabels[item.noticeId].startsAt : '时间未知'}}</view><view wx:if="{{item.endsAt !== null}}">结束时间：{{timeLabels[item.noticeId] ? timeLabels[item.noticeId].endsAt : '时间未知'}}</view><view wx:else>期限：永久</view><view class="errand-notice-reason">限制原因：{{item.reason}}</view><view class="errand-footnote">以上为当时的处理记录，不代表当前状态。</view></block><block wx:elif="{{item.kind === 'feature_released'}}"><view class="errand-notice-title">一条跑腿功能限制已解除</view><view>本条解除的限制操作：{{item.action === 'publish' ? '发布跑腿' : item.action === 'accept' ? '接取跑腿' : '发布与接取跑腿'}}</view><view class="errand-notice-reference">解除的限制编号：{{item.restrictionId}}</view><view>解除时间：{{timeLabels[item.noticeId] ? timeLabels[item.noticeId].releasedAt : '时间未知'}}</view><view class="errand-notice-reason">解除原因：{{item.reason}}</view><view class="errand-footnote">仅解除这一条限制，其他限制仍可能生效。</view></block><view class="errand-notice-time">{{timeLabels[item.noticeId] ? timeLabels[item.noticeId].createdAt : '时间未知'}}</view><wu-f7-button class="errand-text-button" wx:if="{{item.kind === 'accepted' || item.kind === 'completed'}}" data-id="{{item.noticeId}}" disabled="{{busy}}" bind:press="onOrder">查看订单</wu-f7-button><wu-f7-button class="errand-text-button" wx:if="{{!item.readAt}}" data-id="{{item.noticeId}}" disabled="{{busy}}" bind:press="onRead">标记已读</wu-f7-button></view></view></wu-f7-block><wu-f7-block wx:if="{{loaded &amp;&amp; !items.length}}" class="errand-empty" strong="{{true}}" inset="{{true}}" spacing="compact">暂无跑腿通知</wu-f7-block><wu-f7-button class="errand-text-button" wx:if="{{canMore}}" disabled="{{busy}}" bind:press="onMore">加载更多</wu-f7-button></view>
