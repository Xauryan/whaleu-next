<import src="../../school-operations/f7-admin-command.wxml" />
<view class="screen ops-page ops-errand-restrictions f7-ios-theme ops-native">
  <view class="ops-context">
    <view class="ops-context-icon">
      <wu-icon name="shield" size="23" tone="accent" />
    </view>
    <view class="ops-context-title">
      功能限制记录
    </view>
  </view>
  <view class="notice">
    签发、记录、历史和解除均需当前全局管理员权限。功能限制对所有地区生效。
  </view>
  <view class="status" aria-role="status" wx:if="{{status}}">
    {{status}}
  </view>
  <view wx:if="{{error}}" class="error" aria-role="alert">
    {{error}}
  </view>
  <wu-f7-button bind:press="onRefresh" disabled="{{busy || adminCommand.busy}}" class="ops-quiet" variant="plain">
    重新核验权限与记录
  </wu-f7-button>
  <wu-f7-button wx:if="{{busy}}" bind:press="onCancel" class="ops-quiet" variant="plain">
    停止等待
  </wu-f7-button>
  <template is="errand-admin-command" data="{{command:adminCommand,durationLabels,actionLabels,actionOptions}}" />
  <view wx:if="{{access === 'global'}}">
    <wu-f7-button bind:press="onIssue" disabled="{{busy || !loaded || adminCommand.busy || adminCommand.frozen}}" class="ops-primary" variant="fill" size="large">
      签发新跑腿限制
    </wu-f7-button>
    <wu-f7-block wx:if="{{mode === 'list'}}" class="card ops-section" strong="{{true}}" inset="{{true}}" spacing="compact">
      <input value="{{profileDraft}}" bindinput="onProfile" bindconfirm="onSearch" maxlength="36" placeholder="目标公开资料 UUID，留空查看已记录范围" />
      <wu-f7-button bind:press="onSearch" disabled="{{busy || adminCommand.busy}}" variant="tonal">
        查询记录
      </wu-f7-button>
      <view class="chips">
        <wu-f7-button class="chip {{actionFilter === '' ? 'active' : ''}}" data-value="" bind:press="onActionFilter" variant="{{actionFilter === '' ? 'fill' : 'tonal'}}">
          全部动作
        </wu-f7-button>
        <wu-f7-button wx:for="{{actionOptions}}" wx:key="value" class="chip {{actionFilter === item.value ? 'active' : ''}} ops-choice" data-value="{{item.value}}" bind:press="onActionFilter" variant="{{actionFilter === item.value ? 'fill' : 'tonal'}}">
          {{item.label}}
        </wu-f7-button>
      </view>
      <view class="chips">
        <wu-f7-button wx:for="{{stateOptions}}" wx:key="value" class="chip {{stateFilter === item.value ? 'active' : ''}} ops-choice" data-value="{{item.value}}" bind:press="onState" variant="{{stateFilter === item.value ? 'fill' : 'tonal'}}">
          {{item.label}}
        </wu-f7-button>
      </view>
    </wu-f7-block>
    <wu-f7-button wx:if="{{mode === 'history'}}" bind:press="onBackToList" variant="tonal">
      返回记录列表并重新读取
    </wu-f7-button>
  </view>
  <view wx:if="{{loaded}}">
    <view wx:if="{{historyCoverage === 'unknown_before_boundary'}}" class="notice">
      这里只展示已记录的本地及已知基线事实。迁移边界之前的完整历史未知；没有记录不能解释为从未受限。
    </view>
    <view wx:if="{{mode === 'list'}}">
      <view wx:if="{{recordedTotal.status === 'known'}}" class="section-title">
        已记录结果精确总数：{{recordedTotal.value}}
      </view>
      <view class="notice" wx:else>
        已记录结果总数暂不可用。
      </view>
      <wu-f7-block wx:for="{{items}}" wx:key="restrictionId" class="card ops-section ops-restriction" strong="{{true}}" inset="{{true}}" spacing="compact">
        <view class="section-title">
          {{item.subject.status === 'available' ? item.subject.displayName : '公开资料暂不可用'}} · {{actionLabels[item.action]}}
        </view>
        <view class="meta">
          {{stateLabels[item.state]}} · {{item.origin === 'baseline' ? '已知基线' : '本地记录'}}
        </view>
        <wu-f7-button class="ops-disclosure" data-panel="{{'restriction:' + item.restrictionId}}" bind:press="onToggleUiPanel" aria-expanded="{{uiPanel === 'restriction:' + item.restrictionId}}" variant="plain">
          <text>
            记录来源与编号
          </text>
          <wu-icon name="{{uiPanel === 'restriction:' + item.restrictionId ? 'chevron-up' : 'chevron-down'}}" size="17" tone="muted" />
        </wu-f7-button>
        <view wx:if="{{uiPanel === 'restriction:' + item.restrictionId}}" class="ops-details">
          <view class="meta">
            限制编号：{{item.restrictionId}}
          </view>
          <view wx:if="{{item.subject.status === 'available'}}" class="meta">
            公开资料：{{item.subject.profileId}}
          </view>
          <view class="meta">
            记录时间：{{item.recordedAt}}
          </view>
          <view wx:if="{{item.terminal &amp;&amp; item.terminal.kind === 'baseline_released'}}" class="notice">
            基线已知解除时间：{{item.terminal.effectiveAt}}；原操作人与解除原因未知。
          </view>
          <view wx:if="{{item.terminal &amp;&amp; item.terminal.kind === 'manually_released'}}" class="meta">
            手动解除：{{item.terminal.effectiveAt}} · {{item.terminal.reason || '解除原因资料未知'}}
          </view>
          <view wx:if="{{item.terminal &amp;&amp; item.terminal.kind === 'superseded'}}" class="meta">
            由限制 {{item.terminal.replacementRestrictionId}} 替代 · {{item.terminal.effectiveAt}}
          </view>
          <view class="meta">
            操作人：{{item.operator.status === 'available' ? item.operator.displayName : item.operator.status === 'unknown' ? '原操作人未知' : '公开资料暂不可用'}}
          </view>
          <view class="meta">
            来源：{{item.source.kind === 'order' ? '订单 ' + item.source.orderId : item.source.kind === 'global' ? '全局签发' : '原来源未知'}}
          </view>
        </view>
        <view class="body">
          原因：{{item.reason}}
        </view>
        <view class="meta">
          起始：{{item.startsAt}} · {{item.endsAt ? '结束：' + item.endsAt : '永久限制'}}
        </view>
        <wu-f7-button data-id="{{item.restrictionId}}" bind:press="onHistory" disabled="{{busy || adminCommand.busy}}" variant="tonal">
          查看此项历史
        </wu-f7-button>
        <wu-f7-button wx:if="{{item.state === 'active'}}" data-id="{{item.restrictionId}}" bind:press="onRelease" disabled="{{busy || adminCommand.busy || adminCommand.frozen}}" class="ops-destructive" tone="danger" variant="tonal">
          仅解除此项限制
        </wu-f7-button>
      </wu-f7-block>
      <view wx:if="{{!items.length}}" class="empty">
        本页没有已记录的匹配项，完整历史仍未知{{continuation === 'more' ? '；可以继续查找' : '；已到本次记录查询末尾'}}。
      </view>
    </view>
    <view wx:if="{{mode === 'history' &amp;&amp; restriction}}">
      <wu-f7-block class="card ops-section" strong="{{true}}" inset="{{true}}" spacing="compact">
        <view class="section-title">
          此项{{actionLabels[restriction.action]}}限制
        </view>
        <view class="meta">
          {{restriction.restrictionId}} · {{stateLabels[restriction.state]}}
        </view>
        <view class="body">
          原限制原因：{{restriction.reason}}
        </view>
        <view class="meta">
          {{restriction.startsAt}} 至 {{restriction.endsAt || '永久'}}
        </view>
        <wu-f7-button wx:if="{{restriction.state === 'active'}}" data-id="{{restriction.restrictionId}}" bind:press="onRelease" disabled="{{busy || adminCommand.busy || adminCommand.frozen}}" class="ops-destructive" tone="danger" variant="tonal">
          仅解除此项限制
        </wu-f7-button>
      </wu-f7-block>
      <view wx:if="{{restriction.terminal &amp;&amp; restriction.terminal.kind === 'baseline_released'}}" class="notice">
        基线已知解除时间：{{restriction.terminal.effectiveAt}}；原操作人与解除原因未知。没有凭此补造历史事件。
      </view>
      <wu-f7-block wx:for="{{events}}" wx:key="eventId" class="card ops-section" strong="{{true}}" inset="{{true}}" spacing="compact">
        <view class="section-title">
          {{eventLabels[item.kind]}}
        </view>
        <view class="meta">
          生效时间：{{item.effectiveAt}}
        </view>
        <view class="meta">
          实际记录：{{item.recordedAt}}
        </view>
        <view wx:if="{{item.reason}}" class="body">
          原因：{{item.reason}}
        </view>
        <view class="meta">
          操作人：{{item.operator.status === 'available' ? item.operator.displayName : item.operator.status === 'unknown' ? '原操作人未知' : '公开资料暂不可用'}}
        </view>
        <view wx:if="{{item.replacementRestrictionId}}" class="meta">
          替代限制：{{item.replacementRestrictionId}}
        </view>
      </wu-f7-block>
      <view wx:if="{{!events.length}}" class="empty">
        本页没有已记录事件，原签发或更早历史仍未知。
      </view>
      <view wx:if="{{restriction.state === 'expired'}}" class="notice">
        已到原定结束时间。到期由时间推导，不代表管理员执行了解除。
      </view>
    </view>
    <view class="meta">
      第 {{pageNumber}} 页{{continuation === 'end' ? ' · 已到本次末尾' : ''}}
    </view>
    <wu-f7-button wx:if="{{canPrevious}}" bind:press="onPrevious" disabled="{{busy || adminCommand.busy}}" variant="tonal">
      上一页（重新核验）
    </wu-f7-button>
    <wu-f7-button wx:if="{{canNext}}" bind:press="onNext" disabled="{{busy || adminCommand.busy}}" variant="tonal">
      下一页（继续查找）
    </wu-f7-button>
  </view>
</view>
