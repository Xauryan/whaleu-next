<view class="experience-page f7-ios-theme personal-native">
  <view class="experience-header">
    <wu-f7-button wx:if="{{busy}}" class="experience-refresh" bind:press="onCancel" variant="plain">停止等待</wu-f7-button>
    <wu-f7-button class="experience-refresh" disabled="{{!hasSession || !configured}}" aria-label="{{appearanceDirty ? '刷新并放弃未保存的选择' : '刷新经验状态'}}" wx:else="" bind:press="onReload" variant="plain">
      <wu-icon name="refresh" tone="accent" size="21" />
      <text wx:if="{{appearanceDirty}}">放弃选择并刷新</text>
    </wu-f7-button>
  </view>
  <view wx:if="{{busy || !loaded}}" class="experience-status" aria-role="status">{{status}}</view>
  <view wx:if="{{error}}" class="experience-error" aria-role="alert">{{error}}</view>
  <view wx:if="{{receiptStatus}}" class="experience-note" aria-role="status">{{receiptStatus}}</view>
  <navigator wx:if="{{!hasSession}}" class="experience-link" url="/pages/login/login" open-type="reLaunch">
    登录后查看
    <wu-icon name="chevron-right" tone="accent" size="16" />
  </navigator>
  <wu-f7-block wx:if="{{signInPending}}" class="experience-recovery" strong="{{true}}" inset="{{true}}" spacing="compact">
    <view class="experience-section-title">签到结果待确认</view>
    <view class="experience-note">查询或重试会继续原签到，跨日也不会重复发起。</view>
    <wu-f7-button class="experience-text-button" data-operation="sign_in" disabled="{{busy}}" bind:press="onRecover" variant="plain">查询签到结果</wu-f7-button>
    <wu-f7-button class="experience-text-button" data-operation="sign_in" data-retry="{{true}}" disabled="{{busy}}" bind:press="onRecover" variant="plain">重试原签到</wu-f7-button>
  </wu-f7-block>
  <wu-f7-block wx:if="{{appearancePending}}" class="experience-recovery" strong="{{true}}" inset="{{true}}" spacing="compact">
    <view class="experience-section-title">头衔外观待确认</view>
    <wu-f7-button class="experience-text-button" data-operation="appearance" disabled="{{busy}}" bind:press="onRecover" variant="plain">查询保存结果</wu-f7-button>
    <wu-f7-button class="experience-text-button" data-operation="appearance" data-retry="{{true}}" disabled="{{busy}}" bind:press="onRecover" variant="plain">重试原保存</wu-f7-button>
  </wu-f7-block>
  <block wx:if="{{loaded}}">
    <wu-f7-block class="experience-summary" strong="{{true}}" inset="{{true}}" spacing="compact">
      <view class="experience-summary-top">
        <view>
          <view class="experience-caption">当前经验</view>
          <view class="experience-balance">{{balanceLabel}}</view>
        </view>
        <view wx:if="{{summary.level !== null}}" class="experience-level">Lv.{{summary.level}}</view>
      </view>
      <view class="experience-progress-label">{{progressLabel}}</view>
      <progress wx:if="{{summary.progress}}" percent="{{summary.progress.percent}}" activeColor="#007aff" stroke-width="4" border-radius="4" />
      <view class="experience-sign-in">
        <view>
          <view class="experience-sign-label">{{signInLabel}}</view>
          <view class="experience-day">{{summary.serverDay}} · {{summary.timezone}}</view>
        </view>
        <wu-f7-button class="experience-primary" disabled="{{busy || signInPending || summary.signIn.signedIn === true}}" bind:press="onSignIn" variant="fill">{{summary.signIn.signedIn === true ? '今日已签到' : '签到'}}</wu-f7-button>
      </view>
      <view wx:if="{{summary.pending.count &gt; 0}}" class="experience-note">还有 {{summary.pending.count}} 项经验变动待处理。{{summary.pending.reason === 'baseline_unknown' ? '历史基准尚未确认。' : '签到需等待此前的变动结算。'}}</view>
    </wu-f7-block>
    <view wx:for="{{unlocks}}" wx:key="noticeId" class="experience-unlock">
      <wu-icon name="star" tone="accent" size="25" />
      <view class="experience-unlock-content">
        <view class="experience-section-title">升至 Lv.{{item.toLevel}}</view>
        <view class="experience-note">Lv.{{item.fromLevel}} → Lv.{{item.toLevel}}</view>
        <view wx:if="{{item.titleLabel}}">新头衔 · {{item.titleLabel}}</view>
        <view wx:if="{{item.colorLabel}}">新颜色 · {{item.colorLabel}}</view>
      </view>
      <wu-f7-button class="experience-text-button" data-id="{{item.noticeId}}" disabled="{{busy}}" bind:press="onCloseUnlock" variant="plain">知道了</wu-f7-button>
    </view>
    <wu-f7-button wx:for="{{acknowledgementIds}}" wx:key="*this" class="experience-text-button" data-id="{{item}}" disabled="{{busy}}" bind:press="onCloseUnlock" variant="plain">确认已查看的升级提示</wu-f7-button>
    <wu-f7-block class="experience-section" strong="{{true}}" inset="{{true}}" spacing="compact">
      <view class="experience-section-title">每日经验</view>
      <view class="experience-note">按实际互动累计，没有额外的任务完成奖励。</view>
      <view wx:for="{{tasks}}" wx:key="action" class="experience-task">
        <view class="experience-task-main">
          <view>{{item.label}}</view>
          <view class="experience-note">{{item.reward}}</view>
        </view>
        <view class="experience-task-progress">{{item.progress}}</view>
      </view>
    </wu-f7-block>
    <wu-f7-block class="experience-section" strong="{{true}}" inset="{{true}}" spacing="compact">
      <button class="experience-disclosure" bindtap="onToggleSection" data-field="appearance" aria-expanded="{{experiencePanels.appearance}}">
        <view>
          <view class="experience-section-title">我的头衔</view>
          <view class="experience-current-title">{{previewTitle}}</view>
        </view>
        <wu-icon name="{{experiencePanels.appearance ? 'chevron-up' : 'chevron-down'}}" tone="muted" size="18" />
      </button>
      <view wx:if="{{experiencePanels.appearance}}" class="experience-expanded">
        <view class="experience-badge" style="{{previewStyle}}">{{previewTitle}}</view>
        <view wx:if="{{appearance.coverage === 'partial'}}" class="experience-note">历史记录不完整，仅显示已确认拥有的头衔。</view>
        <view wx:if="{{appearance.titles.length === 0}}" class="experience-note">{{appearance.coverage === 'complete' ? '还没有获得头衔' : '暂未确认更多已拥有的头衔'}}</view>
        <wu-f7-button class="experience-choice {{titleKey === null ? 'selected' : ''}}" data-key="" disabled="{{busy || appearancePending}}" bind:press="onTitle" variant="plain">
          <text>不显示头衔</text>
          <wu-icon wx:if="{{titleKey === null}}" name="check" tone="accent" size="20" />
        </wu-f7-button>
        <block wx:for="{{titleGroups}}" wx:key="label" wx:for-item="group">
          <view class="experience-group-label">{{group.label}}</view>
          <wu-f7-button wx:for="{{group.titles}}" wx:key="key" class="experience-choice {{titleKey === item.key ? 'selected' : ''}}" data-key="{{item.key}}" disabled="{{busy || appearancePending}}" bind:press="onTitle" variant="plain">
            <view>
              <view>{{item.name}}</view>
              <view class="experience-note">{{item.earnedAt ? item.earnedAt : '获得日期不可用'}}</view>
            </view>
            <wu-icon wx:if="{{titleKey === item.key}}" name="check" tone="accent" size="20" />
          </wu-f7-button>
        </block>
        <view class="experience-group-label">头衔颜色</view>
        <wu-f7-button class="experience-choice {{colorId === null ? 'selected' : ''}}" data-id="" disabled="{{busy || appearancePending}}" bind:press="onColor" variant="plain">
          <text>不使用颜色</text>
          <wu-icon wx:if="{{colorId === null}}" name="check" tone="accent" size="20" />
        </wu-f7-button>
        <view class="experience-colors">
          <view wx:for="{{colors}}" wx:key="id" class="experience-color-option">
            <button class="experience-swatch {{item.selected ? 'selected' : ''}}" style="{{item.style}}" bindtap="onColor" data-id="{{item.id}}" disabled="{{busy || appearancePending || !item.selectable}}" aria-label="{{item.name}}">
              {{item.selected ? '✓' : ''}}
            </button>
            <view>{{item.name}}</view>
            <view class="experience-note">{{item.retained ? '已装备' : item.unlockLevel &gt; 0 ? 'Lv.' + item.unlockLevel : '基础颜色'}}</view>
          </view>
        </view>
        <wu-f7-button class="experience-save" disabled="{{busy || appearancePending || !appearanceDirty}}" bind:press="onSave" variant="fill">保存头衔与颜色</wu-f7-button>
        <wu-f7-button class="experience-text-button" disabled="{{busy || appearancePending || !appearanceDirty}}" bind:press="onCancelSelection" variant="plain">取消未保存的选择</wu-f7-button>
        <view class="experience-note">头衔不代表管理权限。「管理员」不会自动佩戴，撤权后仍保留。已拥有头衔不因降级消失，已装备颜色可以保留。</view>
      </view>
    </wu-f7-block>
    <wu-f7-block class="experience-section" id="level-title-rules" strong="{{true}}" inset="{{true}}" spacing="compact">
      <button class="experience-disclosure" bindtap="onToggleTitleRules" aria-expanded="{{rulesExpanded}}">
        <view class="experience-section-title">等级头衔规则</view>
        <wu-icon name="{{rulesExpanded ? 'chevron-up' : 'chevron-down'}}" tone="muted" size="18" />
      </button>
      <block wx:if="{{rulesExpanded}}">
        <view class="experience-note">以下为固定规则，不代表你已拥有这些头衔。</view>
        <view wx:for="{{levelTitleRules}}" wx:key="key" class="experience-rule">
          <view>{{item.name}}</view>
          <view class="experience-note">规则解锁等级：{{item.unlockLevel}}</view>
        </view>
      </block>
    </wu-f7-block>
    <wu-f7-block class="experience-section" strong="{{true}}" inset="{{true}}" spacing="compact">
      <button class="experience-disclosure" bindtap="onToggleSection" data-field="records" aria-expanded="{{experiencePanels.records}}">
        <view class="experience-section-title">经验记录</view>
        <wu-icon name="{{experiencePanels.records ? 'chevron-up' : 'chevron-down'}}" tone="muted" size="18" />
      </button>
      <view wx:if="{{experiencePanels.records}}">
        <view class="experience-note">{{recordsCoverage}}</view>
        <view wx:if="{{records.length === 0}}" class="experience-note">还没有可展示的记录</view>
        <view wx:for="{{records}}" wx:key="recordId" class="experience-record">
          <view class="experience-record-heading">
            <text>{{item.label}}</text>
            <text class="experience-delta">{{item.deltaLabel}}</text>
          </view>
          <view class="experience-note">{{item.dateLabel}}</view>
          <view class="experience-note">{{item.appliedLabel}}</view>
          <view wx:if="{{item.nominalDelta !== null &amp;&amp; item.nominalDelta !== item.appliedDelta}}" class="experience-note">规则变动 {{item.nominalDelta}}，实际变动 {{item.deltaLabel}}</view>
        </view>
        <wu-f7-button wx:if="{{hasMore}}" class="experience-text-button" disabled="{{busy}}" bind:press="onMore" variant="plain">加载更多记录</wu-f7-button>
      </view>
    </wu-f7-block>
  </block>
  <wu-f7-block wx:if="{{hasSession}}" class="experience-section" strong="{{true}}" inset="{{true}}" spacing="compact">
    <button class="experience-disclosure" bindtap="onToggleSection" data-field="redemption" aria-expanded="{{experiencePanels.redemption || redemptionPending}}">
      <view class="experience-section-title">兑换头衔</view>
      <wu-icon name="{{experiencePanels.redemption || redemptionPending ? 'chevron-up' : 'chevron-down'}}" tone="muted" size="18" />
    </button>
    <view wx:if="{{experiencePanels.redemption || redemptionPending}}">
      <view wx:if="{{redemptionStatus !== 'available'}}" class="experience-note">兑换暂不可用，已拥有的头衔仍可选择。</view>
      <block wx:if="{{redemptionStatus === 'available'}}">
        <wu-f7-input class="experience-code" value="{{redemptionCode}}" password="{{true}}" maxlength="128" placeholder="输入兑换码" disabled="{{busy}}" bind:input="onRedemptionInput" label="兑换码" />
        <view class="experience-note">区分大小写，空格会原样保留。</view>
        <wu-f7-button wx:if="{{!redemptionPending}}" class="experience-save" disabled="{{busy || !redemptionCode}}" bind:press="onRedeemTitle" variant="fill">兑换头衔</wu-f7-button>
      </block>
      <block wx:if="{{redemptionPending}}">
        <view class="experience-note">原兑换结果待确认。请先查询；暂未查到不代表兑换不会完成。</view>
        <wu-f7-button class="experience-text-button" disabled="{{busy}}" bind:press="onRecoverRedemption" variant="plain">查询原兑换结果</wu-f7-button>
        <wu-f7-button wx:if="{{redemptionStatus === 'available'}}" class="experience-text-button" disabled="{{busy || !redemptionCode}}" bind:press="onRetryRedemption" variant="plain">用原兑换码重试</wu-f7-button>
        <view class="experience-note">退出页面后需重新输入原兑换码。若原请求尚未提交，新输入的内容可能成为首次接受的内容，请勿更换兑换码。</view>
      </block>
    </view>
  </wu-f7-block>
  <navigator wx:if="{{!busy}}" class="experience-ranking-link" url="/pages/experience-ranking/experience-ranking">
    <text>{{appearanceDirty ? '放弃未保存的选择并查看校园成长' : '看看同学们的成长'}}</text>
    <wu-icon name="chevron-right" tone="accent" size="16" />
  </navigator>
</view>
