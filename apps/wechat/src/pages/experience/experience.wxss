page {
  background: var(--wu-surface);
}
.experience-page {
  padding: 32rpx 32rpx calc(64rpx + env(safe-area-inset-bottom));
  color: var(--wu-text);
}
.experience-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 20rpx;
}
.experience-refresh {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 10rpx;
  padding: 0;
  margin: 0;
  min-height: 80rpx;
  min-width: 64rpx;
  background: transparent;
  color: var(--wu-accent);
  font-size: 23rpx;
}
.experience-summary {
  padding: 36rpx 0 28rpx;
}
.experience-summary-top {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 24rpx;
}
.experience-caption,
.experience-progress-label {
  color: var(--wu-secondary);
  font-size: 25rpx;
}
.experience-balance {
  font-size: 72rpx;
  font-weight: 700;
  letter-spacing: -2rpx;
  line-height: 1.2;
  margin: 10rpx 0;
  overflow-wrap: anywhere;
}
.experience-level {
  font-size: 36rpx;
  font-weight: 650;
  letter-spacing: -0.8rpx;
}
.experience-progress-label {
  margin: 18rpx 0 14rpx;
}
.experience-sign-in {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 24rpx;
  margin-top: 28rpx;
}
.experience-sign-label {
  font-size: 27rpx;
}
.experience-day {
  color: var(--wu-secondary);
  font-size: 22rpx;
  margin-top: 6rpx;
}
.experience-primary,
.experience-save {
  min-height: 82rpx;
  margin: 0;
  padding: 0 38rpx;
  border-radius: 18rpx;
  color: #fff;
  background: var(--wu-accent);
  font-size: 28rpx;
  line-height: 82rpx;
}
.experience-save {
  width: 100%;
  margin: 24rpx 0 8rpx;
}
.experience-section {
  border-top: 1rpx solid var(--wu-separator);
  padding: 28rpx 0;
}
.experience-section-title {
  font-size: 31rpx;
  line-height: 1.5;
  font-weight: 650;
}
.experience-note,
.experience-status {
  color: var(--wu-secondary);
  font-size: 24rpx;
  margin-top: 10rpx;
  line-height: 1.65;
  overflow-wrap: anywhere;
}
.experience-error {
  background: var(--wu-danger-bg);
  color: var(--wu-danger);
  border-radius: 16rpx;
  font-size: 26rpx;
  padding: 20rpx;
  margin-top: 16rpx;
}
.experience-task {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 24rpx;
  padding: 22rpx 0;
}
.experience-task:last-child {
  padding-bottom: 0;
}
.experience-task-main {
  flex: 1;
  min-width: 0;
  font-size: 28rpx;
}
.experience-task .experience-note {
  margin-top: 4rpx;
  font-size: 23rpx;
}
.experience-task-progress {
  font-size: 25rpx;
  color: var(--wu-secondary);
  text-align: right;
}
.experience-disclosure {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 24rpx;
  width: 100%;
  min-height: 64rpx;
  margin: 0;
  padding: 0;
  background: transparent;
  color: var(--wu-text);
  text-align: left;
  line-height: 1.5;
}
.experience-current-title {
  font-size: 25rpx;
  color: var(--wu-secondary);
  margin-top: 6rpx;
  font-weight: 400;
}
.experience-expanded {
  padding-top: 24rpx;
}
.experience-badge {
  display: inline-block;
  padding: 8rpx 18rpx;
  border-radius: 8rpx;
  color: #17304c;
  font-size: 29rpx;
  font-weight: 600;
  text-shadow: 0 1rpx 2rpx #fff;
}
.experience-choice {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 24rpx;
  width: 100%;
  margin: 0;
  padding: 20rpx 0;
  min-height: 88rpx;
  background: transparent;
  color: var(--wu-text);
  text-align: left;
  border-radius: 0;
  border-bottom: 1rpx solid var(--wu-separator);
  font-size: 28rpx;
  line-height: 1.5;
}
.experience-choice.selected {
  color: var(--wu-accent);
}
.experience-choice .experience-note {
  font-size: 22rpx;
  margin-top: 5rpx;
}
.experience-group-label {
  margin: 28rpx 0 8rpx;
  font-size: 25rpx;
  font-weight: 600;
  color: var(--wu-secondary);
}
.experience-colors {
  display: flex;
  flex-wrap: wrap;
  gap: 24rpx 0;
  margin: 28rpx -8rpx;
}
.experience-color-option {
  width: 25%;
  box-sizing: border-box;
  padding: 0 8rpx;
  text-align: center;
  font-size: 23rpx;
}
.experience-swatch {
  width: 72rpx;
  height: 72rpx;
  min-height: 72rpx;
  line-height: 72rpx;
  padding: 0;
  margin: 0 auto 12rpx;
  color: #111;
  font-size: 28rpx;
  text-shadow: 0 1rpx 2rpx #fff;
  border-radius: 50%;
}
.experience-swatch.selected {
  outline: 3rpx solid var(--wu-accent);
  outline-offset: 5rpx;
}
.experience-color-option .experience-note {
  margin-top: 4rpx;
  font-size: 21rpx;
}
.experience-text-button {
  background: transparent;
  color: var(--wu-accent);
  min-height: 80rpx;
  padding: 8rpx 0;
  margin: 6rpx 0;
  font-size: 26rpx;
  line-height: 1.6;
}
.experience-rule {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 20rpx;
  padding: 20rpx 0;
  font-size: 28rpx;
}
.experience-rule .experience-note {
  margin: 0;
}
.experience-record {
  padding: 22rpx 0;
  border-bottom: 1rpx solid var(--wu-separator);
}
.experience-record-heading {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 24rpx;
  font-size: 28rpx;
}
.experience-delta {
  font-weight: 600;
  font-variant-numeric: tabular-nums;
}
.experience-record .experience-note {
  margin-top: 6rpx;
  font-size: 22rpx;
}
.experience-code {
  min-height: 88rpx;
  padding: 12rpx 22rpx;
  box-sizing: border-box;
  margin-top: 20rpx;
  border-radius: 16rpx;
  background: var(--wu-bg);
  font-size: 28rpx;
  color: var(--wu-text);
}
.experience-recovery {
  margin: 24rpx 0;
  padding: 24rpx;
  background: var(--wu-bg);
  border-radius: 20rpx;
}
.experience-unlock {
  display: flex;
  align-items: center;
  gap: 20rpx;
  padding: 26rpx 0;
  border-top: 1rpx solid var(--wu-separator);
}
.experience-unlock-content {
  flex: 1;
  min-width: 0;
  font-size: 26rpx;
}
.experience-link,
.experience-ranking-link {
  display: flex;
  align-items: center;
  gap: 10rpx;
  min-height: 88rpx;
  color: var(--wu-accent);
  font-size: 27rpx;
}
.experience-ranking-link {
  justify-content: space-between;
}
.experience-page {
  position: relative;
}
.experience-header {
  position: absolute;
  top: 24rpx;
  right: 32rpx;
  z-index: 1;
}
.experience-summary {
  padding-top: 12rpx;
}
.experience-summary-top {
  padding-right: 84rpx;
}
.experience-status {
  min-height: 80rpx;
  padding-right: 180rpx;
}

@import '../public-profile/framework7-personal.wxss';
