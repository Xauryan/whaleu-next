<view class="support-page contacts-page support-native f7-ios-theme">
  <wu-f7-block spacing="compact" strong="{{true}}" inset="{{true}}" class="identity-heading"
    ><view class="identity-mark large"
      ><wu-icon name="person" size="28" tone="accent" /></view
    ><view class="section-title">发布者的联系方式</view
    ><view class="hint">由发布者自愿填写，不代表已认证</view></wu-f7-block
  >
  <view class="disclosure"
    ><wu-icon name="lock" size="18" tone="muted" /><text
      >分身也可能通过联系方式被识别。查看和复制时都会重新检查当前权限。</text
    ></view
  >
  <view wx:if="{{!loaded || busy}}" class="status" aria-role="status"
    >{{status}}</view
  >
  <view wx:if="{{error}}" class="error" aria-role="alert">{{error}}</view>
  <view wx:if="{{contacts.error}}" class="error" aria-role="alert"
    >{{contacts.error}}</view
  >
  <view
    wx:if="{{contacts.busy || contacts.contacts}}"
    class="status"
    aria-role="status"
    >{{contacts.status}}</view
  >
  <wu-f7-block spacing="compact" strong="{{true}}" inset="{{true}}"
    wx:if="{{loaded &amp;&amp; !contacts.enabled &amp;&amp; !contacts.error}}"
    class="empty compact"
    ><view class="section-title">暂无可查看的联系方式</view
    ><view class="hint">发布者未提供，或当前权限已变化。</view></wu-f7-block
  >
  <wu-f7-list spacing="compact" strong="{{true}}" inset="{{true}}" class="contact-list">
    <view
      wx:if="{{contacts.contacts &amp;&amp; contacts.contacts.wechat}}"
      class="contact-row"
      ><view class="contact-value"
        ><view class="meta">微信</view
        ><view>{{contacts.contacts.wechat}}</view></view
      ><wu-f7-button variant="plain"
        class="copy-button"
        bind:press="onCopy"
        data-field="wechat"
        disabled="{{contacts.busy}}"
      >
        复制
      </wu-f7-button></view
    >
    <view
      wx:if="{{contacts.contacts &amp;&amp; contacts.contacts.qq}}"
      class="contact-row"
      ><view class="contact-value"
        ><view class="meta">QQ</view
        ><view>{{contacts.contacts.qq}}</view></view
      ><wu-f7-button variant="plain"
        class="copy-button"
        bind:press="onCopy"
        data-field="qq"
        disabled="{{contacts.busy}}"
      >
        复制
      </wu-f7-button></view
    >
    <view
      wx:if="{{contacts.contacts &amp;&amp; contacts.contacts.phone}}"
      class="contact-row"
      ><view class="contact-value"
        ><view class="meta">电话</view
        ><view>{{contacts.contacts.phone}}</view></view
      ><wu-f7-button variant="plain"
        class="copy-button"
        bind:press="onCopy"
        data-field="phone"
        disabled="{{contacts.busy}}"
      >
        复制
      </wu-f7-button></view
    >
  </wu-f7-list>
  <wu-f7-button variant="fill"
    class="primary"
    bind:press="onReveal"
    disabled="{{busy || contacts.busy || !contacts.enabled}}"
    loading="{{contacts.busy}}"
  >
    {{contacts.contacts ? '重新核验联系方式' : '查看联系方式'}}
  </wu-f7-button>
  <wu-f7-button variant="plain" class="quiet" bind:press="onReload" disabled="{{busy || contacts.busy}}">
    刷新帖子权限
  </wu-f7-button>
</view>
