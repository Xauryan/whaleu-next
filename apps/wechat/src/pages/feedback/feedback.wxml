<import src="../../post-pins/management.wxml" />
<import src="../../post-pins/feed.wxml" />
<view class="screen">
  <view class="eyebrow">WHALEU · 全站公开专题</view><view class="title">意见与建议</view>
  <view class="subtitle">每所学校都能看到。正文、审核通过的图片、实名或分身与认证学校公开展示。</view>
  <view aria-role="status">{{status}}</view><view wx:if="{{error}}" class="error">{{error}}</view>
  <navigator wx:if="{{space &amp;&amp; hasSession}}" class="link" url="/pages/community-compose/community-compose?spaceId={{space.id}}&amp;category=feedback">发布意见建议 →</navigator>
  <navigator wx:if="{{hasSession}}" class="link" url="/pages/feedback-notices/feedback-notices">超级管理员反馈提醒（本地） →</navigator>
  <navigator wx:if="{{!hasSession}}" class="link" url="/pages/login/login">登录后参与讨论 →</navigator>
  <button bindtap="onRefresh" disabled="{{busy}}" loading="{{busy}}">刷新意见列表</button><button wx:if="{{busy}}" bindtap="onCancel">停止等待</button>
  <template is="scoped-post-pin" data="{{postPin,hasSession}}" />
  <view wx:for="{{posts}}" wx:key="id" class="card">
    <view class="author">{{item.author.displayName}} · {{item.author.kind === 'anonymous' ? '分身' : '实名'}}{{item.viewer.isSelf ? ' · 我' : ''}}</view>
    <view wx:if="{{item.feedback.authorSchool}}" class="meta">认证学校：{{item.feedback.authorSchool}}</view>
    <view class="body">{{item.text}}</view><view wx:if="{{item.images.length}}" class="meta">{{item.images.length}} 张图片，进入详情安全查看</view>
    <view class="meta">{{item.publishedAt}} · {{item.likeCount}} 赞 · {{item.discussionCount}} 条讨论</view>
    <navigator wx:if="{{hasSession}}" class="link" url="/pages/community-detail/community-detail?postId={{item.id}}">查看详情、赞评与举报 →</navigator>
  </view>
  <view wx:if="{{loaded &amp;&amp; !posts.length}}" class="empty">暂无可展示的意见建议</view>
  <button wx:if="{{canLoadMore}}" bindtap="onMore" disabled="{{busy}}">加载更多</button>
  <view wx:if="{{continuation === 'login_required'}}" class="notice">登录后继续浏览；翻页需要手机号验证。</view>
  <navigator wx:if="{{continuation === 'phone_verification_required'}}" class="link" url="/pages/phone-binding/phone-binding">验证手机号后继续 →</navigator>
  <view class="notice">本地审核与提醒用于开发验证。真实图片提供方、微信订阅或公众号通知未启用，不代表已向管理员发送微信。</view>
</view>

<template is="post-pin-management" data="{{management:postPinManagement}}" />
