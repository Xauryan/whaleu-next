@import '../account-status/support.wxss';
.scope-label {
  display: flex;
  align-items: center;
  gap: 14rpx;
  font-size: 27rpx;
  color: var(--wu-secondary, #6e6e73);
}
.feedback-item {
  padding: 32rpx 0 14rpx;
  border-bottom: 1rpx solid var(--wu-separator, #e5e5ea);
}
.author-row {
  display: flex;
  align-items: center;
  gap: 18rpx;
}
.author-info {
  min-width: 0;
}
.author {
  font-size: 28rpx;
  font-weight: 600;
}
.author-info .meta {
  margin: 4rpx 0 0;
  font-size: 23rpx;
}
.self-label {
  color: var(--wu-secondary, #6e6e73);
  font-size: 22rpx;
  margin-left: 14rpx;
  font-weight: 400;
}
.post-body {
  font-size: 31rpx;
  line-height: 1.7;
  white-space: pre-wrap;
  overflow-wrap: anywhere;
  margin: 22rpx 0;
}
.media-note {
  display: flex;
  align-items: center;
  gap: 12rpx;
  font-size: 24rpx;
  color: var(--wu-secondary, #6e6e73);
  margin-bottom: 20rpx;
}
.post-meta {
  display: flex;
  flex-wrap: wrap;
  justify-content: space-between;
  gap: 14rpx;
  color: var(--wu-tertiary, #8e8e93);
  font-size: 22rpx;
}
.counts {
  display: flex;
  align-items: center;
  gap: 10rpx;
}
.counts wu-icon:nth-of-type(2) {
  margin-left: 16rpx;
}
.detail-link {
  display: flex;
  align-items: center;
  justify-content: flex-end;
  gap: 8rpx;
  font-size: 25rpx;
  color: var(--wu-accent, #007aff);
}
.feedback-page .card {
  border-top: 1rpx solid var(--wu-separator, #e5e5ea);
  padding: 24rpx 0;
  margin-top: 24rpx;
}
.feedback-page .card .body {
  font-size: 29rpx;
  line-height: 1.7;
  white-space: pre-wrap;
  margin: 20rpx 0;
}
.feedback-page .card button {
  color: var(--wu-accent, #007aff);
  background: transparent;
  width: 100%;
}
.feedback-page .card .notice {
  font-size: 25rpx;
  line-height: 1.7;
  color: var(--wu-secondary, #6e6e73);
  margin: 14rpx 0;
}

@import '../account-status/framework7-support.wxss';
