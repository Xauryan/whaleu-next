<view class="account-page f7-ios-theme f7-identity-screen">
  <wu-f7-block spacing="compact">
    <view class="status-line" aria-role="status"> {{status}} </view>
    <view wx:if="{{error}}" class="error" aria-role="alert"> {{error}} </view>
    <view wx:if="{{receiptStatus}}" class="body-copy"> {{receiptStatus}} </view>
    <wu-f7-button
      wx:if="{{busy}}"
      class="quiet"
      bind:press="onCancel"
      variant="plain"
      size="normal"
    >
      停止等待结果（不撤销已发送请求）
    </wu-f7-button>
    <navigator
      wx:if="{{!hasSession}}"
      class="text-link"
      url="/pages/login/login"
    >
      前往登录
    </navigator>
  </wu-f7-block>
  <wu-f7-block
    wx:if="{{frozen}}"
    class="surface"
    strong="{{true}}"
    inset="{{true}}"
    spacing="compact"
  >
    <view class="inline-icon">
      <wu-icon name="clock" tone="accent" size="24" />
      <view class="section-title"> 先确认上次选择 </view>
    </view>
    <view class="body-copy">
      返回或停止等待不会撤销已发送的请求。未查到结果也不代表未完成，请保留原请求，不要另建一次选择。
    </view>
    <wu-f7-button
      class="primary"
      disabled="{{busy || !hasSession}}"
      bind:press="onReceipt"
      variant="fill"
      size="large"
    >
      查询原请求结果
    </wu-f7-button>
    <wu-f7-button
      class="secondary"
      disabled="{{busy || !hasSession}}"
      bind:press="onRetry"
      variant="tonal"
      size="normal"
    >
      重试相同的原请求
    </wu-f7-button>
  </wu-f7-block>
  <block wx:if="{{loaded &amp;&amp; state &amp;&amp; !frozen}}">
    <wu-f7-block
      wx:if="{{state.selectedCampus}}"
      class="surface"
      strong="{{true}}"
      inset="{{true}}"
      spacing="compact"
    >
      <view class="caption"> 当前身份校区 </view>
      <view class="section-title"> {{state.selectedCampus.name}} </view>
      <view class="body-copy">
        {{state.selectedCampus.operatingRegion.name}}
      </view>
    </wu-f7-block>
    <wu-f7-block spacing="compact">
      <view wx:if="{{!state.canSelect}}" class="caption">
        {{eligibilityMessage}}
      </view>
    </wu-f7-block>
    <view
      wx:if="{{state.options.status === 'known' &amp;&amp; state.options.items.length &gt; 0}}"
    >
      <view class="section-label"> 可选校区 </view>
      <wu-f7-list strong="{{true}}" inset="{{true}}" spacing="compact">
        <wu-f7-list-item
          wx:for="{{state.options.items}}"
          wx:key="id"
          class="choice {{selectedId === item.id ? 'selected' : ''}}"
          data-id="{{item.id}}"
          disabled="{{busy || !state.canSelect}}"
          bind:press="onChoose"
          link="{{true}}"
          title="{{item.name}}"
          after="{{selectedId === item.id ? '已选' : ''}}"
          aria-label="{{item.name + '，' + item.operatingRegion.name + (selectedId === item.id ? '，已选' : '')}}"
          footer-slot="{{true}}"
        >
          <view slot="footer" class="choice-meta">
            {{item.operatingRegion.name}}
          </view>
        </wu-f7-list-item>
      </wu-f7-list>
      <wu-f7-block spacing="compact">
        <wu-f7-button
          class="primary"
          disabled="{{busy || !state.canSelect || !selectedId}}"
          bind:press="onRequestConfirmation"
          variant="fill"
          size="large"
        >
          继续确认
        </wu-f7-button>
      </wu-f7-block>
    </view>
    <wu-f7-block
      wx:if="{{confirmation}}"
      class="confirmation"
      strong="{{true}}"
      inset="{{true}}"
      spacing="compact"
    >
      <view class="caption"> 确认保存为身份校区 </view>
      <view class="section-title"> {{confirmation.name}} </view>
      <view class="body-copy"> {{confirmation.operatingRegion.name}} </view>
      <view class="body-copy">
        不会新增学校认证或管理权限。返回草稿后仍需主动发送，发布资格与审核会重新检查。
      </view>
      <wu-f7-button
        class="primary"
        disabled="{{busy}}"
        bind:press="onConfirm"
        variant="fill"
        size="large"
      >
        确认保存
      </wu-f7-button>
      <wu-f7-button
        class="secondary"
        disabled="{{busy}}"
        bind:press="onDismissConfirmation"
        variant="tonal"
        size="normal"
      >
        取消选择
      </wu-f7-button>
    </wu-f7-block>
  </block>
  <wu-f7-block spacing="compact">
    <view class="privacy-note">
      仅影响之后发布，不改浏览校园、认证、历史内容或管理范围。离开会清除显示，设备只保留本账号待确认的请求。
    </view>
    <wu-f7-button
      wx:if="{{!busy &amp;&amp; !frozen}}"
      class="quiet"
      disabled="{{!hasSession || !configured}}"
      bind:press="onReload"
      variant="plain"
      size="normal"
    >
      重新查询
    </wu-f7-button>
  </wu-f7-block>
  <wu-f7-list strong="{{true}}" inset="{{true}}" spacing="compact">
    <navigator class="link-row" url="/pages/verification/verification">
      <wu-f7-list-item title-slot="{{true}}" after-slot="{{true}}">
        <text class="link-label" slot="title"> 查看认证状态 </text>
        <wu-icon name="chevron-right" size="16" tone="muted" slot="after" />
      </wu-f7-list-item>
    </navigator>
  </wu-f7-list>
</view>
