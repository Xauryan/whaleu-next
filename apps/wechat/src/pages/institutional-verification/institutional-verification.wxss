.screen {
  padding: 32rpx;
}
.eyebrow {
  color: #527184;
  font-size: 24rpx;
}
.title {
  font-size: 40rpx;
  font-weight: 600;
  margin: 20rpx 0;
}
.notice {
  line-height: 1.75;
  margin: 24rpx 0;
  color: #405568;
}
.error {
  color: #a32b37;
  margin: 20rpx 0;
}
.card {
  padding: 28rpx;
  background: #fff;
  border-radius: 20rpx;
  margin: 24rpx 0;
  line-height: 1.7;
}
.card-title {
  font-weight: 600;
  margin-bottom: 16rpx;
}
input {
  border: 1rpx solid #cbd6de;
  padding: 16rpx;
  margin: 16rpx 0;
}
button {
  margin: 20rpx 0;
}
navigator {
  color: #275c83;
  margin: 28rpx 0;
}
