<view class="account-page login-page f7-ios-theme f7-identity-screen">
  <wu-f7-block title="鲸语校园" spacing="compact" />
  <wu-f7-block spacing="compact">
    <view class="status-line" aria-role="status"> {{status}} </view>
  </wu-f7-block>
  <wu-f7-block
    wx:if="{{!configured}}"
    class="surface"
    strong="{{true}}"
    inset="{{true}}"
    spacing="compact"
  >
    <view class="section-title"> 登录暂未开放 </view>
    <view class="body-copy"> 微信登录环境尚未启用，你可以先浏览校园。 </view>
  </wu-f7-block>
  <wu-f7-block spacing="compact">
    <view wx:if="{{error}}" class="error" aria-role="alert"> {{error}} </view>
    <view wx:if="{{requestId}}" class="request-id" selectable="true">
      问题编号：{{requestId}}
    </view>
    <view wx:if="{{verified}}" class="session-note">
      <wu-icon name="shield" tone="accent" size="20" />
      <text> 当前会话已验证 </text>
    </view>
    <wu-f7-button
      wx:if="{{!hasLocalSession &amp;&amp; !signingIn}}"
      class="primary"
      disabled="{{!configured || busy}}"
      loading="{{busy}}"
      bind:press="onLogin"
      variant="fill"
      size="large"
    >
      使用微信登录
    </wu-f7-button>
    <wu-f7-button
      wx:if="{{hasLocalSession}}"
      class="primary"
      disabled="{{!configured || busy}}"
      loading="{{busy}}"
      bind:press="onCheckSession"
      variant="fill"
      size="large"
    >
      验证当前登录
    </wu-f7-button>
  </wu-f7-block>
  <wu-f7-list strong="{{true}}" inset="{{true}}" spacing="compact">
    <navigator
      wx:if="{{verified &amp;&amp; !busy}}"
      class="link-row"
      url="/pages/profile/profile"
    >
      <wu-f7-list-item title-slot="{{true}}" after-slot="{{true}}">
        <text class="link-label" slot="title"> 我的资料与偏好 </text>
        <wu-icon name="chevron-right" size="16" tone="muted" slot="after" />
      </wu-f7-list-item>
    </navigator>
    <navigator
      wx:if="{{verified &amp;&amp; !busy}}"
      class="link-row"
      url="/pages/campus/campus"
    >
      <wu-f7-list-item title-slot="{{true}}" after-slot="{{true}}">
        <text class="link-label" slot="title"> 选择校园 </text>
        <wu-icon name="chevron-right" size="16" tone="muted" slot="after" />
      </wu-f7-list-item>
    </navigator>
  </wu-f7-list>
  <wu-f7-block spacing="compact">
    <navigator
      class="browse-link"
      url="/pages/community-feed/community-feed"
      open-type="reLaunch"
    >
      先逛逛校园
    </navigator>
    <wu-f7-button
      wx:if="{{hasLocalSession || signingIn}}"
      class="quiet"
      bind:press="onLogout"
      variant="plain"
      size="normal"
    >
      {{signingIn ? '取消登录' : '退出登录'}}
    </wu-f7-button>
    <view class="privacy-note">
      登录仅建立账号会话，不会请求手机号或完成学生认证。手机号授权需在独立页面由你主动同意。
    </view>
    <view class="login-footer">
      <navigator url="/pages/account-status/account-status">
        账号状态与申诉
      </navigator>
      <navigator url="/pages/announcements/announcements"> 校园公告 </navigator>
    </view>
    <view class="preview-note"> 开发预览 · 尚未开放正式服务 </view>
  </wu-f7-block>
</view>
