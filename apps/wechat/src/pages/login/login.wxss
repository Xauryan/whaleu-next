.screen {
  padding: 56rpx 32rpx 80rpx;
}
.eyebrow {
  color: #456587;
  font-size: 24rpx;
  font-weight: 600;
  letter-spacing: 3rpx;
}
.title {
  font-size: 48rpx;
  font-weight: 700;
  margin: 20rpx 0;
}
.intro {
  color: #495d77;
  font-size: 28rpx;
  line-height: 1.8;
  margin-bottom: 36rpx;
}
.card {
  background: #fff;
  border: 2rpx solid #dce5f0;
  border-radius: 24rpx;
  padding: 32rpx;
  margin-bottom: 24rpx;
}
.card-title {
  font-size: 30rpx;
  font-weight: 600;
}
.status {
  color: #244b74;
  font-size: 34rpx;
  font-weight: 600;
  margin: 20rpx 0;
}
.notice,
.error {
  font-size: 27rpx;
  line-height: 1.7;
  padding: 20rpx;
  border-radius: 12rpx;
  margin-bottom: 24rpx;
}
.notice {
  color: #515940;
  background: #f4f4e9;
}
.error {
  color: #8b2738;
  background: #fff0f2;
}
.request-id {
  color: #62728a;
  font-size: 22rpx;
  word-break: break-all;
  margin: 12rpx 0 24rpx;
}
.session {
  border-top: 2rpx solid #e6edf5;
  margin: 24rpx 0;
  padding-top: 8rpx;
}
.field-label {
  color: #65768c;
  font-size: 23rpx;
  margin: 16rpx 0 6rpx;
}
.field-value {
  display: block;
  color: #243d5b;
  font-size: 25rpx;
  line-height: 1.5;
  word-break: break-all;
}
.primary,
.secondary {
  font-size: 29rpx;
  border-radius: 14rpx;
  margin-top: 20rpx;
}
.primary {
  background: #195a93;
  color: #fff;
}
.primary[disabled] {
  background: #e2e8f0;
  color: #66748a;
}
.secondary {
  background: #eef3f9;
  color: #294e76;
}
.secondary-card {
  background: #f8fafd;
}
.detail {
  color: #536780;
  font-size: 25rpx;
  line-height: 1.8;
  margin-top: 20rpx;
}
