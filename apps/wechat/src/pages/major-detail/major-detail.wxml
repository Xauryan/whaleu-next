<!-- Native Framework7 v9.2.0 presentation; existing Page and controller ownership is unchanged. -->
<import src="../../majors/framework7-product.wxml" />
<view class="screen major-product has-dock f7-ios-theme f7-discussions">
  <view class="major-toolbar major-toolbar-end">
    <wu-f7-button class="major-icon-button" data-panel="options" aria-label="更多专业选项" bind:press="onTogglePanel" variant="plain">
      <wu-icon name="more" size="22" />
    </wu-f7-button>
  </view>
  <view wx:if="{{uiPanel === 'options'}}" class="major-options">
    <navigator class="major-link" url="/pages/major-discussion-recovery/major-discussion-recovery">
      请求与点赞记录
      <wu-icon name="chevron-right" size="16" />
    </navigator>
    <view class="major-meta">
      未提供培养方案、学位或就业说明。
    </view>
  </view>
  <template is="major-status" data="{{status,error,hasSession,busy,loaded,uiPanel}}" />
  <block wx:if="{{loaded &amp;&amp; detail}}">
    <wu-f7-block class="major-identity" spacing="compact">
      <wu-f7-block class="major-identity-icon" spacing="compact">
        <wu-icon name="graduation" size="30" tone="blue" />
      </wu-f7-block>
      <view class="major-title">
        {{detail.item.majorName}}
      </view>
      <view class="major-meta">
        {{detail.item.collegeName}} · {{detail.item.departmentId}}系
      </view>
    </wu-f7-block>
    <view class="major-detail-summary">
      <template is="major-summary" data="{{summary:detail.item.summary}}" />
    </view>
    <view class="major-list-heading">
      <view class="major-section-title">
        相关专业
      </view>
      <wu-f7-button class="major-icon-button" disabled="{{busy}}" aria-label="刷新相关专业" bind:press="onRelatedRefresh" variant="plain">
        <wu-icon name="refresh" size="19" />
      </wu-f7-button>
    </view>
    <view wx:if="{{relatedError}}" class="major-error">
      {{relatedError}}
    </view>
    <block wx:if="{{relatedLoaded}}">
      <wu-f7-list spacing="compact" strong="{{true}}">
        <template wx:for="{{relatedItems}}" wx:key="id" is="major-item" data="{{item,busy}}" />
      </wu-f7-list>
      <wu-f7-block wx:if="{{!relatedItems.length}}" class="major-empty" spacing="compact">
        暂时没有相关专业
      </wu-f7-block>
    </block>
    <view class="major-dock">
      <wu-f7-button class="major-primary" disabled="{{busy}}" bind:press="onOpenDiscussion" variant="fill" size="large">
        <wu-icon name="message" size="20" tone="inverse" />
        查看主题
      </wu-f7-button>
    </view>
  </block>
  <view wx:if="{{!loaded &amp;&amp; relatedError}}" class="major-error">
    {{relatedError}}
  </view>
</view>
