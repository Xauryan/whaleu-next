<!-- Native Framework7 v9.2.0 presentation; existing Page and controller ownership is unchanged. -->
<import src="../../majors/framework7-product.wxml" />
<view class="screen major-product f7-ios-theme f7-discussions">
  <view class="major-search">
    <wu-icon name="search" size="20" tone="muted" />
    <wu-f7-input value="{{searchDraft}}" maxlength="100" disabled="{{busy}}" placeholder="搜索专业或学院" bind:input="onSearchInput" />
    <wu-f7-button class="major-quiet" disabled="{{busy}}" bind:press="onSearch" variant="plain">
      搜索
    </wu-f7-button>
  </view>
  <view class="major-toolbar">
    <picker range="{{departmentNames}}" value="{{departmentIndex}}" bindchange="onDepartment" disabled="{{busy || !departments}}">
      <view class="major-filter">
        {{departmentNames[departmentIndex]}}
        <wu-icon name="chevron-down" size="16" />
      </view>
    </picker>
    <wu-f7-button class="major-icon-button" data-panel="options" aria-label="更多专业目录选项" bind:press="onTogglePanel" variant="plain">
      <wu-icon name="more" size="22" />
    </wu-f7-button>
  </view>
  <view wx:if="{{uiPanel === 'options'}}" class="major-options">
    <navigator class="major-link" url="/pages/major-discussion-recovery/major-discussion-recovery">
      请求与点赞记录
      <wu-icon name="chevron-right" size="16" />
    </navigator>
    <navigator class="major-link" url="/pages/major-discussion-notices/major-discussion-notices">
      讨论通知
      <wu-icon name="chevron-right" size="16" />
    </navigator>
  </view>
  <template is="major-status" data="{{status,error,hasSession,busy,loaded,uiPanel}}" />
  <block wx:if="{{loaded}}">
    <view class="major-list-heading">
      <view wx:if="{{appliedFilter !== departmentNames[departmentIndex]}}" class="major-section-title">
        {{appliedFilter}}
      </view>
      <view class="major-meta">
        {{totalCount}} 个专业
      </view>
    </view>
    <wu-f7-list spacing="compact" strong="{{true}}">
      <template wx:for="{{items}}" wx:key="id" is="major-item" data="{{item,busy}}" />
    </wu-f7-list>
    <wu-f7-block wx:if="{{!items.length}}" class="major-empty" spacing="compact">
      <wu-icon name="search" size="32" tone="muted" />
      <view>
        没有找到相关专业
      </view>
      <view class="major-meta">
        换个名称或院系再试试
      </view>
    </wu-f7-block>
    <wu-f7-button wx:if="{{canNext}}" class="major-load-more" disabled="{{busy}}" bind:press="onNext" variant="plain">
      更多专业
    </wu-f7-button>
  </block>
</view>
