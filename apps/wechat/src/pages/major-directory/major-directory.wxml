<import src="../../majors/common.wxml" />
<view class="screen">
  <view class="eyebrow">WHALEU · 院系专业</view><view class="title">专业目录</view>
  <navigator class="link" url="/pages/major-discussion-recovery/major-discussion-recovery">原讨论请求与自己的点赞恢复 →</navigator>
  <navigator class="link" url="/pages/major-discussion-notices/major-discussion-notices">专业讨论通知 →</navigator>
  <template is="major-status" data="{{status,error,hasSession,busy}}" />
  <view class="card"><view class="section-title">按院系与名称查找</view>
    <picker range="{{departmentNames}}" value="{{departmentIndex}}" bindchange="onDepartment" disabled="{{busy || !departments}}"><view class="filter-picker">{{departmentNames[departmentIndex]}}</view></picker>
    <input value="{{searchDraft}}" maxlength="100" bindinput="onSearchInput" disabled="{{busy}}" placeholder="专业名或学院名" />
    <button bindtap="onSearch" disabled="{{busy}}">应用筛选与搜索</button>
    <view class="meta">院系和名称可同时筛选；浏览选择不会授予认证或管理权限。</view>
  </view>
  <block wx:if="{{loaded}}"><view class="section-title">{{appliedFilter}}</view><view class="meta">共 {{totalCount}} 个专业 · 第 {{pageNumber}} 页</view>
    <template wx:for="{{items}}" wx:key="id" is="major-item" data="{{item,busy}}" />
    <view wx:if="{{!items.length}}" class="empty">当前条件没有专业</view>
    <button wx:if="{{canNext}}" bindtap="onNext" disabled="{{busy}}">下一页</button>
  </block>
  <view class="notice">目录仅来自当前已确认的来源。专业讨论没有数值评分；图片、删除和历史迁移仍未完成。</view>
</view>
