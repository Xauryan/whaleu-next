<!-- Native Framework7 v9.2.0 presentation; existing Page and controller ownership is unchanged. -->
<import src="../../major-discussion/framework7-product.wxml" />
<view class="screen major-product has-dock f7-ios-theme f7-discussions">
  <view class="major-toolbar">
    <view class="major-tabs">
      <wu-f7-button class="major-tab {{sort === 'likes' ? 'major-tab-active' : ''}}" data-sort="likes" disabled="{{busy}}" bind:press="onSort" variant="{{sort === 'likes' ? 'tonal' : 'plain'}}">
        热门
      </wu-f7-button>
      <wu-f7-button class="major-tab {{sort === 'time' ? 'major-tab-active' : ''}}" data-sort="time" disabled="{{busy}}" bind:press="onSort" variant="{{sort === 'time' ? 'tonal' : 'plain'}}">
        最新
      </wu-f7-button>
    </view>
    <wu-f7-button class="major-icon-button" data-panel="options" aria-label="更多讨论选项" bind:press="onTogglePanel" variant="plain">
      <wu-icon name="more" size="22" />
    </wu-f7-button>
  </view>
  <view wx:if="{{uiPanel === 'options'}}" class="major-options">
    <navigator class="major-link" url="/pages/major-discussion-recovery/major-discussion-recovery">
      请求与点赞记录
      <wu-icon name="chevron-right" size="16" />
    </navigator>
    <navigator class="major-link" url="/pages/major-discussion-notices/major-discussion-notices">
      回复与赞通知
      <wu-icon name="chevron-right" size="16" />
    </navigator>
    <view class="major-meta">
      使用公开昵称，可附最多 3 张图片。专业没有创建者通知。
    </view>
  </view>
  <template is="discussion-status" data="{{status,error,receiptStatus,deletionLocatorUnavailable,hasSession,busy,frozen,recoveryMajorId,recoveryOperation,recoveryCommentId,recoveryPhase,confirming,loaded,uiPanel}}" />
  <block wx:if="{{loaded}}">
    <view class="major-list-heading">
      <view class="major-section-title">
        {{totalCount}} 个主题
      </view>
    </view>
    <template wx:for="{{items}}" wx:key="id" is="discussion-item" data="{{item,deleteTarget,mode,busy,frozen,confirming,focusCommentId,imageBusy,timeLabels}}" />
    <wu-f7-block wx:if="{{!items.length}}" class="major-empty" spacing="compact">
      <wu-icon name="message" size="32" tone="muted" />
      <view>
        还没有主题
      </view>
      <view class="major-meta">
        聊聊你的想法
      </view>
    </wu-f7-block>
    <wu-f7-button wx:if="{{canNext}}" class="major-load-more" disabled="{{busy}}" bind:press="onNext" variant="plain">
      更多主题
    </wu-f7-button>
  </block>
  <view wx:if="{{loaded &amp;&amp; !frozen}}" class="major-dock">
    <wu-f7-button class="major-compose-entry" data-panel="compose" disabled="{{busy || imageBusy || imageFrozen || confirming}}" bind:press="onTogglePanel" variant="fill" size="large">
      <wu-icon name="edit" size="20" />
      发布主题
    </wu-f7-button>
    <view class="major-meta">
      公开
    </view>
  </view>
  <template is="discussion-form" data="{{loaded,frozen,mode,busy,confirming,replyTarget,body,bodyBytes,canPublish,selectedComment,deleteTarget,imageEnabled,imageCount,imageBusy,imageFrozen,imageStatus,imagePending,imageProgress,imageRequestId,imageRecoverable,imageCancelConfirm,uiPanel}}" />
  <template wx:if="{{!(loaded &amp;&amp; !frozen &amp;&amp; uiPanel === 'compose' &amp;&amp; !confirming) &amp;&amp; confirming !== 'publish' &amp;&amp; !(confirming === 'delete' &amp;&amp; deleteTarget) &amp;&amp; !(confirming === 'like' &amp;&amp; selectedComment)}}" is="discussion-image-state" data="{{imageEnabled,imageStatus,imagePending,imageBusy,imageProgress,imageRequestId,imageRecoverable,imageCancelConfirm,busy}}" />
  <template is="discussion-gallery" data="{{galleryOpen,gallerySrc,galleryStatus,galleryIndex,galleryCount}}" />
</view>
