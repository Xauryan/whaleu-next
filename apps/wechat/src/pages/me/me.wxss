.me-page {
  min-height: 100vh;
  padding-bottom: 180rpx;
  box-sizing: border-box;
  color: var(--wu-text, #1d1d1f);
  background: var(--wu-surface, #fff);
}
.profile-cover {
  position: relative;
  overflow: hidden;
  padding: 0 28rpx 42rpx;
  color: #f5f5f7;
  background: linear-gradient(145deg, #25282a 0%, #17191b 53%, #111314 100%);
}
.profile-cover-image,
.profile-cover-shade {
  position: absolute;
  inset: 0;
  width: 100%;
  height: 100%;
}
.profile-cover-shade {
  background: rgba(0, 0, 0, 0.38);
}
.profile-toolbar,
.profile-identity,
.profile-social-summary,
.profile-bio,
.profile-detail-tags,
.profile-detail-status,
.profile-notice,
.profile-shortcuts {
  position: relative;
}
.profile-toolbar {
  display: flex;
  align-items: center;
  justify-content: space-between;
  height: 74rpx;
  margin-bottom: 20rpx;
}
.profile-toolbar-actions {
  display: flex;
  align-items: center;
  gap: 10rpx;
}
.edit-profile-pill {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  gap: 8rpx;
  padding: 9rpx 20rpx;
  border-radius: 40rpx;
  background: rgba(255, 255, 255, 0.15);
  color: #f5f5f7;
  font-size: 25rpx;
  line-height: 1.35;
}
.icon-button {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 60rpx;
  height: 60rpx;
  min-height: 0;
  flex-shrink: 0;
  margin: 0;
  padding: 0;
  border: 0;
  border-radius: 50%;
  background: transparent;
}
.icon-button::after,
.profile-avatar::after,
.settings-button::after,
.text-button::after,
.content-tab::after,
.content-mode::after,
.empty-action::after,
.page-button::after,
.avatar-preview-close::after {
  border: 0;
}
.profile-identity {
  display: flex;
  align-items: center;
  gap: 32rpx;
}
.profile-avatar {
  width: 156rpx;
  height: 156rpx;
  flex-shrink: 0;
  display: flex;
  align-items: center;
  justify-content: center;
  margin: 0;
  padding: 0;
  border-radius: 50%;
  overflow: hidden;
  background: #343638;
  border: 2rpx solid rgba(255, 255, 255, 0.85);
}
.profile-avatar[disabled] {
  background: #343638;
  opacity: 1;
}
.avatar-image {
  width: 100%;
  height: 100%;
}
.profile-copy {
  flex: 1;
  min-width: 0;
}
.profile-name {
  font-size: 38rpx;
  font-weight: 650;
  line-height: 1.35;
  overflow-wrap: break-word;
  letter-spacing: -0.8rpx;
}
.profile-campus {
  display: flex;
  align-items: center;
  gap: 8rpx;
  margin-top: 15rpx;
  color: #b7b9bc;
  font-size: 23rpx;
  line-height: 1.5;
}
.profile-uid {
  margin-top: 11rpx;
  color: #b7b9bc;
  font-size: 22rpx;
  line-height: 1.5;
}
.profile-detail-tags {
  display: flex;
  flex-wrap: wrap;
  align-items: center;
  gap: 10rpx;
  margin-top: 19rpx;
}
.profile-detail-capsule {
  display: inline-flex;
  align-items: center;
  gap: 7rpx;
  padding: 7rpx 16rpx;
  min-height: 34rpx;
  border-radius: 40rpx;
  color: #ededee;
  background: rgba(255, 255, 255, 0.12);
  font-size: 22rpx;
  line-height: 1.4;
}
.profile-social-summary {
  margin-top: 42rpx;
}
.profile-social-stats {
  display: flex;
  align-items: flex-start;
  gap: 30rpx;
  flex-wrap: wrap;
}
.profile-stat {
  display: flex;
  align-items: baseline;
  gap: 7rpx;
}
.profile-stat-value {
  font-size: 32rpx;
  font-weight: 650;
  line-height: 1.25;
  font-variant-numeric: tabular-nums;
}
.profile-stat-label {
  color: #dedee0;
  font-size: 26rpx;
  line-height: 1.5;
}
.profile-stat-note {
  margin-top: 6rpx;
  color: #a8aaad;
  font-size: 18rpx;
  line-height: 1.5;
}
.profile-stat-error {
  display: flex;
  align-items: center;
  gap: 15rpx;
  margin-top: 8rpx;
  color: #b7b9bc;
  font-size: 21rpx;
  line-height: 1.5;
}
.profile-bio {
  margin: 17rpx 2rpx 0;
  font-size: 26rpx;
  line-height: 1.7;
  white-space: pre-wrap;
  overflow-wrap: break-word;
}
.profile-bio-empty {
  color: #b7b9bc;
}
.profile-notice {
  display: flex;
  gap: 15rpx;
  align-items: center;
  justify-content: space-between;
  margin-top: 20rpx;
  font-size: 23rpx;
  color: #c6c7c9;
  line-height: 1.55;
}
.text-button {
  margin: 0;
  padding: 0;
  flex-shrink: 0;
  background: transparent;
  color: var(--wu-accent, #007aff);
  font-size: 24rpx;
  min-height: 0;
}
.profile-cover .text-button {
  color: #8fc0ff;
}
.profile-actions {
  display: flex;
  align-items: center;
  gap: 13rpx;
  margin-top: 26rpx;
}
.public-profile-link {
  display: flex;
  flex: 1;
  align-items: center;
  gap: 7rpx;
  color: #76777d;
  font-size: 23rpx;
}
.edit-profile {
  padding: 13rpx 35rpx;
  border: 1rpx solid #c7c8ce;
  border-radius: 36rpx;
  font-size: 24rpx;
  font-weight: 550;
}
.settings-button {
  display: flex;
  align-items: center;
  justify-content: center;
  margin: 0;
  padding: 0;
  width: 79rpx;
  height: 62rpx;
  min-height: 0;
  border: 1rpx solid #c7c8ce;
  border-radius: 33rpx;
  background: transparent;
}
.profile-shortcuts {
  display: flex;
  gap: 12rpx;
  margin-top: 27rpx;
}
.shortcut {
  flex: 1;
  min-width: 0;
  padding: 17rpx 15rpx;
  border-radius: 17rpx;
  background: rgba(255, 255, 255, 0.08);
}
.shortcut-title {
  display: flex;
  align-items: center;
  gap: 8rpx;
  font-size: 23rpx;
  font-weight: 550;
  white-space: nowrap;
}
.shortcut-note {
  margin-top: 7rpx;
  padding-left: 2rpx;
  color: #b7b9bc;
  font-size: 20rpx;
}
.profile-content {
  position: relative;
  min-height: 620rpx;
  margin-top: 0;
  border-radius: 0;
  background: var(--wu-surface, #fff);
  overflow: hidden;
}
.content-tabs {
  display: flex;
  align-items: center;
  justify-content: flex-start;
  gap: 24rpx;
  padding: 0 30rpx;
  border-bottom: 1rpx solid var(--wu-separator, #ededf0);
}
.content-tab {
  position: relative;
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 8rpx;
  min-width: 76rpx;
  margin: 0;
  padding: 24rpx 8rpx 23rpx;
  color: var(--wu-secondary, #86868b);
  font-size: 30rpx;
  line-height: 1.5;
  background: transparent;
  border-radius: 0;
  font-weight: 450;
}
.content-search-button {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 58rpx;
  height: 70rpx;
  min-height: 0;
  margin: 0 0 0 auto;
  padding: 0;
  background: transparent;
}
.content-search-panel {
  padding: 18rpx 30rpx 8rpx;
}
.content-search-input {
  height: 68rpx;
  padding: 0 20rpx;
  border-radius: 14rpx;
  background: var(--wu-bg, #f5f5f7);
  color: var(--wu-text, #1d1d1f);
  font-size: 25rpx;
}
.content-search-note {
  margin-top: 8rpx;
  color: var(--wu-secondary, #86868b);
  font-size: 20rpx;
}
.content-tab-active {
  color: var(--wu-text, #1d1d1f);
  font-weight: 650;
}
.content-tab-active::before {
  content: '';
  position: absolute;
  bottom: 10rpx;
  left: 24rpx;
  right: 24rpx;
  height: 4rpx;
  border-radius: 4rpx;
  background: var(--wu-accent, #007aff);
}
.content-scope {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 14rpx;
  padding: 20rpx 25rpx;
  font-size: 21rpx;
  color: var(--wu-secondary, #86868b);
}
.scope-label,
.all-history {
  display: flex;
  align-items: center;
  gap: 7rpx;
}
.content-empty {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 92rpx 34rpx 110rpx;
  text-align: center;
}
.empty-icon {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 106rpx;
  height: 106rpx;
  margin-bottom: 25rpx;
  opacity: 0.48;
}
.empty-title {
  font-size: 28rpx;
  font-weight: 550;
  line-height: 1.5;
}
.empty-note {
  max-width: 570rpx;
  color: var(--wu-secondary, #86868b);
  font-size: 23rpx;
  line-height: 1.65;
  margin-top: 11rpx;
}
.empty-action {
  width: auto;
  display: inline-block;
  margin: 30rpx auto 0;
  padding: 12rpx 37rpx;
  border: 1rpx solid var(--wu-separator, #dedee3);
  border-radius: 38rpx;
  background: transparent;
  color: var(--wu-text, #1d1d1f);
  font-size: 26rpx;
  font-weight: 550;
  line-height: 1.5;
  min-height: 0;
}
.content-error {
  padding: 70rpx 38rpx;
  text-align: center;
  font-size: 24rpx;
  color: var(--wu-secondary, #86868b);
  line-height: 1.7;
}
.content-grid {
  display: grid;
  grid-template-columns: repeat(2, minmax(0, 1fr));
  align-items: start;
  gap: 16rpx;
  padding: 0 20rpx 20rpx;
}
.content-card {
  overflow: hidden;
  border-radius: 18rpx;
  background: var(--wu-bg, #f5f5f7);
}
.content-card-body {
  padding: 24rpx 22rpx 22rpx;
}
.content-card-context {
  color: var(--wu-secondary, #86868b);
  font-size: 20rpx;
  line-height: 1.45;
  margin-bottom: 14rpx;
}
.content-card-text {
  overflow: hidden;
  display: -webkit-box;
  -webkit-box-orient: vertical;
  -webkit-line-clamp: 7;
  font-size: 28rpx;
  font-weight: 550;
  line-height: 1.6;
  white-space: pre-wrap;
  overflow-wrap: break-word;
}
.content-card-media {
  display: flex;
  align-items: center;
  gap: 7rpx;
  margin-top: 20rpx;
  color: var(--wu-secondary, #86868b);
  font-size: 19rpx;
  line-height: 1.5;
}
.content-card-footer {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 10rpx;
  padding: 0 22rpx 22rpx;
  color: var(--wu-secondary, #86868b);
  font-size: 20rpx;
}
.content-card-author {
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}
.content-card-likes {
  display: flex;
  align-items: center;
  gap: 5rpx;
  flex-shrink: 0;
}
.card-pressed {
  opacity: 0.65;
}
.content-note {
  padding: 18rpx 30rpx;
  color: var(--wu-secondary, #86868b);
  font-size: 21rpx;
  line-height: 1.6;
}
.content-pagination {
  display: flex;
  justify-content: center;
  gap: 20rpx;
  margin: 18rpx 30rpx 35rpx;
}
.page-button {
  margin: 0;
  padding: 12rpx 28rpx;
  background: var(--wu-bg, #f5f5f7);
  border-radius: 30rpx;
  font-size: 23rpx;
  color: var(--wu-text, #1d1d1f);
  min-height: 0;
}
.menu-backdrop {
  position: fixed;
  inset: 0;
  z-index: 110;
  background: rgba(0, 0, 0, 0.28);
}
.profile-menu {
  position: fixed;
  top: 0;
  bottom: 0;
  left: 0;
  width: 79vw;
  max-width: 79vw;
  z-index: 111;
  background: var(--wu-surface, #fff);
  box-shadow: 10rpx 0 80rpx rgba(0, 0, 0, 0.08);
  padding-bottom: env(safe-area-inset-bottom);
  box-sizing: border-box;
}
.menu-heading {
  display: flex;
  justify-content: flex-end;
  padding: 0 20rpx;
  height: 54rpx;
}
.menu-scroll {
  height: calc(100% - 310rpx - env(safe-area-inset-top));
}
.menu-row {
  display: flex;
  align-items: center;
  gap: 20rpx;
  padding: 25rpx 32rpx;
}
.menu-icon {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 52rpx;
  height: 52rpx;
  flex-shrink: 0;
}
.menu-row-copy {
  min-width: 0;
  flex: 1;
}
.menu-row-title {
  font-size: 28rpx;
  font-weight: 550;
}
.avatar-preview {
  position: fixed;
  inset: 0;
  z-index: 120;
  display: flex;
  justify-content: center;
  align-items: center;
  background: rgba(0, 0, 0, 0.94);
}
.avatar-preview-close {
  position: absolute;
  top: 26rpx;
  right: 22rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  width: 76rpx;
  height: 76rpx;
  min-height: 0;
  margin: 0;
  padding: 0;
  background: transparent;
}
.avatar-preview-image {
  width: 100vw;
  height: 72vh;
}
.avatar-preview-status {
  color: #fff;
  font-size: 26rpx;
}
@media (prefers-color-scheme: dark) {
  .profile-cover {
    background: var(--wu-surface, #fff);
  }
  .profile-avatar,
  .profile-avatar[disabled] {
    background: #3a3b41;
    border-color: #4a4b50;
  }
  .profile-campus,
  .profile-uid,
  .public-profile-link,
  .shortcut-note,
  .profile-notice {
    color: #aaaab2;
  }
  .edit-profile,
  .settings-button {
    border-color: #66656c;
  }
  .shortcut {
    background: rgba(255, 255, 255, 0.06);
  }
}

.content-thumbnail-box {
  position: relative;
  width: 100%;
  background: var(--wu-bg, #f5f5f7);
}
.content-thumbnail,
.content-thumbnail-placeholder {
  position: absolute;
  inset: 0;
  width: 100%;
  height: 100%;
}
.content-thumbnail-placeholder {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  gap: 12rpx;
  color: var(--wu-secondary, #86868b);
  font-size: 20rpx;
}

.content-modes {
  display: flex;
  align-items: center;
  gap: 31rpx;
  padding: 0 30rpx;
  border-bottom: 1rpx solid var(--wu-separator, #ededf0);
}
.content-mode {
  min-height: 0;
  margin: 0;
  padding: 23rpx 9rpx;
  border: 0;
  border-radius: 0;
  background: transparent;
  color: var(--wu-secondary, #86868b);
  font-size: 28rpx;
  line-height: 1.5;
  font-weight: 400;
}
.content-mode-active {
  color: var(--wu-text, #1d1d1f);
  font-weight: 550;
}

.menu-footer {
  position: absolute;
  bottom: calc(30rpx + env(safe-area-inset-bottom));
  left: 0;
  right: 0;
  display: flex;
  justify-content: space-around;
}
.menu-footer-item {
  width: 31%;
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 17rpx;
  padding: 0;
  margin: 0;
  font-size: 22rpx;
  color: var(--wu-secondary);
  background: transparent;
  line-height: 1.4;
}
.menu-footer-item::after {
  border: 0;
}
.menu-footer-icon {
  width: 78rpx;
  height: 78rpx;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  background: var(--wu-bg, #f5f5f7);
}
