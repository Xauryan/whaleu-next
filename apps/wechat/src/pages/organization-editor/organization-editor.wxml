<view class="screen">
 <view class="eyebrow">WHALEU · 组织</view><view class="title">{{publicRead ? '组织详情' : id ? '组织管理与审核' : '申请新组织'}}</view>
 <view wx:if="{{stateLabel}}" class="meta">{{stateLabel}} · {{roleLabel}} · 内容版本 {{revision}} · 权限版本 {{authorityVersion}}</view>
 <view wx:if="{{error}}" class="error">{{error}}</view><view wx:if="{{status}}" class="notice">{{status}}</view>
 <view wx:if="{{pending}}" class="card"><view>有一笔组织操作尚未确认。处理完成前不能发送新操作。</view><button bindtap="onRecover" disabled="{{busy}}">恢复原操作结果</button><button bindtap="onRetry" disabled="{{busy}}">重试同一请求</button><button bindtap="onCancelPending" disabled="{{busy}}">取消原请求</button></view>
 <button bindtap="onRefresh" disabled="{{busy}}">重新加载</button>
 <view wx:if="{{publicDetail}}" class="card"><view class="section-title">{{publicDetail.data.name}}</view><view>{{publicDetail.data.introText}}</view><view wx:if="{{publicDetail.data.platform === 'qq'}}">QQ群号：{{publicDetail.data.qqGroupNumber}}</view><navigator wx:if="{{publicDetail.management.available}}" url="/pages/organization-editor/organization-editor?id={{id}}">管理此组织 →</navigator></view>
 <view wx:if="{{form}}" class="card">
  <view wx:if="{{!id}}"><button data-kind="school" bindtap="onKind">校园群</button><button data-kind="org" bindtap="onKind">组织社团</button><button data-kind="official" bindtap="onKind">公众号</button><view>当前类型：{{form.kind}}</view>
   <view wx:if="{{form.kind !== 'official'}}"><button data-platform="qq" bindtap="onPlatform">QQ群</button><button data-platform="wechat" bindtap="onPlatform">微信群</button></view><view>当前平台：{{form.platform}}</view>
   <view wx:for="{{categories}}" wx:key="id"><button data-id="{{item.id}}" bindtap="onCategory">{{item.name}} {{form.categoryId === item.id ? '已选择' : ''}}</button></view><button wx:if="{{moreCategories}}" bindtap="onMoreCategories">更多分类</button>
  </view>
  <input data-field="name" value="{{form.name}}" bindinput="onField" maxlength="20" placeholder="名称，最多10字" disabled="{{busy || pending || (detail &amp;&amp; !detail.permissions.edit)}}" />
  <textarea data-field="introText" value="{{form.introText}}" bindinput="onField" maxlength="2000" placeholder="介绍，最多1000字" disabled="{{busy || pending || (detail &amp;&amp; !detail.permissions.edit)}}" />
  <input wx:if="{{form.platform === 'qq'}}" data-field="qqGroupNumber" value="{{form.qqGroupNumber}}" bindinput="onField" maxlength="16" placeholder="5–16位QQ群号" disabled="{{busy || pending || (detail &amp;&amp; !detail.permissions.edit)}}" />
 </view>
 <view wx:if="{{pendingImages.length}}" class="card"><view class="section-title">尚未解决的原图片上传</view><view class="notice">按原内容版本恢复或取消。旧版本图片不能自动套用到新内容。取消未绑定上传不会撤销已提交的组织修改，已绑定图片仅确认历史结果。</view><view wx:for="{{pendingImages}}" wx:key="key"><view>{{item.label}} · 原内容版本 {{item.applicationRevision}}</view><button data-slot="{{item.slot}}" data-revision="{{item.applicationRevision}}" data-action="recover" bindtap="onPendingImage" disabled="{{busy || pending || upload.status === 'working'}}">恢复原图片请求</button><button data-slot="{{item.slot}}" data-revision="{{item.applicationRevision}}" data-action="cancel" bindtap="onPendingImage" disabled="{{busy || pending || upload.status === 'working'}}">取消原图片请求</button></view></view>
 <view wx:if="{{upload.message}}" class="notice">{{upload.message}} {{upload.progress}}%</view>
 <view wx:for="{{slots}}" wx:key="slot" class="card"><view>{{item.label}} · {{item.configured ? '已配置' : '未配置'}} · {{item.change === 'replace' ? '待替换' : item.change === 'remove' ? '待移除' : '保持当前'}}</view>
  <button wx:if="{{item.configured}}" data-slot="{{item.slot}}" bindtap="onPreviewImage">查看当前图片</button>
  <view wx:if="{{detail &amp;&amp; detail.permissions.edit &amp;&amp; !publicRead}}"><button data-slot="{{item.slot}}" bindtap="onPickImage" disabled="{{busy || pending || upload.status === 'working'}}">选择并审核图片</button><button data-slot="{{item.slot}}" bindtap="onRecoverImage" disabled="{{busy || pending}}">恢复原上传</button><button data-slot="{{item.slot}}" bindtap="onCancelImage" disabled="{{busy || pending}}">取消原上传</button><button data-slot="{{item.slot}}" bindtap="onRemoveImage" disabled="{{busy || pending}}">保存时移除</button><button data-slot="{{item.slot}}" bindtap="onKeepImage" disabled="{{busy || pending}}">保持当前</button></view>
 </view>
 <view wx:if="{{image.message}}" class="notice">{{image.message}}</view><view wx:if="{{image.src}}" class="card"><image src="{{image.src}}" mode="widthFix" /><button bindtap="onCloseImage">关闭图片</button></view>
 <view wx:if="{{form &amp;&amp; (!detail || detail.permissions.edit)}}"><button bindtap="onSave" loading="{{busy}}" disabled="{{busy || pending}}">{{id ? '保存修改' : '保存申请草稿'}}</button><button wx:if="{{detail &amp;&amp; detail.permissions.submit}}" bindtap="onSubmit" disabled="{{busy || pending}}">提交学校管理员审核</button></view>
 <view wx:if="{{detail &amp;&amp; detail.permissions.review}}" class="card"><view>请核对完整申请。业务审批不会代替图片安全审核。</view><textarea value="{{reason}}" bindinput="onReason" maxlength="500" placeholder="拒绝理由（拒绝时必填）" /><button bindtap="onApprove" disabled="{{busy || pending}}">批准并授予申请人唯一所有权</button><button bindtap="onReject" disabled="{{busy || pending}}">拒绝申请</button></view>
 <view wx:if="{{detail &amp;&amp; detail.members.length}}" class="card"><view class="section-title">管理成员</view><view wx:for="{{detail.members}}" wx:key="grantId"><view>{{item.profile ? item.profile.displayName : '资料暂不可用'}} · {{item.role === 'organization_owner' ? '所有者' : '管理员'}}</view><button wx:if="{{detail &amp;&amp; detail.permissions.manageMembers &amp;&amp; item.profile &amp;&amp; item.role !== 'organization_owner'}}" data-id="{{item.profile.profileId}}" bindtap="onRemoveAdmin" disabled="{{busy || pending}}">移除管理员</button></view></view>
 <view wx:if="{{detail &amp;&amp; detail.permissions.manageMembers}}" class="card"><input value="{{lookupInput}}" bindinput="onLookupInput" placeholder="对方公开主页ID" /><button bindtap="onLookup" disabled="{{busy || pending}}">查找本校认证成员</button><view wx:if="{{person}}">{{person.displayName}}<button bindtap="onAddAdmin" disabled="{{busy || pending}}">添加管理员</button><view wx:if="{{detail &amp;&amp; detail.permissions.transferOwner}}"><view class="notice">转让后真实旧所有者降为管理员；唯一所有权交给此成员，请核对接收人。</view><button bindtap="onTransfer" disabled="{{busy || pending}}">转让所有权给此成员</button></view></view></view>
 <navigator url="/pages/organizations/organizations">我管理的组织与申请 →</navigator>
</view>
