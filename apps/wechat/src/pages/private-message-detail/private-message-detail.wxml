<view class="screen">
  <view class="eyebrow">WHALEU · 文字私信</view><view class="status" aria-role="status">{{status}}</view><view wx:if="{{error}}" class="error" aria-role="alert">{{error}}</view>
  <navigator wx:if="{{!hasSession}}" class="link" url="/pages/login/login">登录后使用私信</navigator>
  <view wx:if="{{needsOpen}}" class="card"><view class="section-title">确认私信身份</view><view class="notice">本次使用{{openingMode === 'anonymous' ? '此帖子内的分身身份' : '公开身份'}}。身份在会话创建后不会切换，原内容和发送资格仍需重新核验。</view><button bindtap="onOpen" disabled="{{busy || pending}}">确认身份并打开会话</button></view>
  <view wx:if="{{conversation}}" class="card"><view class="title">{{conversation.peer.displayName}}</view><view class="identity-banner">我：{{conversation.self.displayName}}（{{conversation.self.mode === 'anonymous' ? '本帖分身' : '公开身份'}}）
对方：{{conversation.peer.displayName}}（{{conversation.peer.mode === 'anonymous' ? '本帖分身' : '公开身份'}}）</view>
    <button wx:if="{{conversation.peer.mode === 'named' &amp;&amp; conversation.peer.profileId}}" bindtap="onProfile" disabled="{{busy}}">查看公开主页</button><button wx:if="{{conversation.source &amp;&amp; conversation.source.available}}" bindtap="onSource" disabled="{{busy}}">查看来源帖子</button><view wx:if="{{conversation.source &amp;&amp; !conversation.source.available}}" class="notice">来源帖子当前不可打开，会话历史独立保留。</view>
    <view class="notice">{{sendReason}}</view><view class="row"><button data-kind="{{conversation.hidden ? 'reopen' : 'hide'}}" bindtap="onAction" disabled="{{busy || pending}}">{{conversation.hidden ? '重新显示会话' : '隐藏会话'}}</button><button wx:if="{{!conversation.blockedByYou}}" data-kind="block" bindtap="onAction" disabled="{{busy || pending}}">{{conversation.blockScope === 'named' ? '拉黑公开身份用户' : '屏蔽此会话'}}</button></view>
  </view>
  <button wx:if="{{!needsOpen}}" bindtap="onReload" disabled="{{busy}}">刷新会话</button><button wx:if="{{busy}}" bindtap="onCancel">停止等待（不撤销请求）</button>
  <button wx:if="{{browsingOlder || hasNewMessages}}" bindtap="onLatest" disabled="{{busy}}">{{hasNewMessages ? '有新消息，回到最新' : '回到最新消息'}}</button>
  <scroll-view class="history" scroll-y="true" scroll-into-view="{{anchor}}" scroll-with-animation="false"><button wx:if="{{canMore}}" bindtap="onMore" disabled="{{busy}}">载入更早消息</button><view wx:if="{{loaded &amp;&amp; !messages.length}}" class="empty">还没有消息</view>
    <view wx:for="{{messages}}" wx:key="id" id="message-{{item.id}}" class="message {{item.sender === 'self' ? 'self' : 'peer'}}"><view class="meta">{{item.sender === 'self' ? '我' : conversation.peer.displayName}} · {{item.createdAt}}</view><text class="body" selectable="{{item.state === 'text'}}">{{item.state === 'text' ? item.text : item.state === 'recalled' ? '消息已撤回' : '消息暂不可查看'}}</text><view class="row"><button wx:if="{{item.state === 'text'}}" size="mini" data-id="{{item.id}}" bindtap="onCopy" disabled="{{busy}}">复制</button><button wx:if="{{item.canRecall}}" size="mini" data-kind="recall" data-id="{{item.id}}" bindtap="onAction" disabled="{{busy || pending}}">撤回</button></view></view>
  </scroll-view>
  <view wx:if="{{conversation}}" class="card"><textarea value="{{text}}" maxlength="-1" bindinput="onText" disabled="{{busy || pending}}" placeholder="文字私信，最多 500 个字符 / 2000 字节" /><button bindtap="onSend" disabled="{{busy || pending || !canSend || !text}}">发送文字</button><button wx:if="{{canReedit}}" bindtap="onReedit" disabled="{{busy || pending}}">重新编辑刚撤回的文字</button></view>
  <view wx:if="{{confirm}}" class="confirm" aria-role="dialog"><view class="notice">{{confirm.description}}</view><button bindtap="onConfirm" disabled="{{busy || pending}}">确认</button><button bindtap="onDismiss">取消</button></view>
  <navigator class="link" url="/pages/private-message-recovery/private-message-recovery">{{pending ? '原请求待确认，请到恢复页查询或按原内容重试 →' : '查看私信请求恢复 →'}}</navigator>
  <navigator class="link" url="/pages/private-message-list/private-message-list">返回私信列表 →</navigator><view wx:if="{{coverage === 'local'}}" class="notice">当前为已核验的本地历史范围，旧版完整历史尚未迁移。</view><view class="notice">图片和站外通知投递尚未开放。退出登录、切换账号或离开页面会清除当前显示与临时草稿；待确认请求的原文在退出登录或切换账号时清除，最小请求凭据保留供原账号查询或安全取消。</view>
</view>
