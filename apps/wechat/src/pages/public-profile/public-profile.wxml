<import src="../../profile/named-avatar.wxml" />
<import src="../../experience/public-display.wxml" />
<import src="./personal-recovery.wxml" />
<import src="../../community/trading-summary.wxml" />
<view class="public-profile-screen f7-ios-theme personal-native">
  <view class="profile-page-header">
    <wu-f7-button class="profile-refresh" disabled="{{busy}}" loading="{{busy}}" aria-label="刷新公开主页" bind:press="onReload" variant="plain">
      <wu-icon name="refresh" tone="accent" size="21" />
    </wu-f7-button>
  </view>
  <view wx:if="{{busy || !loaded}}" class="status" aria-role="status">{{status}}</view>
  <view wx:if="{{error}}" class="error" aria-role="alert">{{error}}</view>
  <wu-f7-button wx:if="{{busy}}" class="secondary" bind:press="onCancel" variant="tonal">停止加载</wu-f7-button>
  <template is="block-recovery" data="{{block}}" />
  <view wx:if="{{follow.receiptStatus}}" class="notice" aria-role="status">{{follow.receiptStatus}}</view>
  <wu-f7-block wx:if="{{noProfile}}" class="notice" strong="{{true}}" inset="{{true}}" spacing="compact">
    当前账号尚无公开主页资料。这不代表没有发布记录。
  </wu-f7-block>
  <view wx:if="{{selfEntry || profile &amp;&amp; profile.isOwn}}" class="profile-owner-actions">
    <navigator class="link" url="/pages/profile/profile">
      编辑资料
      <wu-icon name="chevron-right" tone="accent" size="14" />
    </navigator>
    <navigator class="link" url="/pages/community-mine/community-mine">
      我的发布
      <wu-icon name="chevron-right" tone="accent" size="14" />
    </navigator>
    <navigator class="link" url="/pages/community-liked/community-liked">
      我的点赞
      <wu-icon name="chevron-right" tone="accent" size="14" />
    </navigator>
    <navigator class="link" url="/pages/community-saved/community-saved">
      我的收藏
      <wu-icon name="chevron-right" tone="accent" size="14" />
    </navigator>
  </view>
  <view wx:if="{{profile &amp;&amp; profile.status === 'blocked_by_you'}}" class="card">
    <view class="notice">你已拉黑此用户，资料与主页内容已隐藏。</view>
    <wu-f7-button disabled="{{busy || block.busy || block.frozen}}" bind:press="onUnblockProfile" variant="plain">解除我的拉黑</wu-f7-button>
  </view>
  <view wx:if="{{profile &amp;&amp; profile.status === 'unavailable'}}" class="notice">此主页当前不可查看。可稍后重新加载。</view>
  <view wx:if="{{loaded &amp;&amp; profile &amp;&amp; profile.status !== 'available' &amp;&amp; follow.frozen}}" class="notice follow-recovery">
    <view>关注操作结果待确认。主页暂不可查看，可重试原操作查询结果。</view>
    <view wx:if="{{follow.error}}" class="error">{{follow.error}}</view>
    <wu-f7-button wx:if="{{follow.recoveryProfileId === profile.profileId}}" class="secondary" disabled="{{busy || block.busy || block.frozen || follow.busy}}" bind:press="onFollowRetry" variant="tonal">重试原操作</wu-f7-button>
    <navigator wx:elif="{{follow.recoveryProfileId}}" class="quiet-link" url="/pages/public-profile/public-profile?profileId={{follow.recoveryProfileId}}">
      回原公开主页处理
    </navigator>
    <wu-f7-button wx:if="{{follow.busy}}" class="profile-refresh" bind:press="onFollowCancel" variant="plain">停止等待</wu-f7-button>
  </view>
  <block wx:if="{{loaded &amp;&amp; !busy &amp;&amp; !block.busy &amp;&amp; !block.frozen}}">
    <block wx:if="{{profile &amp;&amp; profile.status === 'available'}}">
      <view class="profile-overview">
        <image wx:if="{{coverRead.localSrc}}" class="public-cover-image" src="{{coverRead.localSrc}}" mode="aspectFill" binderror="onCoverError" aria-label="主页背景图" show-menu-by-longpress="{{false}}" />
        <view class="profile-avatar-wrap">
          <image wx:if="{{avatarRead.localSrc}}" class="profile-avatar" src="{{avatarRead.localSrc}}" mode="aspectFit" bindtap="onOpenAvatar" binderror="onAvatarError" show-menu-by-longpress="{{false}}" />
          <view class="profile-avatar profile-avatar-placeholder" aria-label="{{avatarRead.status === 'none' ? '尚未选择头像' : '头像暂不可用'}}" wx:else="">
            <wu-icon name="person" tone="accent" size="42" />
          </view>
        </view>
        <view class="profile-name">
          {{profile.displayName}}
          <text wx:if="{{profile.isOwn}}" class="self-label">我</text>
        </view>
        <template is="public-experience-display" data="{{display:profile.experienceDisplay,colors:experienceColorStyles,detailed:false}}" />
        <view wx:if="{{profile.affiliation}}" class="profile-school">
          <wu-icon name="campus" tone="accent" size="16" />
          <text>{{profile.affiliation.schoolName}}</text>
        </view>
        <view wx:if="{{profile.schoolUidStatus === 'assigned' &amp;&amp; profile.publicUid}}" class="profile-public-uid">
          <text selectable="true">UID {{profile.publicUid.formatted}}</text>
        </view>
        <view wx:if="{{profile.bio}}" class="profile-bio">
          <text selectable="true">{{profile.bio}}</text>
        </view>
        <view wx:if="{{loaded &amp;&amp; !busy &amp;&amp; !block.busy &amp;&amp; !block.frozen &amp;&amp; publicDetails.details &amp;&amp; publicDetails.details.profileId === profile.profileId &amp;&amp; (publicDetails.details.region !== null || publicDetails.details.gender !== null || publicDetails.details.age !== null)}}" class="profile-metadata">
          <view wx:if="{{publicDetails.details.region !== null}}" class="profile-metadata-chip">
            <wu-icon name="location" size="15" tone="muted" />
            <text>{{publicDetails.details.region}}</text>
          </view>
          <view wx:if="{{publicDetails.details.gender !== null}}" class="profile-metadata-chip" aria-label="{{profileGenderLabels[publicDetails.details.gender]}}">
            <wu-icon name="{{publicDetails.details.gender === 'male' ? 'male' : 'female'}}" size="18" tone="{{publicDetails.details.gender === 'male' ? 'blue' : 'pink'}}" />
          </view>
          <view wx:if="{{publicDetails.details.age !== null}}" class="profile-metadata-chip">
            <text>{{publicDetails.details.age}}岁</text>
          </view>
        </view>
        <view wx:if="{{!profile.postsHidden}}" class="profile-stats">
          <view>
            <text class="profile-stat-value">{{profile.postCountStatus === 'known' ? profile.postCount : '—'}}</text>
            <text>公开主题</text>
          </view>
          <view>
            <text class="profile-stat-value">{{profile.tradeCountStatus === 'known' ? profile.tradeCount : '—'}}</text>
            <text>公开交易</text>
          </view>
        </view>
        <view class="notice" wx:else="">对方已隐藏主页主题与交易。</view>
        <view wx:if="{{!profile.isOwn}}" class="profile-actions">
          <wu-f7-button wx:if="{{hasSession}}" class="{{follow.following ? 'secondary' : 'primary'}} follow-button" disabled="{{busy || block.busy || block.frozen || follow.busy || follow.frozen || follow.following === null}}" loading="{{follow.busy}}" bind:press="onFollow" variant="{{follow.following ? 'tonal' : 'fill'}}">
            <wu-icon name="{{follow.following ? 'check' : 'plus'}}" tone="{{follow.following ? 'accent' : 'inverse'}}" size="18" />
            <text>{{follow.frozen ? '结果待确认' : follow.following === null ? '关注状态未知' : follow.following ? '已关注' : '关注'}}</text>
          </wu-f7-button>
          <navigator class="primary follow-button" url="/pages/login/login" wx:else="">
            登录后关注
          </navigator>
          <wu-f7-button class="secondary message-button" disabled="{{busy || block.busy || block.frozen}}" bind:press="onPrivateMessage" variant="tonal">
            <wu-icon name="message" tone="accent" size="18" />
            <text>私信</text>
          </wu-f7-button>
        </view>
        <view wx:if="{{hasSession &amp;&amp; !profile.isOwn &amp;&amp; follow.status &amp;&amp; (follow.busy || follow.frozen)}}" class="profile-follow-status" aria-role="status">{{follow.status}}</view>
        <view wx:if="{{follow.error}}" class="error" aria-role="alert">{{follow.error}}</view>
        <view wx:if="{{follow.frozen}}" class="notice follow-recovery">
          <view>这次{{follow.recoveryFollowing ? '关注' : '取消关注'}}结果待确认。重试只会继续原操作。</view>
          <wu-f7-button wx:if="{{follow.recoveryProfileId === profile.profileId}}" class="secondary" disabled="{{busy || block.busy || block.frozen || follow.busy}}" bind:press="onFollowRetry" variant="tonal">重试原操作</wu-f7-button>
          <navigator wx:elif="{{follow.recoveryProfileId}}" class="quiet-link" url="/pages/public-profile/public-profile?profileId={{follow.recoveryProfileId}}">
            回原公开主页处理
          </navigator>
        </view>
        <wu-f7-button wx:if="{{hasSession &amp;&amp; !profile.isOwn &amp;&amp; !follow.busy &amp;&amp; !follow.frozen &amp;&amp; follow.following === null}}" class="profile-refresh" disabled="{{busy || block.busy || block.frozen}}" bind:press="onFollowReload" variant="plain">刷新关注状态</wu-f7-button>
        <wu-f7-button wx:if="{{follow.busy}}" class="profile-refresh" bind:press="onFollowCancel" variant="plain">停止等待</wu-f7-button>
      </view>
      <view wx:if="{{avatarRead.expanded &amp;&amp; avatarRead.localSrc}}" class="avatar-overlay">
        <image src="{{avatarRead.localSrc}}" mode="aspectFit" binderror="onAvatarError" show-menu-by-longpress="{{false}}" />
        <button bindtap="onCloseAvatar">
          关闭预览
        </button>
      </view>
      <view class="profile-details">
        <button class="profile-details-toggle" aria-expanded="{{showProfileDetails}}" bindtap="onProfileDetails">
          主页信息
          <wu-icon name="{{showProfileDetails ? 'chevron-up' : 'chevron-down'}}" size="14" />
        </button>
        <view wx:if="{{showProfileDetails}}" class="profile-information">
          <view class="meta">获赞与收藏总数暂不可用。</view>
          <view class="meta">这里只展示当前可查看的公开身份主题与交易。分身、隐藏或删除的发布仅保留在本人记录中；已解决交易不在主页展示。</view>
          <view wx:if="{{profile.schoolUidStatus !== 'assigned'}}" class="meta">UID {{profile.schoolUidStatus === 'unassigned' ? '尚未分配' : '暂不可核验'}}</view>
          <navigator class="link" url="/pages/school-identity-management/school-identity-management?targetProfileId={{profile.profileId}}">
            学校归属管理
          </navigator>
          <navigator class="link" url="/pages/school-admin-management/school-admin-management?targetProfileId={{profile.profileId}}">
            学校管理员管理
          </navigator>
          <wu-f7-button wx:if="{{hasSession &amp;&amp; !profile.isOwn}}" class="secondary" disabled="{{busy || block.busy || block.frozen}}" bind:press="onBlockProfile" variant="tonal">拉黑此用户</wu-f7-button>
        </view>
      </view>
      <block wx:if="{{!profile.postsHidden}}">
        <view class="profile-tabs">
          <wu-f7-button class="chip {{tab === 'posts' ? 'active' : ''}}" data-key="posts" bind:press="onTab" variant="{{tab === 'posts' ? 'tonal' : 'plain'}}">主题</wu-f7-button>
          <wu-f7-button class="chip {{tab === 'trading' ? 'active' : ''}}" data-key="trading" bind:press="onTab" variant="{{tab === 'trading' ? 'tonal' : 'plain'}}">交易</wu-f7-button>
        </view>
        <view wx:if="{{tab === 'trading'}}" class="chips">
          <wu-f7-button class="chip {{!tradingSubtype ? 'active' : ''}}" data-key="" bind:press="onTradingSubtype" variant="{{!tradingSubtype ? 'tonal' : 'plain'}}">全部交易</wu-f7-button>
          <wu-f7-button wx:for="{{tradingCategories}}" wx:key="key" class="chip {{tradingSubtype === item.key ? 'active' : ''}}" data-key="{{item.key}}" bind:press="onTradingSubtype" variant="{{tradingSubtype === item.key ? 'tonal' : 'plain'}}">{{item.label}}</wu-f7-button>
        </view>
        <view wx:if="{{total !== null}}" class="meta">当前可查看 {{total}} 条</view>
        <view wx:elif="{{loaded &amp;&amp; totalStatus === 'unavailable'}}" class="meta">总数暂不可用</view>
        <view wx:for="{{items}}" wx:key="id" class="profile-post-row">
          <view wx:if="{{item.author.kind === 'named'}}" class="author">
            <wu-f7-button class="profile-post-avatar" aria-label="查看公开身份头像" data-id="{{item.id}}" disabled="{{busy || block.busy || block.frozen}}" bind:press="onPostAvatar" variant="plain">
              <wu-icon name="person" tone="accent" size="22" />
            </wu-f7-button>
            <text>{{item.author.displayName}}</text>
            <template wx:if="{{item.author.kind === 'named'}}" is="public-experience-display" data="{{display:item.author.experienceDisplay,colors:experienceColorStyles}}" />
          </view>
          <view class="meta">{{item.space.name}} · {{item.publishedAt}}</view>
          <view class="profile-post-body">
            <text>{{item.text}}</text>
          </view>
          <template wx:if="{{item.trading}}" is="trading-summary" data="{{listing:item.trading,tradingLabels}}" />
          <view wx:if="{{item.images.length}}" class="notice">图片暂不可用</view>
          <view class="profile-post-stats">
            <view>
              <wu-icon name="heart" size="16" />
              {{item.likeCount}}
            </view>
            <view aria-label="{{item.commentCount === null ? '回复数量暂不可用' : item.commentCount + ' 条根回复'}}">
              <wu-icon name="message" size="16" />
              {{item.commentCount === null ? '—' : item.commentCount}}
            </view>
            <view>
              <wu-icon name="bookmark" size="16" />
              {{item.saveCount}}
            </view>
          </view>
          <navigator wx:if="{{hasSession}}" class="link" url="/pages/community-detail/community-detail?postId={{item.id}}">
            查看帖子
            <wu-icon name="chevron-right" tone="accent" size="14" />
          </navigator>
          <navigator class="link" url="/pages/login/login" wx:else="">
            登录后查看详情
            <wu-icon name="chevron-right" tone="accent" size="14" />
          </navigator>
        </view>
        <view wx:if="{{loaded &amp;&amp; total === 0 &amp;&amp; continuation === 'end'}}" class="empty">还没有可展示的公开主题或交易。</view>
        <view wx:elif="{{continuation === 'scan_pending'}}" class="notice">还有历史内容尚未查看。</view>
        <view wx:elif="{{continuation === 'end'}}" class="meta">已到本次浏览末尾</view>
        <view wx:if="{{pageNumber}}" class="meta">第 {{pageNumber}} 页</view>
        <wu-f7-button wx:if="{{canPrevious}}" disabled="{{busy}}" bind:press="onPrevious" variant="plain">上一页</wu-f7-button>
        <wu-f7-button wx:if="{{canLoadMore}}" disabled="{{busy}}" bind:press="onMore" variant="plain">{{continuation === 'scan_pending' ? '继续查看' : '下一页'}}</wu-f7-button>
      </block>
    </block>
  </block>
  <template is="named-avatar-preview" data="{{avatar:namedAvatar}}" />
</view>
