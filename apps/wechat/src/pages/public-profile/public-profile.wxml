<import src="../../profile/named-avatar.wxml" />
<import src="../../experience/public-display.wxml" />
<import src="../../community/block-recovery.wxml" />
<import src="../../community/trading-summary.wxml" />
<view class="screen"><button wx:if="{{loaded &amp;&amp; profile.status === 'available' &amp;&amp; !profile.isOwn}}" bindtap="onPrivateMessage" disabled="{{busy || block.busy || block.frozen}}">以公开身份私信</button>
  <view class="eyebrow">WHALEU · 公开主页</view><view class="title">校园里的你</view>
  <view class="status" aria-role="status">{{status}}</view><view wx:if="{{error}}" class="error" aria-role="alert">{{error}}</view>
  <button bindtap="onReload" disabled="{{busy}}" loading="{{busy}}">重新加载主页</button><button wx:if="{{busy}}" bindtap="onCancel">停止加载</button>
  <template is="block-recovery" data="{{block}}" />
  <view wx:if="{{noProfile}}" class="notice">当前账号尚无公开主页资料。这不代表没有发布记录。</view>
  <view wx:if="{{selfEntry || profile.isOwn}}" class="actions"><navigator class="link" url="/pages/profile/profile">编辑我的资料与主页隐私 →</navigator><navigator class="link" url="/pages/community-mine/community-mine">我的全部发布与结果恢复 →</navigator><navigator class="link" url="/pages/community-liked/community-liked">我的点赞历史 →</navigator><navigator class="link" url="/pages/community-saved/community-saved">我的收藏 →</navigator></view>
  <view wx:if="{{profile.status === 'blocked_by_you'}}" class="card"><view class="notice">你已拉黑此用户，资料与主页内容已隐藏。</view><button bindtap="onUnblockProfile" disabled="{{busy || block.busy || block.frozen}}">解除我的拉黑</button></view>
  <view wx:if="{{profile.status === 'unavailable'}}" class="notice">此主页当前不可查看。可稍后重新加载。</view>
  <block wx:if="{{profile.status === 'available'}}">
    <view class="card"><image wx:if="{{avatarRead.localSrc}}" class="profile-avatar" src="{{avatarRead.localSrc}}" mode="aspectFit" bindtap="onOpenAvatar" binderror="onAvatarError" show-menu-by-longpress="{{false}}" /><view wx:else class="meta">{{avatarRead.status === 'none' ? '尚未选择头像' : '头像当前不可显示'}}</view><view wx:if="{{avatarRead.expanded &amp;&amp; avatarRead.localSrc}}" class="avatar-overlay"><image src="{{avatarRead.localSrc}}" mode="aspectFit" binderror="onAvatarError" show-menu-by-longpress="{{false}}" /><button bindtap="onCloseAvatar">关闭预览</button></view><view class="author"><text>{{profile.displayName}}</text><text wx:if="{{profile.isOwn}}" class="badge">我</text><template is="public-experience-display" data="{{display:profile.experienceDisplay,colors:experienceColorStyles,detailed:true}}" /></view><view class="body"><text selectable="true">{{profile.bio || '尚未填写简介'}}</text></view>
      <view class="meta">认证机构、公开 UID：暂不可用</view><view class="meta">获赞与码住：暂不可用</view>
      <view wx:if="{{!profile.postsHidden}}" class="meta">当前公开帖子 {{profile.postCountStatus === 'known' ? profile.postCount : '总数暂不可用'}} · 当前公开交易 {{profile.tradeCountStatus === 'known' ? profile.tradeCount : '总数暂不可用'}}</view>
      <view wx:else class="notice">对方已隐藏主页帖子与交易。普通信息流与可用直接链接的访问另行核验。</view>
      <button wx:if="{{hasSession &amp;&amp; !profile.isOwn}}" bindtap="onBlockProfile" disabled="{{busy || block.busy || block.frozen}}">拉黑此用户</button>
    </view>
    <block wx:if="{{!profile.postsHidden}}">
      <view class="chips"><view class="chip {{tab === 'posts' ? 'active' : ''}}" data-key="posts" bindtap="onTab">公开帖子</view><view class="chip {{tab === 'trading' ? 'active' : ''}}" data-key="trading" bindtap="onTab">公开交易</view></view>
      <view wx:if="{{tab === 'trading'}}" class="chips"><view class="chip {{!tradingSubtype ? 'active' : ''}}" data-key="" bindtap="onTradingSubtype">全部交易</view><view wx:for="{{tradingCategories}}" wx:key="key" class="chip {{tradingSubtype === item.key ? 'active' : ''}}" data-key="{{item.key}}" bindtap="onTradingSubtype">{{item.label}}</view></view>
      <view wx:if="{{total !== null}}" class="meta">此列表当前可查看 {{total}} 条</view>
      <view wx:elif="{{loaded &amp;&amp; totalStatus === 'unavailable'}}" class="meta">此列表的准确总数暂不可用，不代表没有记录。</view>
      <view wx:for="{{items}}" wx:key="id" class="card"><view wx:if="{{item.author.kind === 'named'}}" class="author"><button size="mini" data-id="{{item.id}}" bindtap="onPostAvatar" disabled="{{busy || block.busy || block.frozen}}">查看头像</button><text>{{item.author.displayName}}</text><template wx:if="{{item.author.kind === 'named'}}" is="public-experience-display" data="{{display:item.author.experienceDisplay,colors:experienceColorStyles}}" /></view><view class="meta">{{item.space.name}} · {{item.publishedAt}}</view><view class="body"><text>{{item.text}}</text></view><template wx:if="{{item.trading}}" is="trading-summary" data="{{listing:item.trading,tradingLabels}}" /><view wx:if="{{item.images.length}}" class="notice">图片暂不可用，等待安全下载接入</view><navigator wx:if="{{hasSession}}" class="link" url="/pages/community-detail/community-detail?postId={{item.id}}">查看帖子与讨论 →</navigator><navigator wx:else class="link" url="/pages/login/login">登录后查看详情 →</navigator></view>
      <view wx:if="{{loaded &amp;&amp; total === 0 &amp;&amp; continuation === 'end'}}" class="empty">当前没有可展示的公开身份内容。</view>
      <view wx:elif="{{continuation === 'scan_pending'}}" class="notice">本次核验尚未到历史末尾。点击继续查看，核验下一批；暂未显示记录不代表历史为空。</view>
      <view wx:elif="{{continuation === 'end'}}" class="meta">已到本次浏览末尾。新发布或状态变化请重新加载查看。</view>
      <view wx:if="{{pageNumber}}" class="meta">第 {{pageNumber}} 页 · 每次翻页重新核验</view><button wx:if="{{canPrevious}}" bindtap="onPrevious" disabled="{{busy}}">上一页</button><button wx:if="{{canLoadMore}}" bindtap="onMore" disabled="{{busy}}">{{continuation === 'scan_pending' ? '继续查看' : '下一页'}}</button>
      <view class="notice">主页仅展示当前可查看的公开身份内容。匿名、隐藏、删除的发布保留在本人记录中；已解决交易不在主页发现列表中。</view>
    </block>
  </block>
<template is="named-avatar-preview" data="{{avatar:namedAvatar}}" />
</view>
