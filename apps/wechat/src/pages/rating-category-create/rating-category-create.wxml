<import src="../../ratings/framework7-recovery-common.wxml" />
<view class="screen management-page rating-category-create f7-ios-theme f7-rating-recovery">
  <wu-f7-block class="f7-recovery-content" spacing="compact">
  <view class="management-context">
    <view class="management-context-icon">
      <wu-icon name="plus" tone="accent" size="22" />
    </view>
    <view class="management-context-copy">
      <view class="context-title">
        {{parentName || (regionId ? '当前地区' : '全局分类')}}
      </view>
      <view class="meta">
        创建普通评分分类
      </view>
    </view>
  </view>
  <view class="notice">
    仅当前具有对应管理授权的账号可提交。浏览地区、身份标签或目录可见性不能证明管理资格。
  </view>
  <template is="rating-status" data="{{status,error,receiptStatus,hasSession,frozen,recoveryOperation,busy,needsRefresh}}" />
  <block wx:if="{{ready &amp;&amp; !frozen}}">
    <view class="card scope management-scope">
      <view class="section-title">
        本次精确发布范围
      </view>
      <view>
        {{regionId ? '地区完整校区集合' : '全局分类及全部当前已映射地区'}}
      </view>
      <view wx:if="{{regionId}}" class="meta">
        地区 ID：{{regionId}}
      </view>
      <view class="meta">
        服务器核验的受影响校区：{{campusIds.length}} 个
      </view>
      <view wx:for="{{campusIds}}" wx:key="*this" class="scope-id">
        {{item}}
      </view>
      <view wx:if="{{!campusIds.length}}" class="notice">
        当前没有已映射的受影响校区，仅发布全局目录。
      </view>
      <view class="notice">
        该集合由服务器完整核验，提交前后若授权、校区映射、目录或父分类变化，必须重新核验。
      </view>
    </view>
    <view wx:if="{{!creationConfirmation}}" class="card">
      <view class="section-title">
        连接位置
      </view>
      <wu-f7-button data-id="" bind:press="onParent" disabled="{{busy}}" class="management-action management-choice {{!parentId ? 'is-selected' : ''}}" variant="{{!parentId ? 'fill' : 'tonal'}}">
        {{!parentId ? '已选：' : ''}}新建根分类
      </wu-f7-button>
      <wu-f7-button wx:for="{{parents}}" wx:key="id" data-id="{{item.id}}" bind:press="onParent" disabled="{{busy}}" class="management-action management-choice {{parentId === item.id ? 'is-selected' : ''}}" variant="{{parentId === item.id ? 'fill' : 'tonal'}}">
        {{parentId === item.id ? '已选：' : ''}}{{item.name}}（第 {{item.level}} 级，{{item.id}}）
      </wu-f7-button>
      <view class="notice">
        父分类选项仅包含同一来源范围内、当前审核有效的原生分类。树总深度最多三级。
      </view>
    </view>
    <view class="card">
      <view class="section-title">
        {{creationConfirmation ? '确认整棵分类树' : '编辑分类树'}} · {{nodes.length}} / 32 项
      </view>
      <view>
        {{parentId ? '连接到：' + parentName : '新建根分类'}}
      </view>
      <view wx:if="{{parentId}}" class="meta">
        父分类 ID：{{parentId}}
      </view>
      <view wx:for="{{nodes}}" wx:key="key" class="category-node">
        <view class="meta">
          第 {{item.level}} 级 · {{item.key}}{{item.parentKey ? ' · 上级节点：' + item.parentKey : ' · 本次树根'}}
        </view>
        <block wx:if="{{!creationConfirmation}}">
          <wu-f7-input value="{{item.name}}" data-key="{{item.key}}" bind:input="onName" maxlength="200" placeholder="分类名称（1–100 字）" disabled="{{busy}}"  />
          <textarea value="{{item.description}}" data-key="{{item.key}}" bindinput="onDescription" maxlength="1000" placeholder="分类说明（0–500 字）" disabled="{{busy}}" />
          <wu-f7-button wx:if="{{item.level &lt; 3}}" data-key="{{item.key}}" bind:press="onAddChild" disabled="{{busy || nodes.length &gt;= 32}}" class="management-action" variant="tonal">
            添加子分类
          </wu-f7-button>
          <wu-f7-button wx:if="{{item.parentKey}}" data-key="{{item.key}}" bind:press="onRemoveNode" disabled="{{busy}}" class="management-action" variant="tonal">
            移除此节点及子分类
          </wu-f7-button>
        </block>
        <block wx:else>
          <view class="section-title">
            {{item.name}}
          </view>
          <view class="body">
            {{item.description}}
          </view>
        </block>
      </view>
      <wu-f7-button wx:if="{{!creationConfirmation}}" bind:press="onCreate" disabled="{{busy}}" class="management-primary" variant="fill" size="large">
        检查范围与分类树
      </wu-f7-button>
    </view>
    <view wx:if="{{creationConfirmation}}" class="card confirmation management-confirmation" aria-role="alert">
      <view class="section-title">
        确认提交以上范围与全部 {{nodes.length}} 个分类？
      </view>
      <view class="notice">
        仅创建普通分类。整棵树须通过精确审核后才可一起发布；审核待定时不会显示为发布成功。停止等待不会撤销已发送的申请。
      </view>
      <wu-f7-button bind:press="onConfirmCreate" disabled="{{busy}}" loading="{{busy}}" class="management-primary" variant="fill" size="large">
        确认提交分类树
      </wu-f7-button>
      <wu-f7-button bind:press="onDismissCreate" class="management-quiet" variant="plain">
        返回编辑
      </wu-f7-button>
    </view>
  </block>
  <wu-f7-button wx:if="{{frozen &amp;&amp; canCancelCategoryCreation &amp;&amp; !cancelCategoryCreationConfirmation}}" bind:press="onCancelCategoryCreation" disabled="{{busy}}" class="management-action" variant="tonal">
    明确撤销原分类申请
  </wu-f7-button>
  <view wx:if="{{cancelCategoryCreationConfirmation}}" class="card confirmation management-confirmation" aria-role="alert">
    <view class="section-title">
      撤销原编号、原范围和原分类树的申请？
    </view>
    <view class="notice">
      仅关闭尚未发布的原申请，不会回退已经发布的分类。已发布结果优先；撤销结果未知时仍保留原请求。
    </view>
    <wu-f7-button bind:press="onConfirmCancelCategoryCreation" disabled="{{busy}}" class="management-destructive" variant="tonal" tone="danger">
      确认撤销原分类申请
    </wu-f7-button>
    <wu-f7-button bind:press="onDismissCancelCategoryCreation" disabled="{{busy}}" class="management-action" variant="plain">
      继续保留原申请
    </wu-f7-button>
  </view>
  <wu-f7-button bind:press="onReturnCatalog" class="management-quiet" variant="plain">
    返回评分目录
  </wu-f7-button>
  </wu-f7-block>
</view>
