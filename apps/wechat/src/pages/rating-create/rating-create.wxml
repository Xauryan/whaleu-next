<import src="../../ratings/framework7-product.wxml" />
<view class="screen rating-product f7-ios-theme f7-rating-product">
  <wu-f7-block class="product-state" spacing="compact">
    <template is="product-rating-status" data="{{status,error,receiptStatus,hasSession,frozen,recoveryOperation,busy,needsRefresh,loaded:ready}}" />
  </wu-f7-block>
  <view wx:if="{{ready}}" class="product-form-canvas">
    <wu-f7-input class="product-title-input" value="{{name}}" maxlength="200" disabled="{{busy || frozen}}" placeholder="对象名称" bind:input="onName" />
    <textarea class="product-body-input" value="{{description}}" bindinput="onDescription" maxlength="1000" disabled="{{busy || frozen}}" placeholder="介绍一下它，让大家更容易找到（选填）" />
    <view class="meta">
      名称 100 字 · 说明 500 字 · 纯文字
    </view>
    <wu-f7-button class="primary" disabled="{{busy || frozen || !name}}" bind:press="onCreate" variant="fill" size="large">
      提交申请
    </wu-f7-button>
  </view>
  <view wx:if="{{canCancelCreation}}" class="product-recovery">
    <wu-f7-button disabled="{{busy}}" bind:press="onCancelCreation" variant="tonal">
      撤销未完成的申请
    </wu-f7-button>
    <view wx:if="{{cancelCreationConfirmation}}">
      <view class="notice">
        停止这次创建？尚未完成的申请将被关闭。若已创建成功，不会删除对象。
      </view>
      <wu-f7-button disabled="{{busy}}" bind:press="onConfirmCancelCreation" variant="tonal">
        确认撤销
      </wu-f7-button>
      <wu-f7-button disabled="{{busy}}" bind:press="onDismissCancelCreation" variant="tonal">
        保留申请
      </wu-f7-button>
    </view>
  </view>
  <view class="product-end">
    <navigator url="/pages/rating-catalog/rating-catalog" class="link">
      返回目录
    </navigator>
  </view>
</view>
