<import src="../../ratings/framework7-product.wxml" />
<view class="screen rating-product has-dock f7-ios-theme f7-rating-product">
  <view class="product-heading product-toolbar">
    <view class="meta">
      校园评分
    </view>
    <wu-f7-button class="plain-button" data-panel="more" aria-label="更多评分操作" bind:press="onTogglePanel" variant="plain">
      <wu-icon name="more" size="20" />
    </wu-f7-button>
  </view>
  <view wx:if="{{uiPanel === 'more'}}" class="product-disclosure">
    <navigator class="link" url="/pages/rating-recovery/rating-recovery">
      查询上次操作
    </navigator>
    <wu-f7-button wx:if="{{hasSession}}" bind:press="onOwnerEditing" variant="tonal">
      编辑我创建的对象
    </wu-f7-button>
    <wu-f7-button wx:if="{{hasSession}}" bind:press="onOwnerDeletion" variant="tonal">
      删除我创建的对象
    </wu-f7-button>
  </view>
  <wu-f7-block class="product-state" spacing="compact">
    <template is="product-rating-status" data="{{status,error,receiptStatus,hasSession,frozen,recoveryOperation,busy,needsRefresh,loaded}}" />
  </wu-f7-block>
  <view wx:if="{{!loaded &amp;&amp; hasSession &amp;&amp; configured}}">
    <wu-f7-button class="plain-button" data-panel="sort" bind:press="onTogglePanel" variant="plain">
      切换排序
    </wu-f7-button>
  </view>
  <view wx:if="{{uiPanel === 'sort'}}" class="product-tabs">
    <wu-f7-button data-sort="time" data-order="desc" disabled="{{frozen || !hasSession || !configured}}" bind:press="onSort" variant="tonal">
      最新
    </wu-f7-button>
    <wu-f7-button data-sort="time" data-order="asc" disabled="{{frozen || !hasSession || !configured}}" bind:press="onSort" variant="tonal">
      最早
    </wu-f7-button>
    <wu-f7-button data-sort="likes" data-order="desc" disabled="{{frozen || !hasSession || !configured}}" bind:press="onSort" variant="tonal">
      赞最多
    </wu-f7-button>
    <wu-f7-button data-sort="likes" data-order="asc" disabled="{{frozen || !hasSession || !configured}}" bind:press="onSort" variant="tonal">
      赞最少
    </wu-f7-button>
  </view>
  <block wx:if="{{loaded &amp;&amp; detail}}">
    <view class="product-hero">
      <view class="title">
        {{detail.name}}
      </view>
      <view wx:if="{{detail.description}}" class="body">
        {{detail.description}}
      </view>
      <view wx:if="{{!summary || summary.status === 'unavailable'}}" class="notice">
        评分数据暂不可用
      </view>
      <block wx:else>
        <view wx:if="{{summary.count === 0}}" class="meta">
          暂无评分
        </view>
        <view class="product-score-summary" wx:else>
          <view class="product-score-number">
            {{summary.average}}
          </view>
          <view>
            <view class="product-score-caption">
              满分 5 分
            </view>
            <view class="meta">
              {{summary.count}} 人评分
            </view>
          </view>
          <wu-f7-button class="plain-button" data-panel="distribution" bind:press="onTogglePanel" variant="plain">
            评分分布
            <wu-icon name="chevron-right" size="16" />
          </wu-f7-button>
        </view>
        <view wx:if="{{uiPanel === 'distribution'}}" class="product-disclosure">
          <view wx:for="{{scores}}" wx:key="*this" class="product-distribution">
            <text>
              {{item}} 分
            </text>
            <text>
              {{summary.distribution[item]}} 人
            </text>
          </view>
        </view>
      </block>
      <view class="product-inline-actions">
        <wu-f7-button data-panel="score" bind:press="onTogglePanel" variant="tonal">
          {{!myScoreKnown ? '查看我的评分' : myScore ? '我的评分 · ' + myScore.score : '我要评分'}}
        </wu-f7-button>
        <block wx:if="{{subscriptions[detail.id] &amp;&amp; subscriptions[detail.id].status === 'known'}}">
          <view class="meta">
            {{subscriptions[detail.id].count}} 人码住
          </view>
          <wu-f7-button class="plain-button" data-id="{{detail.id}}" disabled="{{busy || frozen}}" bind:press="onSubscription" variant="plain">
            {{subscriptions[detail.id].subscribed ? '取消码住' : '码住'}}
          </wu-f7-button>
        </block>
        <block wx:else>
          <view class="meta">
            订阅状态暂不可用
          </view>
          <wu-f7-button class="plain-button" disabled="{{true}}" variant="plain">
            码住暂不可用
          </wu-f7-button>
        </block>
      </view>
    </view>
    <view wx:if="{{uiPanel === 'score'}}" class="product-disclosure">
      <view class="section-title">
        我的评分
      </view>
      <view wx:if="{{!myScoreKnown}}" class="notice">
        暂未确认你的评分，请刷新后再试。
      </view>
      <view wx:elif="{{myScore}}" class="meta">
        当前 {{myScore.score}} 分，可重新选择
      </view>
      <view class="meta" wx:else>
        选择 1–5 分
      </view>
      <view wx:if="{{myScoreKnown &amp;&amp; detail.allowedActions.setScore}}" class="product-score-scale">
        <wu-f7-button wx:for="{{scores}}" wx:key="*this" class="{{myScore &amp;&amp; myScore.score === item ? 'score-selected' : 'secondary'}}" data-score="{{item}}" disabled="{{busy || frozen}}" bind:press="onScore" variant="{{myScore &amp;&amp; myScore.score === item ? 'fill' : 'tonal'}}">
          {{item}}
        </wu-f7-button>
      </view>
      <view wx:if="{{!detail.allowedActions.setScore}}" class="notice">
        当前暂不能评分，请刷新后再试。
      </view>
      <view class="meta">
        评分与文字评价分别提交
      </view>
    </view>
    <view class="product-section-heading">
      <view class="section-title">
        文字评价
      </view>
      <wu-f7-button class="plain-button" data-panel="sort" bind:press="onTogglePanel" variant="plain">
        {{commentSort === 'time' ? (commentOrder === 'desc' ? '最新' : '最早') : (commentOrder === 'desc' ? '赞最多' : '赞最少')}}
        <wu-icon name="chevron-down" size="16" />
      </wu-f7-button>
    </view>
    <view wx:for="{{comments}}" wx:key="id" class="product-comment">
      <view class="author">
        {{item.author.displayName}}
        <text class="badge">
          {{item.author.mode === 'anonymous' ? '分身' : '公开'}}
        </text>
        <text wx:if="{{item.isMine}}" class="badge">
          我
        </text>
      </view>
      <view class="meta">
        {{timeLabels[item.id]}}
      </view>
      <view class="body">
        {{item.body}}
      </view>
      <view class="product-inline-actions">
        <template is="product-rating-like" data="{{state:likes[item.id],id:item.id,busy,frozen}}" />
        <wu-f7-button class="plain-button" data-id="{{item.id}}" disabled="{{busy || frozen}}" bind:press="onDiscussion" variant="plain">
          回复
        </wu-f7-button>
        <wu-f7-button class="plain-button" data-panel="comment:{{item.id}}" aria-label="更多评价操作" bind:press="onTogglePanel" variant="plain">
          <wu-icon name="more" size="20" />
        </wu-f7-button>
      </view>
      <view wx:if="{{uiPanel === 'comment:' + item.id}}" class="product-disclosure">
        <wu-f7-button data-id="{{item.id}}" disabled="{{busy || frozen}}" bind:press="onDeletionOptions" variant="tonal">
          删除选项
        </wu-f7-button>
        <wu-f7-button wx:if="{{item.isMine &amp;&amp; item.allowedActions.delete}}" data-id="{{item.id}}" disabled="{{busy || frozen}}" bind:press="onDelete" variant="tonal">
          删除我的评价
        </wu-f7-button>
      </view>
    </view>
    <view wx:if="{{!comments.length}}" class="empty">
      还没有文字评价
    </view>
    <wu-f7-button wx:if="{{canMoreComments}}" disabled="{{busy}}" bind:press="onMoreComments" variant="tonal">
      加载更多评价
    </wu-f7-button>
    <view wx:if="{{detail.allowedActions.createComment}}" class="product-dock">
      <wu-f7-button class="primary" wx:if="{{detail.allowedActions.createComment}}" disabled="{{busy || frozen}}" bind:press="onCompose" variant="fill" size="large">
        写评价
      </wu-f7-button>
    </view>
  </block>
  <view wx:if="{{selectedScore !== null}}" class="modal-mask">
    <view class="modal">
      <view class="section-title">
        提交 {{selectedScore}} 分？
      </view>
      <view class="notice">
        只修改评分，不发布文字。若评分已在其他设备更新，请刷新后重新确认。
      </view>
      <wu-f7-button class="primary" disabled="{{busy || frozen}}" loading="{{busy}}" bind:press="onConfirmScore" variant="fill" size="large">
        确认评分
      </wu-f7-button>
      <wu-f7-button bind:press="onDismissScore" variant="tonal">
        取消
      </wu-f7-button>
    </view>
  </view>
  <view wx:if="{{composerOpen &amp;&amp; detail}}" class="modal-mask">
    <view class="modal">
      <view class="section-title">
        写评价
      </view>
      <view class="product-tabs">
        <wu-f7-button wx:for="{{detail.allowedActions.authorModes}}" wx:key="*this" data-mode="{{item}}" class="{{authorMode === item ? 'selected' : ''}}" disabled="{{busy || frozen}}" bind:press="onAuthorMode" variant="{{authorMode === item ? 'fill' : 'tonal'}}">
          {{item === 'named' ? '公开' : '分身'}}
        </wu-f7-button>
      </view>
      <view wx:if="{{!authorMode}}" class="notice">
        请选择发布身份
      </view>
      <textarea value="{{text}}" bindinput="onText" maxlength="-1" disabled="{{busy || frozen}}" placeholder="分享你的真实体验" />
      <view class="meta">
        {{textLength}} / 500 字符 · 仅支持文字
      </view>
      <wu-f7-button class="primary" disabled="{{busy || frozen || !authorMode || textLength &lt; 1 || textLength &gt; 500}}" loading="{{busy}}" bind:press="onPublish" variant="fill" size="large">
        发布评价
      </wu-f7-button>
      <wu-f7-button bind:press="onCloseComposer" variant="tonal">
        关闭并清空
      </wu-f7-button>
    </view>
  </view>
  <view wx:if="{{deleteId}}" class="modal-mask">
    <view class="modal">
      <view class="section-title">
        删除我的评价？
      </view>
      <view class="notice">
        这条评价及其全部回复将不再显示，评分仍保留。
      </view>
      <wu-f7-button disabled="{{busy || frozen}}" loading="{{busy}}" bind:press="onConfirmDelete" variant="tonal" tone="danger">
        确认删除
      </wu-f7-button>
      <wu-f7-button bind:press="onDismissDelete" variant="tonal">
        返回
      </wu-f7-button>
    </view>
  </view>
</view>
