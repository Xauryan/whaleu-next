<view class="screen rating-product f7-ios-theme f7-rating-recovery">
  <wu-f7-block class="f7-recovery-content" spacing="compact">
  <view class="product-heading product-toolbar"
    ><wu-f7-button
      class="plain-button"
      data-panel="info"
      bind:press="onTogglePanel"
      aria-label="随机选择说明"
     variant="plain">
      <wu-icon name="more" size="20" />
    </wu-f7-button></view
  >
  <view wx:if="{{uiPanel === 'info'}}" class="product-disclosure"
    ><view class="meta"
      >每次从完整候选范围独立随机选择，可能再次选中同一个对象。指定最低均分时，只有达到条件的已评分对象才会参与；统计无法确认时不会进行抽取。</view
    ></view
  >
  <view wx:if="{{!loaded || busy}}" class="status" aria-role="status"
    >{{status}}</view
  ><view wx:if="{{error}}" class="error" aria-role="alert">{{error}}</view
  ><navigator wx:if="{{!hasSession}}" class="link" url="/pages/login/login"
    >登录后继续</navigator
  >
  <view class="product-toolbar"
    ><wu-f7-button class="plain-button" bind:press="onRefresh" variant="plain">重选条件</wu-f7-button><wu-f7-button class="plain-button" wx:if="{{busy}}" bind:press="onCancel" variant="plain">
      停止等待
    </wu-f7-button></view
  >
  <block wx:if="{{categoryId &amp;&amp; hasSession &amp;&amp; configured}}">
    <view wx:if="{{result}}" class="product-hero">
      <block wx:if="{{result.item}}"
        ><view class="meta">这次选中了</view
        ><view class="title">{{result.item.target.name}}</view
        ><view class="body">{{result.item.target.description}}</view>
        <block wx:if="{{result.item.summary.status === 'known'}}"
          ><view
            wx:if="{{result.item.summary.count &gt; 0}}"
            class="product-score-summary"
            ><view class="product-score-number"
              >{{result.item.summary.average}}</view
            ><view class="meta"
              >{{result.item.summary.count}} 人评分</view
            ></view
          ><view wx:else class="meta">暂无评分</view></block
        ><view wx:else class="notice">评分数据暂不可用</view>
        <view class="meta"
          >{{result.item.regionId ? '学校校区地区目录' : '全局目录'}} · 从
          {{result.candidateCount}} 个候选中选出</view
        ><wu-f7-button class="primary" bind:press="onTarget" disabled="{{busy}}" variant="fill" size="large">
          查看评分与评价
        </wu-f7-button> </block
      ><view wx:else class="empty">没有符合条件的对象，试试放宽筛选</view>
    </view>
    <view class="product-section"
      ><view class="product-section-heading"
        ><view class="section-title"
          >{{campus ? campus.institutionName : '全局范围'}}</view
        ><wu-f7-button
          class="plain-button"
          data-panel="scope"
          bind:press="onTogglePanel"
         variant="plain">
          选择范围
        </wu-f7-button></view
      ><view wx:if="{{campus}}" class="meta"
        >{{campus.fullName}} · 包含所属学校全部校区地区与全局</view
      >
      <view wx:if="{{uiPanel === 'scope'}}" class="product-disclosure"
        ><wu-f7-button bind:press="onGlobal" variant="tonal">仅全局</wu-f7-button><wu-f7-button bind:press="onCampusPicker" disabled="{{pickerOpen}}" variant="tonal">
          选择学校与校区</wu-f7-button><view class="meta">范围独立选择，不沿用目录或身份校区。</view></view
      >
      <view class="section-title">最低均分</view
      ><wu-f7-input
        type="digit"
        value="{{minimumAverageInput}}"
        bind:input="onMinimumAverage"
        placeholder="不限；1–5 分，最多一位小数"
       />
      <wu-f7-button
        class="primary"
        bind:press="onDraw"
        loading="{{busy &amp;&amp; !pickerOpen}}"
        disabled="{{busy || pickerOpen}}"
       variant="fill" size="large">
        {{result ? '再选一个' : '随机选一个'}}
      </wu-f7-button>
    </view>
    <view wx:if="{{pickerOpen}}" class="modal-mask"
      ><view class="modal"
        ><view class="section-title">选择学校与校区</view
        ><wu-f7-input
          value="{{campusQuery}}"
          bind:input="onCampusQuery"
          placeholder="学校或校区名称"
         /><wu-f7-input
          value="{{campusDistrict}}"
          bind:input="onCampusDistrict"
          placeholder="地区（选填）"
         /><wu-f7-button bind:press="onSearchCampuses" disabled="{{busy}}" variant="tonal">
          搜索校区
        </wu-f7-button>
        <view wx:for="{{campuses}}" wx:key="id" class="product-list-row"
          ><view class="section-title">{{item.fullName}}</view
          ><view class="meta">{{item.institutionName}} · {{item.district}}</view
          ><wu-f7-button
            data-id="{{item.id}}"
            bind:press="onChooseCampus"
            disabled="{{busy || !item.isActive || !item.institutionId}}"
           variant="tonal">
            {{item.isActive ? item.institutionId ? '选择此校区所属学校' :
            '暂不可选择' : '暂不可选择'}}
          </wu-f7-button></view
        >
        <wu-f7-button
          wx:if="{{hasPreviousCampuses}}"
          bind:press="onPreviousCampuses"
          disabled="{{busy}}"
         variant="tonal">
          上一页</wu-f7-button><wu-f7-button
          wx:if="{{hasNextCampuses}}"
          bind:press="onNextCampuses"
          disabled="{{busy}}"
         variant="tonal">
          下一页</wu-f7-button><wu-f7-button bind:press="onCloseCampusPicker" variant="plain">关闭选择</wu-f7-button>
      </view></view
    >
  </block>
  </wu-f7-block>
</view>
