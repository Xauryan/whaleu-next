<import src="../../ratings/common.wxml" />
<view class="screen"><view class="eyebrow">WHALEU · 评分结果恢复</view><view class="title">确认原请求的结果</view>
  <view class="notice">仅查询当前账号的原请求。目标已隐藏、文字已删除或当前地区不可访问时，仍可恢复已提交的最小回执；不会显示旧正文或把历史分值当作当前评分。</view>
  <template is="rating-status" data="{{status,error,receiptStatus,hasSession,frozen,recoveryOperation,busy,needsRefresh}}" />
  <view wx:if="{{loaded &amp;&amp; !frozen}}" class="card">{{receiptStatus ? '历史操作结果已确认。请重新进入当前目标读取最新状态。' : '当前账号没有待确认的评分操作。'}}</view>
  <navigator wx:if="{{frozen}}" class="link" url="/pages/target-owner-edit/target-owner-edit">创建者编辑申请恢复与撤销 →</navigator>
  <navigator wx:if="{{frozen}}" class="link" url="/pages/target-owner-delete/target-owner-delete">创建者删除申请恢复与撤销 →</navigator>
  <navigator wx:if="{{frozen}}" class="link" url="/pages/rating-category-manage/rating-category-manage?scope=global">分类管理原请求：预览、确认与取消 →</navigator>
  <navigator wx:if="{{frozen}}" class="link" url="/pages/rating-category-create/rating-category-create">分类创建申请恢复与撤销 →</navigator>
  <navigator wx:if="{{frozen}}" class="link" url="/pages/rating-create/rating-create">创建申请恢复与撤销 →</navigator>
  <navigator class="link" url="/pages/rating-scoped/rating-scoped?mode=catalog&amp;scope=global">进入校园范围评分目录 →</navigator>
  <navigator class="link" url="/pages/rating-catalog/rating-catalog">重新进入原地区评分目录 →</navigator>
</view>

<navigator url="/pages/rating-discussion-media/rating-discussion-media?recovery=1">评分图片原请求恢复（旧版本未决优先）</navigator>
