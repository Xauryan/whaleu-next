<import src="../../ratings/common.wxml" />
<view class="screen">
  <view class="eyebrow">WHALEU · 校园范围评分</view><view class="title">{{scopeLabel}}</view>
  <template is="rating-status" data="{{status,error,receiptStatus,hasSession,frozen,recoveryOperation,busy,needsRefresh}}" />
  <view wx:if="{{frozen &amp;&amp; canCancelPending}}" class="card"><button bindtap="onRequestCancelPending" disabled="{{busy}}">明确取消原创建 / 编辑请求</button><block wx:if="{{cancelPendingConfirmation}}"><view class="notice">服务端确认取消或返回原回执后才会释放请求编号。</view><button bindtap="onCancelPending" disabled="{{busy}}">确认取消原请求</button><button bindtap="onDismissCancelPending">返回</button></block></view>
  <view wx:if="{{mode !== 'recovery'}}" class="card"><view class="section-title">浏览范围</view><view class="notice">身份校区与浏览校园分别核验。选择校园不会授予发布或管理权限。随机选择覆盖该校园所属学校的全部校园和独立全局。</view><button bindtap="onOpenCampuses" disabled="{{busy || frozen}}">明确选择校园</button><button bindtap="onCampus" disabled="{{busy || frozen}}">选择独立全局</button><view wx:if="{{identityCampusId}}" class="meta">身份校区：{{identityCampusId}}</view><view wx:if="{{viewCampusId}}" class="meta">浏览校园：{{viewCampusId}}</view></view>
  <view wx:if="{{pickerOpen}}" class="card"><input value="{{campusQuery}}" bindinput="onCampusQuery" placeholder="搜索校园" /><button bindtap="onSearchCampuses" disabled="{{busy}}">搜索</button><button wx:for="{{campuses}}" wx:key="id" data-id="{{item.id}}" bindtap="onCampus" disabled="{{busy || !item.isActive}}">{{item.fullName}}</button><button wx:if="{{campusPage &gt; 1}}" bindtap="onPreviousCampuses" disabled="{{busy}}">上一页校园</button><button wx:if="{{hasMoreCampuses}}" bindtap="onNextCampuses" disabled="{{busy}}">下一页校园</button><button bindtap="onCloseCampuses">关闭并清空选择列表</button></view>
  <button wx:if="{{hasSession &amp;&amp; mode === 'catalog'}}" bindtap="onCategoryManagement" disabled="{{busy || frozen}}">分类管理：先核验当前明确范围的资格</button>
  <block wx:if="{{loaded &amp;&amp; !pickerOpen}}">
    <block wx:if="{{mode === 'catalog'}}"><view class="section-title">当前有效分类</view><view wx:for="{{categories}}" wx:key="id" class="card"><view class="section-title">{{item.name}}</view><view class="body">{{item.description}}</view><button data-mode="catalog" data-id="{{item.id}}" bindtap="onNavigate" disabled="{{busy || frozen}}">进入分类</button><button data-mode="random" data-id="{{item.id}}" bindtap="onNavigate" disabled="{{busy || frozen}}">随机选择：确认完整候选范围</button><button wx:if="{{item.kind === 'general'}}" data-mode="create" data-id="{{item.id}}" bindtap="onNavigate" disabled="{{busy || frozen}}">在此分类创建评分对象</button></view><button wx:if="{{canMoreCategories}}" bindtap="onMoreCategories" disabled="{{busy || frozen}}">继续读取分类</button></block>
    <block wx:if="{{mode === 'catalog' || mode === 'subscriptions'}}"><view wx:for="{{targets}}" wx:key="id" class="card"><view class="section-title">{{item.name}}</view><view class="body">{{item.description}}</view><button data-mode="detail" data-id="{{item.id}}" bindtap="onNavigate" disabled="{{busy || frozen}}">查看当前评分</button><button wx:if="{{subscriptions[item.id] &amp;&amp; subscriptions[item.id].status === 'known'}}" data-id="{{item.id}}" bindtap="onSubscription" disabled="{{busy || frozen}}">{{subscriptions[item.id].subscribed ? '取消订阅' : '订阅更新'}}</button></view><button wx:if="{{canMoreTargets}}" bindtap="onMoreTargets" disabled="{{busy || frozen}}">继续读取对象</button></block>
    <view wx:if="{{detail}}" class="card"><view class="title">{{detail.name}}</view><view class="body">{{detail.description}}</view><view wx:if="{{summary &amp;&amp; summary.status === 'known'}}" class="meta">{{summary.count}} 人评分 · {{summary.average === null ? '暂无均分' : summary.average}}</view><view wx:else class="notice">完整评分统计暂不可用</view><view wx:if="{{myScore}}" class="meta">我的评分：{{myScore.myScore ? myScore.myScore.score : '尚未评分'}}</view><view class="chips"><button wx:for="{{scores}}" wx:key="*this" data-score="{{item}}" bindtap="onScore" disabled="{{busy || frozen || !detail.allowedActions.setScore}}">{{item}} 分</button></view><button wx:if="{{subscriptions[detail.id] &amp;&amp; subscriptions[detail.id].status === 'known'}}" data-id="{{detail.id}}" bindtap="onSubscription" disabled="{{busy || frozen}}">{{subscriptions[detail.id].subscribed ? '取消订阅' : '订阅更新'}}</button><button data-mode="edit" bindtap="onNavigate" disabled="{{busy || frozen}}">创建者编辑：核验资格</button><button bindtap="onCleanup" disabled="{{busy || frozen}}">创建者删除：独立清理入口</button></view>
    <block wx:if="{{mode === 'detail'}}"><button wx:if="{{detail.allowedActions.createComment}}" bindtap="onCompose" disabled="{{busy || frozen}}">发布文字评价</button><view class="chips"><button data-sort="time" data-order="desc" bindtap="onSort" disabled="{{busy || frozen}}">最新评价</button><button data-sort="likes" data-order="desc" bindtap="onSort" disabled="{{busy || frozen}}">按赞排序</button></view><view wx:for="{{comments}}" wx:key="id" class="card"><view class="author">{{item.author.displayName}} · {{item.author.mode === 'anonymous' ? '本目标分身' : '实名'}}</view><view class="body">{{item.body}}</view><template is="rating-like" data="{{state:likes[item.id],id:item.id,busy,frozen}}" /><button data-mode="thread" data-id="{{item.id}}" bindtap="onNavigate" disabled="{{busy || frozen}}">评价讨论</button><button data-id="{{item.id}}" bindtap="onCleanup" disabled="{{busy || frozen}}">删除选项</button></view><button wx:if="{{canMoreComments}}" bindtap="onMoreComments" disabled="{{busy || frozen}}">继续读取评价</button></block>
    <block wx:if="{{mode === 'thread' &amp;&amp; discussion}}"><view class="card"><view class="author">{{discussion.root.author.displayName}}</view><view class="body">{{discussion.root.body}}</view><template is="rating-like" data="{{state:likes[discussion.root.id],id:discussion.root.id,busy,frozen}}" /><button wx:if="{{discussion.allowedActions.createReply}}" bindtap="onCompose" disabled="{{busy || frozen}}">回复评价</button><button data-id="{{discussion.root.id}}" bindtap="onCleanup" disabled="{{busy || frozen}}">原评价删除选项</button></view><view wx:for="{{replies}}" wx:key="id" class="card"><view class="author">{{item.author.displayName}}</view><view class="body">{{item.body}}</view><view wx:if="{{item.replyTo.kind === 'reply'}}" class="meta">{{item.replyTo.status === 'available' ? '回复当前可见引用' : '原回复当前不可见'}}</view><template is="rating-like" data="{{state:likes[item.id],id:item.id,busy,frozen}}" /><button wx:if="{{item.allowedActions.reply}}" data-id="{{item.id}}" bindtap="onCompose" disabled="{{busy || frozen}}">回复这一条</button><button data-id="{{item.id}}" bindtap="onCleanup" disabled="{{busy || frozen}}">回复删除选项</button></view><button wx:if="{{canMoreReplies}}" bindtap="onMoreReplies" disabled="{{busy || frozen}}">继续读取回复</button></block>
    <view wx:if="{{mode === 'create' || mode === 'edit'}}" class="card"><view class="section-title">{{mode === 'create' ? '创建评分对象' : '编辑评分对象'}}</view><input value="{{name}}" bindinput="onName" disabled="{{busy || frozen}}" maxlength="-1" placeholder="名称，最多 100 个字符" /><textarea value="{{description}}" bindinput="onDescription" disabled="{{busy || frozen}}" maxlength="-1" placeholder="描述，最多 500 个字符" /><button bindtap="onDefinitionConfirm" disabled="{{busy || frozen}}">核对并确认内容</button><block wx:if="{{definitionConfirmation}}"><view class="notice">本次提交绑定当前校园、分类和来源版本。提交后只能查询、重试或取消原请求。</view><button bindtap="onDefinitionCommit" disabled="{{busy || frozen}}">确认提交</button></block><button bindtap="onDefinitionDismiss">关闭并清空草稿</button></view>
    <view wx:if="{{mode === 'random'}}" class="card"><view class="section-title">{{scopeLabel}}</view><input value="{{minimumAverageInput}}" bindinput="onMinimumAverage" type="digit" placeholder="可选最低均分：1–5" disabled="{{busy || frozen}}" /><button bindtap="onDraw" disabled="{{busy || frozen}}">按完整范围随机选一个</button><block wx:if="{{randomResult}}"><view class="meta">满足条件的不同对象：{{randomResult.candidateCount}}</view><block wx:if="{{randomResult.item}}"><view class="section-title">{{randomResult.item.target.name}}</view><button bindtap="onRandomTarget" disabled="{{busy || frozen}}">按已核验展示范围打开</button></block></block></view>
    <block wx:if="{{mode === 'updates'}}"><view class="chips"><button data-kind="updates" bindtap="onNoticeKind" disabled="{{busy}}">回复更新</button><button data-kind="like-updates" bindtap="onNoticeKind" disabled="{{busy}}">赞更新</button><button data-kind="subscription-updates" bindtap="onNoticeKind" disabled="{{busy}}">订阅更新</button></view><view class="meta">{{unreadCount}} 条未读</view><view wx:for="{{notices}}" wx:key="noticeId" class="card"><view class="meta">{{item.createdAt}} · {{item.readAt ? '已读' : '未读'}}</view><view class="notice">历史更新保留；当前目标须在明确选择的范围重新核验。</view><button data-id="{{item.noticeId}}" bindtap="onNotice" disabled="{{busy || frozen}}">以当前范围核验并打开</button></view><button wx:if="{{canMoreNotices}}" bindtap="onMoreNotices" disabled="{{busy}}">继续读取更新</button></block>
  </block>
  <view wx:if="{{selectedScore !== null}}" class="modal-mask"><view class="modal"><view class="section-title">确认评分 {{selectedScore}} 分？</view><button bindtap="onConfirmScore" disabled="{{busy || frozen}}">确认评分</button><button bindtap="onDismissScore">关闭并清空</button></view></view>
  <view wx:if="{{composerOpen}}" class="modal-mask"><view class="modal"><view class="section-title">发布纯文字内容</view><button wx:for="{{authorModes}}" wx:key="*this" data-mode="{{item}}" bindtap="onAuthorMode" disabled="{{busy || frozen}}">{{item === 'named' ? '实名发布' : '本目标分身发布'}}</button><view wx:if="{{!authorMode}}" class="notice">请明确选择发布身份</view><textarea value="{{text}}" bindinput="onText" disabled="{{busy || frozen}}" maxlength="-1" placeholder="1–500 个字符" /><button bindtap="onPublish" disabled="{{busy || frozen || !authorMode || !text}}">确认发布</button><button bindtap="onCloseComposer">关闭并清空</button></view></view>
  <button class="link" data-mode="catalog" bindtap="onSection" disabled="{{busy || frozen}}">当前范围目录 →</button><button class="link" data-mode="updates" bindtap="onSection" disabled="{{busy || frozen}}">当前范围评分更新 →</button><button class="link" data-mode="subscriptions" bindtap="onSection" disabled="{{busy || frozen}}">当前范围已订阅对象 →</button><navigator class="link" url="/pages/rating-recovery/rating-recovery">全部版本原请求恢复 →</navigator>
  <view class="notice">新协议需服务端完整来源和部署能力。未激活范围保持不可用，历史恢复与独立删除入口保留。</view>
</view>
