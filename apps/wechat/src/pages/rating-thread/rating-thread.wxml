<import src="../../ratings/framework7-product.wxml" />
<view class="screen rating-product has-dock f7-ios-theme f7-rating-product">
  <view class="product-heading product-toolbar">
    <wu-f7-button class="plain-button" data-panel="more" aria-label="更多回复操作" bind:press="onTogglePanel" variant="plain">
      <wu-icon name="more" size="20" />
    </wu-f7-button>
  </view>
  <view wx:if="{{uiPanel === 'more'}}" class="product-disclosure">
    <wu-f7-button disabled="{{busy || frozen || !hasSession}}" bind:press="onDeletionOptions" variant="tonal">
      查找删除选项
    </wu-f7-button>
    <navigator class="link" url="/pages/rating-recovery/rating-recovery">
      查询上次操作
    </navigator>
    <navigator class="link" url="/pages/rating-updates/rating-updates">
      回复与赞更新
    </navigator>
  </view>
  <wu-f7-block class="product-state" spacing="compact">
    <template is="product-rating-status" data="{{status,error,receiptStatus,hasSession,frozen,recoveryOperation,busy,needsRefresh,loaded}}" />
  </wu-f7-block>
  <wu-f7-button wx:if="{{collapsed}}" disabled="{{busy || frozen}}" bind:press="onExpand" variant="tonal">
    展开回复
  </wu-f7-button>
  <block wx:if="{{loaded &amp;&amp; discussion &amp;&amp; detail}}">
    <view class="product-hero">
      <view class="title">
        {{detail.name}}
      </view>
      <view class="author">
        {{discussion.root.author.displayName}}
        <text class="badge">
          {{discussion.root.author.mode === 'anonymous' ? '分身' : '公开'}}
        </text>
      </view>
      <view class="meta">
        {{timeLabels[discussion.root.id]}}
      </view>
      <view class="body">
        {{discussion.root.body}}
      </view>
      <view class="product-inline-actions">
        <template is="product-rating-like" data="{{state:likes[discussion.root.id],id:discussion.root.id,busy,frozen}}" />
        <wu-f7-button class="plain-button" data-panel="root" aria-label="评价操作" bind:press="onTogglePanel" variant="plain">
          <wu-icon name="more" size="20" />
        </wu-f7-button>
      </view>
      <view wx:if="{{uiPanel === 'root'}}" class="product-disclosure">
        <wu-f7-button data-id="{{discussion.root.id}}" disabled="{{busy || frozen}}" bind:press="onDeletionOptions" variant="tonal">
          删除选项
        </wu-f7-button>
      </view>
    </view>
    <view class="product-section-heading">
      <view class="section-title">
        回复
      </view>
      <wu-f7-button class="plain-button" bind:press="onCollapse" variant="plain">
        收起
      </wu-f7-button>
    </view>
    <wu-f7-button class="plain-button" wx:if="{{anchorReplyId}}" disabled="{{busy || frozen}}" bind:press="onFirst" variant="plain">
      从最早的回复看起
    </wu-f7-button>
    <view wx:for="{{replies}}" wx:key="id" id="reply-{{item.id}}" class="product-comment {{anchorReplyId === item.id ? 'rating-anchor' : ''}}">
      <view class="author">
        {{item.author.displayName}}
        <text class="badge">
          {{item.author.mode === 'anonymous' ? '分身' : '公开'}}
        </text>
        <text wx:if="{{item.isMine}}" class="badge">
          我
        </text>
      </view>
      <view class="meta">
        {{timeLabels[item.id]}}
      </view>
      <view wx:if="{{item.replyTo.kind === 'root'}}" class="product-quote">
        回复这条评价
      </view>
      <view wx:elif="{{item.replyTo.status === 'available'}}" class="product-quote">
        回复 {{item.replyTo.author.displayName}}
        <text class="badge">
          {{item.replyTo.author.mode === 'anonymous' ? '分身' : '公开'}}
        </text>
      </view>
      <view class="product-quote" wx:else>
        原回复当前不可查看
      </view>
      <view class="body">
        {{item.body}}
      </view>
      <view class="product-inline-actions">
        <template is="product-rating-like" data="{{state:likes[item.id],id:item.id,busy,frozen}}" />
        <wu-f7-button class="plain-button" wx:if="{{item.allowedActions.reply}}" data-id="{{item.id}}" disabled="{{busy || frozen}}" bind:press="onReply" variant="plain">
          回复
        </wu-f7-button>
        <wu-f7-button class="plain-button" data-panel="reply:{{item.id}}" aria-label="更多回复操作" bind:press="onTogglePanel" variant="plain">
          <wu-icon name="more" size="20" />
        </wu-f7-button>
      </view>
      <view wx:if="{{uiPanel === 'reply:' + item.id}}" class="product-disclosure">
        <wu-f7-button data-id="{{item.id}}" disabled="{{busy || frozen}}" bind:press="onDeletionOptions" variant="tonal">
          删除选项
        </wu-f7-button>
        <wu-f7-button wx:if="{{item.isMine &amp;&amp; item.allowedActions.delete}}" data-id="{{item.id}}" disabled="{{busy || frozen}}" bind:press="onDelete" variant="tonal">
          删除我的回复
        </wu-f7-button>
      </view>
    </view>
    <view wx:if="{{!replies.length}}" class="empty">
      还没有回复
    </view>
    <wu-f7-button wx:if="{{canMore}}" disabled="{{busy || frozen}}" bind:press="onMore" variant="tonal">
      加载更多回复
    </wu-f7-button>
    <view wx:if="{{discussion.allowedActions.createReply}}" class="product-dock">
      <wu-f7-button class="primary" wx:if="{{discussion.allowedActions.createReply}}" disabled="{{busy || frozen}}" bind:press="onRootReply" variant="fill" size="large">
        回复这条评价
      </wu-f7-button>
    </view>
  </block>
  <view wx:if="{{composerOpen &amp;&amp; discussion}}" class="modal-mask">
    <view class="modal">
      <view class="section-title">
        回复 {{replyToName}}
      </view>
      <view class="product-tabs">
        <wu-f7-button wx:for="{{discussion.allowedActions.authorModes}}" wx:key="*this" data-mode="{{item}}" class="{{authorMode === item ? 'selected' : ''}}" disabled="{{busy || frozen}}" bind:press="onAuthorMode" variant="{{authorMode === item ? 'fill' : 'tonal'}}">
          {{item === 'named' ? '公开' : '分身'}}
        </wu-f7-button>
      </view>
      <view wx:if="{{!authorMode}}" class="notice">
        请选择发布身份
      </view>
      <textarea value="{{text}}" bindinput="onText" maxlength="-1" disabled="{{busy || frozen}}" placeholder="说说你的想法" />
      <view class="meta">
        {{textLength}} / 500 字符 · 仅支持文字
      </view>
      <wu-f7-button class="primary" disabled="{{busy || frozen || !authorMode || textLength &lt; 1 || textLength &gt; 500}}" loading="{{busy}}" bind:press="onPublish" variant="fill" size="large">
        发布回复
      </wu-f7-button>
      <wu-f7-button bind:press="onDismiss" variant="tonal">
        关闭并清空
      </wu-f7-button>
    </view>
  </view>
  <view wx:if="{{deleteId}}" class="modal-mask">
    <view class="modal">
      <view class="section-title">
        删除我的回复？
      </view>
      <view class="notice">
        只删除这条回复，后续回复和独立评分保留。
      </view>
      <wu-f7-button disabled="{{busy || frozen}}" loading="{{busy}}" bind:press="onConfirmDelete" variant="tonal" tone="danger">
        确认删除回复
      </wu-f7-button>
      <wu-f7-button bind:press="onDismiss" variant="tonal">
        返回
      </wu-f7-button>
    </view>
  </view>
</view>
