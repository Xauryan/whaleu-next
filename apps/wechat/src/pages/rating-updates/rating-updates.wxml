<view class="notice-page f7-ios-theme f7-notifications-page">
  <view class="notice-toolbar">
    <view class="notice-tabs">
      <wu-f7-button variant="{{category === 'reply' ? 'tonal' : 'plain'}}" data-category="reply" class="notice-tab {{category === 'reply' ? 'active' : 'secondary'}}" bind:press="onCategory">
        回复
      </wu-f7-button>
      <wu-f7-button variant="{{category === 'like' ? 'tonal' : 'plain'}}" data-category="like" class="notice-tab {{category === 'like' ? 'active' : 'secondary'}}" bind:press="onCategory">
        赞
      </wu-f7-button>
      <wu-f7-button variant="{{category === 'subscription' ? 'tonal' : 'plain'}}" data-category="subscription" class="notice-tab {{category === 'subscription' ? 'active' : 'secondary'}}" bind:press="onCategory">
        订阅
      </wu-f7-button>
    </view>
    <wu-f7-button class="notice-icon-button" disabled="{{busy}}" loading="{{busy}}" aria-label="刷新评分互动" bind:press="onRefresh">
      <wu-icon name="refresh" size="21" />
    </wu-f7-button>
  </view>
  <view wx:if="{{loaded}}" class="notice-count">
    {{unreadCount}} 条未读
  </view>
  <view wx:if="{{uiStatus}}" class="notice-state" aria-role="status">
    {{uiStatus}}
  </view>
  <view wx:if="{{error}}" class="notice-state notice-error" aria-role="alert">
    {{error}}
  </view>
  <wu-f7-button wx:if="{{busy}}" class="notice-secondary" bind:press="onCancel">
    停止等待
  </wu-f7-button>
  <navigator wx:if="{{!hasSession}}" class="notice-action" url="/pages/login/login">
    登录后查看
  </navigator>
  <wu-f7-list spacing="compact" class="notice-list">
    <view wx:for="{{items}}" wx:key="noticeId" class="notice-event">
      <view class="notice-symbol {{item.kind === 'like' ? 'notice-symbol-like' : ''}}">
        <wu-icon name="{{item.status === 'available' ? (item.kind === 'like' ? 'heart' : 'reply') : 'bell'}}" tone="{{item.kind === 'like' ? 'coral' : 'accent'}}" size="23" />
        <view wx:if="{{!item.readAt}}" class="notice-unread" aria-label="未读" />
      </view>
      <view class="notice-content">
        <block wx:if="{{item.status === 'available'}}">
          <view wx:if="{{item.kind === 'like'}}" class="notice-byline">
            <text class="notice-author">
              {{item.actor.displayName}}
            </text>
            <text class="notice-identity">
              公开身份
            </text>
          </view>
          <view class="notice-byline" wx:else>
            <text class="notice-author">
              {{item.preview.author.displayName}}
            </text>
            <text class="notice-identity">
              {{item.preview.author.mode === 'anonymous' ? '分身' : '公开身份'}}
            </text>
          </view>
          <view class="notice-context">
            {{item.kind === 'subscription' ? (item.activity === 'root' ? '订阅的目标有新评价' : '订阅的目标有新回复') : item.kind === 'like' ? (item.target.replyId ? '赞了你的回复' : '赞了你的评价') : (item.reason === 'direct_root' ? '回复了你的评价' : '回复了你的回复')}}
          </view>
          <view class="notice-body">
            {{item.preview.text}}
          </view>
        </block>
        <view class="notice-state" wx:else>
          这条内容暂不可查看
        </view>
        <view class="notice-time">
          {{item.timeLabel}} · {{item.readAt ? '已读' : '未读'}}
        </view>
        <view class="notice-actions">
          <block wx:if="{{item.status === 'available'}}">
            <wu-f7-button class="notice-action" data-id="{{item.noticeId}}" disabled="{{busy}}" bind:press="onOpen">
              {{item.kind === 'subscription' ? '查看订阅更新' : item.kind === 'like' ? '查看获赞内容' : '查看回复'}}
              <wu-icon name="chevron-right" tone="accent" size="14" />
            </wu-f7-button>
          </block>
          <wu-f7-button wx:if="{{!item.readAt}}" class="notice-read" data-id="{{item.noticeId}}" disabled="{{busy}}" bind:press="onRead">
            标为已读
          </wu-f7-button>
        </view>
      </view>
    </view>
  </wu-f7-list>
  <wu-f7-block wx:if="{{loaded &amp;&amp; !items.length}}" class="notice-empty" spacing="compact">
    <view class="notice-empty-content">
      <wu-icon name="heart" tone="muted" size="34" />
      <text class="notice-empty-title">
        还没有{{category === 'subscription' ? '订阅更新' : category === 'like' ? '新赞' : '新回复'}}
      </text>
      <text class="notice-empty-detail">
        新的互动会显示在这里
      </text>
    </view>
  </wu-f7-block>
  <wu-f7-button wx:if="{{canMore}}" class="notice-action" disabled="{{busy}}" bind:press="onMore">
    查看更多
  </wu-f7-button>
  <wu-f7-block class="notice-footer" spacing="compact">
    <view class="notice-footer-content">
      <view class="notice-hint">
        浏览列表不会清空未读。
      </view>
      <view class="notice-links">
        <navigator class="notice-secondary" url="/pages/rating-catalog/rating-catalog">
          发现评分
        </navigator>
        <navigator class="notice-secondary" url="/pages/rating-scoped/rating-scoped?mode=catalog&amp;scope=global">
          校园评分
        </navigator>
        <navigator class="notice-secondary" url="/pages/community-updates/community-updates">
          帖子互动
        </navigator>
      </view>
    </view>
  </wu-f7-block>
</view>
