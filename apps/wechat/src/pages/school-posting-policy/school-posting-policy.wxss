.page {
  padding: 32rpx;
  color: #18354b;
}
.title {
  font-size: 42rpx;
  font-weight: 700;
  margin-bottom: 12rpx;
}
.card {
  background: #fff;
  border-radius: 22rpx;
  padding: 28rpx;
  margin: 24rpx 0;
}
.card-title {
  font-size: 32rpx;
  font-weight: 600;
  margin-bottom: 18rpx;
}
.hint {
  font-size: 25rpx;
  color: #61758a;
  line-height: 1.65;
  margin: 12rpx 0;
}
.error {
  color: #a42135;
  padding: 20rpx;
  background: #fff0f0;
  border-radius: 12rpx;
  line-height: 1.6;
}
.pending {
  border: 2rpx solid #b48123;
}
.identifier {
  font-size: 22rpx;
  color: #61758a;
  word-break: break-all;
  margin-top: 10rpx;
}
button {
  margin-top: 18rpx;
  font-size: 28rpx;
}
input {
  padding: 20rpx;
  background: #f3f6fb;
  margin: 18rpx 0;
  border-radius: 12rpx;
}
.switch-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 16rpx;
  padding: 18rpx 0;
}
.field-title {
  font-weight: 600;
  margin-top: 28rpx;
}
.category,
.expiry-option {
  display: block;
  padding: 16rpx 0;
  font-size: 28rpx;
}
.rules view {
  line-height: 1.7;
  margin: 12rpx 0;
}
.primary {
  background: #195a93;
  color: #fff;
}
