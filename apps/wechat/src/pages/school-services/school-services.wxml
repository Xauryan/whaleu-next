<view class="page">
  <view class="title">学校服务</view>
  <view class="subtitle">{{campusName || '进群 · 公众号 · 联系管理员'}}</view>
  <view wx:if="{{regionName}}" class="hint">{{regionName}}</view>
  <view wx:if="{{error}}" class="error" aria-role="alert">{{error}}</view>
  <view wx:if="{{status}}" class="hint">{{status}}</view>
  <navigator class="link" url="/pages/campus/campus">选择或切换浏览校区</navigator>
  <button bindtap="onRefresh" loading="{{busy}}" disabled="{{busy}}">刷新当前资料</button>
  <view wx:for="{{entries}}" wx:key="entryKey" class="card">
    <view class="card-title">{{item.label}}</view>
    <view wx:if="{{item.state === 'unconfigured'}}" class="hint">该校暂未配置</view>
    <view wx:elif="{{item.state === 'disabled'}}" class="hint">当前服务已停用</view>
    <block wx:else>
      <view wx:if="{{item.data.name}}" class="name">{{item.data.name}}</view>
      <view wx:if="{{item.data.description}}" class="description">{{item.data.description}}</view>
      <view wx:if="{{item.data.maxGroupNumber}}" class="hint">群序号上限：{{item.data.maxGroupNumber}}</view>
      <view wx:if="{{item.data.wechatId}}">微信号：{{item.data.wechatId}}</view>
      <view wx:if="{{item.data.qqGroupNumber}}">QQ群号：{{item.data.qqGroupNumber}}</view>
      <button wx:if="{{item.data.wechatId}}" data-key="{{item.entryKey}}" data-field="wechatId" bindtap="onCopy" disabled="{{busy}}">复制管理员微信号</button>
      <button wx:if="{{item.data.qqGroupNumber}}" data-key="{{item.entryKey}}" data-field="qqGroupNumber" bindtap="onCopy" disabled="{{busy}}">复制QQ群号</button>
      <button wx:if="{{item.data.joinUrl}}" data-key="{{item.entryKey}}" data-field="joinUrl" bindtap="onCopy" disabled="{{busy}}">复制官方入群链接</button>
      <button wx:if="{{item.entryKey === 'official_account' &amp;&amp; item.data.name}}" data-key="{{item.entryKey}}" data-field="name" bindtap="onCopy" disabled="{{busy}}">复制公众号名称</button>
      <button wx:if="{{item.qrcode.status === 'configured'}}" data-key="{{item.entryKey}}" bindtap="onPreview" disabled="{{busy}}">预览当前二维码</button>
      <view wx:if="{{item.state === 'partial'}}" class="hint">部分资料尚未配置</view>
    </block>
  </view>
  <view wx:if="{{qr.status !== 'idle'}}" class="card">
    <view class="hint">{{qr.message}}</view>
    <image wx:if="{{qr.src}}" src="{{qr.src}}" mode="widthFix" class="qr-image" />
    <button bindtap="onCloseQr">关闭二维码预览</button>
  </view>
  <navigator class="link" url="/pages/school-configuration/school-configuration">学校服务管理</navigator>
  <view class="footnote">资料由该地区授权管理员发布。管理员与群号变更后需刷新；旧系统资料尚未导入的学校会明确显示未配置。</view>
</view>
