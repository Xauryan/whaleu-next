@import '../community-search/framework7-forms.wxss';
.school-services-screen .campus-link {
  color: var(--f7-text-color);
}
.school-services-screen .service-name {
  margin-top: 12px;
  font-size: var(--f7-list-font-size);
  font-weight: 600;
  overflow-wrap: anywhere;
}
.school-services-screen .service-description {
  margin: 8px 0 12px;
  color: var(--f7-list-item-text-text-color);
  font-size: var(--f7-list-item-text-font-size);
  line-height: 1.6;
  white-space: pre-wrap;
  overflow-wrap: anywhere;
}
.school-services-screen .service-unavailable {
  margin-top: 8px;
}
.school-services-screen .contact-row {
  min-height: 56px;
  padding: 8px 0;
}
.school-services-screen .contact-row > view {
  min-width: 0;
}
.school-services-screen .contact-label {
  color: var(--f7-list-item-subtitle-text-color);
  font-size: var(--f7-list-item-subtitle-font-size);
}
.school-services-screen .service-actions {
  display: flex;
  flex-wrap: wrap;
  gap: 4px 8px;
}
