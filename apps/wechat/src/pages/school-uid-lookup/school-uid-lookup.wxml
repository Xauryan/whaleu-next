<view class="screen">
  <view class="title">按学校与 UID 查询</view>
  <view class="notice">仅超级管理员可查询当前学校与当前校内 UID。历史号码、不可查看的主页及未知状态均不会显示身份。</view>
  <view aria-role="status">{{status}}</view><view wx:if="{{error}}" class="error" aria-role="alert">{{error}}</view>
  <button bindtap="onReload" disabled="{{busy}}">重新核验权限</button><button wx:if="{{busy}}" bindtap="onCancel">停止等待</button>
  <view wx:if="{{canLookup}}" class="card">
    <input class="input" value="{{campusQuery}}" placeholder="搜索学校或校区" bindinput="onQuery" disabled="{{busy}}" />
    <button bindtap="onSearch" disabled="{{busy}}">搜索学校目录</button>
    <button wx:for="{{campuses}}" wx:key="id" data-id="{{item.id}}" bindtap="onChoose" disabled="{{busy}}">{{item.institutionName}} · {{item.fullName}}（{{item.institutionId}}）</button>
    <button wx:if="{{campusPage > 1}}" bindtap="onPrevious" disabled="{{busy}}">上一页</button><button wx:if="{{campusPage * 20 &lt; campusTotal}}" bindtap="onNext" disabled="{{busy}}">下一页</button>
    <view wx:if="{{schoolCode}}">已选学校：{{schoolName}}（{{schoolCode}}）</view>
    <input class="input" value="{{uid}}" placeholder="校内 UID，如 000123" maxlength="19" bindinput="onUid" disabled="{{busy}}" />
    <button bindtap="onLookup" disabled="{{busy || !schoolCode || !uid}}">查询此学校与 UID</button>
  </view>
  <view wx:if="{{result &amp;&amp; result.status === 'found' &amp;&amp; !busy}}" class="card"><view>{{result.target.displayName}}</view><navigator class="link" url="/pages/public-profile/public-profile?profileId={{result.target.profileId}}">打开当前公开主页 →</navigator></view>
  <view wx:if="{{result &amp;&amp; result.status === 'unavailable'}}" class="notice">此学校与 UID 当前不可查询。</view>
  <navigator class="link" url="/pages/school-identity-management/school-identity-management">恢复原学校归属管理请求 →</navigator>
  <navigator class="link" url="/pages/profile/profile">返回我的资料 →</navigator>
</view>
