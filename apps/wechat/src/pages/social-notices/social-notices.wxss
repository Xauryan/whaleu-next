@import '../../notifications/details.wxss';
.notice-page .social-open {
  display: block;
  width: 100%;
  padding: 0;
  margin: 0;
  background: transparent;
  color: inherit;
  text-align: left;
  border-radius: 0;
  line-height: 1.5;
}
.notice-page .social-open[disabled] {
  opacity: 1;
  background: transparent;
  color: inherit;
}
.notice-page .social-tone-coral {
  background: #fff0f2;
}
.notice-page .social-tone-socialblue {
  background: #edf4ff;
}
.notice-page .social-tone-mint {
  background: #eaf9f1;
}
@media (prefers-color-scheme: dark) {
  .notice-page .social-tone-coral {
    background: #35252c;
  }
  .notice-page .social-tone-socialblue {
    background: #1c2c42;
  }
  .notice-page .social-tone-mint {
    background: #1e342a;
  }
}

