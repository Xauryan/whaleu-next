<view class="screen"><view class="title">认证站内消息</view><view>仅本地站内通知，未启用微信或公众号外部送达。</view><view wx:if="{{error}}" class="error">{{error}}</view><view wx:for="{{notices}}" wx:key="id" class="card"><view>{{item.kind==='student_auth'?'有新的学生归属申请':item.outcome==='approved'?'学生归属申请已通过':'学生归属申请未通过'}}</view><view>{{item.createdAt}} · {{item.read?'已读':'未读'}}</view><button data-id="{{item.id}}" bindtap="onNotice" disabled="{{busy||!item.available}}">查看当前可访问的申请</button><button data-id="{{item.id}}" bindtap="onReadNotice" disabled="{{busy||!item.available||item.read}}">标记已读</button></view><button bindtap="onPrevious" disabled="{{busy||page<=1}}">上一页</button><button bindtap="onNext" disabled="{{busy||!hasNext}}">下一页</button><button bindtap="onReload" disabled="{{busy}}">刷新</button><navigator url="/pages/student-verification/student-verification">我的认证申请</navigator><navigator url="/pages/student-verification-review/student-verification-review">校方审核队列</navigator></view>
