<view class="screen"><view class="eyebrow">WHALEU · 校方审核</view><view class="title">学生归属申请队列</view>
 <view class="intro">仅当前被授权的学校管理员可查看本地区申请。请人工判断学校归属；材料内容安全检查不等于学生认证。不能审核自己的申请。</view><view wx:if="{{error}}" class="error">{{error}}</view><view>{{message}}</view>
 <view wx:if="{{management==='none'}}">当前账号没有学校审核权限。</view><view wx:if="{{regionId}}">目标地区：{{regionName||regionId}}</view>
 <view wx:if="{{management==='global'}}"><input value="{{campusQuery}}" bindinput="onSearchInput" maxlength="100" placeholder="搜索校区以明确选择审核地区"/><button bindtap="onSearch" disabled="{{busy}}">搜索</button><button wx:for="{{campuses}}" wx:key="id" data-id="{{item.id}}" bindtap="onChooseCampus" disabled="{{busy}}">{{item.fullName}}</button></view>
 <button wx:for="{{items}}" wx:key="id" bindtap="onSelect" data-id="{{item.id}}" disabled="{{busy}}">{{item.campusName}} · {{item.submittedAt}}</button><button bindtap="onPrevious" disabled="{{busy||page<=1}}">上一页</button><button bindtap="onNext" disabled="{{busy||!hasNext}}">下一页</button>
 <view wx:if="{{application}}" class="card"><view class="card-title">{{stateLabel}}</view><view>{{application.campusName}}</view><view>公开账号编号：{{application.profileId||'暂未建立'}}</view><view wx:if="{{application.reason}}">拒绝原因：{{application.reason}}</view><button wx:if="{{application.state==='pending'&&application.evidenceAvailable}}" bindtap="onPreview" disabled="{{busy}}">私密读取申请材料</button><view>{{evidenceMessage}}</view><block wx:if="{{application.state==='pending'}}"><button bindtap="onApprove" disabled="{{busy||pending}}">通过学校归属审核</button><textarea value="{{reason}}" bindinput="onReason" maxlength="200" placeholder="拒绝必须填写原因，不超过200字"/><button bindtap="onReject" disabled="{{busy||pending||!reason}}">拒绝本次申请</button></block></view>
 <view wx:if="{{evidenceSrc}}" class="card"><image class="evidence" src="{{evidenceSrc}}" mode="widthFix"/><button bindtap="onClosePreview">关闭并清除材料</button></view>
 <view wx:if="{{confirmation}}" class="card"><view>{{confirmation==='approved'?'确认通过？将发行学校归属认证，不会发行学号。':'确认拒绝本次申请？申请人可重新提交新材料。'}}</view><button bindtap="onConfirm" disabled="{{busy}}">确认审核决定</button><button bindtap="onDismiss" disabled="{{busy}}">返回</button></view>
 <view wx:if="{{pending}}"><button bindtap="onRecover" disabled="{{busy}}">查询原审核请求</button><button bindtap="onCancelRequest" disabled="{{busy}}">关闭尚未执行的原请求</button></view>
 <button bindtap="onReload" disabled="{{busy}}">刷新队列</button><navigator url="/pages/student-verification-notices/student-verification-notices">认证站内消息</navigator><navigator url="/pages/student-verification/student-verification">我的认证申请</navigator>
</view>
