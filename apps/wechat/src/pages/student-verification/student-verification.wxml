<view class="screen">
  <view wx:if="{{schoolUidView.error}}" class="notice">校内 UID 查询未完成：{{schoolUidView.error}}</view>
  <view wx:if="{{schoolUidView.loaded}}" class="card">
    <view class="card-title">当前校内 UID</view>
    <view wx:if="{{schoolUidView.schoolUid.status === 'assigned'}}">{{schoolUidView.schoolUid.school.name}} · {{schoolUidView.schoolUid.formattedUid}}</view>
    <view wx:elif="{{schoolUidView.schoolUid.status === 'unassigned'}}">当前没有校内 UID</view>
    <view wx:else>{{(application ? application.state === 'approved' : false) ? '认证已通过，校内 UID 暂不可用' : '校内 UID 暂不可用，请以独立的认证结果确认学校归属状态'}}</view>
  </view>

 <view class="eyebrow">WHALEU · 学生归属申请</view>
 <view class="title">提交学校归属材料</view>
 <view class="intro">选择一张校园卡或录取通知书，只需足以判断学校归属，可遮盖无关信息。无需另填真实姓名、身份证号或学号。材料不会公开，也不会写入个人资料。</view>
 <view wx:if="{{error}}" class="error" aria-role="alert">{{error}}</view><view class="detail">{{message}}</view>
 <navigator wx:if="{{!hasSession}}" url="/pages/login/login" open-type="reLaunch">请先登录</navigator>
 <view wx:if="{{application}}" class="card">
  <view class="card-title">{{stateLabel}}</view><view>{{application.campusName}}</view><view wx:if="{{application.reason}}">拒绝原因：{{application.reason}}</view>
  <view wx:if="{{application.evidenceExpiresAt}}">材料访问截止：{{application.evidenceExpiresAt}}</view>
  <view wx:if="{{application.state==='approved'}}">归属与学号分别验证，校内 UID 状态单独查询。学校更正需由超级管理员处理；续期或撤销请联系学校管理员。</view>
  <block wx:if="{{application.state==='draft'}}"><button bindtap="onChooseEvidence" disabled="{{busy||pending}}">选择一张材料图片</button><button bindtap="onRecoverEvidence" disabled="{{busy||pending}}">恢复原材料上传</button><view>{{evidenceMessage}}</view><button bindtap="onSubmit" disabled="{{busy||pending||!evidenceReady}}">提交审核</button></block>
  <button wx:if="{{application.state==='draft'||application.state==='pending'}}" bindtap="onWithdraw" disabled="{{busy||pending}}">取消本次申请</button>
  <button wx:if="{{application.evidenceAvailable}}" bindtap="onPreview" disabled="{{busy}}">私密查看本次材料</button>
 </view>
 <view wx:if="{{canApply}}" class="card"><view>选择材料对应的学校校区</view><input value="{{campusQuery}}" bindinput="onSearchInput" maxlength="100" placeholder="搜索学校或校区"/><button bindtap="onSearch" disabled="{{busy||pending}}">搜索校区</button><button wx:for="{{campuses}}" wx:key="id" data-id="{{item.id}}" bindtap="onChooseCampus" class="{{selectedCampusId===item.id?'selected':''}}" disabled="{{busy||pending}}">{{item.fullName}}</button><button bindtap="onPrepare" disabled="{{busy||pending||!selectedCampusId}}">开始本次申请</button></view>
 <view wx:if="{{confirmation}}" class="card"><view>{{confirmation==='submit'?'确认提交？材料将绑定本次申请，审核前不会获得学生归属认证。':'确认取消？已发行的归属资格不会因此撤销。'}}</view><button bindtap="onConfirm" disabled="{{busy}}">确认</button><button bindtap="onDismiss" disabled="{{busy}}">返回</button></view>
 <view wx:if="{{pending}}" class="card"><view>有一个结果待确认的原请求，请先恢复。</view><button bindtap="onRecover" disabled="{{busy}}">查询原请求</button><button bindtap="onCancelRequest" disabled="{{busy}}">关闭尚未执行的原请求</button></view>
 <view wx:if="{{evidenceSrc}}" class="card"><image class="evidence" src="{{evidenceSrc}}" mode="widthFix"/><button bindtap="onClosePreview">关闭并清除材料预览</button></view>
 <button bindtap="onReload" disabled="{{busy}}">刷新当前状态</button><button bindtap="onCleanup" disabled="{{busy||pending}}">清理本人未绑定的材料上传</button>
 <navigator url="/pages/verification/verification">查看独立认证状态</navigator><navigator url="/pages/phone-binding/phone-binding">授权手机号</navigator><navigator url="/pages/identity-campus/identity-campus">选择身份校区</navigator><navigator url="/pages/student-verification-notices/student-verification-notices">认证站内消息</navigator><navigator url="/pages/student-verification-review/student-verification-review">校方审核入口</navigator>
</view>
