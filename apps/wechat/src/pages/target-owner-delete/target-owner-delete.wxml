<import src="../../ratings/common.wxml" />
<view class="screen">
  <view class="title">删除我创建的对象</view>
  <template is="rating-status" data="{{status,error,receiptStatus,hasSession,frozen,recoveryOperation,busy,needsRefresh}}" />
  <view class="notice">此页面核验你是否可以删除此对象，不展示对象详情。即使对象已隐藏，也可通过原链接申请删除。</view>
  <view wx:if="{{ready}}" class="card">
    <view class="section-title">{{deleted ? '此对象已删除' : '此对象'}}</view>
    <button wx:if="{{!deleted}}" bindtap="onDelete" disabled="{{busy || frozen}}">删除此对象</button>
    <view wx:if="{{deleteConfirmation}}">
      <view class="notice">删除后不再公开显示，评分和互动历史会保留。删除后无法恢复，确认删除此对象？</view>
      <button bindtap="onConfirmDelete" disabled="{{busy || frozen}}">确认删除</button>
      <button bindtap="onDismissDelete">暂不删除</button>
    </view>
  </view>
  <view wx:if="{{canCancelDeletion}}" class="card">
    <button bindtap="onCancelDeletion" disabled="{{busy}}">撤销这次未确认的删除申请</button>
    <view wx:if="{{cancelDeletionConfirmation}}">
      <view class="notice">确认撤销原删除申请？服务器将关闭尚未完成的原请求；若删除已经成功，只会返回成功回执，不会恢复对象。</view>
      <button bindtap="onConfirmCancelDeletion" disabled="{{busy}}">确认撤销原申请</button>
      <button bindtap="onDismissCancelDeletion" disabled="{{busy}}">保留原申请</button>
    </view>
  </view>
  <button bindtap="onCancel">关闭确认并停止等待</button>
  <button bindtap="onReturnCatalog">返回目录并重新加载 →</button>
</view>
