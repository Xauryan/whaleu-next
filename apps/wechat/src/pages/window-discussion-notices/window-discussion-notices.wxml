<import src="../../window-discussion/common.wxml" />
<view class="screen"><view class="title">窗口讨论通知</view><view class="status">{{status}}</view><view wx:if="{{readStatus}}" class="notice">{{readStatus}}</view><view wx:if="{{error}}" class="error">{{error}}</view><navigator wx:if="{{!hasSession}}" class="link" url="/pages/login/login">登录后继续 →</navigator><button bindtap="onRefresh" disabled="{{busy}}">重新核验通知</button><button wx:if="{{busy}}" bindtap="onCancelWait">停止等待</button>
<block wx:if="{{loaded}}"><view class="meta">当前未读 {{unreadCount}} 条 · 第 {{pageNumber}} 页</view><view wx:for="{{items}}" wx:key="noticeId" class="card"><view>{{item.readAt ? '已读' : '未读'}} · {{item.createdAt}}</view><block wx:if="{{item.status === 'available'}}"><view>{{item.kind === 'like' ? '赞' : '回复'}} · {{item.preview.author.displayName}}</view><view class="body">{{item.preview.text}}</view><button wx:if="{{item.kind === 'reply' &amp;&amp; item.preview.thumbnail}}" data-id="{{item.noticeId}}" bindtap="onNoticeImage" disabled="{{busy}}">查看回复首图</button><button data-id="{{item.noticeId}}" bindtap="onOpen" disabled="{{busy}}">核验当前内容后打开</button></block><view wx:else class="notice">当前内容不可查看</view><button wx:if="{{!item.readAt}}" data-id="{{item.noticeId}}" bindtap="onRead" disabled="{{busy}}">将此通知标为已读</button></view><button wx:if="{{canNext}}" bindtap="onNext" disabled="{{busy}}">下一页</button></block>
<view class="notice">打开内容不会自动标为已读。通知只表示本地记录，不代表推送送达。</view><navigator class="link" url="/pages/window-discussion-recovery/window-discussion-recovery">独立回执恢复与自己的点赞 →</navigator></view>

<template is="discussion-gallery" data="{{galleryOpen,gallerySrc,galleryStatus,galleryIndex,galleryCount}}" />
