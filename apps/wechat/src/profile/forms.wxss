.screen {
  padding: 48rpx 32rpx 72rpx;
}
.eyebrow {
  color: var(--wu-secondary);
  font-size: 24rpx;
  font-weight: 600;
  letter-spacing: 3rpx;
}
.title {
  font-size: 56rpx;
  letter-spacing: -1.5rpx;
  font-weight: 700;
  margin: 20rpx 0;
}
.intro,
.detail {
  color: var(--wu-secondary);
  font-size: 27rpx;
  line-height: 1.8;
}
.intro {
  margin-bottom: 32rpx;
}
.detail {
  margin-top: 14rpx;
}
.card {
  background: var(--wu-surface);
  border: 1rpx solid var(--wu-separator);
  border-radius: 24rpx;
  padding: 30rpx;
  margin-bottom: 24rpx;
}
.card-title {
  font-size: 31rpx;
  font-weight: 600;
}
.campus-name {
  font-size: 34rpx;
  font-weight: 600;
  color: var(--wu-text);
  margin: 16rpx 0;
  overflow-wrap: anywhere;
}
.field-label {
  display: block;
  color: var(--wu-secondary);
  font-size: 26rpx;
  margin: 24rpx 0 12rpx;
}
.input,
.textarea {
  box-sizing: border-box;
  width: 100%;
  background: var(--wu-bg);
  border: 1rpx solid var(--wu-separator);
  border-radius: 12rpx;
  padding: 18rpx 20rpx;
  font-size: 29rpx;
  color: var(--wu-text);
}
.input {
  height: 88rpx;
}
.textarea {
  height: 220rpx;
  line-height: 1.7;
}
.hint,
.counter {
  font-size: 23rpx;
  color: var(--wu-secondary);
  line-height: 1.7;
  margin-top: 10rpx;
}
.counter {
  text-align: right;
}
.status-panel {
  margin-bottom: 26rpx;
}
.status {
  color: var(--wu-text);
  font-size: 28rpx;
  font-weight: 600;
  margin: 18rpx 0;
}
.error {
  color: var(--wu-danger);
  background: var(--wu-danger-bg);
  padding: 20rpx;
  border-radius: 12rpx;
  font-size: 26rpx;
  line-height: 1.7;
  margin-top: 16rpx;
}
.request-id {
  color: var(--wu-secondary);
  font-size: 22rpx;
  word-break: break-all;
  margin: 12rpx 0;
}
.primary,
.secondary {
  font-size: 28rpx;
  border-radius: 20rpx;
  margin-top: 20rpx;
}
.primary {
  background: var(--wu-accent);
  color: #fff;
}
.secondary {
  background: var(--wu-bg);
  color: var(--wu-text);
}
.primary[disabled],
.secondary[disabled] {
  background: var(--wu-bg);
  color: var(--wu-tertiary);
}
.text-link {
  display: block;
  color: var(--wu-accent);
  padding: 22rpx 0;
  font-size: 27rpx;
}
.preference-row {
  display: flex;
  align-items: center;
  gap: 14rpx;
  padding: 26rpx 0;
  border-bottom: 2rpx solid var(--wu-separator);
}
.preference-text {
  flex: 1;
  min-width: 0;
}
.preference-label {
  color: var(--wu-text);
  font-size: 28rpx;
}
.preference-row switch {
  flex-shrink: 0;
}
.footnote {
  color: var(--wu-secondary);
  font-size: 23rpx;
  line-height: 1.9;
  margin-top: 32rpx;
}
.results-heading {
  color: var(--wu-secondary);
  font-size: 25rpx;
  margin: 28rpx 0 18rpx;
}
.selected-card {
  border-color: var(--wu-accent);
  background: var(--wu-tint);
}
.badge {
  display: inline-block;
  margin-top: 16rpx;
  padding: 8rpx 16rpx;
  border-radius: 30rpx;
  color: var(--wu-accent);
  background: var(--wu-tint);
  font-size: 23rpx;
}
.pagination {
  display: flex;
  gap: 20rpx;
}
.pagination button {
  flex: 1;
  margin: 0;
}
.empty {
  text-align: center;
  padding: 48rpx 30rpx;
}
.confirm-card {
  margin-top: 30rpx;
  border-color: var(--wu-separator);
}
