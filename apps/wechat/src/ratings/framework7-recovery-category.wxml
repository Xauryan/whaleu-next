<view class="screen management-page category-workspace f7-ios-theme f7-rating-recovery">
  <wu-f7-block class="f7-recovery-content" spacing="compact">
  <view class="management-context">
    <view class="management-context-icon">
      <wu-icon name="menu" tone="accent" size="22" />
    </view>
    <view class="management-context-copy">
      <view class="context-title">
        {{effectiveName || scopeLabel || '选择管理范围'}}
      </view>
      <view class="meta">
        {{editorPage ? '本次分类变更' : '管理当前范围的分类'}}
      </view>
    </view>
  </view>
  <view class="card management-scope-choice">
    <view class="section-title">
      {{effectiveName ? scopeLabel : '管理范围'}}
    </view>
    <view wx:if="{{viewCampusId}}" class="meta">
      校园 ID：{{viewCampusId}}
    </view>
    <view class="notice">
      浏览校园与管理资格分别核验。共享基础、校园覆盖和独立全局分别保存。
    </view>
    <wu-f7-button bind:press="onOpenCampuses" disabled="{{busy || frozen}}" class="management-action" variant="tonal">
      选择校园
    </wu-f7-button>
    <wu-f7-button bind:press="onGlobal" disabled="{{busy || frozen}}" class="management-action" variant="tonal">
      独立全局
    </wu-f7-button>
  </view>
  <view wx:if="{{status}}" class="notice" aria-role="status">
    {{status}}
  </view>
  <view wx:if="{{error}}" class="error" aria-role="alert">
    {{error}}
  </view>
  <view wx:if="{{receiptStatus}}" class="card">
    {{receiptStatus}}
  </view>
  <wu-f7-button wx:if="{{!hasSession}}" bind:press="onLogin" class="management-action" variant="tonal">
    登录后管理分类
  </wu-f7-button>
  <wu-f7-button wx:if="{{hasSession &amp;&amp; !frozen}}" bind:press="onRefresh" disabled="{{busy}}" class="management-quiet" variant="plain">
    重新核验管理范围
  </wu-f7-button>
  <wu-f7-button wx:if="{{busy}}" bind:press="onStop" class="management-quiet" variant="plain">
    停止等待
  </wu-f7-button>
  <view wx:if="{{pickerOpen}}" class="card">
    <view class="section-title">
      {{pickerPurpose === 'placement' ? '选择本次精确适用校园集合' : '选择管理视图校园'}}
    </view>
    <wu-f7-input value="{{campusQuery}}" bind:input="onCampusQuery" placeholder="搜索校园"  />
    <wu-f7-button bind:press="onSearchCampuses" disabled="{{busy}}" class="management-action" variant="tonal">
      搜索
    </wu-f7-button>
    <wu-f7-button wx:for="{{campuses}}" wx:key="id" data-id="{{item.id}}" bind:press="onCampus" disabled="{{busy || !item.isActive}}" class="management-action" variant="tonal">
      {{item.fullName}} · {{item.id}}
    </wu-f7-button>
    <wu-f7-button wx:if="{{campusPage &gt; 1}}" bind:press="onPreviousCampuses" disabled="{{busy}}" class="management-action" variant="tonal">
      上一页
    </wu-f7-button>
    <wu-f7-button wx:if="{{hasMoreCampuses}}" bind:press="onNextCampuses" disabled="{{busy}}" class="management-action" variant="tonal">
      下一页
    </wu-f7-button>
    <wu-f7-button bind:press="onCloseCampuses" class="management-quiet" variant="plain">
      关闭校园列表
    </wu-f7-button>
  </view>
  <view wx:if="{{frozen}}" class="card recovery">
    <view class="section-title">
      原请求受保护：{{recoveryOperation}}
    </view>
    <view class="meta">
      {{requestId}}
    </view>
    <view class="notice">
      查询未找到、断网或停止等待都不会释放原请求。更换内容须先确认原请求已关闭。
    </view>
    <wu-f7-button bind:press="onRecover" disabled="{{busy}}" class="management-primary" variant="fill" size="large">
      查询原回执
    </wu-f7-button>
    <wu-f7-button wx:if="{{isCategoryPending &amp;&amp; !preview}}" bind:press="onPreparePending" disabled="{{busy}}" class="management-action" variant="tonal">
      恢复原意图并重新核对预览
    </wu-f7-button>
    <navigator wx:if="{{!isCategoryPending}}" url="/pages/rating-recovery/rating-recovery" class="management-link">
      前往原评分请求恢复
      <wu-icon name="chevron-right" tone="muted" size="22" />
    </navigator>
    <wu-f7-button wx:if="{{isCategoryPending}}" bind:press="onRequestCancel" disabled="{{busy}}" class="management-action" variant="tonal">
      取消尚未完成的原请求
    </wu-f7-button>
    <view wx:if="{{cancelConfirmation}}" class="confirmation management-confirmation">
      <view class="notice">
        确认取消这个原请求？已发布结果优先；取消不会撤回已生效的分类变更。
      </view>
      <wu-f7-button bind:press="onConfirmCancel" disabled="{{busy}}" class="management-destructive" variant="tonal" tone="danger">
        确认取消原请求
      </wu-f7-button>
      <wu-f7-button bind:press="onDismissCancel" disabled="{{busy}}" class="management-action" variant="plain">
        保留原请求
      </wu-f7-button>
    </view>
  </view>
  <view wx:if="{{iconFrozen &amp;&amp; iconSlots.length}}" class="card">
    <view class="section-title">
      冻结的全部图标槽位 · {{iconSlots.length}} / 32
    </view>
    <view class="notice">
      每次只选择并上传一个节点。释放本地文件后才处理下一张；全部图标与文字在同一次发布中生效。
    </view>
    <view wx:for="{{iconSlots}}" wx:key="key">
      <view>
        {{item.label}} · {{item.selection}} · {{item.status}}
      </view>
      <wu-f7-button wx:if="{{item.selection === 'replace' &amp;&amp; item.status !== 'ready'}}" data-key="{{item.key}}" bind:press="onIconUpload" disabled="{{busy}}" class="management-action" variant="tonal">
        选择原图并上传此节点
      </wu-f7-button>
    </view>
    <view>
      {{iconUploadStatus}} · {{iconProgress}}%
    </view>
  </view>
  <view wx:if="{{iconRead.state !== 'idle'}}" class="card">
    <image wx:if="{{iconRead.localSrc}}" src="{{iconRead.localSrc}}" mode="aspectFit" class="category-icon-preview" />
    <view wx:else>
      {{iconRead.state === 'loading' ? '正在核验并读取当前图标' : '图标暂不可用（不是无图）'}}
    </view>
    <wu-f7-button bind:press="onIconClose" class="management-quiet" variant="plain">
      关闭图标
    </wu-f7-button>
  </view>
  <block wx:if="{{loaded &amp;&amp; !frozen &amp;&amp; !pickerOpen}}">
    <block wx:if="{{!editorPage}}">
      <view class="card">
        <view class="section-title">
          管理分类与状态
        </view>
        <wu-f7-button data-status="all" bind:press="onFilter" disabled="{{busy}}" class="management-action management-choice {{filter === 'all' ? 'is-selected' : ''}}" variant="{{filter === 'all' ? 'fill' : 'tonal'}}">
          全部状态
        </wu-f7-button>
        <wu-f7-button data-status="enabled" bind:press="onFilter" disabled="{{busy}}" class="management-action management-choice {{filter === 'enabled' ? 'is-selected' : ''}}" variant="{{filter === 'enabled' ? 'fill' : 'tonal'}}">
          已启用
        </wu-f7-button>
        <wu-f7-button data-status="disabled" bind:press="onFilter" disabled="{{busy}}" class="management-action management-choice {{filter === 'disabled' ? 'is-selected' : ''}}" variant="{{filter === 'disabled' ? 'fill' : 'tonal'}}">
          已停用
        </wu-f7-button>
        <wu-f7-button data-status="archived" bind:press="onFilter" disabled="{{busy}}" class="management-action management-choice {{filter === 'archived' ? 'is-selected' : ''}}" variant="{{filter === 'archived' ? 'fill' : 'tonal'}}">
          已归档
        </wu-f7-button>
        <wu-f7-button bind:press="onRoot" disabled="{{busy}}" class="management-action" variant="tonal">
          根分类
        </wu-f7-button>
        <wu-f7-button bind:press="onOpenEditor" disabled="{{busy}}" class="management-action" variant="tonal">
          管理当前层级 / 创建分类
        </wu-f7-button>
      </view>
      <view wx:for="{{categories}}" wx:key="id" class="card management-category">
        <view class="section-title">
          {{item.label}}
        </view>
        <view class="meta">
          {{item.id}} · {{item.stateLabel}}
        </view>
        <view wx:if="{{item.unavailable}}" class="notice">
          正文来源或审核暂不可用，仅显示管理元数据。
        </view>
        <wu-f7-button data-id="{{item.id}}" bind:press="onInspect" disabled="{{busy}}" class="management-action" variant="tonal">
          查看基础、覆盖与历史
        </wu-f7-button>
        <wu-f7-button data-id="{{item.id}}" bind:press="onChildren" disabled="{{busy}}" class="management-action" variant="tonal">
          查看直接子分类
        </wu-f7-button>
        <wu-f7-button data-id="{{item.id}}" bind:press="onOpenEditor" disabled="{{busy}}" class="management-action" variant="tonal">
          编辑此分类
        </wu-f7-button>
      </view>
      <view wx:if="{{!categories.length}}" class="notice">
        此筛选下没有分类。空列表不授予创建资格。
      </view>
      <wu-f7-button wx:if="{{canPreviousCategories}}" bind:press="onPreviousCategories" disabled="{{busy}}" class="management-action" variant="tonal">
        上一页分类
      </wu-f7-button>
      <wu-f7-button wx:if="{{canMore}}" bind:press="onMore" disabled="{{busy}}" class="management-action" variant="tonal">
        下一页分类
      </wu-f7-button>
    </block>
    <view wx:if="{{detailId}}" class="card management-detail">
      <view class="section-title">
        分类身份与当前状态
      </view>
      <view class="meta">
        {{detailId}} · {{detailState}} · {{detailVisibility}}
      </view>
      <view class="meta">
        {{detailSystemKey ? '系统 key：' + detailSystemKey + '（不可修改或回收）' : '普通分类'}}
      </view>
      <view class="section-title">
        共享基础
      </view>
      <view>
        {{baseName}}
      </view>
      <view class="body">
        {{baseDescription}}
      </view>
      <view class="section-title">
        本校园覆盖
      </view>
      <view>
        {{overrideName}}
      </view>
      <view class="body">
        {{overrideDescription}}
      </view>
      <block wx:if="{{iconEnabled}}">
        <view>
          共享基础图标：{{iconBaseLabel}}
        </view>
        <wu-f7-button data-value="base" bind:press="onIconOpen" disabled="{{busy}}" class="management-action" variant="tonal">
          核验基础图标
        </wu-f7-button>
        <view>
          本校园图标：{{iconOverrideLabel}}
        </view>
        <wu-f7-button data-value="override" bind:press="onIconOpen" disabled="{{busy}}" class="management-action" variant="tonal">
          核验本校园设置
        </wu-f7-button>
        <view>
          有效图标：{{iconEffectiveLabel}}
        </view>
        <wu-f7-button data-value="effective" bind:press="onIconOpen" disabled="{{busy}}" class="management-action" variant="tonal">
          查看当前有效图标
        </wu-f7-button>
      </block>
      <view class="section-title">
        当前有效正文
      </view>
      <view>
        {{effectiveName}}
      </view>
      <view class="body">
        {{effectiveDescription}}
      </view>
      <view wx:if="{{detailUnavailable}}" class="notice">
        {{detailUnavailable}}
      </view>
      <view class="notice">
        停用、归档或移出校园会阻止新互动；既有评分对象、回复、订阅与通知历史保留，原作者清理走原入口。
      </view>
      <wu-f7-button bind:press="onHistory" disabled="{{busy}}" class="management-action" variant="tonal">
        读取管理变更历史
      </wu-f7-button>
      <view wx:for="{{history}}" wx:key="requestId" class="history-row">
        <view>
          {{item.label}}
        </view>
        <view class="meta">
          {{item.occurredAt}} · {{item.requestId}}
        </view>
        <wu-f7-button wx:if="{{iconEnabled}}" data-id="{{item.requestId}}" bind:press="onIconRetirementRecover" disabled="{{busy}}" class="management-action" variant="tonal">
          核验此原请求的旧图清理状态
        </wu-f7-button>
      </view>
      <wu-f7-button wx:if="{{canMoreHistory}}" bind:press="onMoreHistory" disabled="{{busy}}" class="management-action" variant="tonal">
        继续读取历史
      </wu-f7-button>
    </view>
    <block wx:if="{{editorPage}}">
      <view class="card">
        <view class="section-title">
          选择本次操作
        </view>
        <wu-f7-button wx:for="{{operations}}" wx:key="operation" data-operation="{{item.operation}}" bind:press="onOperation" disabled="{{busy || !item.allowed}}" class="management-action management-choice {{operation === item.operation ? 'is-selected' : ''}}" variant="{{operation === item.operation ? 'fill' : 'tonal'}}">
          {{operation === item.operation ? '已选：' : ''}}{{item.label}}{{item.reason ? ' · ' + item.reason : ''}}
          <wu-icon wx:if="{{operation === item.operation}}" name="check" tone="accent" size="18" />
        </wu-f7-button>
      </view>
      <view wx:if="{{operation}}" class="card management-editor">
        <view class="section-title">
          {{operationLabel}}
        </view>
        <block wx:if="{{operation === 'edit_category_base_scoped' || operation === 'set_category_override_scoped' || operation === 'create_system_category_scoped'}}">
          <block wx:if="{{operation === 'set_category_override_scoped'}}">
            <view class="notice">
              名称与简介分别选择继承或覆盖；简介覆盖为空会明确清空本校园简介。
            </view>
            <wu-f7-button data-field="nameMode" data-value="inherit" bind:press="onChoice" class="management-action management-choice {{nameMode === 'inherit' ? 'is-selected' : ''}}" variant="{{nameMode === 'inherit' ? 'fill' : 'tonal'}}">
              名称：{{nameMode === 'inherit' ? '已选' : ''}}继承基础
            </wu-f7-button>
            <wu-f7-button data-field="nameMode" data-value="set" bind:press="onChoice" class="management-action management-choice {{nameMode === 'set' ? 'is-selected' : ''}}" variant="{{nameMode === 'set' ? 'fill' : 'tonal'}}">
              名称：{{nameMode === 'set' ? '已选' : ''}}单独覆盖
            </wu-f7-button>
          </block>
          <wu-f7-input wx:if="{{operation !== 'set_category_override_scoped' || nameMode === 'set'}}" value="{{name}}" data-field="name" bind:input="onText" maxlength="-1" placeholder="名称（1–100 字）" disabled="{{busy}}"  />
          <block wx:if="{{operation === 'set_category_override_scoped'}}">
            <wu-f7-button data-field="descriptionMode" data-value="inherit" bind:press="onChoice" class="management-action management-choice {{descriptionMode === 'inherit' ? 'is-selected' : ''}}" variant="{{descriptionMode === 'inherit' ? 'fill' : 'tonal'}}">
              简介：{{descriptionMode === 'inherit' ? '已选' : ''}}继承基础
            </wu-f7-button>
            <wu-f7-button data-field="descriptionMode" data-value="set" bind:press="onChoice" class="management-action management-choice {{descriptionMode === 'set' ? 'is-selected' : ''}}" variant="{{descriptionMode === 'set' ? 'fill' : 'tonal'}}">
              简介：{{descriptionMode === 'set' ? '已选' : ''}}单独覆盖（可空）
            </wu-f7-button>
          </block>
          <textarea wx:if="{{operation !== 'set_category_override_scoped' || descriptionMode === 'set'}}" value="{{description}}" data-field="description" bindinput="onText" maxlength="-1" placeholder="简介（0–500 字）" disabled="{{busy}}" />
          <wu-f7-button wx:if="{{operation === 'create_system_category_scoped'}}" bind:press="onGenerateDescription" disabled="{{busy || assistance.busy}}" class="management-action" variant="tonal">
            生成简介建议
          </wu-f7-button>
          <wu-f7-button wx:if="{{operation === 'set_category_override_scoped'}}" bind:press="onResetOverride" class="management-action" variant="tonal">
            {{iconEnabled ? '名称、简介和图标都恢复继承' : '两个字段都恢复继承'}}
          </wu-f7-button>
        </block>
        <block wx:if="{{operation === 'set_category_visibility_scoped'}}">
          <view class="notice">
            仅改变当前明确视图的展示状态，不改变共享启用状态。
          </view>
          <wu-f7-button data-field="visibility" data-value="shown" bind:press="onChoice" class="management-action management-choice {{visibility === 'shown' ? 'is-selected' : ''}}" variant="{{visibility === 'shown' ? 'fill' : 'tonal'}}">
            {{visibility === 'shown' ? '已选：' : ''}}显示
          </wu-f7-button>
          <wu-f7-button data-field="visibility" data-value="hidden" bind:press="onChoice" class="management-action management-choice {{visibility === 'hidden' ? 'is-selected' : ''}}" variant="{{visibility === 'hidden' ? 'fill' : 'tonal'}}">
            {{visibility === 'hidden' ? '已选：' : ''}}隐藏
          </wu-f7-button>
        </block>
        <block wx:if="{{operation === 'set_category_lifecycle_scoped'}}">
          <view class="notice">
            归档后恢复到停用，再单独启用。启用父项不会覆盖子项各自的停用或隐藏。
          </view>
          <wu-f7-button wx:for="{{lifecycleActions}}" wx:key="value" data-field="lifecycleAction" data-value="{{item.value}}" bind:press="onChoice" disabled="{{!item.allowed}}" class="management-action management-choice {{lifecycleAction === item.value ? 'is-selected' : ''}}" variant="{{lifecycleAction === item.value ? 'fill' : 'tonal'}}">
            {{lifecycleAction === item.value ? '已选：' : ''}}{{item.label}}
          </wu-f7-button>
        </block>
        <block wx:if="{{operation === 'create_categories_scoped' || operation === 'create_system_category_scoped' || operation === 'set_category_scope_scoped'}}">
          <view class="section-title">
            明确适用范围
          </view>
          <wu-f7-button data-field="scopeKind" data-value="global" bind:press="onChoice" class="management-action management-choice {{scopeKind === 'global' ? 'is-selected' : ''}}" variant="{{scopeKind === 'global' ? 'fill' : 'tonal'}}">
            {{scopeKind === 'global' ? '已选：' : ''}}独立全局
          </wu-f7-button>
          <wu-f7-button data-field="scopeKind" data-value="campuses" bind:press="onChoice" class="management-action management-choice {{scopeKind === 'campuses' ? 'is-selected' : ''}}" variant="{{scopeKind === 'campuses' ? 'fill' : 'tonal'}}">
            {{scopeKind === 'campuses' ? '已选：' : ''}}精确校园集合
          </wu-f7-button>
          <block wx:if="{{scopeKind === 'campuses'}}">
            <wu-f7-button bind:press="onPlacementCampuses" class="management-action" variant="tonal">
              添加适用校园
            </wu-f7-button>
            <view wx:for="{{placementCampuses}}" wx:key="id">
              <view>
                {{item.label}} · {{item.id}}
              </view>
              <wu-f7-button data-id="{{item.id}}" bind:press="onRemovePlacementCampus" class="management-action" variant="tonal">
                从本次集合移除
              </wu-f7-button>
            </view>
            <view class="notice">
              校园集合必须非空，不会因新增校园自动扩大。
            </view>
          </block>
          <block wx:if="{{operation === 'set_category_scope_scoped'}}">
            <wu-f7-button data-field="propagation" data-value="self" bind:press="onChoice" class="management-action management-choice {{propagation === 'self' ? 'is-selected' : ''}}" variant="{{propagation === 'self' ? 'fill' : 'tonal'}}">
              {{propagation === 'self' ? '已选：' : ''}}仅此分类（必须保持后代路径合法）
            </wu-f7-button>
            <wu-f7-button data-field="propagation" data-value="subtree" bind:press="onChoice" class="management-action management-choice {{propagation === 'subtree' ? 'is-selected' : ''}}" variant="{{propagation === 'subtree' ? 'fill' : 'tonal'}}">
              {{propagation === 'subtree' ? '已选：' : ''}}同步完整子树
            </wu-f7-button>
            <view class="notice">
              变更分类适用范围不会移动、复制或重分类评分对象。
            </view>
            <view class="notice">
              同一稳定身份且共享定义、基础元数据和业务状态一致的多来源，才可按服务端预览原子合并承接。文字或业务状态可先分别统一；身份映射等冲突需要可信来源裁决，不能按当前校园猜测。
            </view>
          </block>
        </block>
        <block wx:if="{{operation === 'create_system_category_scoped'}}">
          <view class="section-title">
            已注册且有消费能力的系统类型
          </view>
          <wu-f7-button wx:for="{{systemOptions}}" wx:key="systemKey" data-key="{{item.systemKey}}" bind:press="onSystemKey" disabled="{{!item.available}}" class="management-action management-choice" variant="tonal">
            {{systemKey === item.systemKey ? '已选：' : ''}}{{item.systemKey}} · {{item.kind}} · 最多 {{item.maximumDepth}} 级
          </wu-f7-button>
          <view class="section-title">
            系统最大层数（后续通过批量子分类添加节点）
          </view>
          <wu-f7-button data-field="levelCount" data-value="1" bind:press="onChoice" class="management-action management-choice {{levelCount === 1 ? 'is-selected' : ''}}" variant="{{levelCount === 1 ? 'fill' : 'tonal'}}">
            {{levelCount === 1 ? '已选：' : ''}}一级
          </wu-f7-button>
          <wu-f7-button data-field="levelCount" data-value="2" bind:press="onChoice" class="management-action management-choice {{levelCount === 2 ? 'is-selected' : ''}}" variant="{{levelCount === 2 ? 'fill' : 'tonal'}}">
            {{levelCount === 2 ? '已选：' : ''}}二级
          </wu-f7-button>
          <wu-f7-button data-field="levelCount" data-value="3" bind:press="onChoice" class="management-action management-choice {{levelCount === 3 ? 'is-selected' : ''}}" variant="{{levelCount === 3 ? 'fill' : 'tonal'}}">
            {{levelCount === 3 ? '已选：' : ''}}三级
          </wu-f7-button>
          <view wx:if="{{!systemOptions.length}}" class="notice">
            当前没有可用系统注册选项；不能创建未知专用评分体系。
          </view>
        </block>
        <block wx:if="{{operation === 'create_categories_scoped' || operation === 'batch_update_subcategories_scoped'}}">
          <view class="section-title">
            本次新增节点 · {{nodes.length}} / 32
          </view>
          <view class="notice">
            {{detailId ? '新增项连接到当前分类（批量只新增直接子项）' : '新建根分类树'}}。每个新节点可独立选择图标；封面仍未接入；根分类可单独请求简介建议。
          </view>
          <view wx:for="{{nodes}}" wx:key="key" class="category-node">
            <view class="meta">
              {{item.key}} · 第 {{item.level}} 级{{item.parentKey ? ' · 上级 ' + item.parentKey : ''}}
            </view>
            <wu-f7-input value="{{item.name}}" data-key="{{item.key}}" data-field="name" bind:input="onNodeText" maxlength="-1" placeholder="新分类名称"  />
            <textarea value="{{item.description}}" data-key="{{item.key}}" data-field="description" bindinput="onNodeText" maxlength="-1" placeholder="新分类简介（可空）" />
            <wu-f7-button wx:if="{{operation === 'create_categories_scoped' &amp;&amp; !detailId &amp;&amp; !item.parentKey}}" data-key="{{item.key}}" bind:press="onGenerateDescription" disabled="{{busy || assistance.busy}}" class="management-action" variant="tonal">
              生成简介建议
            </wu-f7-button>
            <wu-f7-button wx:if="{{operation !== 'batch_update_subcategories_scoped' &amp;&amp; item.level &lt; 3}}" data-key="{{item.key}}" bind:press="onAddChild" class="management-action" variant="tonal">
              添加子节点
            </wu-f7-button>
            <wu-f7-button data-key="{{item.key}}" bind:press="onRemoveNode" class="management-action" variant="tonal">
              移除此草稿节点
            </wu-f7-button>
          </view>
          <wu-f7-button wx:if="{{operation === 'batch_update_subcategories_scoped' || !nodes.length}}" bind:press="onAddNode" class="management-action" variant="tonal">
            添加新分类草稿
          </wu-f7-button>
        </block>
        <block wx:if="{{operation === 'batch_update_subcategories_scoped'}}">
          <view class="section-title">
            直接子项的同一笔变更
          </view>
          <view class="notice">
            新增、停用、恢复和顺序一起提交；任一失败都不应部分生效。
          </view>
          <view wx:for="{{batchChildren}}" wx:key="id" class="category-node">
            <view>
              {{item.label}} · {{item.state}}
            </view>
            <wu-f7-button data-id="{{item.id}}" data-action="retain" bind:press="onBatchAction" class="management-action management-choice" variant="tonal">
              {{item.action === 'retain' ? '已选：' : ''}}保留
            </wu-f7-button>
            <wu-f7-button data-id="{{item.id}}" data-action="disable" bind:press="onBatchAction" disabled="{{item.state !== 'enabled'}}" class="management-action management-choice" variant="tonal">
              {{item.action === 'disable' ? '已选：' : ''}}停用
            </wu-f7-button>
            <wu-f7-button data-id="{{item.id}}" data-action="restore" bind:press="onBatchAction" disabled="{{item.state !== 'archived'}}" class="management-action management-choice" variant="tonal">
              {{item.action === 'restore' ? '已选：' : ''}}恢复为停用
            </wu-f7-button>
            <wu-f7-button data-id="{{item.id}}" data-action="enable" bind:press="onBatchAction" disabled="{{item.state !== 'disabled'}}" class="management-action management-choice" variant="tonal">
              {{item.action === 'enable' ? '已选：' : ''}}启用
            </wu-f7-button>
          </view>
          <wu-f7-button wx:if="{{canPreviousBatch}}" data-direction="-1" bind:press="onPageBatch" class="management-action" variant="tonal">
            上一页子项
          </wu-f7-button>
          <wu-f7-button wx:if="{{canNextBatch}}" data-direction="1" bind:press="onPageBatch" class="management-action" variant="tonal">
            下一页子项
          </wu-f7-button>
        </block>
        <block wx:if="{{operation === 'reorder_categories_scoped' || operation === 'batch_update_subcategories_scoped'}}">
          <view class="section-title">
            完整同级顺序
          </view>
          <view class="notice">
            包含当前隐藏、停用和归档项；不能只提交当前分页或跨父分类 ID。
          </view>
          <wu-f7-button wx:if="{{operation === 'reorder_categories_scoped'}}" data-field="orderMode" data-value="set" bind:press="onChoice" class="management-action management-choice {{orderMode === 'set' ? 'is-selected' : ''}}" variant="{{orderMode === 'set' ? 'fill' : 'tonal'}}">
            {{orderMode === 'set' ? '已选：' : ''}}保存当前排列
          </wu-f7-button>
          <wu-f7-button wx:if="{{operation === 'reorder_categories_scoped'}}" data-field="orderMode" data-value="inherit" bind:press="onChoice" class="management-action management-choice {{orderMode === 'inherit' ? 'is-selected' : ''}}" variant="{{orderMode === 'inherit' ? 'fill' : 'tonal'}}">
            {{orderMode === 'inherit' ? '已选：' : ''}}恢复继承顺序
          </wu-f7-button>
          <view wx:for="{{order}}" wx:key="key" class="order-row">
            <view>
              {{orderOffset + index + 1}}. {{item.label}}
            </view>
            <wu-f7-button data-key="{{item.key}}" data-direction="up" bind:press="onMove" disabled="{{orderOffset + index === 0}}" class="management-action" variant="tonal">
              上移
            </wu-f7-button>
            <wu-f7-button data-key="{{item.key}}" data-direction="down" bind:press="onMove" disabled="{{orderOffset + index === orderCount - 1}}" class="management-action" variant="tonal">
              下移
            </wu-f7-button>
          </view>
          <view class="meta">
            完整集合 {{orderCount}} 项，本页显示 {{order.length}} 项
          </view>
          <wu-f7-button wx:if="{{canPreviousOrder}}" data-direction="-1" bind:press="onPageOrder" class="management-action" variant="tonal">
            上一页顺序
          </wu-f7-button>
          <wu-f7-button wx:if="{{canNextOrder}}" data-direction="1" bind:press="onPageOrder" class="management-action" variant="tonal">
            下一页顺序
          </wu-f7-button>
        </block>
        <view wx:if="{{iconEnabled &amp;&amp; iconSlots.length}}">
          <view class="section-title">
            图标选择与来源
          </view>
          <view class="notice">
            先完成文字、范围和所有图标模式，再冻结草稿并依次选择图片。继承会跟随基础；明确无图会遮蔽基础。
          </view>
          <view wx:for="{{iconSlots}}" wx:key="key" class="category-node">
            <view>
              {{item.label}} · 已选 {{item.selection}}
            </view>
            <wu-f7-button wx:if="{{item.canKeep}}" data-key="{{item.key}}" data-value="keep" bind:press="onIconChoice" class="management-action management-choice" variant="tonal">
              保留当前图标
            </wu-f7-button>
            <wu-f7-button wx:if="{{item.isOverride}}" data-key="{{item.key}}" data-value="inherit" bind:press="onIconChoice" class="management-action management-choice" variant="tonal">
              继承共享基础
            </wu-f7-button>
            <wu-f7-button wx:if="{{item.isOverride}}" data-key="{{item.key}}" data-value="set-empty" bind:press="onIconChoice" class="management-action management-choice" variant="tonal">
              本校园明确无图
            </wu-f7-button>
            <wu-f7-button data-key="{{item.key}}" data-value="clear" bind:press="onIconChoice" wx:else class="management-action management-choice" variant="tonal">
              清空图标 / 新节点无图
            </wu-f7-button>
            <wu-f7-button data-key="{{item.key}}" data-value="replace" bind:press="onIconChoice" class="management-action management-choice" variant="tonal">
              冻结后选择新图
            </wu-f7-button>
          </view>
        </view>
        <wu-f7-button bind:press="onPrepare" disabled="{{busy}}" loading="{{busy}}" class="management-primary" variant="fill" size="large">
          {{iconEnabled ? '冻结文字与全部图标槽位，继续上传 / 预览' : '准备并核对完整变更预览'}}
        </wu-f7-button>
        <wu-f7-button bind:press="onDiscardDraft" disabled="{{busy}}" class="management-quiet" variant="plain">
          取消未保存的本地改动
        </wu-f7-button>
      </view>
    </block>
  </block>
  <view wx:if="{{assistance.requestId || assistance.status}}" class="card">
    <view class="section-title">
      简介建议
    </view>
    <view>
      {{assistance.status}}
    </view>
    <view wx:if="{{assistance.preview}}" class="body">
      {{assistance.preview}}
    </view>
    <wu-f7-button wx:if="{{assistance.canAdopt}}" bind:press="onAdoptDescription" disabled="{{busy || frozen || assistance.busy}}" class="management-action" variant="tonal">
      采用此简介
    </wu-f7-button>
    <wu-f7-button wx:if="{{assistance.canRecover}}" bind:press="onRecoverAssistance" disabled="{{assistance.busy}}" class="management-action" variant="tonal">
      查询原建议请求
    </wu-f7-button>
    <wu-f7-button wx:if="{{assistance.canCancel}}" bind:press="onCancelAssistance" disabled="{{assistance.busy}}" class="management-action" variant="tonal">
      取消原建议请求
    </wu-f7-button>
    <wu-f7-button wx:if="{{assistance.canDismiss}}" bind:press="onDismissAssistance" disabled="{{assistance.busy}}" class="management-action" variant="plain">
      关闭此建议
    </wu-f7-button>
  </view>
  <view wx:if="{{preview}}" class="card confirmation management-preview management-confirmation" aria-role="alert">
    <view class="section-title">
      核对服务端完整预览
    </view>
    <view>
      {{preview.operationLabel}}
    </view>
    <view class="meta">
      原请求：{{requestId}}
    </view>
    <view class="meta">
      确认有效期：{{preview.validUntil}}
    </view>
    <view class="body" wx:for="{{preview.lines}}" wx:key="*this">
      {{item}}
    </view>
    <view class="meta">
      变更明细 {{preview.from}}–{{preview.to}} / {{preview.changeCount}} 项，确认绑定完整预览摘要。
    </view>
    <wu-f7-button wx:if="{{preview.canPrevious}}" data-direction="-1" bind:press="onPagePreview" class="management-action" variant="tonal">
      上一页变更
    </wu-f7-button>
    <wu-f7-button wx:if="{{preview.canNext}}" data-direction="1" bind:press="onPagePreview" class="management-action" variant="tonal">
      下一页变更
    </wu-f7-button>
    <view class="notice">
      确认仅提交以上原意图与精确版本。版本、授权、来源或审核变更会整体拒绝，需要重新核验。
    </view>
    <wu-f7-button bind:press="onCommit" disabled="{{busy}}" loading="{{busy}}" class="management-primary" variant="fill" size="large">
      确认发布这笔完整变更
    </wu-f7-button>
    <wu-f7-button bind:press="onClosePreview" disabled="{{busy}}" class="management-quiet" variant="plain">
      关闭预览并保留原请求
    </wu-f7-button>
  </view>
  <view class="notice">
    {{iconEnabled ? '本范围支持独立图标协议，封面仍未接入。' : '当前文字协议不提供图标上传。'}}未知专用评分类型不能替代为通用评分。
  </view>
  <view class="management-history">
    <view class="section-title">
      原请求与旧图
    </view>
    <view wx:if="{{iconRetirement}}" class="card">
      <view class="section-title">
        原请求的旧图标清理
      </view>
      <view class="meta">
        {{iconRetirement.requestId}}
      </view>
      <view class="notice">
        {{iconRetirement.status}}
      </view>
      <view class="notice">
        清理须重新核验原账号与全部原影响范围。仍被引用的图标会保留；清理排队或引用退役都不等于文件已物理删除。
      </view>
      <wu-f7-button bind:press="onIconRetirementInspect" disabled="{{busy}}" class="management-action" variant="tonal">
        查询此原请求的旧图状态
      </wu-f7-button>
      <view wx:for="{{iconRetirement.items}}" wx:key="appearanceId" class="history-row">
        <view class="meta">
          {{item.appearanceId}}
        </view>
        <view>
          {{item.label}}
        </view>
        <wu-f7-button wx:if="{{item.canCleanup}}" data-id="{{item.appearanceId}}" bind:press="onIconRetirementCleanup" disabled="{{busy}}" class="management-action" variant="tonal">
          明确请求清理此旧图
        </wu-f7-button>
      </view>
      <view class="meta">
        旧图记录 {{iconRetirement.from}}–{{iconRetirement.to}} / {{iconRetirement.count}}
      </view>
      <wu-f7-button wx:if="{{iconRetirement.canPrevious}}" data-direction="-1" bind:press="onIconRetirementPage" disabled="{{busy}}" class="management-action" variant="tonal">
        上一页旧图
      </wu-f7-button>
      <wu-f7-button wx:if="{{iconRetirement.canNext}}" data-direction="1" bind:press="onIconRetirementPage" disabled="{{busy}}" class="management-action" variant="tonal">
        下一页旧图
      </wu-f7-button>
    </view>
    <view wx:if="{{hasSession &amp;&amp; configured}}" class="card">
      <view class="section-title">
        恢复原分类图标清理
      </view>
      <view class="notice">
        重启或丢失清理响应后，可填写已知原请求编号。先查询原回执，再读取服务器保留的旧图记录；不会换编号重发分类变更。
      </view>
      <wu-f7-input value="{{iconRetirementRecoveryRequestId}}" bind:input="onIconRetirementRequestId" maxlength="36" placeholder="原分类变更请求编号" disabled="{{busy}}"  />
      <wu-f7-button bind:press="onIconRetirementRecover" disabled="{{busy}}" class="management-action" variant="tonal">
        按原请求恢复旧图状态
      </wu-f7-button>
    </view>
  </view>
  <navigator url="/pages/rating-recovery/rating-recovery" class="management-link">
    独立查询历史评分回执
    <wu-icon name="chevron-right" tone="muted" size="22" />
  </navigator>
  <wu-f7-button bind:press="onReturnCatalog" class="management-quiet" variant="plain">
    返回当前范围评分目录
  </wu-f7-button>
  </wu-f7-block>
</view>
