<template name="product-rating-status">
  <view
    wx:if="{{!loaded || busy || needsRefresh}}"
    class="status"
    aria-role="status"
    >{{status}}</view
  >
  <view wx:if="{{error}}" class="error" aria-role="alert">{{error}}</view>
  <view wx:if="{{receiptStatus}}" class="notice">{{receiptStatus}}</view>
  <navigator wx:if="{{!hasSession}}" class="link" url="/pages/login/login"
    >登录后继续</navigator
  >
  <view wx:if="{{frozen}}" class="product-recovery">
    <view class="section-title">上次操作结果待确认</view>
    <view class="notice">尚未确认结果，请查询或重试原请求，不要重复提交。</view>
    <button bindtap="onRecover" disabled="{{busy}}">查询原回执</button>
    <button bindtap="onRetry" disabled="{{busy}}">重试原请求</button>
    <navigator
      class="link"
      url="/pages/rating-category-manage/rating-category-manage?scope=global"
      >分类管理操作</navigator
    >
    <navigator
      class="link"
      url="/pages/rating-category-create/rating-category-create"
      >分类创建申请</navigator
    >
    <navigator
      class="link"
      url="/pages/rating-scoped/rating-scoped?mode=recovery"
      >校园评分操作</navigator
    >
  </view>
  <button
    class="plain-button"
    bindtap="onRefresh"
    disabled="{{busy}}"
    loading="{{busy}}"
  >
    {{needsRefresh ? '刷新后重新确认' : '重新加载'}}
  </button>
  <button class="plain-button" wx:if="{{busy}}" bindtap="onCancel">
    停止等待
  </button>
</template>

<template name="product-rating-like">
  <block wx:if="{{state &amp;&amp; state.status === 'known'}}">
    <button
      class="product-like"
      data-id="{{id}}"
      bindtap="onLike"
      disabled="{{busy || frozen}}"
    >
      {{state.liked ? '已赞' : '赞'}} {{state.count}}
    </button>
  </block>
  <view wx:else class="notice">点赞暂不可用</view>
</template>
