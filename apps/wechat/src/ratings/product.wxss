/* Public ratings journeys. Legacy recovery and management pages keep their styles. */
.rating-product,
.course-product {
  padding: 28rpx 32rpx calc(48rpx + env(safe-area-inset-bottom));
  min-height: 100vh;
  box-sizing: border-box;
  background: var(--wu-surface);
}
.rating-product.has-dock,
.course-product.has-dock {
  padding-bottom: calc(160rpx + env(safe-area-inset-bottom));
}
.rating-product .title,
.course-product .title {
  font-size: 48rpx;
  line-height: 1.25;
  margin: 8rpx 0 18rpx;
  letter-spacing: -1.2rpx;
}
.rating-product .section-title,
.course-product .section-title {
  font-size: 30rpx;
  line-height: 1.4;
  margin: 0 0 8rpx;
}
.rating-product .body,
.course-product .body {
  font-size: 29rpx;
  line-height: 1.65;
  margin: 14rpx 0;
  word-break: normal;
  overflow-wrap: anywhere;
}
.rating-product .meta,
.course-product .meta {
  font-size: 24rpx;
  margin: 8rpx 0;
  line-height: 1.5;
}
.rating-product .notice,
.rating-product .status,
.course-product .notice,
.course-product .status {
  padding: 10rpx 0;
  font-size: 25rpx;
  line-height: 1.6;
}
.rating-product .empty,
.course-product .empty {
  text-align: center;
  padding: 80rpx 16rpx;
}
.rating-product .card,
.course-product .card {
  padding: 28rpx 0;
  margin: 0;
  border: 0;
  border-radius: 0;
  background: transparent;
}
.rating-product button,
.course-product button {
  background: var(--wu-bg);
  color: var(--wu-text);
  border-radius: 18rpx;
  font-size: 27rpx;
  font-weight: 500;
  margin: 0;
  padding: 0 24rpx;
  line-height: 1.4;
  display: flex;
  align-items: center;
  justify-content: center;
}
.rating-product button.primary,
.course-product button.primary {
  background: var(--wu-text);
  color: var(--wu-surface);
}
.rating-product .plain-button,
.course-product .plain-button {
  background: transparent;
  color: var(--wu-secondary);
  min-height: 88rpx;
  padding: 0 12rpx;
  font-size: 25rpx;
}
.rating-product .link,
.course-product .link {
  color: var(--wu-text);
  font-size: 27rpx;
}
.product-heading,
.product-section-heading,
.product-toolbar,
.product-inline-actions,
.product-search {
  display: flex;
  align-items: center;
  gap: 16rpx;
}
.product-heading,
.product-section-heading {
  justify-content: space-between;
}
.product-heading {
  margin-bottom: 12rpx;
}
.product-heading .title {
  margin: 0;
}
.product-toolbar {
  justify-content: flex-end;
  margin: 6rpx -12rpx;
  flex-wrap: wrap;
}
.product-state {
  margin: 6rpx 0;
}
.product-state .status:empty {
  display: none;
}
.product-section {
  padding: 30rpx 0;
}
.product-section + .product-section {
  border-top: 1rpx solid var(--wu-separator);
}
.product-section-heading {
  margin: 28rpx 0 12rpx;
}
.product-tabs {
  display: flex;
  gap: 24rpx;
  align-items: center;
  overflow-x: auto;
  margin: 14rpx 0;
}
.rating-product .product-tabs button,
.course-product .product-tabs button {
  flex: none;
  min-height: 88rpx;
  padding: 0;
  border-radius: 0;
  background: transparent;
  color: var(--wu-secondary);
  border-bottom: 3rpx solid transparent;
}
.rating-product .product-tabs .selected,
.course-product .product-tabs .selected {
  color: var(--wu-text);
  border-bottom-color: var(--wu-text);
  font-weight: 600;
}
.product-entry-row {
  display: flex;
  gap: 12rpx;
  margin: 24rpx 0 30rpx;
}
.product-entry {
  flex: 1;
  padding: 22rpx 10rpx;
  background: var(--wu-bg);
  border-radius: 18rpx;
  text-align: center;
  font-size: 27rpx;
  font-weight: 600;
}
.product-list-row {
  padding: 28rpx 0;
  border-bottom: 1rpx solid var(--wu-separator);
}
.product-list-row:last-child {
  border-bottom: 0;
}
.product-list-row .product-inline-actions {
  margin: 14rpx 0 0;
  justify-content: space-between;
}
.rating-product .product-row-open,
.course-product .product-row-open {
  width: 100%;
  min-height: 88rpx;
  padding: 0;
  background: transparent;
  justify-content: space-between;
  text-align: left;
  gap: 20rpx;
  font-size: 32rpx;
  font-weight: 600;
}
.product-chevron {
  color: var(--wu-tertiary);
  font-size: 38rpx;
  font-weight: 400;
}
.product-disclosure {
  background: var(--wu-bg);
  border-radius: 20rpx;
  margin: 14rpx 0;
  padding: 24rpx;
}
.product-disclosure .link {
  display: block;
  padding: 16rpx 0;
}
.product-disclosure button + button {
  margin-top: 12rpx;
}
.product-disclosure .body {
  margin-top: 0;
}
.product-hero {
  padding: 24rpx 0 30rpx;
}
.product-score-summary {
  display: flex;
  gap: 22rpx;
  align-items: center;
  margin: 24rpx 0;
}
.product-score-number {
  font-size: 76rpx;
  line-height: 1;
  font-weight: 700;
  letter-spacing: -2rpx;
  font-variant-numeric: tabular-nums;
}
.product-score-caption {
  color: var(--wu-secondary);
  font-size: 24rpx;
}
.product-score-summary .meta {
  margin: 0;
}
.product-score-grid {
  display: flex;
  gap: 12rpx;
  margin: 20rpx 0;
}
.product-score-axis {
  flex: 1;
  min-width: 0;
  padding: 20rpx 10rpx;
  background: var(--wu-bg);
  border-radius: 18rpx;
  text-align: center;
}
.product-score-axis .value {
  font-size: 40rpx;
  font-weight: 650;
  line-height: 1.25;
}
.product-score-axis .label {
  font-size: 23rpx;
  font-weight: 400;
  color: var(--wu-secondary);
  margin-top: 6rpx;
}
.product-score-scale {
  display: flex;
  gap: 10rpx;
  margin: 22rpx 0;
}
.product-score-scale button {
  flex: 1;
  padding: 0;
  min-width: 0;
}
.rating-product .score-selected,
.course-product .score-selected {
  background: var(--wu-text);
  color: var(--wu-surface);
}
.product-comment {
  padding: 28rpx 0;
  border-bottom: 1rpx solid var(--wu-separator);
}
.product-comment .author {
  font-size: 27rpx;
}
.product-comment .badge {
  background: transparent;
  padding: 0;
  font-size: 23rpx;
  color: var(--wu-secondary);
  font-weight: 400;
}
.product-comment .product-inline-actions {
  gap: 18rpx;
  flex-wrap: wrap;
}
.rating-product .product-like {
  background: transparent;
  min-height: 88rpx;
  padding: 0;
  font-size: 25rpx;
  color: var(--wu-secondary);
  gap: 8rpx;
}
.product-quote {
  color: var(--wu-secondary);
  font-size: 25rpx;
  padding: 12rpx 18rpx;
  margin: 12rpx 0;
  border-left: 3rpx solid var(--wu-separator);
}
.product-dock {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  padding: 18rpx 32rpx calc(18rpx + env(safe-area-inset-bottom));
  background: var(--wu-surface);
  border-top: 1rpx solid var(--wu-separator);
  z-index: 20;
  display: flex;
  align-items: center;
  gap: 18rpx;
}
.product-dock .primary {
  flex: 1;
}
.product-dock .meta {
  margin: 0;
}
.rating-product .modal-mask,
.course-product .modal-mask {
  align-items: flex-end;
  padding: 0;
  background: rgba(0, 0, 0, 0.35);
}
.rating-product .modal,
.course-product .modal {
  max-height: 84vh;
  box-sizing: border-box;
  padding: 30rpx 32rpx calc(30rpx + env(safe-area-inset-bottom));
  background: var(--wu-elevated);
  border-radius: 30rpx 30rpx 0 0;
}
.modal .product-heading {
  margin-bottom: 22rpx;
}
.modal button + button {
  margin-top: 14rpx;
}
.modal .product-inline-actions button + button,
.modal .product-score-scale button + button {
  margin-top: 0;
}
.rating-product input,
.rating-product textarea,
.course-product input,
.course-product textarea {
  background: var(--wu-bg);
  color: var(--wu-text);
  border: 0;
  border-radius: 16rpx;
}
.product-search {
  margin: 22rpx 0;
}
.product-search input {
  flex: 1;
  min-width: 0;
  margin: 0;
}
.product-search button {
  flex: none;
}
.product-form-canvas {
  padding: 20rpx 0;
}
.rating-product .product-title-input {
  background: transparent;
  border-bottom: 1rpx solid var(--wu-separator);
  border-radius: 0;
  height: 100rpx;
  padding: 14rpx 0;
  font-size: 36rpx;
  font-weight: 600;
}
.rating-product .product-body-input {
  background: transparent;
  padding: 16rpx 0;
  min-height: 380rpx;
  border-radius: 0;
}
.product-recovery {
  background: var(--wu-bg);
  border-radius: 20rpx;
  padding: 24rpx;
  margin: 18rpx 0;
}
.product-recovery .product-inline-actions {
  margin-top: 18rpx;
}
.product-recovery .product-inline-actions button {
  flex: 1;
  background: var(--wu-surface);
}
.product-end {
  margin-top: 28rpx;
  display: flex;
  justify-content: center;
  gap: 28rpx;
}
.product-end .link {
  color: var(--wu-secondary);
  font-size: 24rpx;
}
.product-distribution {
  display: flex;
  justify-content: space-between;
  padding: 10rpx 0;
  font-size: 25rpx;
}
.course-product .course-scores {
  display: grid;
  grid-template-columns: repeat(5, 1fr);
  gap: 10rpx;
  margin: 16rpx 0 28rpx;
}
.course-product .course-scores button {
  width: 100%;
  min-height: 88rpx;
  padding: 0;
}
.course-product .filter-picker {
  margin: 0;
  padding: 16rpx 0;
  border: 0;
  color: var(--wu-text);
  font-size: 25rpx;
}
.course-product .comment-body {
  line-height: 1.65;
}
.course-product .comment-input {
  border: 0;
  padding: 22rpx;
  min-height: 300rpx;
}

.rating-product .plain-button,
.course-product .plain-button {
  gap: 8rpx;
}
.course-product .filter-picker {
  display: flex;
  align-items: center;
  gap: 8rpx;
}
