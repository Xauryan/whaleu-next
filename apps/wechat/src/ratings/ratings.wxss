@import '../community/forms.wxss';
.body {
  white-space: pre-wrap;
  overflow-wrap: anywhere;
}
.scores {
  display: flex;
  gap: 12rpx;
  margin: 20rpx 0;
}
.scores button {
  flex: 1;
  min-width: 0;
  padding: 0;
  font-size: 28rpx;
}
.score-selected {
  background: #175990;
  color: #fff;
}
.distribution {
  display: flex;
  justify-content: space-between;
  margin: 12rpx 0;
}
.recovery {
  border: 1px solid #d39055;
}
.modal-mask {
  position: fixed;
  inset: 0;
  background: rgba(0, 0, 0, 0.4);
  z-index: 50;
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 32rpx;
}
.modal {
  width: 100%;
  max-height: 80vh;
  overflow: auto;
  background: #fff;
  padding: 28rpx;
  border-radius: 24rpx;
}
textarea {
  box-sizing: border-box;
  width: 100%;
  min-height: 220rpx;
}
.rating-cover-thumb {
  width: 120rpx;
  height: 120rpx;
  border-radius: 12rpx;
}
.rating-cover > image,
.rating-cover-editor > image {
  width: 240rpx;
  height: 240rpx;
}
.rating-cover-expanded {
  position: fixed;
  inset: 0;
  z-index: 100;
  background: rgba(0, 0, 0, 0.92);
  display: flex;
  flex-direction: column;
  justify-content: center;
  padding: 32rpx;
}
.rating-cover-expanded image {
  width: 100%;
  height: 75vh;
}
