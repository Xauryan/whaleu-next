<template name="discussion-status">
  <view class="status">{{status}}</view><view wx:if="{{error}}" class="error">{{error}}</view>
  <view wx:if="{{receiptStatus}}" class="notice">{{receiptStatus}}</view>
  <navigator wx:if="{{!hasSession}}" class="link" url="/pages/login/login">登录后继续 →</navigator>
  <button bindtap="onRefresh" disabled="{{busy}}">重新核验当前内容</button>
  <button wx:if="{{busy}}" bindtap="onCancelWait">停止等待</button>
  <view wx:if="{{frozen}}" class="card">
    <view class="section-title">原请求待确认</view><view class="meta">窗口：{{recoveryWindowId}}</view>
    <view class="meta">操作：{{recoveryOperation}} · {{recoveryPhase === 'cancel' ? '已确认取消，等待服务端结果' : '提交结果待确认'}}</view>
    <view wx:if="{{recoveryCommentId}}" class="meta">评论 / 主题：{{recoveryCommentId}}</view>
    <view class="notice">原请求编号、原文与版本已固定。停止等待不会取消服务端操作，也不能创建替代请求。</view>
    <button bindtap="onRecover" disabled="{{busy}}">查询原回执</button>
    <button bindtap="onRetry" disabled="{{busy}}">先查回执，再重试原{{recoveryPhase === 'cancel' ? '取消' : '请求'}}</button>
    <button wx:if="{{recoveryPhase === 'submit'}}" bindtap="onRequestCancellation" disabled="{{busy}}">查询后申请取消</button>
    <view wx:if="{{confirming === 'cancel'}}" class="confirmation"><view>确认取消这个原请求？若已完成，以原回执为准。</view><button bindtap="onConfirmCancellation" disabled="{{busy}}">确认服务端取消</button><button bindtap="onCloseConfirmation" disabled="{{busy}}">返回</button></view>
  </view>
</template>
<template name="discussion-item">
  <view class="card {{focusCommentId === item.id ? 'focused' : ''}}">
    <view class="section-title">{{item.author.displayName}}</view>
    <view wx:if="{{item.addressedAuthor}}" class="meta">回复 {{item.addressedAuthor.displayName}}</view>
    <view class="body">{{item.body}}</view><view class="meta">{{item.createdAt}} · {{item.likes}} 个赞</view>
    <button data-id="{{item.id}}" bindtap="onLike" disabled="{{busy || frozen || confirming}}">{{item.isLiked ? '取消我的赞' : '赞'}}</button>
    <button wx:if="{{mode === 'roots'}}" data-id="{{item.id}}" bindtap="onThread" disabled="{{busy}}">查看 {{item.replyCount}} 条回复 →</button>
    <button wx:elif="{{item.rootId}}" data-id="{{item.id}}" bindtap="onReply" disabled="{{busy || frozen || confirming}}">回复 {{item.author.displayName}}</button>
  </view>
</template>
<template name="discussion-form">
  <view wx:if="{{loaded &amp;&amp; !frozen}}" class="card">
    <view class="section-title">{{mode === 'thread' ? '使用公开昵称回复' : '使用公开昵称评论'}}</view>
    <view wx:if="{{mode === 'thread'}}" class="notice">{{replyTarget ? '回复 ' + replyTarget.author.displayName : '回复主题作者'}}<button wx:if="{{replyTarget}}" bindtap="onReplyRoot" disabled="{{busy || confirming}}">改为回复主题</button></view>
    <textarea value="{{body}}" maxlength="-1" bindinput="onBody" disabled="{{busy || confirming}}" placeholder="文字内容，不支持图片" />
    <view class="meta">{{bodyBytes}} / 8000 UTF-8 字节 · 保留原文</view>
    <button bindtap="onConfirmPublish" disabled="{{busy || confirming || !canPublish}}">核对后发表</button>
  </view>
  <view wx:if="{{confirming === 'publish'}}" class="card confirmation"><view class="section-title">确认以公开昵称发表</view><view class="body">{{body}}</view><view>文字独立于窗口分数，根评论不发送窗口创建者通知。</view><button bindtap="onSubmit" disabled="{{busy}}">确认发表原文</button><button bindtap="onCloseConfirmation" disabled="{{busy}}">返回修改</button></view>
  <view wx:if="{{confirming === 'like' &amp;&amp; selectedComment}}" class="card confirmation"><view class="section-title">确认{{selectedComment.isLiked ? '取消我的赞' : '点赞'}}</view><view class="body">{{selectedComment.body}}</view><view>只修改自己的点赞。其他设备上的新版本不会被覆盖。</view><button bindtap="onSubmit" disabled="{{busy}}">确认这次{{selectedComment.isLiked ? '取消点赞' : '点赞'}}</button><button bindtap="onCloseConfirmation" disabled="{{busy}}">返回</button></view>
</template>
