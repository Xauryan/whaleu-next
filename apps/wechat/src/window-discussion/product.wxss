/* Public window discussion only; recovery and notices keep their own surfaces. */
.discussion-product {
  min-height: 100vh;
  padding: 8rpx 32rpx calc(48rpx + env(safe-area-inset-bottom));
  box-sizing: border-box;
  background: var(--wu-surface);
}
.discussion-product.has-dock {
  padding-bottom: calc(160rpx + env(safe-area-inset-bottom));
}
.discussion-product button {
  min-height: 88rpx;
  margin: 0;
  padding: 0 24rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 12rpx;
  border-radius: 18rpx;
  background: var(--wu-bg);
  color: var(--wu-text);
  font-size: 27rpx;
  font-weight: 500;
  line-height: 1.4;
}
.discussion-product .discussion-toolbar,
.discussion-product .discussion-section-heading,
.discussion-product .discussion-byline,
.discussion-product .discussion-sheet-header,
.discussion-product .discussion-gallery-toolbar {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 20rpx;
}
.discussion-product .discussion-tabs {
  display: flex;
  gap: 32rpx;
}
.discussion-product .discussion-tabs button {
  padding: 0;
  border-radius: 0;
  background: transparent;
  color: var(--wu-secondary);
  border-bottom: 4rpx solid transparent;
  font-size: 30rpx;
}
.discussion-product .discussion-tabs button.selected {
  border-color: var(--wu-text);
  color: var(--wu-text);
  font-weight: 600;
}
.discussion-product .discussion-icon-button {
  width: 88rpx;
  padding: 0;
  background: transparent;
  flex: none;
}
.discussion-product .discussion-thread-tools {
  display: flex;
  justify-content: flex-end;
  margin-bottom: -16rpx;
}
.discussion-product .discussion-list-count {
  margin-top: 28rpx;
  color: var(--wu-secondary);
  font-size: 24rpx;
}
.discussion-product .discussion-item {
  padding: 28rpx 0 20rpx;
}
.discussion-product .discussion-item + .discussion-item {
  border-top: 1rpx solid var(--wu-separator);
}
.discussion-product .discussion-author {
  font-size: 27rpx;
  font-weight: 600;
  min-width: 0;
  overflow-wrap: anywhere;
}
.discussion-product .discussion-time {
  flex: none;
  font-size: 23rpx;
  color: var(--wu-tertiary);
}
.discussion-product .discussion-addressed {
  margin-top: 10rpx;
  font-size: 24rpx;
  color: var(--wu-secondary);
}
.discussion-product .discussion-body {
  margin: 16rpx 0 8rpx;
  white-space: pre-wrap;
  overflow-wrap: anywhere;
  font-size: 29rpx;
  line-height: 1.65;
}
.discussion-product .discussion-item-actions,
.discussion-product .discussion-images,
.discussion-product .discussion-photo-actions,
.discussion-product .discussion-gallery-actions {
  display: flex;
  align-items: center;
  flex-wrap: wrap;
  gap: 24rpx;
}
.discussion-product .discussion-item-actions {
  gap: 32rpx;
}
.discussion-product .discussion-inline-button {
  padding: 0;
  min-width: 88rpx;
  background: transparent;
  color: var(--wu-secondary);
  font-size: 24rpx;
}
.discussion-product .discussion-liked {
  color: var(--wu-text);
}
.discussion-product .discussion-images {
  gap: 12rpx;
  margin-top: 18rpx;
}
.discussion-product .discussion-image-button {
  font-size: 24rpx;
}
.discussion-product .discussion-focused {
  border-radius: 14rpx;
  background: var(--wu-tint);
  padding-left: 20rpx;
  padding-right: 20rpx;
}
.discussion-product .discussion-root .discussion-topic {
  padding-top: 12rpx;
  padding-bottom: 28rpx;
}
.discussion-product .discussion-root .discussion-body {
  font-size: 33rpx;
}
.discussion-product .discussion-section-heading {
  padding-top: 30rpx;
  border-top: 1rpx solid var(--wu-separator);
}
.discussion-product .discussion-section-title {
  margin: 0;
  font-size: 31rpx;
  font-weight: 600;
  line-height: 1.4;
}
.discussion-product .discussion-count {
  margin-left: 14rpx;
  color: var(--wu-secondary);
  font-size: 25rpx;
  font-weight: 400;
}
.discussion-product .discussion-meta {
  font-size: 24rpx;
  color: var(--wu-secondary);
  line-height: 1.55;
  overflow-wrap: anywhere;
}
.discussion-product .discussion-status,
.discussion-product .discussion-notice {
  padding: 12rpx 0;
  color: var(--wu-secondary);
  font-size: 25rpx;
  line-height: 1.6;
  overflow-wrap: anywhere;
}
.discussion-product .discussion-status:empty {
  display: none;
}
.discussion-product .discussion-error {
  padding: 18rpx 0;
  color: var(--wu-danger);
  font-size: 26rpx;
}
.discussion-product .discussion-tools {
  background: var(--wu-bg);
  border-radius: 20rpx;
  margin: 14rpx 0;
  padding: 4rpx 20rpx;
}
.discussion-product .discussion-tool {
  display: flex;
  align-items: center;
  gap: 16rpx;
  min-height: 88rpx;
  color: var(--wu-text);
  font-size: 26rpx;
  padding: 0;
  background: transparent;
  justify-content: flex-start;
}
.discussion-product .discussion-tool > wu-icon:last-child {
  margin-left: auto;
}
.discussion-product .discussion-link {
  min-height: 88rpx;
  display: flex;
  align-items: center;
  color: var(--wu-accent);
}
.discussion-product .discussion-text-button {
  background: transparent;
  color: var(--wu-secondary);
  font-size: 26rpx;
}
.discussion-product .discussion-next {
  width: 100%;
  margin-top: 12rpx;
}
.discussion-product .discussion-empty {
  padding: 100rpx 20rpx;
  text-align: center;
}
.discussion-product .discussion-empty > wu-icon {
  display: inline-flex;
  margin-bottom: 28rpx;
}
.discussion-product .discussion-empty .discussion-meta {
  margin-top: 12rpx;
}
.discussion-product .discussion-primary {
  background: var(--wu-text);
  color: var(--wu-surface);
  width: 100%;
}
.discussion-product .discussion-dock {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  z-index: 10;
  padding: 16rpx 32rpx calc(16rpx + env(safe-area-inset-bottom));
  background: var(--wu-surface);
  border-top: 1rpx solid var(--wu-separator);
}
.discussion-product .discussion-sheet-backdrop {
  position: fixed;
  inset: 0;
  z-index: 30;
  background: rgba(0, 0, 0, 0.34);
  display: flex;
  align-items: flex-end;
}
.discussion-product .discussion-sheet {
  width: 100%;
  box-sizing: border-box;
  padding: 24rpx 32rpx calc(24rpx + env(safe-area-inset-bottom));
  border-radius: 28rpx 28rpx 0 0;
  background: var(--wu-elevated);
  max-height: 88vh;
  overflow-y: auto;
}
.discussion-product .discussion-sheet-header {
  margin-bottom: 8rpx;
}
.discussion-product textarea {
  width: 100%;
  height: 240rpx;
  margin: 24rpx 0 12rpx;
  box-sizing: border-box;
  color: var(--wu-text);
  font-size: 30rpx;
  line-height: 1.6;
}
.discussion-product .discussion-compose-meta {
  text-align: right;
  font-size: 23rpx;
  color: var(--wu-tertiary);
  margin: 12rpx 0 20rpx;
}
.discussion-product .discussion-reply-target {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 16rpx;
  font-size: 24rpx;
  color: var(--wu-secondary);
}
.discussion-product .discussion-reply-target .discussion-text-button {
  flex: none;
  padding: 0;
  font-size: 24rpx;
}
.discussion-product .discussion-photo-actions {
  gap: 28rpx;
}
.discussion-product .discussion-photo-actions .discussion-meta {
  margin-left: auto;
}
.discussion-product .discussion-photo-note {
  font-size: 23rpx;
  line-height: 1.55;
  color: var(--wu-tertiary);
  margin-bottom: 24rpx;
}
.discussion-product .discussion-confirmation .discussion-body {
  max-height: 40vh;
  overflow-y: auto;
}
.discussion-product .discussion-confirmation .discussion-primary {
  margin-top: 20rpx;
}
.discussion-product .discussion-recovery {
  padding: 24rpx;
  border-radius: 20rpx;
  background: var(--wu-bg);
  margin: 20rpx 0;
}
.discussion-product .discussion-recovery-actions {
  display: flex;
  flex-wrap: wrap;
  gap: 12rpx;
}
.discussion-product .discussion-recovery-actions button {
  background: var(--wu-surface);
  font-size: 25rpx;
}
.discussion-product .discussion-recovery .discussion-confirmation {
  border-top: 1rpx solid var(--wu-separator);
  margin-top: 20rpx;
  padding-top: 24rpx;
}
.discussion-product .discussion-gallery {
  position: fixed;
  inset: 0;
  z-index: 100;
  display: flex;
  flex-direction: column;
  justify-content: center;
  padding: 24rpx 32rpx calc(24rpx + env(safe-area-inset-bottom));
  box-sizing: border-box;
  background: #111113;
  color: #fff;
}
.discussion-product .discussion-gallery-toolbar {
  position: absolute;
  top: 16rpx;
  left: 32rpx;
  right: 32rpx;
}
.discussion-product .discussion-gallery button {
  background: transparent;
  color: #fff;
}
.discussion-product .discussion-gallery-image {
  width: 100%;
  height: 65vh;
}
.discussion-product .discussion-gallery-actions {
  justify-content: space-between;
}
.discussion-product .discussion-gallery .discussion-meta,
.discussion-product .discussion-gallery .discussion-notice {
  color: #c8c8ce;
  text-align: center;
}
