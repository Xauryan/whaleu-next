@import '../course-ratings/course-ratings.wxss';
.body {
  white-space: pre-wrap;
  overflow-wrap: anywhere;
}
.confirmation {
  border: 2rpx solid #2878cb;
}
.focused {
  border: 3rpx solid #2878cb;
}
.actions {
  display: flex;
  gap: 12rpx;
}
textarea {
  width: 100%;
  min-height: 200rpx;
  box-sizing: border-box;
}
input {
  border: 1rpx solid #cbd5e1;
  padding: 16rpx;
  margin: 14rpx 0;
}

.discussion-images {
  display: flex;
  gap: 12rpx;
  flex-wrap: wrap;
  margin: 16rpx 0;
}
.discussion-images button {
  margin: 0;
}
.discussion-gallery {
  position: fixed;
  inset: 0;
  z-index: 100;
  background: rgba(12, 20, 30, 0.94);
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 24rpx;
}
.gallery-card {
  background: #fff;
  border-radius: 20rpx;
  padding: 20rpx;
  width: 100%;
}
.gallery-image {
  width: 100%;
  height: 65vh;
}
