<template name="window-status">
  <view wx:if="{{!loaded || busy}}" class="meta">{{status}}</view>
  <view wx:if="{{error}}" class="error">{{error}}</view>
  <view wx:if="{{receiptStatus}}" class="notice">{{receiptStatus}}</view>
  <navigator wx:if="{{!hasSession}}" class="link" url="/pages/login/login"
    >登录后查看窗口评分</navigator
  >
  <view wx:if="{{frozen}}" class="dp-recovery">
    <view class="section-title">原窗口评分待确认</view>
    <view wx:if="{{recoveryWindowId}}" class="body"
      >窗口编号：{{recoveryWindowId}}</view
    >
    <view wx:if="{{recoveryScore !== null}}" class="body"
      >原请求分数：{{recoveryScore}}</view
    >
    <view class="notice"
      >{{recoveryPhase === 'cancel' ?
      '已保存取消决定；恢复时只查询回执或重试取消，不会重新提交评分。' :
      '未查到回执不等于失败。保留原账号、来源、编号、版本与分数，不能创建替代请求。'}}</view
    >
    <button bindtap="onRecover" disabled="{{busy}}">查询原回执</button>
    <button bindtap="onRetry" disabled="{{busy}}">
      {{recoveryPhase === 'cancel' ? '查询后重试原取消' : '查询后重试原评分'}}
    </button>
    <button
      wx:if="{{recoveryWindowId &amp;&amp; recoveryPhase !== 'cancel'}}"
      bindtap="onRequestCancellation"
      disabled="{{busy}}"
    >
      查询后申请取消原请求
    </button>
  </view>
  <view wx:if="{{confirming === 'cancel'}}" class="dp-recovery">
    <view class="section-title">确认取消原评分请求</view>
    <view class="notice"
      >只有取得服务端取消回执才算取消。若原请求已完成，将返回其真实回执；取消不会删除已经写入的评分。</view
    >
    <button
      bindtap="onConfirmCancellation"
      disabled="{{busy || !receiptMissing}}"
    >
      确认取消这个原请求
    </button>
    <button bindtap="onCloseConfirmation" disabled="{{busy}}">返回</button>
  </view>
  <button class="dp-plain dp-refresh" bindtap="onRefresh" disabled="{{busy}}">
    <wu-icon name="refresh" size="18" />刷新
  </button>
  <button wx:if="{{busy}}" bindtap="onCancelWait">停止等待</button>
  <view wx:if="{{restartRequired}}" class="notice"
    >分页已失效，旧页已清除，请从第一页重新加载。</view
  >
</template>
<template name="window-facts">
  <view class="section-title">{{window.name}}</view>
  <view class="meta">{{window.canteenName}} · {{window.floor.label}}</view>
</template>
<template name="window-summary">
  <view wx:if="{{summary.kind === 'unavailable'}}" class="notice"
    >历史评分暂不能确认</view
  >
  <block wx:elif="{{summary.ratingCount === 0}}"
    ><view class="dp-score-empty">暂无评分</view
    ><view class="meta">还没有评分记录</view></block
  >
  <block wx:else
    ><view class="dp-score"
      ><text class="dp-score-value">{{summary.mean}}</text
      ><view class="meta">{{summary.ratingCount}} 条评分</view></view
    ></block
  >
</template>
