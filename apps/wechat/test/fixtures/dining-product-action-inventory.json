      "tag": "button",
      "attrs": {
        "wx:if": "{{busy}}",
        "bindtap": "onCancelWait"
      },
      "ancestors": []
    }
  ],
  "window-ratings/common.wxml": [
    {
      "tag": "navigator",
      "attrs": {
