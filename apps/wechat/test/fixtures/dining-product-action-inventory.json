        "bindtap": "onCloseConfirmation",
        "disabled": "{{busy}}"
      },
      "ancestors": [
        {
          "wx:if": "{{confirming === 'cancel'}}"
        }
      ]
    },
    {
      "tag": "button",
      "attrs": {
        "bindtap": "onRefresh",
        "disabled": "{{busy}}"
