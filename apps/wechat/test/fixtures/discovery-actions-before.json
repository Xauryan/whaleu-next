      ]
    },
    {
      "event": "bindtap",
      "action": "onOwnerVisibilityUnhide",
      "dataset": {
        "data-id": "{{item.id}}"
      },
      "guards": [
        "wx:for:{{publications}}",
        "wx:key:id",
