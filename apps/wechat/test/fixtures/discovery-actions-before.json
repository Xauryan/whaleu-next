{
  "community-search": [
    {
      "event": "bindtap",
      "action": "onMode",
      "dataset": {
        "data-mode": "keyword"
      },
      "guards": []
    },
    {
      "event": "bindtap",
      "action": "onMode",
      "dataset": {
        "data-mode": "semantic"
      },
      "guards": []
    },
    {
      "event": "bindtap",
      "action": "onAggregateScope",
      "dataset": {
        "data-scope": "all"
      },
      "guards": []
    },
    {
      "event": "bindtap",
      "action": "onAggregateScope",
      "dataset": {
        "data-scope": "regional"
      },
      "guards": []
    },
    {
      "event": "bindtap",
      "action": "onAggregateScope",
      "dataset": {
        "data-scope": "global"
      },
      "guards": []
    },
    {
      "event": "bindtap",
      "action": "onScope",
      "dataset": {
        "data-id": "{{regional.id}}"
      },
      "guards": ["wx:if:{{regional}}"]
    },
    {
      "event": "bindtap",
      "action": "onScope",
      "dataset": {
        "data-id": "{{item.id}}"
      },
      "guards": ["wx:for:{{globalSpaces}}", "wx:key:id"]
    },
    {
      "event": "bindtap",
      "action": "onCategory",
      "dataset": {
        "data-key": "{{item.key}}"
      },
      "guards": [
        "wx:if:{{selectedScope === 'all' || selectedScope === 'regional' || selectedScope === 'explicit' && space}}",
        "wx:for:{{categories}}",
        "wx:key:key",
        "wx:if:{{selectedScope === 'all' || selectedScope === 'regional' || space && space.kind === 'regional' || item.key === 'all' || item.key === 'discussion'}}"
      ]
    },
    {
      "event": "bindtap",
      "action": "onTradingSubtype",
      "dataset": {
        "data-key": ""
      },
      "guards": ["wx:if:{{category === 'trading'}}"]
    },
    {
      "event": "bindtap",
      "action": "onTradingSubtype",
      "dataset": {
        "data-key": "{{item.key}}"
      },
      "guards": [
        "wx:if:{{category === 'trading'}}",
        "wx:for:{{tradingCategories}}",
        "wx:key:key"
      ]
    },
    {
      "event": "bindtap",
      "action": "onType",
      "dataset": {
        "data-key": "{{item.key}}"
      },
      "guards": ["wx:for:{{searchTypes}}", "wx:key:key"]
    },
    {
      "event": "bindchange",
      "action": "onFromDate",
      "dataset": {},
      "guards": []
    },
    {
      "event": "bindchange",
      "action": "onToDate",
      "dataset": {},
      "guards": []
    },
    {
      "event": "bindtap",
      "action": "onClearDates",
      "dataset": {},
      "guards": ["wx:if:{{from || to}}"]
    },
    {
      "event": "bindtap",
      "action": "onClearPost",
      "dataset": {},
      "guards": ["wx:if:{{withinPostId}}"]
    },
    {
      "event": "navigate",
      "action": "/pages/login/login",
      "dataset": {},
      "guards": ["wx:if:{{!hasSession}}"]
    },
    {
      "event": "bindinput",
      "action": "onInput",
      "dataset": {},
      "guards": []
    },
    {
      "event": "bindconfirm",
      "action": "onSubmit",
      "dataset": {},
      "guards": []
    },
    {
      "event": "bindtap",
      "action": "onSubmit",
      "dataset": {},
      "guards": [
        "disabled:{{!selectedScope || selectedScope === 'explicit' && !space || !configured}}"
      ]
    },
    {
      "event": "bindtap",
      "action": "onRefresh",
      "dataset": {},
      "guards": ["disabled:{{busy || !selectedScope}}"]
    },
    {
      "event": "bindtap",
      "action": "onCancel",
      "dataset": {},
      "guards": ["wx:if:{{busy}}"]
    },
    {
      "event": "navigate",
      "action": "/pages/community-feed/community-feed",
      "dataset": {},
      "guards": []
    },
    {
      "event": "navigate",
      "action": "open:navigateBack",
      "dataset": {},
      "guards": []
    },
    {
      "event": "bindtap",
      "action": "onHit",
      "dataset": {
        "data-kind": "{{item.kind}}",
        "data-id": "{{item.contentId}}"
      },
      "guards": ["wx:for:{{hits}}", "wx:key:key", "wx:if:{{hasSession}}"]
    },
    {
      "event": "bindtap",
      "action": "onWithinPost",
      "dataset": {
        "data-post-id": "{{item.postId}}"
      },
      "guards": ["wx:for:{{hits}}", "wx:key:key", "wx:if:{{!withinPostId}}"]
    },
    {
      "event": "navigate",
      "action": "/pages/login/login",
      "dataset": {},
      "guards": ["wx:if:{{continuation === 'login_required'}}"]
    },
    {
      "event": "bindtap",
      "action": "onPrevious",
      "dataset": {},
      "guards": ["wx:if:{{canPrevious}}", "disabled:{{busy}}"]
    },
    {
      "event": "bindtap",
      "action": "onNext",
      "dataset": {},
      "guards": ["wx:if:{{canNext}}", "disabled:{{busy}}"]
    },
    {
      "event": "navigate",
      "action": "/pages/phone-binding/phone-binding",
      "dataset": {},
      "guards": ["wx:if:{{continuation === 'phone_verification_required'}}"]
    }
  ],
  "community-hot": [
    {
      "event": "bindtap",
      "action": "onRefresh",
      "dataset": {},
      "guards": ["disabled:{{busy}}"]
    },
    {
      "event": "navigate",
      "action": "/pages/community-feed/community-feed",
      "dataset": {},
      "guards": []
    },
    {
      "event": "bindtap",
      "action": "onRange",
      "dataset": {
        "data-key": "{{item.key}}"
      },
      "guards": ["wx:for:{{hotRanges}}", "wx:key:key", "disabled:{{busy}}"]
    },
    {
      "event": "bindtap",
      "action": "onCancel",
      "dataset": {},
      "guards": ["wx:if:{{busy}}"]
    },
    {
      "event": "bindtap",
      "action": "onAuthor",
      "dataset": {
        "data-id": "{{item.id}}"
      },
      "guards": [
        "wx:for:{{posts}}",
        "wx:key:id",
        "wx:if:{{item.author.kind === 'named'}}"
      ]
    },
    {
      "event": "navigate",
      "action": "/pages/community-detail/community-detail?postId={{item.id}}&viewSpaceId={{selectedSpaceId}}",
      "dataset": {},
      "guards": ["wx:for:{{posts}}", "wx:key:id", "wx:if:{{hasSession}}"]
    },
    {
      "event": "navigate",
      "action": "/pages/login/login",
      "dataset": {},
      "guards": ["wx:for:{{posts}}", "wx:key:id", "wx:else:"]
    },
    {
      "event": "navigate",
      "action": "/pages/login/login",
      "dataset": {},
      "guards": ["wx:if:{{continuation === 'login_required'}}"]
    },
    {
      "event": "navigate",
      "action": "/pages/phone-binding/phone-binding",
      "dataset": {},
      "guards": ["wx:if:{{continuation === 'phone_verification_required'}}"]
    },
    {
      "event": "bindtap",
      "action": "onPrevious",
      "dataset": {},
      "guards": ["wx:if:{{canPrevious}}", "disabled:{{busy}}"]
    },
    {
      "event": "bindtap",
      "action": "onNext",
      "dataset": {},
      "guards": ["wx:if:{{canNext}}", "disabled:{{busy}}"]
    },
    {
      "event": "bindtap",
      "action": "onToggleInfo",
      "dataset": {},
      "guards": []
    },
    {
      "event": "navigate",
      "action": "open:navigateBack",
      "dataset": {},
      "guards": []
    }
  ],
  "community-saved": [
    {
      "event": "bindtap",
      "action": "onReload",
      "dataset": {},
      "guards": ["disabled:{{busy || savedMutation.busy}}"]
    },
    {
      "event": "bindtap",
      "action": "onCancel",
      "dataset": {},
      "guards": ["wx:if:{{busy}}"]
    },
    {
      "event": "navigate",
      "action": "/pages/login/login",
      "dataset": {},
      "guards": ["wx:if:{{!hasSession}}"]
    },
    {
      "event": "bindtap",
      "action": "onAuthor",
      "dataset": {
        "data-id": "{{item.post.id}}"
      },
      "guards": [
        "wx:for:{{items}}",
        "wx:key:saveEpochId",
        "wx:if:{{item.post.author.kind === 'named'}}"
      ]
    },
    {
      "event": "navigate",
      "action": "/pages/community-detail/community-detail?postId={{item.post.id}}",
      "dataset": {},
      "guards": ["wx:for:{{items}}", "wx:key:saveEpochId"]
    },
    {
      "event": "bindtap",
      "action": "onUnsave",
      "dataset": {
        "data-id": "{{item.post.id}}"
      },
      "guards": [
        "wx:for:{{items}}",
        "wx:key:saveEpochId",
        "disabled:{{busy || savedMutation.busy || savedMutation.frozen || !item.post.viewer.canSave}}"
      ]
    },
    {
      "event": "bindtap",
      "action": "onMore",
      "dataset": {},
      "guards": [
        "wx:if:{{canLoadMore}}",
        "disabled:{{busy || savedMutation.busy}}"
      ]
    },
    {
      "event": "navigate",
      "action": "/pages/community-updates/community-updates",
      "dataset": {},
      "guards": []
    },
    {
      "event": "navigate",
      "action": "/pages/community-feed/community-feed",
      "dataset": {},
      "guards": []
    }
  ],
