      "event": "bindtap",
      "action": "onNativePreview",
      "dataset": {
        "data-slot": "{{item.slot}}"
      },
      "guards": [
        "wx:if:{{managed}}",
        "wx:for:{{nativeDetail.slots}}",
        "wx:key:slot"
      ]
    },
    {
      "event": "bindtap",
      "action": "onNativeClose",
      "dataset": {},
      "guards": ["wx:if:{{managed}}", "wx:if:{{nativeImage.src}}"]
    }
  ]
}
