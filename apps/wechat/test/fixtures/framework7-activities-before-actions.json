  "src/pages/activity-native/activity-native.wxml": {
    "sourceSha256": "5e72eab4438d08a238f7adf7e528a58c18a1b127e65ec7cc2188c055b1c11670",
    "actions": [
      {
        "tag": "button",
        "attrs": {
          "class": "activity-text-button activity-muted",
          "bindtap": "onLegacy"
        },
        "scopes": []
      },
      {
        "tag": "button",
        "attrs": {
          "class": "activity-icon-button",
          "bindtap": "onMine",
          "aria-label": "我的发布"
        },
        "scopes": []
      },
      {
        "tag": "button",
        "attrs": {
          "class": "activity-icon-button",
          "bindtap": "onRefresh",
          "disabled": "{{busy}}",
          "aria-label": "刷新活动"
        },
        "scopes": [
          {
            "disabled": "{{busy}}"
          }
        ]
      },
      {
        "tag": "button",
        "attrs": {
          "class": "activity-compact-primary",
          "bindtap": "onPublish"
        },
        "scopes": []
      },
      {
        "tag": "view",
        "attrs": {
          "wx:for": "{{items}}",
