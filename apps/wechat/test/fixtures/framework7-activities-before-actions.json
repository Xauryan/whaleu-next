{
  "src/pages/activity-list/activity-list.wxml": {
    "sourceSha256": "849062d59ea477e964f3ecd1749de92ae6ee8dfd9c013b220511fb041862146a",
    "actions": [
      {
        "tag": "button",
        "attrs": {
          "class": "activity-text-button",
          "bindtap": "onNative"
        },
        "scopes": []
      },
      {
        "tag": "button",
        "attrs": {
          "class": "activity-icon-button",
          "bindtap": "onMine",
          "aria-label": "我的发布"
        },
        "scopes": []
      },
      {
        "tag": "button",
        "attrs": {
          "class": "activity-icon-button",
          "data-field": "preferences",
          "bindtap": "onTogglePanel",
          "aria-label": "活动提醒设置"
        },
        "scopes": []
      },
      {
        "tag": "button",
        "attrs": {
          "class": "activity-icon-button activity-accent",
          "bindtap": "onPublish",
          "aria-label": "发布活动"
        },
        "scopes": []
      },
      {
        "tag": "button",
        "attrs": {
          "wx:if": "{{window !== 'all'}}",
          "class": "activity-text-button",
          "bindtap": "onAll",
          "disabled": "{{busy}}"
        },
        "scopes": [
          {
            "wx:if": "{{window !== 'all'}}",
            "disabled": "{{busy}}"
          }
        ]
      },
      {
        "tag": "button",
        "attrs": {
          "class": "activity-icon-button",
          "bindtap": "onRefresh",
          "disabled": "{{busy}}",
          "loading": "{{busy}}",
          "aria-label": "{{restartRequired ? '重新开始浏览' : '刷新活动'}}"
        },
        "scopes": [
          {
            "disabled": "{{busy}}",
            "loading": "{{busy}}"
          }
        ]
      },
      {
        "tag": "navigator",
        "attrs": {
          "wx:if": "{{!hasSession}}",
          "class": "activity-text-button",
          "url": "/pages/login/login"
        },
        "scopes": [
          {
            "wx:if": "{{!hasSession}}"
          }
        ]
      },
      {
        "tag": "button",
        "attrs": {
          "wx:if": "{{busy}}",
          "class": "activity-text-button activity-muted",
          "bindtap": "onCancel"
        },
        "scopes": [
          {
            "wx:if": "{{busy}}"
          }
        ]
      },
      {
        "tag": "button",
        "attrs": {
          "class": "activity-event-open",
          "data-id": "{{item.id}}",
          "bindtap": "onActivity",
          "disabled": "{{busy}}"
        },
        "scopes": [
          {
            "wx:for": "{{items}}",
            "wx:key": "id"
          },
          {
            "disabled": "{{busy}}"
          }
        ]
      },
      {
        "tag": "button",
        "attrs": {
          "wx:if": "{{canPrevious}}",
          "class": "activity-text-button",
          "bindtap": "onPrevious",
          "disabled": "{{busy}}"
        },
        "scopes": [
          {
            "wx:if": "{{loaded}}"
          },
          {
            "wx:if": "{{canPrevious}}",
            "disabled": "{{busy}}"
          }
        ]
      },
      {
        "tag": "button",
        "attrs": {
          "wx:if": "{{canNext}}",
          "class": "activity-text-button",
          "bindtap": "onNext",
          "disabled": "{{busy}}"
        },
        "scopes": [
          {
            "wx:if": "{{loaded}}"
          },
          {
            "wx:if": "{{canNext}}",
            "disabled": "{{busy}}"
          }
        ]
      },
      {
        "tag": "button",
        "attrs": {
          "wx:if": "{{visit.pending}}",
          "class": "activity-text-button",
          "bindtap": "onVisitRetry",
          "disabled": "{{visit.busy}}",
          "loading": "{{visit.busy}}"
        },
        "scopes": [
          {
            "wx:if": "{{visit.pending || visit.error}}"
          },
          {
            "wx:if": "{{visit.pending}}",
            "disabled": "{{visit.busy}}",
            "loading": "{{visit.busy}}"
          }
        ]
      },
      {
        "tag": "button",
        "attrs": {
          "class": "activity-disclosure",
          "data-field": "information",
          "bindtap": "onTogglePanel"
        },
        "scopes": []
      },
      {
        "tag": "navigator",
        "attrs": {
          "class": "activity-text-button",
          "url": "/pages/identity-campus/identity-campus"
        },
        "scopes": [
          {
            "wx:if": "{{uiPanels.information}}"
          }
        ]
      },
      {
        "tag": "switch",
        "attrs": {
          "wx:if": "{{preference.loaded}}",
          "checked": "{{preference.checked}}",
          "disabled": "{{preference.busy || preference.needsReload}}",
          "bindchange": "onPreference"
        },
        "scopes": [
          {
            "wx:if": "{{uiPanels.preferences || preference.dirty || preference.needsReload || preference.error}}"
          },
          {
            "wx:if": "{{preference.loaded}}",
            "disabled": "{{preference.busy || preference.needsReload}}"
          }
        ]
      },
      {
        "tag": "button",
        "attrs": {
          "wx:if": "{{preference.dirty && !preference.needsReload}}",
          "class": "activity-text-button",
          "bindtap": "onPreferenceSave",
          "disabled": "{{preference.busy}}"
        },
        "scopes": [
          {
            "wx:if": "{{uiPanels.preferences || preference.dirty || preference.needsReload || preference.error}}"
          },
          {
            "wx:if": "{{preference.dirty && !preference.needsReload}}",
            "disabled": "{{preference.busy}}"
          }
        ]
      },
      {
        "tag": "button",
        "attrs": {
          "class": "activity-text-button activity-muted",
          "bindtap": "onPreferenceReload",
          "disabled": "{{preference.busy}}"
        },
        "scopes": [
          {
            "wx:if": "{{uiPanels.preferences || preference.dirty || preference.needsReload || preference.error}}"
          },
          {
            "disabled": "{{preference.busy}}"
          }
        ]
      }
    ]
  },
  "src/pages/activity-detail/activity-detail.wxml": {
