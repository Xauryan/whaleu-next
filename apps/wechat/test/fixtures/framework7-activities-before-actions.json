        ]
      }
    ]
  },
  "src/pages/activity-native-detail/activity-native-detail.wxml": {
    "sourceSha256": "f4b9d6cd68f8f44eee18133ec94e2cb82fe59baf826e7fce29a8e9cc28d13558",
    "actions": [
      {
        "tag": "button",
        "attrs": {
          "wx:if": "{{error}}",
          "class": "activity-text-button",
          "bindtap": "onRefresh",
          "disabled": "{{busy}}"
        },
        "scopes": [
          {
            "wx:if": "{{error}}",
            "disabled": "{{busy}}"
          }
        ]
      },
      {
        "tag": "button",
        "attrs": {
          "wx:for": "{{slots}}",
          "wx:key": "slot",
          "class": "activity-media-choice {{selectedSlot === item.slot ? 'selected' : ''}}",
          "data-slot": "{{item.slot}}",
          "bindtap": "onImage"
        },
        "scopes": [
          {
            "wx:if": "{{activity}}"
          },
          {
            "wx:if": "{{slots.length}}"
          },
          {
            "wx:for": "{{slots}}",
            "wx:key": "slot"
          }
        ]
      },
      {
        "tag": "button",
        "attrs": {
          "class": "activity-disclosure",
          "data-field": "information",
          "bindtap": "onTogglePanel"
        },
        "scopes": [
          {
            "wx:if": "{{activity}}"
          }
        ]
      },
      {
        "tag": "button",
        "attrs": {
          "class": "activity-primary",
          "bindtap": "onQr"
        },
        "scopes": [
          {
            "wx:if": "{{activity}}"
          },
          {
            "wx:if": "{{activity.organizerQr.status === 'available'}}"
          }
        ]
      }
    ]
  },
  "src/pages/activity-publish/activity-publish.wxml": {
    "sourceSha256": "e340efd6de3396ecd8650ef4a887c1f26a30c78d27b2fb1790fbceca6f45829a",
    "actions": [
      {
        "tag": "button",
        "attrs": {
          "class": "activity-text-button activity-muted",
          "bindtap": "onCatalog"
        },
        "scopes": []
      },
      {
        "tag": "button",
        "attrs": {
          "class": "activity-text-button activity-muted",
          "bindtap": "onMine"
        },
        "scopes": []
      },
      {
        "tag": "button",
        "attrs": {
          "class": "activity-primary",
          "bindtap": "onRecover",
          "disabled": "{{busy}}"
        },
        "scopes": [
          {
            "wx:if": "{{pending}}"
          },
          {
            "disabled": "{{busy}}"
          }
        ]
      },
      {
        "tag": "button",
        "attrs": {
          "class": "activity-text-button",
          "bindtap": "onRetry",
          "disabled": "{{busy}}"
        },
        "scopes": [
          {
            "wx:if": "{{pending}}"
          },
          {
            "disabled": "{{busy}}"
          }
        ]
      },
      {
        "tag": "button",
        "attrs": {
          "class": "activity-text-button activity-muted",
          "bindtap": "onCancelOriginal",
          "disabled": "{{busy}}"
        },
        "scopes": [
          {
            "wx:if": "{{pending}}"
          },
          {
            "disabled": "{{busy}}"
          }
        ]
      },
      {
        "tag": "button",
        "attrs": {
          "wx:for": "{{organizers}}",
          "wx:key": "organizationId",
          "class": "activity-organizer-option {{selected && selected.organizationId === item.organizationId ? 'selected' : ''}}",
          "data-id": "{{item.organizationId}}",
          "bindtap": "onOrganizer",
          "disabled": "{{busy || pending}}"
        },
        "scopes": [
          {
            "wx:if": "{{!id}}"
          },
          {
            "wx:for": "{{organizers}}",
            "wx:key": "organizationId",
            "disabled": "{{busy || pending}}"
          }
        ]
      },
      {
        "tag": "button",
        "attrs": {
          "wx:if": "{{moreOrganizers}}",
          "class": "activity-text-button",
          "bindtap": "onMoreOrganizers",
          "disabled": "{{busy || pending}}"
        },
        "scopes": [
          {
            "wx:if": "{{!id}}"
          },
          {
            "wx:if": "{{moreOrganizers}}",
            "disabled": "{{busy || pending}}"
          }
        ]
      },
      {
        "tag": "input",
        "attrs": {
          "class": "activity-title-input",
          "value": "{{form.title}}",
          "maxlength": "50",
          "data-field": "title",
          "bindinput": "onField",
          "disabled": "{{busy || pending}}",
          "placeholder": "给活动起一个名字",
          "aria-label": "活动标题，最多50字"
        },
        "scopes": [
          {
            "wx:if": "{{!draft || draft.state !== 'published'}}"
          },
          {
            "disabled": "{{busy || pending}}"
          }
        ]
      },
      {
        "tag": "textarea",
        "attrs": {
          "class": "activity-description-input",
          "value": "{{form.description}}",
          "maxlength": "1000",
          "data-field": "description",
          "bindinput": "onField",
          "disabled": "{{busy || pending}}",
          "placeholder": "介绍活动内容、参与方式和需要准备的物品…",
          "aria-label": "活动介绍，最多1000字",
          "auto-height": "true"
        },
        "scopes": [
          {
            "wx:if": "{{!draft || draft.state !== 'published'}}"
          },
          {
            "disabled": "{{busy || pending}}"
          }
        ]
      },
      {
        "tag": "button",
        "attrs": {
          "class": "activity-choice {{typeSelected.online ? 'selected' : ''}}",
          "data-type": "online",
          "bindtap": "onType",
          "disabled": "{{busy || pending}}"
        },
        "scopes": [
          {
            "wx:if": "{{!draft || draft.state !== 'published'}}"
          },
          {
            "disabled": "{{busy || pending}}"
          }
        ]
      },
      {
        "tag": "button",
        "attrs": {
          "class": "activity-choice {{typeSelected.offline ? 'selected' : ''}}",
          "data-type": "offline",
          "bindtap": "onType",
          "disabled": "{{busy || pending}}"
        },
        "scopes": [
          {
            "wx:if": "{{!draft || draft.state !== 'published'}}"
          },
          {
            "disabled": "{{busy || pending}}"
          }
        ]
      },
      {
        "tag": "button",
        "attrs": {
          "class": "activity-choice {{typeSelected.reward ? 'selected' : ''}}",
          "data-type": "reward",
          "bindtap": "onType",
          "disabled": "{{busy || pending}}"
        },
        "scopes": [
          {
            "wx:if": "{{!draft || draft.state !== 'published'}}"
          },
          {
            "disabled": "{{busy || pending}}"
          }
        ]
      },
      {
        "tag": "input",
        "attrs": {
          "value": "{{form.activityTime}}",
          "maxlength": "200",
          "data-field": "activityTime",
          "bindinput": "onField",
          "disabled": "{{busy || pending}}",
          "placeholder": "例如：周六 14:00—16:00"
        },
        "scopes": [
          {
            "wx:if": "{{!draft || draft.state !== 'published'}}"
          },
          {
            "disabled": "{{busy || pending}}"
          }
        ]
      },
      {
        "tag": "input",
        "attrs": {
          "value": "{{form.activityLocation}}",
          "maxlength": "200",
          "data-field": "activityLocation",
          "bindinput": "onField",
          "disabled": "{{busy || pending}}",
          "placeholder": "填写集合地点或线上参与地点"
        },
        "scopes": [
          {
            "wx:if": "{{!draft || draft.state !== 'published'}}"
          },
          {
            "disabled": "{{busy || pending}}"
          }
        ]
      },
      {
        "tag": "button",
        "attrs": {
          "class": "activity-disclosure",
          "data-field": "options",
          "bindtap": "onTogglePanel"
        },
        "scopes": [
          {
            "wx:if": "{{!draft || draft.state !== 'published'}}"
          }
        ]
      },
      {
        "tag": "input",
        "attrs": {
          "class": "activity-option-input",
          "value": "{{endAtInput}}",
          "placeholder": "2026-12-01T18:00:00+08:00",
          "data-field": "endAt",
          "bindinput": "onField",
          "disabled": "{{busy || pending}}"
        },
        "scopes": [
          {
            "wx:if": "{{!draft || draft.state !== 'published'}}"
          },
          {
            "wx:if": "{{uiPanels.options}}"
          },
          {
            "disabled": "{{busy || pending}}"
          }
        ]
      },
      {
        "tag": "switch",
        "attrs": {
          "checked": "{{form.showOrganizerQr}}",
          "bindchange": "onQr",
          "disabled": "{{busy || pending}}"
        },
        "scopes": [
          {
            "wx:if": "{{!draft || draft.state !== 'published'}}"
          },
          {
            "wx:if": "{{uiPanels.options}}"
          },
          {
            "disabled": "{{busy || pending}}"
          }
        ]
      },
      {
        "tag": "button",
        "attrs": {
          "wx:if": "{{!id}}",
          "class": "activity-primary",
          "bindtap": "onCreate",
          "disabled": "{{busy || pending || !selected}}"
        },
        "scopes": [
          {
            "wx:if": "{{!draft || draft.state !== 'published'}}"
          },
          {
            "wx:if": "{{!id}}"
          },
          {
            "wx:if": "{{!id}}",
            "disabled": "{{busy || pending || !selected}}"
          }
        ]
      },
      {
        "tag": "button",
        "attrs": {
          "class": "activity-text-button",
          "data-slot": "{{item.slot}}",
          "bindtap": "onUpload",
          "disabled": "{{busy || pending || upload.status === 'working'}}"
        },
        "scopes": [
          {
            "wx:if": "{{draft && draft.state === 'draft'}}"
          },
          {
            "wx:for": "{{slots}}",
            "wx:key": "slot"
          },
          {
            "wx:if": "{{item.slot === 'cover' || uiPanels.gallery || item.configured || item.changed}}"
          },
          {
            "disabled": "{{busy || pending || upload.status === 'working'}}"
          }
        ]
      },
      {
        "tag": "button",
        "attrs": {
          "wx:if": "{{item.configured}}",
          "class": "activity-text-button activity-muted",
          "data-slot": "{{item.slot}}",
          "bindtap": "onPreview",
          "disabled": "{{busy || pending || !item.configured || item.changed}}"
        },
        "scopes": [
          {
            "wx:if": "{{draft && draft.state === 'draft'}}"
          },
          {
            "wx:for": "{{slots}}",
            "wx:key": "slot"
          },
          {
            "wx:if": "{{item.slot === 'cover' || uiPanels.gallery || item.configured || item.changed}}"
          },
          {
            "wx:if": "{{item.configured}}",
            "disabled": "{{busy || pending || !item.configured || item.changed}}"
          }
        ]
      },
      {
        "tag": "button",
        "attrs": {
          "wx:if": "{{item.configured || item.changed}}",
          "class": "activity-text-button activity-muted",
          "data-slot": "{{item.slot}}",
          "bindtap": "onRemove",
          "disabled": "{{busy || pending}}"
        },
        "scopes": [
          {
            "wx:if": "{{draft && draft.state === 'draft'}}"
          },
          {
            "wx:for": "{{slots}}",
            "wx:key": "slot"
          },
          {
            "wx:if": "{{item.slot === 'cover' || uiPanels.gallery || item.configured || item.changed}}"
          },
          {
            "wx:if": "{{item.configured || item.changed}}",
            "disabled": "{{busy || pending}}"
          }
        ]
      },
      {
        "tag": "button",
        "attrs": {
          "class": "activity-disclosure",
          "data-field": "gallery",
          "bindtap": "onTogglePanel"
        },
        "scopes": [
          {
            "wx:if": "{{draft && draft.state === 'draft'}}"
          }
        ]
      },
      {
        "tag": "button",
        "attrs": {
          "class": "activity-text-button",
          "data-slot": "{{item.slot}}",
          "data-revision": "{{item.revision}}",
          "data-action": "recover",
          "bindtap": "onPendingImage",
          "disabled": "{{busy || pending || upload.status === 'working'}}"
        },
        "scopes": [
          {
            "wx:if": "{{draft && draft.state === 'draft'}}"
          },
          {
            "wx:for": "{{pendingImages}}",
            "wx:key": "slot"
          },
          {
            "disabled": "{{busy || pending || upload.status === 'working'}}"
          }
        ]
      },
      {
        "tag": "button",
        "attrs": {
          "class": "activity-text-button activity-muted",
          "data-slot": "{{item.slot}}",
          "data-revision": "{{item.revision}}",
          "data-action": "cancel",
          "bindtap": "onPendingImage",
          "disabled": "{{busy || pending || upload.status === 'working'}}"
        },
        "scopes": [
          {
            "wx:if": "{{draft && draft.state === 'draft'}}"
          },
          {
            "wx:for": "{{pendingImages}}",
            "wx:key": "slot"
          },
          {
            "disabled": "{{busy || pending || upload.status === 'working'}}"
          }
        ]
      },
      {
        "tag": "button",
        "attrs": {
          "class": "{{dirty ? 'activity-primary' : 'activity-secondary'}}",
          "bindtap": "onSave",
          "disabled": "{{busy || pending || upload.status === 'working'}}"
        },
        "scopes": [
          {
            "wx:if": "{{draft && draft.state === 'draft'}}"
          },
          {
            "disabled": "{{busy || pending || upload.status === 'working'}}"
          }
        ]
      },
      {
        "tag": "button",
        "attrs": {
          "class": "{{dirty ? 'activity-secondary' : 'activity-primary'}}",
          "bindtap": "onPublish",
          "disabled": "{{busy || pending || dirty || upload.status === 'working'}}"
        },
        "scopes": [
          {
            "wx:if": "{{draft && draft.state === 'draft'}}"
          },
          {
            "disabled": "{{busy || pending || dirty || upload.status === 'working'}}"
          }
        ]
      },
      {
        "tag": "button",
        "attrs": {
          "class": "activity-text-button activity-danger",
          "bindtap": "onDiscardDraft",
          "disabled": "{{busy || pending || upload.status === 'working'}}"
        },
        "scopes": [
          {
            "wx:if": "{{draft && draft.state === 'draft'}}"
          },
          {
            "wx:if": "{{uiPanels.options}}"
          },
          {
            "disabled": "{{busy || pending || upload.status === 'working'}}"
          }
        ]
      },
      {
        "tag": "button",
        "attrs": {
          "wx:if": "{{draft && draft.state === 'published'}}",
          "class": "activity-primary",
          "bindtap": "onPublished"
        },
        "scopes": [
          {
            "wx:if": "{{draft && draft.state === 'published'}}"
          }
        ]
      }
    ]
  }
}
