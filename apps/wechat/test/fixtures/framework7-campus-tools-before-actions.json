        "scopes": [
          {
            "wx:if": "{{authRecovery}}"
          }
        ]
      },
      {
        "tag": "button",
        "attrs": {
          "class": "tool-text-button",
          "bindtap": "onContinueGuest"
        },
        "scopes": [
          {
            "wx:if": "{{authRecovery}}"
          }
        ]
      },
      {
        "tag": "web-view",
        "attrs": {
          "wx:if": "{{webviewSrc}}",
          "src": "{{webviewSrc}}",
          "data-source": "{{webviewSrc}}",
          "data-view-id": "{{webviewViewId}}",
          "bindload": "onWebviewLoad",
          "binderror": "onWebviewError",
          "bindmessage": "onWebviewMessage"
        },
