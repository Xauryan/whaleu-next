            "wx:if": "{{!hasSession}}"
          }
        ]
      },
      {
        "tag": "text",
        "attrs": {
          "wx:if": "{{item.post.author.kind === 'named'}}",
          "data-id": "{{item.post.id}}",
          "bindtap": "onAuthor"
        },
        "scopes": [
          {
            "wx:for": "{{items}}",
            "wx:key": "saveEpochId"
