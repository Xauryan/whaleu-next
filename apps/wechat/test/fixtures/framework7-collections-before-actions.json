      },
      {
        "tag": "button",
        "attrs": {
          "wx:if": "{{canLoadMore}}",
          "class": "more-button",
          "bindtap": "onMore",
          "disabled": "{{busy || savedMutation.busy}}"
        },
        "scopes": [
          {
            "wx:if": "{{canLoadMore}}"
          }
        ]
      },
      {
        "tag": "navigator",
        "attrs": {
