  "src/pages/community-hot/community-hot.wxml": {
    "sourceSha256": "0ed7ed283a1e6dfa3761a964cf69b167b5bdced5fc641311ae417d57ea8a15b9",
    "actions": [
      {
        "tag": "button",
        "attrs": {
          "class": "icon-button",
          "aria-label": "刷新热榜",
          "bindtap": "onRefresh",
          "disabled": "{{busy}}",
          "loading": "{{busy}}"
        },
        "scopes": []
      },
      {
        "tag": "navigator",
        "attrs": {
          "class": "quiet-link",
          "open-type": "reLaunch",
          "url": "/pages/community-feed/community-feed"
        },
        "scopes": []
      },
      {
        "tag": "button",
        "attrs": {
          "wx:for": "{{hotRanges}}",
          "wx:key": "key",
          "class": "category-pill {{range === item.key ? 'active' : ''}}",
          "data-key": "{{item.key}}",
          "bindtap": "onRange",
          "disabled": "{{busy}}"
        },
        "scopes": [
          {
            "wx:for": "{{hotRanges}}",
            "wx:key": "key"
          }
        ]
      },
      {
        "tag": "button",
        "attrs": {
          "wx:if": "{{busy}}",
          "class": "cancel-button",
          "bindtap": "onCancel"
        },
        "scopes": [
          {
            "wx:if": "{{busy}}"
          }
        ]
      },
      {
        "tag": "text",
        "attrs": {
          "wx:if": "{{item.author.kind === 'named'}}",
          "class": "author-name",
          "data-id": "{{item.id}}",
          "bindtap": "onAuthor"
        },
        "scopes": [
          {
            "wx:for": "{{posts}}",
            "wx:key": "id"
          },
          {
            "wx:if": "{{item.author.kind === 'named'}}"
          }
        ]
      },
      {
        "tag": "navigator",
        "attrs": {
          "wx:if": "{{hasSession}}",
          "class": "post-open",
          "url": "/pages/community-detail/community-detail?postId={{item.id}}&viewSpaceId={{selectedSpaceId}}"
        },
        "scopes": [
          {
            "wx:for": "{{posts}}",
            "wx:key": "id"
          },
          {
            "wx:if": "{{hasSession}}"
          }
        ]
      },
      {
        "tag": "navigator",
        "attrs": {
          "class": "post-open",
          "url": "/pages/login/login",
          "wx:else": ""
        },
        "scopes": [
          {
            "wx:for": "{{posts}}",
            "wx:key": "id"
          },
          {
            "wx:else": ""
          }
        ]
      },
      {
        "tag": "navigator",
        "attrs": {
          "class": "quiet-link",
          "url": "/pages/login/login"
        },
        "scopes": [
          {
            "wx:if": "{{continuation === 'login_required'}}"
          }
        ]
      },
      {
        "tag": "navigator",
        "attrs": {
          "class": "quiet-link",
          "url": "/pages/phone-binding/phone-binding"
        },
        "scopes": [
          {
            "wx:if": "{{continuation === 'phone_verification_required'}}"
          }
        ]
      },
      {
        "tag": "button",
        "attrs": {
          "wx:if": "{{canPrevious}}",
          "class": "secondary",
          "bindtap": "onPrevious",
          "disabled": "{{busy}}"
        },
        "scopes": [
          {
            "wx:if": "{{canPrevious}}"
          }
        ]
      },
      {
        "tag": "button",
        "attrs": {
          "wx:if": "{{canNext}}",
          "class": "secondary",
          "bindtap": "onNext",
          "disabled": "{{busy}}"
        },
        "scopes": [
          {
            "wx:if": "{{canNext}}"
          }
        ]
      },
      {
        "tag": "button",
        "attrs": {
          "bindtap": "onToggleInfo"
        },
        "scopes": []
      },
      {
        "tag": "navigator",
        "attrs": {
          "class": "hot-back",
          "open-type": "navigateBack"
        },
        "scopes": []
      }
    ]
  },
