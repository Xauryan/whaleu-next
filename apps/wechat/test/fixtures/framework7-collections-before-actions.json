        "attrs": {
          "class": "text-button muted",
          "data-id": "{{item.post.id}}",
          "bindtap": "onUnsave",
          "disabled": "{{busy || savedMutation.busy || savedMutation.frozen || !item.post.viewer.canSave}}"
        },
        "scopes": [
          {
            "wx:for": "{{items}}",
            "wx:key": "saveEpochId"
          }
        ]
      },
      {
        "tag": "navigator",
