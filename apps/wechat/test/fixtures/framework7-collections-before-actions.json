          "url": "/pages/community-updates/community-updates"
        },
        "scopes": []
      },
      {
        "tag": "button",
        "attrs": {
          "class": "disclosure",
          "bindtap": "onToggleInfo"
        },
        "scopes": []
      },
      {
        "tag": "navigator",
        "attrs": {
          "class": "back-link",
          "url": "/pages/community-feed/community-feed"
        },
        "scopes": []
      }
    ]
