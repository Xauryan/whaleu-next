          "url": "/pages/login/login"
        },
        "scopes": [
          {
            "wx:if": "{{!hasSession}}"
          }
        ]
      },
      {
        "tag": "navigator",
        "attrs": {
          "wx:if": "{{hasSession && error === '请先完成手机号验证，再重新加载课程评分'}}",
          "class": "link",
          "url": "/pages/phone-binding/phone-binding"
        },
        "scopes": [
          {
            "wx:if": "{{hasSession && error === '请先完成手机号验证，再重新加载课程评分'}}"
          }
        ]
      },
      {
        "tag": "button",
        "attrs": {
          "bindtap": "onRecover",
          "disabled": "{{busy}}"
        },
        "scopes": [
          {
            "wx:if": "{{frozen}}"
          },
          {
            "disabled": "{{busy}}"
          }
        ]
      },
      {
        "tag": "button",
        "attrs": {
          "bindtap": "onRetry",
          "disabled": "{{busy}}"
        },
        "scopes": [
          {
            "wx:if": "{{frozen}}"
          },
          {
            "disabled": "{{busy}}"
          }
        ]
      },
      {
        "tag": "button",
        "attrs": {
          "class": "plain-button",
          "bindtap": "onRefresh",
          "disabled": "{{busy}}",
          "loading": "{{busy}}"
        },
        "scopes": [
          {
            "disabled": "{{busy}}",
            "loading": "{{busy}}"
          }
        ]
      },
      {
        "tag": "button",
        "attrs": {
          "class": "plain-button",
          "wx:if": "{{busy}}",
          "bindtap": "onCancel"
        },
        "scopes": [
          {
            "wx:if": "{{busy}}"
          }
        ]
      }
    ]
  }
}
