        "scopes": [
          {
            "wx:if": "{{confirming === 'cancel'}}"
          }
        ]
      },
      {
        "tag": "button",
        "attrs": {
          "class": "dp-plain dp-refresh",
          "bindtap": "onRefresh",
          "disabled": "{{busy}}"
        },
        "scopes": []
      },
      {
        "tag": "button",
        "attrs": {
          "wx:if": "{{busy}}",
          "bindtap": "onCancelWait"
        },
        "scopes": [
          {
            "wx:if": "{{busy}}"
          }
        ]
      }
    ]
  }
}
