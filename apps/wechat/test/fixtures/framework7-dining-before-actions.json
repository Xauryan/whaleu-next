{
  "src/pages/canteen-floor-scores/canteen-floor-scores.wxml": {
    "sourceSha256": "9b03887da3394b639015dd4253036f55606ec9c5fe400d6a8a9a66924127e18e",
    "actions": [
      {
        "tag": "button",
        "attrs": {
          "class": "dp-plain",
          "data-panel": "filter",
          "bindtap": "onTogglePanel",
          "aria-label": "筛选楼层"
        },
        "scopes": [
          {
            "wx:if": "{{loaded && catalog}}"
          }
        ]
      },
      {
        "tag": "button",
        "attrs": {
          "wx:for": "{{canteenOptions}}",
          "wx:key": "id",
          "data-id": "{{item.id}}",
          "class": "{{item.selected ? 'selected' : ''}}",
          "bindtap": "onCanteen",
          "disabled": "{{busy}}"
        },
        "scopes": [
          {
            "wx:if": "{{loaded && catalog}}"
          },
          {
            "wx:for": "{{canteenOptions}}",
            "wx:key": "id"
          }
        ]
      },
      {
        "tag": "picker",
        "attrs": {
          "range": "{{floorLabels}}",
          "value": "{{floorIndex}}",
          "bindchange": "onFloor"
        },
        "scopes": [
          {
            "wx:if": "{{loaded && catalog}}"
          },
          {
            "wx:if": "{{uiPanel === 'filter'}}"
          }
        ]
      },
      {
        "tag": "button",
        "attrs": {
          "wx:if": "{{floorDraft}}",
          "data-id": "{{floorDraft}}",
          "bindtap": "onOpenFloor",
          "disabled": "{{busy}}"
        },
        "scopes": [
          {
            "wx:if": "{{loaded && catalog}}"
          },
          {
            "wx:if": "{{uiPanel === 'filter'}}"
          },
          {
            "wx:if": "{{floorDraft}}"
          }
        ]
      },
      {
        "tag": "button",
        "attrs": {
          "wx:for": "{{floorOptions}}",
          "wx:key": "id",
          "data-id": "{{item.id}}",
          "bindtap": "onOpenFloor",
          "disabled": "{{busy}}",
          "class": "dp-open"
        },
        "scopes": [
          {
            "wx:if": "{{loaded && catalog}}"
          },
          {
            "wx:for": "{{floorOptions}}",
            "wx:key": "id"
          }
        ]
      }
    ]
  },
  "src/pages/canteen-floor-score-detail/canteen-floor-score-detail.wxml": {
    "sourceSha256": "c3c10d7621fd3fa2ccda924734b55cabda06284348d9a52dd72e70ac0dee14c0",
    "actions": [
      {
        "tag": "button",
        "attrs": {
          "class": "dp-plain",
          "data-panel": "info",
          "bindtap": "onTogglePanel",
          "aria-label": "楼层信息"
        },
        "scopes": [
          {
            "wx:if": "{{loaded && detail}}"
          }
        ]
      },
      {
        "tag": "button",
        "attrs": {
          "class": "primary",
          "data-panel": "score",
          "bindtap": "onTogglePanel",
          "disabled": "{{busy || frozen || confirming}}"
        },
        "scopes": [
          {
            "wx:if": "{{loaded && detail}}"
          },
          {
            "wx:if": "{{canScore}}"
          }
        ]
      },
      {
        "tag": "button",
        "attrs": {
          "class": "dp-plain",
          "bindtap": "onClosePanel"
        },
        "scopes": [
          {
            "wx:if": "{{loaded && detail}}"
          },
          {
            "wx:if": "{{canScore}}"
          },
          {
            "wx:if": "{{uiPanel === 'score' && !confirming}}"
          }
        ]
      },
      {
        "tag": "input",
        "attrs": {
          "type": "digit",
          "bindinput": "onScore",
          "disabled": "{{busy || frozen || confirming}}",
          "placeholder": "填写分数，如 4.75"
        },
        "scopes": [
          {
            "wx:if": "{{loaded && detail}}"
          },
          {
            "wx:if": "{{canScore}}"
          },
          {
            "wx:if": "{{uiPanel === 'score' && !confirming}}"
          }
        ]
      },
      {
        "tag": "button",
        "attrs": {
          "class": "primary",
          "bindtap": "onConfirm",
          "disabled": "{{busy || frozen || selectedScore === null}}"
        },
        "scopes": [
          {
            "wx:if": "{{loaded && detail}}"
          },
          {
            "wx:if": "{{canScore}}"
          },
          {
            "wx:if": "{{uiPanel === 'score' && !confirming}}"
          }
        ]
      },
      {
        "tag": "button",
        "attrs": {
          "class": "primary",
          "bindtap": "onSubmit",
          "disabled": "{{busy}}"
        },
        "scopes": [
          {
            "wx:if": "{{confirming === 'score' && detail}}"
          }
        ]
      },
      {
        "tag": "button",
        "attrs": {
          "bindtap": "onCloseConfirmation",
          "disabled": "{{busy}}"
        },
        "scopes": [
          {
            "wx:if": "{{confirming === 'score' && detail}}"
          }
        ]
      }
    ]
  },
  "src/pages/window-ratings/window-ratings.wxml": {
    "sourceSha256": "35dfabe4e815a10951d611a17367bb0cb8bf6549381bd707c6e5a269b4c770cd",
    "actions": [
      {
        "tag": "button",
        "attrs": {
          "class": "dp-plain",
          "data-panel": "menu",
          "bindtap": "onTogglePanel",
          "aria-label": "更多"
        },
        "scopes": []
      },
      {
        "tag": "navigator",
        "attrs": {
          "class": "link",
          "url": "/pages/window-discussion-recovery/window-discussion-recovery"
        },
        "scopes": [
          {
            "wx:if": "{{uiPanel === 'menu'}}"
          }
        ]
      },
      {
        "tag": "navigator",
        "attrs": {
          "class": "link",
          "url": "/pages/window-dishes/window-dishes"
        },
        "scopes": [
          {
            "wx:if": "{{uiPanel === 'menu'}}"
          }
        ]
      },
      {
        "tag": "button",
        "attrs": {
          "class": "dp-filter",
          "data-panel": "filter",
          "bindtap": "onTogglePanel"
        },
        "scopes": [
          {
            "wx:if": "{{catalog}}"
          }
        ]
      },
      {
        "tag": "button",
        "attrs": {
          "wx:for": "{{canteenOptions}}",
          "wx:key": "id",
          "data-id": "{{item.id}}",
          "class": "{{item.selected ? 'score-selected' : ''}}",
          "bindtap": "onCanteen",
          "disabled": "{{busy}}"
        },
        "scopes": [
          {
            "wx:if": "{{catalog}}"
          },
          {
            "wx:if": "{{uiPanel === 'filter'}}"
          },
          {
            "wx:for": "{{canteenOptions}}",
            "wx:key": "id"
          }
        ]
      },
      {
        "tag": "picker",
        "attrs": {
          "range": "{{floorLabels}}",
          "value": "{{floorIndex}}",
          "bindchange": "onFloor",
          "disabled": "{{busy}}"
        },
        "scopes": [
          {
            "wx:if": "{{catalog}}"
          },
          {
            "wx:if": "{{uiPanel === 'filter'}}"
          }
        ]
      },
      {
        "tag": "input",
        "attrs": {
          "class": "window-field",
          "value": "{{minRatingDraft}}",
          "maxlength": "8",
          "placeholder": "最低均分（选填）",
          "bindinput": "onMinimum",
          "bindconfirm": "onSearch",
          "disabled": "{{busy}}"
        },
        "scopes": [
          {
            "wx:if": "{{catalog}}"
          },
          {
            "wx:if": "{{uiPanel === 'filter'}}"
          }
        ]
      },
      {
        "tag": "button",
        "attrs": {
          "class": "primary",
          "bindtap": "onSearch",
          "disabled": "{{busy}}"
        },
        "scopes": [
          {
            "wx:if": "{{catalog}}"
          },
          {
            "wx:if": "{{uiPanel === 'filter'}}"
          }
        ]
      },
      {
        "tag": "button",
        "attrs": {
          "class": "dp-open",
          "data-id": "{{item.id}}",
          "bindtap": "onWindow",
          "disabled": "{{busy}}"
        },
        "scopes": [
          {
            "wx:if": "{{loaded}}"
          },
          {
            "wx:for": "{{items}}",
            "wx:key": "id"
          }
        ]
      },
      {
        "tag": "button",
        "attrs": {
          "wx:if": "{{canNext}}",
          "class": "dp-plain dp-next",
          "bindtap": "onNext",
          "disabled": "{{busy}}"
        },
        "scopes": [
          {
            "wx:if": "{{loaded}}"
          },
          {
            "wx:if": "{{canNext}}"
          }
        ]
      }
    ]
  },
  "src/pages/window-rating-detail/window-rating-detail.wxml": {
    "sourceSha256": "de0f5029ee75aa99af0d78a4c1b02c4fee683e759000df3d1f8adabe7f99c8f4",
    "actions": [
      {
        "tag": "button",
