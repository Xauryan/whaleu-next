        "scopes": [
          {
            "wx:if": "{{loaded && detail}}"
          },
          {
            "wx:if": "{{canScore}}"
          },
          {
            "wx:if": "{{uiPanel === 'score' && !confirming}}"
          },
          {
            "wx:for": "{{scores}}",
            "wx:key": "value"
          }
        ]
      },
      {
        "tag": "button",
        "attrs": {
          "class": "primary",
          "bindtap": "onConfirm",
          "disabled": "{{busy || selectedScore === null || confirming}}"
        },
        "scopes": [
          {
            "wx:if": "{{loaded && detail}}"
          },
          {
            "wx:if": "{{canScore}}"
          },
          {
            "wx:if": "{{uiPanel === 'score' && !confirming}}"
          }
        ]
      },
      {
        "tag": "button",
        "attrs": {
          "class": "primary",
          "bindtap": "onSubmit",
          "disabled": "{{busy || frozen}}"
        },
        "scopes": [
          {
            "wx:if": "{{loaded && detail}}"
          },
          {
            "wx:if": "{{confirming === 'score'}}"
          }
        ]
      },
      {
        "tag": "button",
        "attrs": {
          "bindtap": "onCloseConfirmation",
          "disabled": "{{busy || frozen}}"
        },
        "scopes": [
          {
            "wx:if": "{{loaded && detail}}"
          },
          {
            "wx:if": "{{confirming === 'score'}}"
          }
        ]
      },
      {
        "tag": "button",
        "attrs": {
          "bindtap": "onOpenDiscussion",
          "disabled": "{{busy}}"
        },
        "scopes": []
      },
      {
        "tag": "button",
        "attrs": {
          "bindtap": "onOpenRecommendations",
          "disabled": "{{busy}}"
        },
        "scopes": []
      },
      {
        "tag": "navigator",
        "attrs": {
          "class": "link dp-footer",
          "url": "/pages/window-ratings/window-ratings"
        },
        "scopes": []
      }
    ]
  },
  "src/pages/window-dishes/window-dishes.wxml": {
    "sourceSha256": "965ebd27f6ae4a3416c9480ae10560b4986fe288af3f997d1f92b2bd8d2315b9",
    "actions": [
      {
        "tag": "navigator",
        "attrs": {
          "wx:if": "{{!hasSession}}",
          "class": "link",
          "url": "/pages/login/login"
        },
        "scopes": [
          {
            "wx:if": "{{!hasSession}}"
          }
        ]
      },
      {
        "tag": "button",
        "attrs": {
          "bindtap": "onRecover",
          "disabled": "{{busy}}"
        },
        "scopes": [
          {
            "wx:if": "{{frozen}}"
          }
        ]
      },
      {
        "tag": "button",
        "attrs": {
          "bindtap": "onRetry",
          "disabled": "{{busy}}"
        },
        "scopes": [
          {
            "wx:if": "{{frozen}}"
          }
        ]
      },
      {
        "tag": "button",
        "attrs": {
          "wx:if": "{{recoveryWindowId && recoveryPhase !== 'cancel'}}",
          "bindtap": "onRequestCancellation",
          "disabled": "{{busy}}"
        },
        "scopes": [
          {
            "wx:if": "{{frozen}}"
          },
          {
            "wx:if": "{{recoveryWindowId && recoveryPhase !== 'cancel'}}"
          }
        ]
      },
      {
        "tag": "button",
        "attrs": {
          "bindtap": "onConfirmCancellation",
          "disabled": "{{busy || !receiptMissing}}"
        },
        "scopes": [
          {
            "wx:if": "{{confirming === 'cancel'}}"
          }
        ]
      },
      {
        "tag": "button",
        "attrs": {
          "bindtap": "onCloseConfirmation",
          "disabled": "{{busy}}"
        },
        "scopes": [
          {
            "wx:if": "{{confirming === 'cancel'}}"
          }
        ]
      },
      {
        "tag": "button",
        "attrs": {
          "class": "dp-plain",
          "bindtap": "onRefresh",
          "disabled": "{{busy}}"
        },
        "scopes": []
      },
      {
        "tag": "button",
        "attrs": {
          "wx:if": "{{busy}}",
          "bindtap": "onCancelWait"
        },
        "scopes": [
          {
            "wx:if": "{{busy}}"
          }
        ]
      },
      {
        "tag": "button",
        "attrs": {
          "class": "dp-open",
          "bindtap": "onDish",
          "data-identity": "{{item.dishIdentity}}",
          "disabled": "{{busy || frozen || confirming}}"
        },
        "scopes": [
          {
            "wx:if": "{{loaded}}"
          },
          {
            "wx:for": "{{items}}",
            "wx:key": "dishIdentity"
          }
        ]
      },
      {
        "tag": "button",
        "attrs": {
          "wx:if": "{{canNext}}",
          "class": "dp-plain dp-next",
          "bindtap": "onNext",
          "disabled": "{{busy}}"
        },
        "scopes": [
          {
            "wx:if": "{{loaded}}"
          },
          {
            "wx:if": "{{canNext}}"
          }
        ]
      },
      {
        "tag": "navigator",
        "attrs": {
          "class": "link",
          "url": "/pages/window-ratings/window-ratings"
        },
        "scopes": []
      },
      {
        "tag": "button",
        "attrs": {
          "class": "dp-plain",
          "data-panel": "info",
          "bindtap": "onTogglePanel"
        },
        "scopes": []
      },
      {
        "tag": "button",
        "attrs": {
          "class": "primary",
          "data-panel": "dish",
          "bindtap": "onTogglePanel",
          "disabled": "{{busy || frozen || confirming}}"
        },
        "scopes": []
      },
      {
        "tag": "button",
        "attrs": {
          "class": "dp-plain",
          "bindtap": "onClosePanel"
        },
        "scopes": [
          {
            "wx:if": "{{uiPanel === 'dish' && !confirming && !frozen}}"
          }
        ]
      },
      {
        "tag": "input",
        "attrs": {
          "value": "{{nameDraft}}",
          "bindinput": "onName",
          "maxlength": "-1",
          "disabled": "{{busy || frozen || confirming}}",
          "placeholder": "输入菜名"
        },
        "scopes": [
          {
            "wx:if": "{{uiPanel === 'dish' && !confirming && !frozen}}"
          }
        ]
      },
      {
        "tag": "button",
        "attrs": {
          "bindtap": "onLookup",
          "disabled": "{{busy || frozen || confirming}}"
        },
        "scopes": [
          {
            "wx:if": "{{uiPanel === 'dish' && !confirming && !frozen}}"
          }
        ]
      },
      {
        "tag": "button",
        "attrs": {
          "wx:if": "{{canRecommend}}",
          "class": "primary",
          "bindtap": "onRecommend",
          "disabled": "{{busy || frozen || confirming}}"
        },
        "scopes": [
          {
            "wx:if": "{{uiPanel === 'dish' && !confirming && !frozen}}"
          },
          {
            "wx:if": "{{canRecommend}}"
          }
        ]
      },
      {
        "tag": "button",
        "attrs": {
          "wx:if": "{{canRetract}}",
          "bindtap": "onRetract",
          "disabled": "{{busy || frozen || confirming}}"
        },
        "scopes": [
          {
            "wx:if": "{{uiPanel === 'dish' && !confirming && !frozen}}"
          },
          {
            "wx:if": "{{canRetract}}"
          }
        ]
      },
      {
        "tag": "button",
        "attrs": {
          "class": "primary",
          "bindtap": "onSubmit",
          "disabled": "{{busy || frozen}}"
        },
        "scopes": [
          {
            "wx:if": "{{confirming === 'recommend' || confirming === 'retract'}}"
          }
        ]
      },
      {
        "tag": "button",
        "attrs": {
          "bindtap": "onCloseConfirmation",
          "disabled": "{{busy || frozen}}"
        },
        "scopes": [
          {
            "wx:if": "{{confirming === 'recommend' || confirming === 'retract'}}"
          }
        ]
      }
    ]
  },
