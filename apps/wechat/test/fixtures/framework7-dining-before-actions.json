          "class": "dp-plain",
          "data-panel": "info",
          "bindtap": "onTogglePanel",
          "aria-label": "评分说明"
        },
        "scopes": [
          {
            "wx:if": "{{loaded && detail}}"
          }
        ]
      },
      {
        "tag": "button",
        "attrs": {
          "class": "primary",
          "data-panel": "score",
          "bindtap": "onTogglePanel",
          "disabled": "{{busy || frozen || confirming}}"
        },
        "scopes": [
          {
            "wx:if": "{{loaded && detail}}"
          },
          {
            "wx:if": "{{canScore}}"
          }
        ]
      },
      {
        "tag": "button",
