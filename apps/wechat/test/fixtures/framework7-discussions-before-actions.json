{
  "src/pages/major-directory/major-directory.wxml": {
    "sourceSha256": "c5e2409919bfd1bbde078a86f634f6d8df5f0e6321a4eb56f5c535688903d72b",
    "actions": [
      {
        "tag": "input",
        "attrs": {
          "value": "{{searchDraft}}",
          "maxlength": "100",
          "bindinput": "onSearchInput",
          "disabled": "{{busy}}",
          "placeholder": "搜索专业或学院"
        },
        "scopes": []
      },
      {
        "tag": "button",
        "attrs": {
          "class": "major-quiet",
          "bindtap": "onSearch",
          "disabled": "{{busy}}"
        },
        "scopes": []
      },
      {
        "tag": "picker",
        "attrs": {
          "range": "{{departmentNames}}",
          "value": "{{departmentIndex}}",
          "bindchange": "onDepartment",
          "disabled": "{{busy || !departments}}"
        },
        "scopes": []
      },
      {
        "tag": "button",
        "attrs": {
          "class": "major-icon-button",
          "data-panel": "options",
          "bindtap": "onTogglePanel",
          "aria-label": "更多专业目录选项"
        },
        "scopes": []
      },
      {
        "tag": "navigator",
        "attrs": {
          "class": "major-link",
          "url": "/pages/major-discussion-recovery/major-discussion-recovery"
        },
        "scopes": [
          {
            "wx:if": "{{uiPanel === 'options'}}"
          }
        ]
      },
      {
        "tag": "navigator",
        "attrs": {
          "class": "major-link",
          "url": "/pages/major-discussion-notices/major-discussion-notices"
        },
        "scopes": [
          {
            "wx:if": "{{uiPanel === 'options'}}"
          }
        ]
      },
      {
        "tag": "button",
        "attrs": {
          "wx:if": "{{canNext}}",
          "class": "major-load-more",
          "bindtap": "onNext",
          "disabled": "{{busy}}"
        },
        "scopes": [
          {
            "wx:if": "{{loaded}}"
          },
          {
            "wx:if": "{{canNext}}"
          }
        ]
      }
    ]
  },
