  "src/major-discussion/product.wxml": {
    "sourceSha256": "101f7f7bd35698e50447bb2e244553294ba8f5284de09a43227b203a413c788e",
    "actions": [
      {
        "tag": "navigator",
        "attrs": {
          "wx:if": "{{!hasSession}}",
          "class": "major-link",
          "url": "/pages/login/login"
        },
        "scopes": [
          {
            "wx:if": "{{!hasSession}}"
          }
        ]
      },
      {
        "tag": "button",
        "attrs": {
          "class": "major-quiet",
          "bindtap": "onRefresh",
          "disabled": "{{busy}}"
        },
        "scopes": [
          {
            "wx:if": "{{uiPanel === 'options' || !loaded || error}}"
          }
        ]
      },
      {
        "tag": "button",
        "attrs": {
          "wx:if": "{{busy}}",
          "class": "major-quiet",
          "bindtap": "onCancelWait"
        },
        "scopes": [
          {
            "wx:if": "{{busy}}"
          }
        ]
      },
      {
        "tag": "button",
        "attrs": {
          "bindtap": "onRecover",
          "disabled": "{{busy}}"
        },
        "scopes": [
          {
            "wx:if": "{{frozen}}"
          }
        ]
      },
      {
        "tag": "button",
        "attrs": {
          "bindtap": "onRetry",
          "disabled": "{{busy}}"
        },
        "scopes": [
          {
            "wx:if": "{{frozen}}"
          }
        ]
      },
      {
        "tag": "button",
        "attrs": {
          "wx:if": "{{recoveryPhase === 'submit'}}",
          "bindtap": "onRequestCancellation",
          "disabled": "{{busy}}"
        },
        "scopes": [
          {
            "wx:if": "{{frozen}}"
          },
          {
            "wx:if": "{{recoveryPhase === 'submit'}}"
          }
        ]
      },
      {
        "tag": "button",
        "attrs": {
          "bindtap": "onConfirmCancellation",
          "disabled": "{{busy}}"
        },
        "scopes": [
          {
            "wx:if": "{{frozen}}"
          },
          {
            "wx:if": "{{confirming === 'cancel'}}"
          }
        ]
      },
      {
        "tag": "button",
        "attrs": {
          "bindtap": "onCloseConfirmation",
          "disabled": "{{busy}}"
        },
        "scopes": [
          {
            "wx:if": "{{frozen}}"
          },
          {
            "wx:if": "{{confirming === 'cancel'}}"
          }
        ]
      },
      {
        "tag": "button",
        "attrs": {
          "class": "major-icon-button",
          "data-id": "{{item.id}}",
          "bindtap": "onDeleteMenu",
          "disabled": "{{busy || frozen || confirming}}",
          "aria-label": "更多讨论操作"
        },
        "scopes": []
      },
      {
        "tag": "button",
        "attrs": {
          "wx:for": "{{item.images}}",
          "wx:for-item": "image",
          "wx:key": "bindingId",
          "data-id": "{{item.id}}",
          "data-index": "{{image.ordinal}}",
          "bindtap": "onImage",
          "disabled": "{{busy || imageBusy}}"
        },
        "scopes": [
          {
            "wx:if": "{{item.images && item.images.length}}"
          },
          {
            "wx:for": "{{item.images}}",
            "wx:for-item": "image",
            "wx:key": "bindingId"
          }
        ]
      },
      {
        "tag": "button",
        "attrs": {
          "class": "major-quiet {{item.isLiked ? 'major-liked' : ''}}",
          "data-id": "{{item.id}}",
          "bindtap": "onLike",
          "disabled": "{{busy || frozen || confirming}}",
          "aria-label": "{{item.isLiked ? '取消我的赞' : '点赞'}}"
        },
        "scopes": []
      },
      {
        "tag": "button",
        "attrs": {
          "wx:if": "{{mode === 'roots'}}",
          "class": "major-quiet",
          "data-id": "{{item.id}}",
          "bindtap": "onThread",
          "disabled": "{{busy}}"
        },
        "scopes": [
          {
            "wx:if": "{{mode === 'roots'}}"
          }
        ]
      },
      {
        "tag": "button",
        "attrs": {
          "wx:elif": "{{item.rootId}}",
          "class": "major-quiet",
          "data-id": "{{item.id}}",
          "bindtap": "onReply",
          "disabled": "{{busy || frozen || confirming}}"
        },
        "scopes": [
          {
            "wx:elif": "{{item.rootId}}"
          }
        ]
      },
      {
        "tag": "button",
        "attrs": {
          "wx:if": "{{deleteTarget && deleteTarget.commentId === item.id}}",
          "class": "major-delete",
          "data-id": "{{item.id}}",
          "bindtap": "onDelete",
          "disabled": "{{busy || frozen || confirming}}"
        },
        "scopes": [
          {
            "wx:if": "{{deleteTarget && deleteTarget.commentId === item.id}}"
          }
        ]
      },
      {
        "tag": "button",
        "attrs": {
          "class": "major-delete",
          "bindtap": "onSubmit",
          "disabled": "{{busy}}"
        },
        "scopes": [
          {
            "wx:if": "{{confirming === 'delete' && deleteTarget}}"
          }
        ]
      },
      {
        "tag": "button",
        "attrs": {
          "bindtap": "onCloseConfirmation",
          "disabled": "{{busy}}"
        },
        "scopes": [
          {
            "wx:if": "{{confirming === 'delete' && deleteTarget}}"
          }
        ]
      },
      {
        "tag": "button",
        "attrs": {
          "class": "major-icon-button",
          "bindtap": "onClosePanel",
          "aria-label": "收起编辑"
        },
        "scopes": [
          {
            "wx:if": "{{loaded && !frozen}}"
          },
          {
            "wx:if": "{{uiPanel === 'compose' && !confirming}}"
          }
        ]
      },
      {
        "tag": "button",
        "attrs": {
          "wx:if": "{{replyTarget}}",
          "class": "major-quiet",
          "bindtap": "onReplyRoot",
          "disabled": "{{busy || imageBusy || imageFrozen || confirming}}"
        },
        "scopes": [
          {
            "wx:if": "{{loaded && !frozen}}"
          },
          {
            "wx:if": "{{uiPanel === 'compose' && !confirming}}"
          },
          {
            "wx:if": "{{mode === 'thread'}}"
          },
          {
            "wx:if": "{{replyTarget}}"
          }
        ]
      },
      {
        "tag": "textarea",
        "attrs": {
          "value": "{{body}}",
          "maxlength": "-1",
          "bindinput": "onBody",
          "disabled": "{{busy || imageBusy || imageFrozen || confirming}}",
          "placeholder": "分享你的专业体验或问题"
        },
        "scopes": [
          {
            "wx:if": "{{loaded && !frozen}}"
          },
          {
            "wx:if": "{{uiPanel === 'compose' && !confirming}}"
          }
        ]
      },
      {
        "tag": "button",
        "attrs": {
          "class": "major-quiet",
          "data-source": "album",
          "bindtap": "onPickImage",
          "disabled": "{{busy || imageBusy || imageFrozen || confirming || imageCount >= 3}}"
        },
        "scopes": [
          {
            "wx:if": "{{loaded && !frozen}}"
          },
          {
            "wx:if": "{{uiPanel === 'compose' && !confirming}}"
          },
          {
            "wx:if": "{{imageEnabled}}"
          }
        ]
      },
      {
        "tag": "button",
        "attrs": {
          "class": "major-quiet",
          "data-source": "camera",
          "bindtap": "onPickImage",
          "disabled": "{{busy || imageBusy || imageFrozen || confirming || imageCount >= 3}}"
        },
        "scopes": [
          {
            "wx:if": "{{loaded && !frozen}}"
          },
          {
            "wx:if": "{{uiPanel === 'compose' && !confirming}}"
          },
          {
            "wx:if": "{{imageEnabled}}"
          }
        ]
      },
      {
        "tag": "button",
        "attrs": {
          "class": "major-primary",
          "bindtap": "onConfirmPublish",
          "disabled": "{{busy || imageBusy || imageFrozen || confirming || !canPublish}}"
        },
        "scopes": [
          {
            "wx:if": "{{loaded && !frozen}}"
          },
          {
            "wx:if": "{{uiPanel === 'compose' && !confirming}}"
          }
        ]
      },
      {
        "tag": "button",
        "attrs": {
          "class": "major-primary",
          "bindtap": "onSubmit",
          "disabled": "{{busy}}"
        },
        "scopes": [
          {
            "wx:if": "{{confirming === 'publish'}}"
          }
        ]
      },
      {
        "tag": "button",
        "attrs": {
          "bindtap": "onCloseConfirmation",
          "disabled": "{{busy}}"
        },
        "scopes": [
          {
            "wx:if": "{{confirming === 'publish'}}"
          }
        ]
      },
      {
        "tag": "button",
        "attrs": {
          "class": "major-primary",
          "bindtap": "onSubmit",
          "disabled": "{{busy}}"
        },
        "scopes": [
          {
            "wx:if": "{{confirming === 'like' && selectedComment}}"
          }
        ]
      },
      {
        "tag": "button",
        "attrs": {
          "bindtap": "onCloseConfirmation",
          "disabled": "{{busy}}"
        },
        "scopes": [
          {
            "wx:if": "{{confirming === 'like' && selectedComment}}"
          }
        ]
      },
      {
        "tag": "button",
        "attrs": {
          "wx:if": "{{imageRecoverable}}",
          "bindtap": "onRecoverImages",
          "disabled": "{{busy || imageBusy}}"
        },
        "scopes": [
          {
            "wx:if": "{{imageEnabled && (imageStatus || imagePending || imageBusy)}}"
          },
          {
            "wx:if": "{{imageRecoverable}}"
          }
        ]
      },
      {
