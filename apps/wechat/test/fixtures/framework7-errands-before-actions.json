          "data-value": "pending",
          "bindtap": "onChoice",
          "disabled": "{{busy}}"
        },
        "scopes": []
      },
      {
        "tag": "button",
        "attrs": {
          "class": "errand-sort-toggle",
          "data-field": "sort",
          "bindtap": "onTogglePanel",
          "disabled": "{{busy}}"
        },
        "scopes": []
      },
      {
        "tag": "button",
        "attrs": {
          "class": "errand-choice {{sort === 'created' ? 'selected' : ''}}",
          "data-field": "sort",
          "data-value": "created",
          "bindtap": "onChoice",
          "disabled": "{{busy}}"
        },
        "scopes": [
          {
            "wx:if": "{{uiPanels.sort}}"
          }
        ]
      },
      {
        "tag": "button",
        "attrs": {
          "class": "errand-choice {{sort === 'reward' ? 'selected' : ''}}",
          "data-field": "sort",
          "data-value": "reward",
          "bindtap": "onChoice",
          "disabled": "{{busy}}"
        },
        "scopes": [
          {
            "wx:if": "{{uiPanels.sort}}"
          }
        ]
      },
      {
        "tag": "button",
        "attrs": {
          "class": "errand-choice {{direction === 'desc' ? 'selected' : ''}}",
          "data-field": "direction",
          "data-value": "desc",
          "bindtap": "onChoice",
          "disabled": "{{busy}}"
        },
        "scopes": [
          {
            "wx:if": "{{uiPanels.sort}}"
          }
        ]
      },
      {
        "tag": "button",
        "attrs": {
          "class": "errand-choice {{direction === 'asc' ? 'selected' : ''}}",
          "data-field": "direction",
          "data-value": "asc",
          "bindtap": "onChoice",
          "disabled": "{{busy}}"
        },
        "scopes": [
          {
            "wx:if": "{{uiPanels.sort}}"
          }
        ]
      },
      {
        "tag": "button",
        "attrs": {
          "class": "errand-order-open",
          "data-id": "{{item.id}}",
          "bindtap": "onOrder",
          "disabled": "{{busy}}"
        },
        "scopes": [
          {
            "wx:for": "{{items}}",
            "wx:key": "id"
          }
        ]
      },
      {
        "tag": "button",
        "attrs": {
          "wx:if": "{{canMore}}",
          "class": "errand-text-button errand-load-more",
          "bindtap": "onMore",
          "disabled": "{{busy}}"
        },
        "scopes": [
          {
            "wx:if": "{{canMore}}"
          }
        ]
      },
      {
        "tag": "navigator",
        "attrs": {
          "wx:if": "{{adminAvailable}}",
          "class": "errand-admin-link",
          "url": "/pages/errand-admin/errand-admin"
        },
        "scopes": [
          {
            "wx:if": "{{adminAvailable}}"
          }
        ]
      },
      {
        "tag": "button",
        "attrs": {
          "wx:if": "{{regionId}}",
          "class": "errand-primary",
          "bindtap": "onCompose",
          "disabled": "{{busy || frozen}}"
        },
        "scopes": [
          {
            "wx:if": "{{regionId}}"
          },
          {
            "wx:if": "{{regionId}}"
          }
        ]
      }
    ]
  },
