          "bindinput": "onForm",
          "maxlength": "-1",
          "disabled": "{{busy || imagePublication.busy || imagePublication.frozen}}",
          "placeholder": "例如取件码、详细位置 · 最多200字"
        },
        "scopes": [
          {
            "wx:if": "{{loaded && !frozen}}"
          },
          {
            "wx:if": "{{uiPanels.private}}"
          }
        ]
      },
      {
        "tag": "button",
        "attrs": {
          "class": "errand-disclosure",
          "data-field": "images",
          "bindtap": "onTogglePanel",
          "disabled": "{{busy || imagePublication.busy || imagePublication.frozen}}"
        },
        "scopes": [
          {
            "wx:if": "{{loaded && !frozen}}"
          }
        ]
      },
      {
        "tag": "button",
        "attrs": {
          "class": "errand-text-button",
          "data-value": "{{item.slot}}",
          "bindtap": "onChooseOrderImage",
          "disabled": "{{busy || imagePublication.busy || imagePublication.frozen}}"
        },
        "scopes": [
          {
            "wx:if": "{{loaded && !frozen}}"
          },
          {
            "wx:if": "{{uiPanels.images}}"
          },
          {
            "wx:for": "{{imagePublication.images}}",
            "wx:key": "slot"
          }
        ]
      },
      {
        "tag": "button",
        "attrs": {
          "class": "errand-text-button",
          "data-value": "{{item.slot}}",
          "bindtap": "onRecoverOrderImage",
          "disabled": "{{busy || imagePublication.busy || imagePublication.frozen}}"
        },
        "scopes": [
          {
            "wx:if": "{{loaded && !frozen}}"
          },
          {
            "wx:if": "{{uiPanels.images}}"
          },
          {
            "wx:for": "{{imagePublication.images}}",
            "wx:key": "slot"
          }
        ]
      },
      {
        "tag": "button",
        "attrs": {
          "class": "errand-text-button errand-muted",
          "data-value": "{{item.slot}}",
          "bindtap": "onRemoveOrderImage",
          "disabled": "{{busy || imagePublication.busy || imagePublication.frozen}}"
        },
        "scopes": [
          {
            "wx:if": "{{loaded && !frozen}}"
          },
          {
            "wx:if": "{{uiPanels.images}}"
          },
          {
            "wx:for": "{{imagePublication.images}}",
            "wx:key": "slot"
          }
        ]
      },
      {
        "tag": "button",
        "attrs": {
          "class": "errand-primary",
          "bindtap": "onPublish",
          "disabled": "{{busy || imagePublication.busy || !regionId}}",
          "loading": "{{busy}}"
        },
        "scopes": [
          {
            "wx:if": "{{loaded && !frozen}}"
          }
        ]
      },
      {
        "tag": "button",
        "attrs": {
          "class": "errand-text-button",
          "bindtap": "onRecoverImagePublication",
          "disabled": "{{imagePublication.busy}}"
        },
        "scopes": [
          {
            "wx:if": "{{imagePublication.hasDraft || imagePublication.message}}"
          }
        ]
      },
      {
        "tag": "button",
        "attrs": {
          "wx:if": "{{imagePublication.frozen}}",
          "class": "errand-primary",
          "bindtap": "onRetryImagePublication",
          "disabled": "{{imagePublication.busy}}"
        },
        "scopes": [
          {
            "wx:if": "{{imagePublication.hasDraft || imagePublication.message}}"
          },
          {
            "wx:if": "{{imagePublication.frozen}}"
          }
        ]
      },
      {
        "tag": "button",
        "attrs": {
          "wx:if": "{{imagePublication.hasDraft}}",
          "class": "errand-text-button errand-danger",
          "bindtap": "onCancelImageDraft",
          "disabled": "{{imagePublication.busy}}"
        },
        "scopes": [
          {
            "wx:if": "{{imagePublication.hasDraft || imagePublication.message}}"
          },
          {
            "wx:if": "{{imagePublication.hasDraft}}"
          }
        ]
      },
      {
        "tag": "navigator",
        "attrs": {
          "wx:if": "{{imagePublication.confirmedOrderId}}",
          "class": "errand-toolbar-link",
          "url": "/pages/errand-detail/errand-detail?orderId={{imagePublication.confirmedOrderId}}"
        },
        "scopes": [
          {
            "wx:if": "{{imagePublication.hasDraft || imagePublication.message}}"
          },
          {
            "wx:if": "{{imagePublication.confirmedOrderId}}"
          }
        ]
      }
    ]
  },
  "src/pages/errand-notices/errand-notices.wxml": {
    "sourceSha256": "71cebfbeefcf6c4acd75a165607220ea3b78acb0b72305e6b9e501f64615077d",
    "actions": [
      {
        "tag": "navigator",
