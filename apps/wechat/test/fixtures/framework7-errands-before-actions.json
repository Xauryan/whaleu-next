  "src/pages/errand-detail/errand-detail.wxml": {
    "sourceSha256": "a7c05ac3c294e7843df98153155322324f61a4060586191d98c91f0af04435e6",
    "actions": [
      {
        "tag": "navigator",
        "attrs": {
          "class": "errand-toolbar-link",
          "url": "/pages/errand-mine/errand-mine"
        },
        "scopes": []
      },
      {
        "tag": "button",
        "attrs": {
          "wx:for": "{{detail.publicMedia}}",
          "wx:key": "bindingId",
          "class": "errand-media-button",
          "data-value": "{{item.slot}}",
          "bindtap": "onPreviewOrderImage",
          "disabled": "{{orderImage.status === 'loading'}}"
        },
        "scopes": [
          {
            "wx:if": "{{loaded && detail}}"
          },
          {
            "wx:if": "{{detail.publicMedia && detail.publicMedia.length}}"
          },
          {
            "wx:for": "{{detail.publicMedia}}",
            "wx:key": "bindingId"
          }
        ]
      },
      {
        "tag": "button",
        "attrs": {
          "wx:for": "{{detail.privateMedia}}",
          "wx:key": "bindingId",
          "class": "errand-media-button",
          "data-value": "{{item.slot}}",
          "bindtap": "onPreviewOrderImage",
          "disabled": "{{orderImage.status === 'loading'}}"
        },
        "scopes": [
          {
            "wx:if": "{{loaded && detail}}"
          },
          {
            "wx:if": "{{detail.relation !== 'none' && detail.privateMedia && detail.privateMedia.length}}"
          },
          {
            "wx:for": "{{detail.privateMedia}}",
            "wx:key": "bindingId"
          }
        ]
      },
      {
        "tag": "button",
        "attrs": {
          "class": "errand-text-button",
          "bindtap": "onCloseOrderImage"
        },
        "scopes": [
          {
            "wx:if": "{{loaded && detail}}"
          },
          {
            "wx:if": "{{orderImage.status !== 'idle'}}"
          }
        ]
      },
      {
        "tag": "button",
        "attrs": {
          "wx:if": "{{targetServices.canPreview}}",
          "class": "errand-text-button",
          "bindtap": "onPreviewTargetQr",
          "disabled": "{{targetServices.busy || targetQr.status === 'loading'}}"
        },
        "scopes": [
          {
            "wx:if": "{{loaded && detail}}"
          },
          {
            "wx:if": "{{targetServices.visible}}"
          },
          {
            "wx:if": "{{targetServices.canPreview}}"
          }
        ]
      },
      {
        "tag": "button",
        "attrs": {
          "class": "errand-text-button errand-muted",
          "bindtap": "onDismissTargetNotice",
          "disabled": "{{targetServices.busy}}",
          "loading": "{{targetServices.busy}}"
        },
        "scopes": [
          {
            "wx:if": "{{loaded && detail}}"
          },
          {
            "wx:if": "{{targetServices.visible}}"
          }
        ]
      },
      {
        "tag": "button",
        "attrs": {
          "class": "errand-text-button",
          "bindtap": "onCloseTargetQr"
        },
        "scopes": [
          {
            "wx:if": "{{loaded && detail}}"
          },
          {
            "wx:if": "{{targetQr.status !== 'idle'}}"
          }
        ]
      },
      {
        "tag": "button",
        "attrs": {
          "class": "errand-disclosure",
          "data-field": "details",
          "bindtap": "onTogglePanel"
        },
        "scopes": [
          {
            "wx:if": "{{loaded && detail}}"
          }
        ]
      },
      {
        "tag": "button",
        "attrs": {
          "wx:if": "{{detail.capabilities.delete}}",
          "class": "errand-text-button errand-danger",
          "data-action": "delete",
          "bindtap": "onConfirm",
          "disabled": "{{busy || frozen}}"
        },
        "scopes": [
          {
            "wx:if": "{{loaded && detail}}"
          },
          {
            "wx:if": "{{detail.capabilities.delete}}"
          }
        ]
      },
      {
        "tag": "button",
        "attrs": {
          "wx:if": "{{detail.capabilities.cancel}}",
          "class": "errand-secondary",
          "data-action": "cancel",
          "bindtap": "onConfirm",
          "disabled": "{{busy || frozen}}"
        },
        "scopes": [
          {
            "wx:if": "{{loaded && detail}}"
          },
          {
            "wx:if": "{{detail.capabilities.accept || detail.capabilities.cancel || detail.capabilities.complete}}"
          },
          {
            "wx:if": "{{detail.capabilities.cancel}}"
          }
        ]
      },
      {
        "tag": "button",
        "attrs": {
          "wx:if": "{{detail.capabilities.accept}}",
          "class": "errand-primary",
          "bindtap": "onAccept",
          "disabled": "{{busy || frozen}}"
        },
        "scopes": [
          {
            "wx:if": "{{loaded && detail}}"
          },
          {
            "wx:if": "{{detail.capabilities.accept || detail.capabilities.cancel || detail.capabilities.complete}}"
          },
          {
            "wx:if": "{{detail.capabilities.accept}}"
          }
        ]
      },
      {
        "tag": "button",
        "attrs": {
          "wx:if": "{{detail.capabilities.complete}}",
          "class": "errand-primary",
          "data-action": "complete",
          "bindtap": "onConfirm",
          "disabled": "{{busy || frozen}}"
        },
        "scopes": [
          {
            "wx:if": "{{loaded && detail}}"
          },
          {
            "wx:if": "{{detail.capabilities.accept || detail.capabilities.cancel || detail.capabilities.complete}}"
          },
          {
            "wx:if": "{{detail.capabilities.complete}}"
          }
        ]
      },
      {
        "tag": "button",
        "attrs": {
          "class": "errand-text-button",
          "bindtap": "onToggleLast",
          "disabled": "{{busy}}"
        },
        "scopes": [
          {
            "wx:if": "{{acceptModal}}"
          }
        ]
      },
      {
        "tag": "input",
        "attrs": {
          "data-field": "wechat",
          "value": "{{contacts.wechat}}",
          "bindinput": "onContact",
          "maxlength": "-1",
          "placeholder": "微信 · 最多50字",
          "disabled": "{{busy || frozen}}"
        },
        "scopes": [
          {
            "wx:if": "{{acceptModal}}"
          }
        ]
      },
      {
        "tag": "input",
        "attrs": {
          "data-field": "phone",
          "value": "{{contacts.phone}}",
          "bindinput": "onContact",
          "type": "number",
          "maxlength": "11",
          "placeholder": "电话 · 最多11位数字",
          "disabled": "{{busy || frozen}}"
        },
        "scopes": [
          {
            "wx:if": "{{acceptModal}}"
          }
        ]
      },
      {
        "tag": "button",
        "attrs": {
          "class": "errand-primary",
          "bindtap": "onConfirmAccept",
          "disabled": "{{busy || frozen}}"
        },
        "scopes": [
          {
            "wx:if": "{{acceptModal}}"
          }
        ]
      },
      {
        "tag": "button",
        "attrs": {
          "class": "errand-text-button errand-muted",
          "bindtap": "onCloseAccept"
        },
        "scopes": [
          {
            "wx:if": "{{acceptModal}}"
          }
        ]
      },
      {
        "tag": "button",
        "attrs": {
          "class": "errand-primary {{confirmAction === 'complete' ? '' : 'errand-destructive'}}",
          "bindtap": "onConfirmCommand",
          "disabled": "{{busy || frozen}}"
        },
        "scopes": [
          {
            "wx:if": "{{confirmAction}}"
          }
        ]
      },
      {
        "tag": "button",
        "attrs": {
          "class": "errand-text-button errand-muted",
          "bindtap": "onDismiss",
          "disabled": "{{busy}}"
        },
        "scopes": [
          {
            "wx:if": "{{confirmAction}}"
          }
        ]
      }
    ]
  },
  "src/pages/errand-compose/errand-compose.wxml": {
    "sourceSha256": "3cc84606eaf0a64d1075fd27b3ed3a8baed44f7c748bc225e6cf0c8db87c8169",
    "actions": [
      {
        "tag": "input",
        "attrs": {
          "class": "errand-title-input",
          "data-field": "title",
          "value": "{{form.title}}",
          "bindinput": "onForm",
          "maxlength": "-1",
          "disabled": "{{busy || imagePublication.busy || imagePublication.frozen}}",
          "placeholder": "需要同学帮你做什么？"
        },
        "scopes": [
          {
            "wx:if": "{{loaded && !frozen}}"
          }
        ]
      },
      {
        "tag": "textarea",
        "attrs": {
          "class": "errand-description-input",
          "data-field": "publicText",
          "value": "{{form.publicText}}",
          "bindinput": "onForm",
          "maxlength": "-1",
          "disabled": "{{busy || imagePublication.busy || imagePublication.frozen}}",
          "placeholder": "写清取送地点、物品和具体要求，方便同学接单"
        },
        "scopes": [
          {
            "wx:if": "{{loaded && !frozen}}"
          }
        ]
      },
      {
        "tag": "input",
        "attrs": {
          "data-field": "expectedTimeText",
          "value": "{{form.expectedTimeText}}",
          "bindinput": "onForm",
          "maxlength": "-1",
          "disabled": "{{busy || imagePublication.busy || imagePublication.frozen}}",
          "placeholder": "例如今晚八点前 · 最多50字"
        },
        "scopes": [
          {
            "wx:if": "{{loaded && !frozen}}"
          }
        ]
      },
      {
        "tag": "input",
        "attrs": {
