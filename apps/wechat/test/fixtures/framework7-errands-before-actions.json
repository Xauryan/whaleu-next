      },
      {
        "tag": "input",
        "attrs": {
          "data-field": "wechat",
          "value": "{{form.wechat}}",
          "bindinput": "onForm",
          "maxlength": "-1",
          "disabled": "{{busy || imagePublication.busy || imagePublication.frozen}}",
          "placeholder": "填写微信号 · 最多50字"
        },
        "scopes": [
          {
            "wx:if": "{{loaded && !frozen}}"
          }
        ]
      },
      {
        "tag": "input",
        "attrs": {
          "data-field": "phone",
          "value": "{{form.phone}}",
          "bindinput": "onForm",
          "maxlength": "11",
          "type": "number",
          "disabled": "{{busy || imagePublication.busy || imagePublication.frozen}}",
          "placeholder": "填写联系电话 · 最多11位"
        },
        "scopes": [
          {
            "wx:if": "{{loaded && !frozen}}"
