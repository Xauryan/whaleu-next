          "aria-label": "跑腿通知"
        },
        "scopes": []
      },
      {
        "tag": "button",
        "attrs": {
          "class": "errand-tab {{filter === 'all' ? 'active' : ''}}",
          "data-field": "filter",
          "data-value": "all",
          "bindtap": "onChoice",
          "disabled": "{{busy}}"
        },
        "scopes": []
      },
      {
        "tag": "button",
        "attrs": {
          "class": "errand-tab {{filter === 'pending' ? 'active' : ''}}",
