{
  "src/pages/errand-list/errand-list.wxml": {
    "sourceSha256": "900b9bd13d4c237266fd31f42314034250e57f349ab68c57171c431ea6f7a19e",
    "actions": [
      {
        "tag": "navigator",
        "attrs": {
          "class": "errand-toolbar-link",
          "url": "/pages/errand-mine/errand-mine"
