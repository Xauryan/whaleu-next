        },
        "scopes": [
          {
            "wx:if": "{{busy}}"
          }
        ]
      },
      {
        "tag": "button",
        "attrs": {
          "wx:for": "{{detail.media.items}}",
          "wx:key": "bindingId",
          "class": "image-link",
          "data-slot": "{{item.slot}}",
          "bindtap": "onImage"
        },
        "scopes": [
          {
            "wx:if": "{{loaded && detail}}"
          },
          {
            "wx:if": "{{detail.media.status === 'available'}}"
          },
          {
            "wx:for": "{{detail.media.items}}",
            "wx:key": "bindingId"
          }
        ]
      },
      {
        "tag": "button",
        "attrs": {
          "class": "disclosure",
          "bindtap": "onToggleInfo"
        },
        "scopes": [
          {
            "wx:if": "{{loaded && detail}}"
          }
        ]
      }
    ]
  }
}
