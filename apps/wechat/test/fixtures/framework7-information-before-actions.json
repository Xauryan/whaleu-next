    "actions": [
      {
        "tag": "navigator",
        "attrs": {
          "class": "create-link",
          "url": "/pages/organization-editor/organization-editor"
        },
        "scopes": []
      },
      {
        "tag": "button",
        "attrs": {
          "class": "icon-button",
          "aria-label": "刷新组织列表",
          "bindtap": "onRefresh",
          "disabled": "{{busy}}",
          "loading": "{{busy}}"
        },
        "scopes": []
      },
      {
        "tag": "button",
        "attrs": {
          "class": "tab {{mode === 'mine' ? 'active' : ''}}",
          "bindtap": "onMine"
        },
        "scopes": []
      },
      {
        "tag": "button",
        "attrs": {
          "wx:if": "{{management !== 'none'}}",
          "class": "tab {{mode === 'review' ? 'active' : ''}}",
          "bindtap": "onReviews"
        },
        "scopes": [
          {
            "wx:if": "{{management !== 'none'}}"
          }
        ]
      },
      {
        "tag": "input",
        "attrs": {
          "value": "{{campusQuery}}",
          "bindinput": "onCampusInput",
          "placeholder": "搜索要管理的学校"
        },
        "scopes": [
          {
            "wx:if": "{{mode === 'review' && management === 'global'}}"
          }
        ]
      },
      {
        "tag": "button",
        "attrs": {
          "class": "text-button",
          "bindtap": "onFindCampus",
          "disabled": "{{selecting}}"
        },
        "scopes": [
          {
            "wx:if": "{{mode === 'review' && management === 'global'}}"
          }
        ]
      },
      {
        "tag": "button",
        "attrs": {
          "wx:for": "{{campuses}}",
          "wx:key": "id",
          "class": "campus-result",
          "data-id": "{{item.id}}",
          "bindtap": "onChooseCampus",
          "disabled": "{{selecting}}"
        },
        "scopes": [
          {
            "wx:if": "{{mode === 'review' && management === 'global'}}"
          },
          {
            "wx:for": "{{campuses}}",
            "wx:key": "id"
          }
        ]
      },
      {
        "tag": "navigator",
        "attrs": {
          "class": "organization-link",
          "url": "/pages/organization-editor/organization-editor?id={{item.id}}"
        },
        "scopes": [
          {
            "wx:for": "{{items}}",
            "wx:key": "id"
          }
        ]
      },
      {
        "tag": "button",
        "attrs": {
          "wx:if": "{{more}}",
          "class": "quiet-button",
          "bindtap": "onMore",
          "disabled": "{{busy}}"
        },
        "scopes": [
          {
            "wx:if": "{{more}}"
          }
        ]
      },
      {
        "tag": "navigator",
        "attrs": {
          "class": "utility-row directory-link",
          "url": "/pages/directory-hub/directory-hub"
        },
        "scopes": []
      }
    ]
  },
