  "src/pages/social-notices/social-notices.wxml": {
    "sourceSha256": "1d053c01e605d7206791e7eeb9f0dae53e739adf6507f9862943b6ec9eb2f077",
    "actions": [
      {
        "tag": "button",
        "attrs": {
          "class": "notice-icon-button",
          "bindtap": "onReload",
          "disabled": "{{busy}}",
          "aria-label": "刷新互动消息"
        },
        "scopes": []
      },
      {
        "tag": "navigator",
        "attrs": {
          "url": "/pages/login/login",
          "class": "notice-action"
        },
        "scopes": [
          {
            "wx:if": "{{!hasSession}}"
          }
        ]
      },
      {
        "tag": "button",
        "attrs": {
          "class": "notice-action",
          "bindtap": "onReload",
          "disabled": "{{busy}}"
        },
        "scopes": [
          {
            "wx:if": "{{error}}"
          }
        ]
      },
      {
        "tag": "button",
        "attrs": {
          "class": "social-open",
          "data-id": "{{item.id}}",
          "bindtap": "onOpen",
          "disabled": "{{item.busy || !item.available}}",
          "aria-label": "{{item.title}}，{{item.action}}"
        },
        "scopes": [
          {
            "wx:else": ""
          },
          {
            "wx:for": "{{rows}}",
            "wx:key": "id"
          }
        ]
      },
      {
        "tag": "button",
        "attrs": {
          "wx:if": "{{item.unread}}",
          "class": "notice-read",
          "data-id": "{{item.id}}",
          "bindtap": "onRead",
          "disabled": "{{item.busy}}"
        },
        "scopes": [
          {
            "wx:else": ""
          },
          {
            "wx:for": "{{rows}}",
            "wx:key": "id"
          },
          {
            "wx:if": "{{item.unread}}"
          }
        ]
      },
      {
        "tag": "button",
        "attrs": {
          "wx:if": "{{item.canMore}}",
          "class": "notice-action",
          "bindtap": "onMore",
          "data-source": "{{item.key}}",
          "disabled": "{{item.busy}}",
          "loading": "{{item.busy}}"
        },
        "scopes": [
          {
            "wx:else": ""
          },
          {
            "wx:for": "{{sources}}",
            "wx:key": "key"
          },
          {
            "wx:if": "{{item.canMore}}"
          }
        ]
      },
      {
        "tag": "button",
        "attrs": {
          "wx:if": "{{busy}}",
          "class": "notice-secondary",
          "bindtap": "onCancel"
        },
        "scopes": [
          {
            "wx:else": ""
          },
          {
            "wx:if": "{{busy}}"
          }
        ]
      },
      {
        "tag": "button",
        "attrs": {
          "class": "notice-secondary",
          "bindtap": "onCoverage",
          "aria-expanded": "{{showCoverage}}"
        },
        "scopes": [
          {
            "wx:else": ""
          }
        ]
      }
    ]
  },
  "src/pages/system-notices/system-notices.wxml": {
    "sourceSha256": "88ee84cd1e320abcd1b2e61ccf80f06bdfdbc2c91defc6ebc8473ecbf9bdaa8d",
    "actions": [
      {
        "tag": "button",
        "attrs": {
          "class": "notice-icon-button",
          "bindtap": "onReload",
          "disabled": "{{busy}}",
          "aria-label": "刷新系统消息"
        },
        "scopes": []
      },
      {
        "tag": "button",
        "attrs": {
          "wx:if": "{{busy}}",
          "class": "notice-secondary",
          "bindtap": "onCancel"
        },
        "scopes": [
          {
            "wx:if": "{{busy}}"
          }
        ]
      },
      {
        "tag": "navigator",
        "attrs": {
          "wx:if": "{{!hasSession}}",
          "class": "notice-action",
          "url": "/pages/login/login"
        },
        "scopes": [
          {
            "wx:if": "{{!hasSession}}"
          }
        ]
      },
      {
        "tag": "button",
        "attrs": {
          "wx:if": "{{item.source === 'verification' || item.source === 'feedback' || item.kind === 'accepted' || item.kind === 'completed'}}",
          "class": "notice-action",
          "data-id": "{{item.key}}",
          "bindtap": "onOpen",
          "disabled": "{{busy}}"
        },
        "scopes": [
          {
            "wx:for": "{{items}}",
            "wx:key": "key"
          },
          {
            "wx:if": "{{item.source !== 'system'}}"
          },
          {
            "wx:if": "{{item.source === 'verification' || item.source === 'feedback' || item.kind === 'accepted' || item.kind === 'completed'}}"
          }
        ]
      },
      {
        "tag": "navigator",
        "attrs": {
          "class": "notice-action",
          "url": "/pages/profile/profile"
        },
        "scopes": [
          {
            "wx:for": "{{items}}",
            "wx:key": "key"
          },
          {
            "wx:elif": "{{item.kind === 'profile_nickname_reset'}}"
          }
        ]
      },
      {
        "tag": "navigator",
        "attrs": {
          "class": "notice-action",
          "url": "/pages/account-status/account-status"
        },
        "scopes": [
          {
            "wx:for": "{{items}}",
            "wx:key": "key"
          },
          {
            "wx:elif": "{{item.kind === 'account_punishment_issued' || item.kind === 'account_punishment_released'}}"
          }
        ]
      },
      {
        "tag": "navigator",
        "attrs": {
          "class": "notice-action",
          "url": "/pages/safety-appeal/safety-appeal?appealId={{item.appealId}}"
        },
        "scopes": [
          {
            "wx:for": "{{items}}",
            "wx:key": "key"
          },
          {
            "wx:elif": "{{item.kind === 'account_appeal_decided'}}"
          }
        ]
      },
      {
        "tag": "button",
        "attrs": {
          "wx:if": "{{!item.readAt}}",
          "class": "notice-read",
          "data-id": "{{item.key}}",
          "bindtap": "onRead",
          "disabled": "{{busy}}"
        },
        "scopes": [
          {
            "wx:for": "{{items}}",
            "wx:key": "key"
          },
          {
            "wx:if": "{{!item.readAt}}"
          }
        ]
      },
      {
        "tag": "button",
        "attrs": {
          "wx:if": "{{canLoadMore}}",
          "class": "notice-action",
          "bindtap": "onMore",
          "disabled": "{{busy}}"
        },
        "scopes": [
          {
            "wx:if": "{{canLoadMore}}"
          }
        ]
      },
      {
        "tag": "button",
        "attrs": {
          "class": "notice-secondary",
          "bindtap": "onSources"
        },
        "scopes": []
      }
    ]
  },
