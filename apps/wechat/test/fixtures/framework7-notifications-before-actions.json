  "src/pages/community-updates/community-updates.wxml": {
    "sourceSha256": "289e25793b5fea951c21cb0761614885faaf3df1234c96eea0ac86c61e4af88d",
    "actions": [
      {
        "tag": "button",
        "attrs": {
          "class": "notice-icon-button",
          "bindtap": "onReload",
          "disabled": "{{busy}}",
          "loading": "{{busy}}",
          "aria-label": "刷新帖子互动"
        },
        "scopes": []
      },
      {
        "tag": "button",
        "attrs": {
          "wx:if": "{{busy}}",
          "class": "notice-secondary",
          "bindtap": "onCancel"
        },
        "scopes": [
          {
            "wx:if": "{{busy}}"
          }
        ]
      },
      {
        "tag": "navigator",
        "attrs": {
          "wx:if": "{{!hasSession}}",
          "class": "notice-action",
          "url": "/pages/login/login"
        },
        "scopes": [
          {
            "wx:if": "{{!hasSession}}"
          }
        ]
      },
      {
        "tag": "button",
        "attrs": {
          "class": "notice-action",
          "data-id": "{{item.noticeId}}",
          "bindtap": "onOpen",
          "disabled": "{{busy}}"
        },
        "scopes": [
          {
            "wx:for": "{{items}}",
            "wx:key": "noticeId"
          },
          {
            "wx:if": "{{item.status === 'available'}}"
          }
        ]
      },
      {
        "tag": "button",
        "attrs": {
          "wx:if": "{{!item.readAt}}",
          "class": "notice-read",
          "data-id": "{{item.noticeId}}",
          "bindtap": "onRead",
          "disabled": "{{busy}}"
        },
        "scopes": [
          {
            "wx:for": "{{items}}",
            "wx:key": "noticeId"
          },
          {
            "wx:if": "{{!item.readAt}}"
          }
        ]
      },
      {
        "tag": "button",
        "attrs": {
          "wx:if": "{{canLoadMore}}",
