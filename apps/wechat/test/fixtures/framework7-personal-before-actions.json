{
  "src/pages/public-profile/public-profile.wxml": {
    "sourceSha256": "2d4e893f5f8fb8ce29673d871cbaf31fcd2336d654ab99d2f43f775b72dfdc08",
    "actions": [
      {
        "tag": "button",
        "attrs": {
          "class": "profile-refresh",
          "bindtap": "onReload",
          "disabled": "{{busy}}",
          "loading": "{{busy}}",
          "aria-label": "刷新公开主页"
        },
        "scopes": [
          {
            "disabled": "{{busy}}",
            "loading": "{{busy}}"
          }
        ]
      },
      {
        "tag": "button",
        "attrs": {
          "wx:if": "{{busy}}",
          "class": "secondary",
          "bindtap": "onCancel"
        },
        "scopes": [
          {
            "wx:if": "{{busy}}"
          }
        ]
      },
      {
        "tag": "navigator",
        "attrs": {
          "class": "link",
          "url": "/pages/profile/profile"
        },
        "scopes": [
          {
            "wx:if": "{{selfEntry || profile && profile.isOwn}}"
          }
        ]
      },
      {
        "tag": "navigator",
        "attrs": {
          "class": "link",
          "url": "/pages/community-mine/community-mine"
        },
        "scopes": [
          {
            "wx:if": "{{selfEntry || profile && profile.isOwn}}"
          }
        ]
      },
      {
        "tag": "navigator",
        "attrs": {
          "class": "link",
          "url": "/pages/community-liked/community-liked"
        },
        "scopes": [
          {
            "wx:if": "{{selfEntry || profile && profile.isOwn}}"
          }
        ]
      },
      {
        "tag": "navigator",
        "attrs": {
          "class": "link",
          "url": "/pages/community-saved/community-saved"
        },
        "scopes": [
          {
            "wx:if": "{{selfEntry || profile && profile.isOwn}}"
          }
        ]
      },
      {
        "tag": "button",
        "attrs": {
          "bindtap": "onUnblockProfile",
          "disabled": "{{busy || block.busy || block.frozen}}"
        },
        "scopes": [
          {
            "wx:if": "{{profile && profile.status === 'blocked_by_you'}}"
          },
          {
            "disabled": "{{busy || block.busy || block.frozen}}"
          }
        ]
      },
      {
        "tag": "button",
        "attrs": {
          "wx:if": "{{follow.recoveryProfileId === profile.profileId}}",
          "class": "secondary",
          "bindtap": "onFollowRetry",
          "disabled": "{{busy || block.busy || block.frozen || follow.busy}}"
        },
        "scopes": [
          {
            "wx:if": "{{loaded && profile && profile.status !== 'available' && follow.frozen}}"
          },
          {
            "wx:if": "{{follow.recoveryProfileId === profile.profileId}}",
            "disabled": "{{busy || block.busy || block.frozen || follow.busy}}"
          }
        ]
      },
      {
        "tag": "navigator",
        "attrs": {
          "wx:elif": "{{follow.recoveryProfileId}}",
          "class": "quiet-link",
          "url": "/pages/public-profile/public-profile?profileId={{follow.recoveryProfileId}}"
        },
        "scopes": [
          {
            "wx:if": "{{loaded && profile && profile.status !== 'available' && follow.frozen}}"
          },
          {
            "wx:elif": "{{follow.recoveryProfileId}}"
          }
        ]
      },
      {
        "tag": "button",
        "attrs": {
          "wx:if": "{{follow.busy}}",
          "class": "profile-refresh",
          "bindtap": "onFollowCancel"
        },
        "scopes": [
          {
            "wx:if": "{{loaded && profile && profile.status !== 'available' && follow.frozen}}"
          },
          {
            "wx:if": "{{follow.busy}}"
          }
        ]
      },
      {
        "tag": "image",
        "attrs": {
          "wx:if": "{{coverRead.localSrc}}",
          "class": "public-cover-image",
          "src": "{{coverRead.localSrc}}",
          "mode": "aspectFill",
          "binderror": "onCoverError",
          "aria-label": "主页背景图",
          "show-menu-by-longpress": "{{false}}"
        },
        "scopes": [
          {
            "wx:if": "{{loaded && !busy && !block.busy && !block.frozen}}"
          },
          {
            "wx:if": "{{profile && profile.status === 'available'}}"
          },
          {
            "wx:if": "{{coverRead.localSrc}}"
          }
        ]
      },
      {
        "tag": "image",
        "attrs": {
          "wx:if": "{{avatarRead.localSrc}}",
          "class": "profile-avatar",
          "src": "{{avatarRead.localSrc}}",
          "mode": "aspectFit",
          "bindtap": "onOpenAvatar",
          "binderror": "onAvatarError",
          "show-menu-by-longpress": "{{false}}"
        },
        "scopes": [
          {
            "wx:if": "{{loaded && !busy && !block.busy && !block.frozen}}"
          },
          {
            "wx:if": "{{profile && profile.status === 'available'}}"
          },
          {
            "wx:if": "{{avatarRead.localSrc}}"
          }
        ]
      },
      {
        "tag": "button",
        "attrs": {
          "wx:if": "{{hasSession}}",
          "class": "{{follow.following ? 'secondary' : 'primary'}} follow-button",
          "bindtap": "onFollow",
          "disabled": "{{busy || block.busy || block.frozen || follow.busy || follow.frozen || follow.following === null}}",
          "loading": "{{follow.busy}}"
        },
        "scopes": [
          {
            "wx:if": "{{loaded && !busy && !block.busy && !block.frozen}}"
          },
          {
            "wx:if": "{{profile && profile.status === 'available'}}"
          },
          {
            "wx:if": "{{!profile.isOwn}}"
          },
          {
            "wx:if": "{{hasSession}}",
            "disabled": "{{busy || block.busy || block.frozen || follow.busy || follow.frozen || follow.following === null}}",
            "loading": "{{follow.busy}}"
          }
        ]
      },
      {
        "tag": "navigator",
        "attrs": {
          "class": "primary follow-button",
          "url": "/pages/login/login",
          "wx:else": ""
        },
        "scopes": [
          {
            "wx:if": "{{loaded && !busy && !block.busy && !block.frozen}}"
          },
          {
            "wx:if": "{{profile && profile.status === 'available'}}"
          },
          {
            "wx:if": "{{!profile.isOwn}}"
          },
          {
            "wx:else": ""
          }
        ]
      },
      {
        "tag": "button",
        "attrs": {
          "class": "secondary message-button",
          "bindtap": "onPrivateMessage",
          "disabled": "{{busy || block.busy || block.frozen}}"
        },
        "scopes": [
          {
            "wx:if": "{{loaded && !busy && !block.busy && !block.frozen}}"
          },
          {
            "wx:if": "{{profile && profile.status === 'available'}}"
          },
          {
            "wx:if": "{{!profile.isOwn}}"
          },
          {
            "disabled": "{{busy || block.busy || block.frozen}}"
          }
        ]
      },
      {
        "tag": "button",
        "attrs": {
          "wx:if": "{{follow.recoveryProfileId === profile.profileId}}",
          "class": "secondary",
          "bindtap": "onFollowRetry",
          "disabled": "{{busy || block.busy || block.frozen || follow.busy}}"
        },
        "scopes": [
          {
            "wx:if": "{{loaded && !busy && !block.busy && !block.frozen}}"
          },
          {
            "wx:if": "{{profile && profile.status === 'available'}}"
          },
          {
            "wx:if": "{{follow.frozen}}"
          },
          {
            "wx:if": "{{follow.recoveryProfileId === profile.profileId}}",
            "disabled": "{{busy || block.busy || block.frozen || follow.busy}}"
          }
        ]
      },
      {
        "tag": "navigator",
        "attrs": {
          "wx:elif": "{{follow.recoveryProfileId}}",
          "class": "quiet-link",
          "url": "/pages/public-profile/public-profile?profileId={{follow.recoveryProfileId}}"
        },
        "scopes": [
          {
            "wx:if": "{{loaded && !busy && !block.busy && !block.frozen}}"
          },
          {
            "wx:if": "{{profile && profile.status === 'available'}}"
          },
          {
            "wx:if": "{{follow.frozen}}"
          },
          {
            "wx:elif": "{{follow.recoveryProfileId}}"
          }
        ]
      },
      {
        "tag": "button",
        "attrs": {
          "wx:if": "{{hasSession && !profile.isOwn && !follow.busy && !follow.frozen && follow.following === null}}",
          "class": "profile-refresh",
          "bindtap": "onFollowReload",
          "disabled": "{{busy || block.busy || block.frozen}}"
        },
        "scopes": [
          {
            "wx:if": "{{loaded && !busy && !block.busy && !block.frozen}}"
          },
          {
            "wx:if": "{{profile && profile.status === 'available'}}"
          },
          {
            "wx:if": "{{hasSession && !profile.isOwn && !follow.busy && !follow.frozen && follow.following === null}}",
            "disabled": "{{busy || block.busy || block.frozen}}"
          }
        ]
      },
      {
        "tag": "button",
        "attrs": {
          "wx:if": "{{follow.busy}}",
          "class": "profile-refresh",
          "bindtap": "onFollowCancel"
        },
        "scopes": [
          {
            "wx:if": "{{loaded && !busy && !block.busy && !block.frozen}}"
          },
          {
            "wx:if": "{{profile && profile.status === 'available'}}"
          },
          {
            "wx:if": "{{follow.busy}}"
          }
        ]
      },
      {
        "tag": "image",
        "attrs": {
          "src": "{{avatarRead.localSrc}}",
          "mode": "aspectFit",
          "binderror": "onAvatarError",
          "show-menu-by-longpress": "{{false}}"
        },
        "scopes": [
          {
            "wx:if": "{{loaded && !busy && !block.busy && !block.frozen}}"
          },
          {
            "wx:if": "{{profile && profile.status === 'available'}}"
          },
          {
            "wx:if": "{{avatarRead.expanded && avatarRead.localSrc}}"
          }
        ]
      },
      {
        "tag": "button",
        "attrs": {
          "bindtap": "onCloseAvatar"
        },
        "scopes": [
          {
            "wx:if": "{{loaded && !busy && !block.busy && !block.frozen}}"
          },
          {
            "wx:if": "{{profile && profile.status === 'available'}}"
          },
          {
            "wx:if": "{{avatarRead.expanded && avatarRead.localSrc}}"
          }
        ]
      },
      {
        "tag": "button",
        "attrs": {
          "class": "profile-details-toggle",
          "aria-expanded": "{{showProfileDetails}}",
          "bindtap": "onProfileDetails"
        },
        "scopes": [
          {
            "wx:if": "{{loaded && !busy && !block.busy && !block.frozen}}"
          },
          {
            "wx:if": "{{profile && profile.status === 'available'}}"
          }
        ]
      },
      {
        "tag": "navigator",
        "attrs": {
          "class": "link",
          "url": "/pages/school-identity-management/school-identity-management?targetProfileId={{profile.profileId}}"
        },
        "scopes": [
          {
            "wx:if": "{{loaded && !busy && !block.busy && !block.frozen}}"
          },
          {
            "wx:if": "{{profile && profile.status === 'available'}}"
          },
          {
            "wx:if": "{{showProfileDetails}}"
          }
        ]
      },
      {
        "tag": "navigator",
        "attrs": {
          "class": "link",
          "url": "/pages/school-admin-management/school-admin-management?targetProfileId={{profile.profileId}}"
        },
        "scopes": [
          {
            "wx:if": "{{loaded && !busy && !block.busy && !block.frozen}}"
          },
          {
            "wx:if": "{{profile && profile.status === 'available'}}"
          },
          {
            "wx:if": "{{showProfileDetails}}"
          }
        ]
      },
      {
        "tag": "button",
        "attrs": {
          "wx:if": "{{hasSession && !profile.isOwn}}",
          "class": "secondary",
          "bindtap": "onBlockProfile",
          "disabled": "{{busy || block.busy || block.frozen}}"
        },
        "scopes": [
          {
            "wx:if": "{{loaded && !busy && !block.busy && !block.frozen}}"
          },
          {
            "wx:if": "{{profile && profile.status === 'available'}}"
          },
          {
            "wx:if": "{{showProfileDetails}}"
          },
          {
            "wx:if": "{{hasSession && !profile.isOwn}}",
            "disabled": "{{busy || block.busy || block.frozen}}"
          }
        ]
      },
      {
        "tag": "view",
        "attrs": {
          "class": "chip {{tab === 'posts' ? 'active' : ''}}",
          "data-key": "posts",
          "bindtap": "onTab"
        },
        "scopes": [
          {
            "wx:if": "{{loaded && !busy && !block.busy && !block.frozen}}"
          },
          {
            "wx:if": "{{profile && profile.status === 'available'}}"
          },
          {
            "wx:if": "{{!profile.postsHidden}}"
          }
        ]
      },
      {
        "tag": "view",
        "attrs": {
          "class": "chip {{tab === 'trading' ? 'active' : ''}}",
          "data-key": "trading",
          "bindtap": "onTab"
        },
        "scopes": [
          {
            "wx:if": "{{loaded && !busy && !block.busy && !block.frozen}}"
          },
          {
            "wx:if": "{{profile && profile.status === 'available'}}"
          },
          {
            "wx:if": "{{!profile.postsHidden}}"
          }
        ]
      },
      {
        "tag": "view",
        "attrs": {
          "class": "chip {{!tradingSubtype ? 'active' : ''}}",
          "data-key": "",
          "bindtap": "onTradingSubtype"
        },
        "scopes": [
          {
            "wx:if": "{{loaded && !busy && !block.busy && !block.frozen}}"
          },
          {
            "wx:if": "{{profile && profile.status === 'available'}}"
          },
          {
            "wx:if": "{{!profile.postsHidden}}"
          },
          {
            "wx:if": "{{tab === 'trading'}}"
          }
        ]
      },
      {
        "tag": "view",
        "attrs": {
          "wx:for": "{{tradingCategories}}",
          "wx:key": "key",
          "class": "chip {{tradingSubtype === item.key ? 'active' : ''}}",
          "data-key": "{{item.key}}",
          "bindtap": "onTradingSubtype"
        },
        "scopes": [
          {
            "wx:if": "{{loaded && !busy && !block.busy && !block.frozen}}"
          },
          {
            "wx:if": "{{profile && profile.status === 'available'}}"
          },
          {
            "wx:if": "{{!profile.postsHidden}}"
          },
          {
            "wx:if": "{{tab === 'trading'}}"
          },
          {
            "wx:for": "{{tradingCategories}}",
            "wx:key": "key"
          }
        ]
      },
      {
        "tag": "button",
        "attrs": {
          "class": "profile-post-avatar",
          "aria-label": "查看公开身份头像",
          "data-id": "{{item.id}}",
          "bindtap": "onPostAvatar",
          "disabled": "{{busy || block.busy || block.frozen}}"
        },
        "scopes": [
          {
            "wx:if": "{{loaded && !busy && !block.busy && !block.frozen}}"
          },
          {
            "wx:if": "{{profile && profile.status === 'available'}}"
          },
          {
            "wx:if": "{{!profile.postsHidden}}"
          },
          {
            "wx:for": "{{items}}",
            "wx:key": "id"
          },
          {
            "wx:if": "{{item.author.kind === 'named'}}"
          },
          {
            "disabled": "{{busy || block.busy || block.frozen}}"
          }
        ]
      },
      {
        "tag": "navigator",
        "attrs": {
          "wx:if": "{{hasSession}}",
          "class": "link",
          "url": "/pages/community-detail/community-detail?postId={{item.id}}"
        },
        "scopes": [
          {
            "wx:if": "{{loaded && !busy && !block.busy && !block.frozen}}"
          },
          {
            "wx:if": "{{profile && profile.status === 'available'}}"
          },
          {
            "wx:if": "{{!profile.postsHidden}}"
          },
          {
            "wx:for": "{{items}}",
            "wx:key": "id"
          },
          {
            "wx:if": "{{hasSession}}"
          }
        ]
      },
      {
        "tag": "navigator",
        "attrs": {
          "class": "link",
          "url": "/pages/login/login",
          "wx:else": ""
        },
        "scopes": [
          {
            "wx:if": "{{loaded && !busy && !block.busy && !block.frozen}}"
          },
          {
            "wx:if": "{{profile && profile.status === 'available'}}"
          },
          {
            "wx:if": "{{!profile.postsHidden}}"
          },
          {
            "wx:for": "{{items}}",
            "wx:key": "id"
          },
          {
            "wx:else": ""
          }
        ]
      },
      {
        "tag": "button",
        "attrs": {
          "wx:if": "{{canPrevious}}",
          "bindtap": "onPrevious",
          "disabled": "{{busy}}"
        },
        "scopes": [
          {
            "wx:if": "{{loaded && !busy && !block.busy && !block.frozen}}"
          },
          {
            "wx:if": "{{profile && profile.status === 'available'}}"
          },
          {
            "wx:if": "{{!profile.postsHidden}}"
          },
          {
            "wx:if": "{{canPrevious}}",
            "disabled": "{{busy}}"
          }
        ]
      },
      {
        "tag": "button",
        "attrs": {
          "wx:if": "{{canLoadMore}}",
          "bindtap": "onMore",
          "disabled": "{{busy}}"
        },
        "scopes": [
          {
            "wx:if": "{{loaded && !busy && !block.busy && !block.frozen}}"
          },
          {
            "wx:if": "{{profile && profile.status === 'available'}}"
          },
          {
            "wx:if": "{{!profile.postsHidden}}"
          },
          {
            "wx:if": "{{canLoadMore}}",
            "disabled": "{{busy}}"
          }
        ]
      }
    ]
  },
  "src/pages/community-blocks/community-blocks.wxml": {
    "sourceSha256": "588eb18dd973c18759cfd538f42026b68968767fd8d084528432097961a016d7",
    "actions": [
      {
        "tag": "button",
        "attrs": {
          "class": "blocks-refresh",
          "bindtap": "onReload",
          "disabled": "{{busy || block.busy}}",
          "loading": "{{busy}}",
          "aria-label": "刷新拉黑列表"
        },
        "scopes": [
          {
            "disabled": "{{busy || block.busy}}",
            "loading": "{{busy}}"
          }
        ]
      },
      {
        "tag": "button",
        "attrs": {
          "wx:if": "{{busy}}",
          "class": "blocks-text-button",
          "bindtap": "onCancel"
        },
        "scopes": [
          {
            "wx:if": "{{busy}}"
          }
        ]
      },
      {
        "tag": "navigator",
        "attrs": {
          "wx:if": "{{!hasSession}}",
          "class": "blocks-login",
          "url": "/pages/login/login"
        },
        "scopes": [
          {
            "wx:if": "{{!hasSession}}"
          }
        ]
      },
      {
        "tag": "button",
        "attrs": {
          "class": "blocked-unblock",
          "data-id": "{{item.relationshipId}}",
          "bindtap": "onUnblock",
          "disabled": "{{busy || block.busy || block.frozen || !item.canUnblock}}",
          "loading": "{{block.busy && block.activeRelationshipId === item.relationshipId}}"
        },
        "scopes": [
          {
            "wx:for": "{{items}}",
            "wx:key": "relationshipId"
          },
          {
            "disabled": "{{busy || block.busy || block.frozen || !item.canUnblock}}",
            "loading": "{{block.busy && block.activeRelationshipId === item.relationshipId}}"
          }
        ]
      },
      {
        "tag": "button",
        "attrs": {
          "wx:if": "{{canLoadMore}}",
          "class": "blocks-text-button",
          "bindtap": "onMore",
          "disabled": "{{busy || block.busy}}"
        },
        "scopes": [
          {
            "wx:if": "{{canLoadMore}}",
            "disabled": "{{busy || block.busy}}"
          }
        ]
      },
      {
        "tag": "navigator",
        "attrs": {
          "class": "blocks-back",
          "url": "/pages/community-feed/community-feed"
        },
        "scopes": []
      }
    ]
  },
  "src/pages/experience/experience.wxml": {
    "sourceSha256": "f1ed002855c1b5e0e5707047a96d8734b455c1434bdd7536b778f50737ae0d07",
    "actions": [
      {
        "tag": "button",
        "attrs": {
          "wx:if": "{{busy}}",
          "class": "experience-refresh",
          "bindtap": "onCancel"
        },
        "scopes": [
          {
            "wx:if": "{{busy}}"
          }
        ]
      },
      {
        "tag": "button",
        "attrs": {
          "class": "experience-refresh",
          "bindtap": "onReload",
          "disabled": "{{!hasSession || !configured}}",
          "aria-label": "{{appearanceDirty ? '刷新并放弃未保存的选择' : '刷新经验状态'}}",
          "wx:else": ""
        },
        "scopes": [
          {
            "disabled": "{{!hasSession || !configured}}",
            "wx:else": ""
          }
        ]
      },
      {
        "tag": "navigator",
        "attrs": {
          "wx:if": "{{!hasSession}}",
          "class": "experience-link",
          "url": "/pages/login/login",
          "open-type": "reLaunch"
        },
        "scopes": [
          {
            "wx:if": "{{!hasSession}}"
          }
        ]
      },
      {
        "tag": "button",
        "attrs": {
          "class": "experience-text-button",
          "bindtap": "onRecover",
          "data-operation": "sign_in",
          "disabled": "{{busy}}"
        },
        "scopes": [
          {
            "wx:if": "{{signInPending}}"
          },
          {
            "disabled": "{{busy}}"
          }
        ]
      },
      {
        "tag": "button",
        "attrs": {
          "class": "experience-text-button",
          "bindtap": "onRecover",
          "data-operation": "sign_in",
          "data-retry": "{{true}}",
          "disabled": "{{busy}}"
        },
        "scopes": [
          {
            "wx:if": "{{signInPending}}"
          },
          {
            "disabled": "{{busy}}"
          }
        ]
      },
      {
        "tag": "button",
        "attrs": {
          "class": "experience-text-button",
          "bindtap": "onRecover",
          "data-operation": "appearance",
          "disabled": "{{busy}}"
        },
        "scopes": [
          {
            "wx:if": "{{appearancePending}}"
          },
          {
