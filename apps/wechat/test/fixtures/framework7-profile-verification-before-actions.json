        "scopes": [
          {
            "wx:if": "{{canApply}}"
          }
        ]
      },
      {
        "tag": "button",
        "attrs": {
          "class": "secondary",
          "bindtap": "onChooseEvidence",
          "disabled": "{{busy||pending}}"
        },
        "scopes": [
          {
            "wx:if": "{{application}}"
