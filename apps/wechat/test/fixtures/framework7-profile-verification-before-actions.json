        ]
      },
      {
        "tag": "picker",
        "attrs": {
          "class": "input detail-gender-picker",
          "range": "{{detailGenderLabels}}",
          "value": "{{details.gender === 'female' ? 1 : details.gender === 'male' ? 2 : 0}}",
          "bindchange": "onDetailsGender",
          "disabled": "{{details.busy || details.needsReload}}"
        },
        "scopes": [
          {
            "wx:if": "{{hasSession}}"
          },
