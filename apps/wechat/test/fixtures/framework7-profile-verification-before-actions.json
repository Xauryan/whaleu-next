        "scopes": [
          {
            "wx:if": "{{!hasSession}}"
          }
        ]
      },
      {
        "tag": "button",
        "attrs": {
          "class": "primary",
          "bindtap": "onRecover",
          "disabled": "{{busy}}"
        },
        "scopes": [
          {
            "wx:if": "{{pending}}"
          }
        ]
      },
      {
        "tag": "button",
        "attrs": {
          "class": "secondary",
          "bindtap": "onCancelRequest",
