          "data-id": "{{item.id}}",
          "bindtap": "onChooseCampus",
          "class": "choice {{selectedCampusId===item.id?'selected':''}}",
          "disabled": "{{busy||pending}}"
        },
        "scopes": [
          {
            "wx:if": "{{canApply}}"
