  "student-verification": {
    "sourceSha256": "14f5b347a03de8119a505e39f3867361738479ea4d84a328db0fa8d518c82ba6",
    "typescriptSha256": "a62dca3646c13cf4ff9f0f463190ad5c93396e1f6f50d8a4bab694ad5b08f413",
    "actions": [
      {
        "tag": "navigator",
        "attrs": {
          "wx:if": "{{!hasSession}}",
          "class": "text-link",
          "url": "/pages/login/login",
          "open-type": "reLaunch"
