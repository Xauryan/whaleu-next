{
  "src/pages/feedback/feedback.wxml": {
    "sourceSha256": "250230a2efd2a532cdb8fdf5a9e08f4bf2098dc5d3756763534ae2f05f76e068",
    "actions": [
      {
        "tag": "button",
        "attrs": {
          "class": "icon-button",
          "bindtap": "onRefresh",
          "disabled": "{{busy}}",
          "loading": "{{busy}}",
          "aria-label": "刷新意见列表"
        },
        "scopes": [
          {
            "disabled": "{{busy}}",
            "loading": "{{busy}}"
          }
        ]
      },
      {
        "tag": "navigator",
        "attrs": {
          "wx:if": "{{space && hasSession}}",
          "class": "primary compose-entry",
          "url": "/pages/community-compose/community-compose?spaceId={{space.id}}&category=feedback"
        },
        "scopes": [
          {
            "wx:if": "{{space && hasSession}}"
          }
        ]
      },
      {
        "tag": "navigator",
        "attrs": {
          "wx:if": "{{!hasSession}}",
          "class": "primary",
          "url": "/pages/login/login"
        },
        "scopes": [
          {
            "wx:if": "{{!hasSession}}"
          }
        ]
      },
      {
        "tag": "button",
        "attrs": {
          "wx:if": "{{busy}}",
          "class": "quiet",
          "bindtap": "onCancel"
        },
        "scopes": [
          {
            "wx:if": "{{busy}}"
          }
        ]
      },
      {
        "tag": "navigator",
        "attrs": {
          "wx:if": "{{hasSession}}",
          "class": "detail-link",
          "url": "/pages/community-detail/community-detail?postId={{item.id}}"
        },
        "scopes": [
          {
            "wx:for": "{{posts}}",
            "wx:key": "id"
          },
          {
            "wx:if": "{{hasSession}}"
          }
        ]
      },
      {
        "tag": "button",
        "attrs": {
          "wx:if": "{{canLoadMore}}",
          "class": "quiet",
          "bindtap": "onMore",
          "disabled": "{{busy}}"
        },
        "scopes": [
          {
            "wx:if": "{{canLoadMore}}",
            "disabled": "{{busy}}"
          }
        ]
      },
      {
        "tag": "navigator",
        "attrs": {
          "wx:if": "{{continuation === 'phone_verification_required'}}",
          "class": "link-row",
          "url": "/pages/phone-binding/phone-binding"
        },
        "scopes": [
          {
            "wx:if": "{{continuation === 'phone_verification_required'}}"
          }
        ]
      }
    ]
  },
