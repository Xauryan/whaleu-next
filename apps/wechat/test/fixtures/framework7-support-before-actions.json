        "scopes": [
          {
            "wx:if": "{{nextCursor}}",
            "disabled": "{{busy || frozen}}"
          }
        ]
      },
      {
        "tag": "button",
        "attrs": {
          "class": "quiet",
          "bindtap": "onReload",
          "disabled": "{{busy}}",
          "loading": "{{busy}}"
        },
        "scopes": [
          {
            "disabled": "{{busy}}",
            "loading": "{{busy}}"
          }
        ]
      },
      {
