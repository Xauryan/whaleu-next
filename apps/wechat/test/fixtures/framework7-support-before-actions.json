          "bindtap": "onSelectAppeal",
          "disabled": "{{busy || frozen}}"
        },
        "scopes": [
          {
            "wx:for": "{{appeals}}",
            "wx:key": "appealId"
          },
          {
            "disabled": "{{busy || frozen}}"
