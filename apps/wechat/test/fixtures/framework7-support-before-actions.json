  "src/pages/report-progress/report-progress.wxml": {
    "sourceSha256": "3b9c4320a5e874d3cd50ae654bfd6d88aac830e8c5c3d30fa8f2764de4e3fbfd",
    "actions": [
      {
        "tag": "button",
        "attrs": {
          "class": "icon-button",
          "bindtap": "onReloadReportProgress",
          "disabled": "{{reportProgress.busy}}",
          "aria-label": "刷新进度"
        },
        "scopes": [
          {
            "wx:if": "{{hasTarget}}"
          },
          {
            "wx:if": "{{reportProgress.loaded && reportProgress.progress}}"
          },
          {
            "disabled": "{{reportProgress.busy}}"
          }
        ]
      },
      {
        "tag": "button",
        "attrs": {
          "class": "primary",
          "data-vote": "keep",
          "bindtap": "onJuryChoice",
          "disabled": "{{juryVote.busy || juryVote.frozen}}"
        },
        "scopes": [
          {
            "wx:if": "{{hasTarget}}"
          },
          {
            "wx:if": "{{reportProgress.loaded && reportProgress.progress}}"
          },
          {
            "wx:if": "{{reportProgress.progress.kind === 'post'}}"
          },
          {
            "wx:else": ""
          },
          {
            "wx:if": "{{reportProgress.canVote}}"
          },
          {
            "disabled": "{{juryVote.busy || juryVote.frozen}}"
          }
        ]
      },
      {
        "tag": "button",
        "attrs": {
          "class": "secondary",
          "data-vote": "remove",
          "bindtap": "onJuryChoice",
          "disabled": "{{juryVote.busy || juryVote.frozen}}"
        },
        "scopes": [
          {
            "wx:if": "{{hasTarget}}"
          },
          {
            "wx:if": "{{reportProgress.loaded && reportProgress.progress}}"
          },
          {
            "wx:if": "{{reportProgress.progress.kind === 'post'}}"
          },
          {
            "wx:else": ""
          },
          {
            "wx:if": "{{reportProgress.canVote}}"
          },
          {
            "disabled": "{{juryVote.busy || juryVote.frozen}}"
          }
        ]
      },
      {
        "tag": "button",
        "attrs": {
          "class": "primary",
          "bindtap": "onReloadReportProgress",
          "disabled": "{{reportProgress.busy}}"
        },
        "scopes": [
          {
            "wx:if": "{{hasTarget}}"
          },
          {
            "wx:else": ""
          },
          {
            "disabled": "{{reportProgress.busy}}"
          }
        ]
      },
      {
        "tag": "button",
        "attrs": {
          "wx:if": "{{reportProgress.busy}}",
          "class": "quiet",
          "bindtap": "onCancelReportProgress"
        },
        "scopes": [
          {
            "wx:if": "{{hasTarget}}"
          },
          {
            "wx:if": "{{reportProgress.busy}}"
          }
        ]
      },
      {
        "tag": "button",
        "attrs": {
          "wx:if": "{{reportProgress.loaded && !reportProgress.progress.isSelf}}",
          "class": "secondary",
          "bindtap": "onReport",
          "disabled": "{{!reportProgress.canReport || report.busy || report.frozen}}"
        },
        "scopes": [
          {
            "wx:if": "{{hasTarget}}"
          },
          {
            "wx:if": "{{reportProgress.loaded && !reportProgress.progress.isSelf}}",
            "disabled": "{{!reportProgress.canReport || report.busy || report.frozen}}"
          }
        ]
      },
      {
        "tag": "button",
        "attrs": {
          "class": "quiet",
          "bindtap": "onReloadRecovery",
          "disabled": "{{report.busy || juryVote.busy}}"
        },
        "scopes": [
          {
            "disabled": "{{report.busy || juryVote.busy}}"
          }
        ]
      },
      {
        "tag": "navigator",
        "attrs": {
          "wx:if": "{{!report.hasSession}}",
          "class": "primary",
          "url": "/pages/login/login"
        },
        "scopes": [
          {
            "wx:if": "{{!report.hasSession}}"
          }
        ]
      },
      {
        "tag": "navigator",
        "attrs": {
          "class": "link-row",
          "url": "/pages/system-notices/system-notices"
        },
        "scopes": []
      },
      {
        "tag": "navigator",
        "attrs": {
          "class": "link-row",
          "url": "/pages/community-feed/community-feed"
        },
        "scopes": []
      }
    ]
  },
  "src/pages/account-status/account-status.wxml": {
    "sourceSha256": "c3753326317e49cdd34e1b9c7dba6e40e1d0db8f6e603a65322d5a212a6ac7f4",
    "actions": [
      {
        "tag": "navigator",
        "attrs": {
          "wx:if": "{{!hasSession}}",
          "class": "primary",
          "url": "/pages/login/login"
        },
        "scopes": [
          {
            "wx:if": "{{!hasSession}}"
          }
        ]
      },
      {
        "tag": "button",
        "attrs": {
          "class": "{{accountStatus ? 'quiet' : 'primary'}}",
          "bindtap": "onReload",
          "disabled": "{{busy}}",
          "loading": "{{busy}}"
        },
        "scopes": [
          {
            "disabled": "{{busy}}",
            "loading": "{{busy}}"
          }
        ]
      },
      {
        "tag": "button",
        "attrs": {
          "wx:if": "{{busy}}",
          "class": "quiet",
          "bindtap": "onStopWaiting"
        },
        "scopes": [
          {
            "wx:if": "{{busy}}"
          }
        ]
      },
      {
        "tag": "navigator",
        "attrs": {
          "wx:if": "{{item.canAppeal}}",
          "class": "link-row",
          "url": "/pages/safety-appeal/safety-appeal?punishmentId={{item.punishmentId}}"
        },
        "scopes": [
          {
            "wx:if": "{{mode === 'status' && accountStatus}}"
          },
          {
            "wx:for": "{{accountStatus.current}}",
            "wx:key": "punishmentId"
          },
          {
            "wx:if": "{{item.canAppeal}}"
          }
        ]
      },
      {
        "tag": "navigator",
        "attrs": {
          "wx:if": "{{item.openAppealId}}",
          "class": "link-row",
          "url": "/pages/safety-appeal/safety-appeal?appealId={{item.openAppealId}}"
        },
        "scopes": [
          {
            "wx:if": "{{mode === 'status' && accountStatus}}"
          },
          {
            "wx:for": "{{accountStatus.current}}",
            "wx:key": "punishmentId"
          },
          {
            "wx:if": "{{item.openAppealId}}"
          }
        ]
      },
      {
        "tag": "button",
        "attrs": {
          "class": "quiet",
          "bindtap": "onHistory",
          "disabled": "{{busy || frozen}}"
        },
        "scopes": [
          {
            "wx:if": "{{mode === 'status' && accountStatus}}"
          },
          {
            "disabled": "{{busy || frozen}}"
          }
        ]
      },
      {
        "tag": "button",
        "attrs": {
          "wx:if": "{{historyCursor}}",
          "class": "quiet",
          "bindtap": "onMoreHistory",
          "disabled": "{{busy || frozen}}"
        },
        "scopes": [
          {
            "wx:if": "{{historyCursor}}",
            "disabled": "{{busy || frozen}}"
          }
        ]
      },
      {
        "tag": "navigator",
        "attrs": {
          "class": "link-row",
          "url": "/pages/system-notices/system-notices"
        },
        "scopes": []
      },
      {
        "tag": "navigator",
        "attrs": {
          "class": "link-row",
          "url": "/pages/safety-appeal/safety-appeal"
        },
        "scopes": []
      }
    ]
  },
  "src/pages/account-status/recovery.wxml": {
