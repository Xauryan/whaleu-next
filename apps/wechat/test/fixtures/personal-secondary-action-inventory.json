{
  "public-profile": [
    {
      "tag": "button",
      "attrs": {
        "bindtap": "onReload",
        "disabled": "{{busy}}",
        "loading": "{{busy}}"
      },
      "scopes": []
    },
    {
      "tag": "button",
      "attrs": {
        "bindtap": "onCancel"
      },
      "scopes": [
        {
          "wx:if": "{{busy}}"
        }
      ]
    },
    {
      "tag": "navigator",
      "attrs": {
        "url": "/pages/profile/profile"
      },
      "scopes": [
        {
          "wx:if": "{{selfEntry || profile && profile.isOwn}}"
        }
      ]
    },
    {
      "tag": "navigator",
      "attrs": {
        "url": "/pages/community-mine/community-mine"
      },
      "scopes": [
        {
          "wx:if": "{{selfEntry || profile && profile.isOwn}}"
        }
      ]
    },
    {
      "tag": "navigator",
      "attrs": {
        "url": "/pages/community-liked/community-liked"
      },
      "scopes": [
        {
          "wx:if": "{{selfEntry || profile && profile.isOwn}}"
        }
      ]
    },
    {
      "tag": "navigator",
      "attrs": {
        "url": "/pages/community-saved/community-saved"
      },
      "scopes": [
        {
          "wx:if": "{{selfEntry || profile && profile.isOwn}}"
        }
      ]
    },
    {
      "tag": "button",
      "attrs": {
        "bindtap": "onUnblockProfile",
        "disabled": "{{busy || block.busy || block.frozen}}"
      },
      "scopes": [
        {
          "wx:if": "{{profile && profile.status === 'blocked_by_you'}}"
        }
      ]
    },
    {
      "tag": "button",
      "attrs": {
        "bindtap": "onFollowRetry",
        "disabled": "{{busy || block.busy || block.frozen || follow.busy}}"
      },
      "scopes": [
        {
          "wx:if": "{{loaded && profile && profile.status !== 'available' && follow.frozen}}"
        },
        {
          "wx:if": "{{follow.recoveryProfileId === profile.profileId}}"
        }
      ]
    },
    {
      "tag": "navigator",
      "attrs": {
        "url": "/pages/public-profile/public-profile?profileId={{follow.recoveryProfileId}}"
      },
      "scopes": [
        {
          "wx:if": "{{loaded && profile && profile.status !== 'available' && follow.frozen}}"
        },
        {
          "wx:elif": "{{follow.recoveryProfileId}}"
        }
      ]
    },
    {
      "tag": "button",
      "attrs": {
        "bindtap": "onFollowCancel"
      },
      "scopes": [
        {
          "wx:if": "{{loaded && profile && profile.status !== 'available' && follow.frozen}}"
        },
        {
          "wx:if": "{{follow.busy}}"
        }
      ]
    },
    {
      "tag": "image",
      "attrs": {
        "binderror": "onCoverError",
        "show-menu-by-longpress": "{{false}}"
      },
      "scopes": [
        {
          "wx:if": "{{profile && profile.status === 'available'}}"
        },
        {
          "wx:if": "{{coverRead.localSrc}}"
        }
      ]
    },
    {
      "tag": "image",
      "attrs": {
        "bindtap": "onOpenAvatar",
        "binderror": "onAvatarError",
        "show-menu-by-longpress": "{{false}}"
      },
      "scopes": [
        {
          "wx:if": "{{profile && profile.status === 'available'}}"
        },
        {
          "wx:if": "{{avatarRead.localSrc}}"
        }
      ]
    },
    {
      "tag": "button",
      "attrs": {
        "bindtap": "onFollow",
        "disabled": "{{busy || block.busy || block.frozen || follow.busy || follow.frozen || follow.following === null}}",
        "loading": "{{follow.busy}}"
      },
      "scopes": [
        {
          "wx:if": "{{profile && profile.status === 'available'}}"
        },
        {
          "wx:if": "{{!profile.isOwn}}"
        },
        {
          "wx:if": "{{hasSession}}"
        }
      ]
    },
    {
      "tag": "navigator",
      "attrs": {
        "url": "/pages/login/login"
      },
      "scopes": [
        {
          "wx:if": "{{profile && profile.status === 'available'}}"
        },
        {
          "wx:if": "{{!profile.isOwn}}"
        },
        {
          "wx:else": ""
        }
      ]
    },
    {
      "tag": "button",
      "attrs": {
        "bindtap": "onPrivateMessage",
        "disabled": "{{busy || block.busy || block.frozen}}"
      },
      "scopes": [
        {
          "wx:if": "{{profile && profile.status === 'available'}}"
        },
        {
          "wx:if": "{{!profile.isOwn}}"
        }
      ]
    },
    {
      "tag": "button",
      "attrs": {
        "bindtap": "onFollowRetry",
        "disabled": "{{busy || block.busy || block.frozen || follow.busy}}"
      },
      "scopes": [
        {
          "wx:if": "{{profile && profile.status === 'available'}}"
        },
        {
          "wx:if": "{{follow.frozen}}"
        },
        {
          "wx:if": "{{follow.recoveryProfileId === profile.profileId}}"
        }
      ]
    },
    {
      "tag": "navigator",
      "attrs": {
        "url": "/pages/public-profile/public-profile?profileId={{follow.recoveryProfileId}}"
      },
      "scopes": [
        {
          "wx:if": "{{profile && profile.status === 'available'}}"
        },
        {
          "wx:if": "{{follow.frozen}}"
        },
        {
          "wx:elif": "{{follow.recoveryProfileId}}"
        }
      ]
    },
    {
      "tag": "button",
      "attrs": {
        "bindtap": "onFollowReload",
        "disabled": "{{busy || block.busy || block.frozen}}"
      },
      "scopes": [
        {
          "wx:if": "{{profile && profile.status === 'available'}}"
        },
        {
          "wx:if": "{{hasSession && !profile.isOwn && !follow.busy && !follow.frozen && follow.following === null}}"
        }
      ]
    },
    {
      "tag": "button",
      "attrs": {
        "bindtap": "onFollowCancel"
      },
      "scopes": [
        {
          "wx:if": "{{profile && profile.status === 'available'}}"
        },
        {
          "wx:if": "{{follow.busy}}"
        }
      ]
    },
    {
      "tag": "image",
      "attrs": {
        "binderror": "onAvatarError",
        "show-menu-by-longpress": "{{false}}"
      },
      "scopes": [
        {
          "wx:if": "{{profile && profile.status === 'available'}}"
        },
        {
          "wx:if": "{{avatarRead.expanded && avatarRead.localSrc}}"
        }
      ]
    },
    {
      "tag": "button",
      "attrs": {
        "bindtap": "onCloseAvatar"
      },
      "scopes": [
        {
          "wx:if": "{{profile && profile.status === 'available'}}"
        },
        {
          "wx:if": "{{avatarRead.expanded && avatarRead.localSrc}}"
        }
      ]
    },
    {
      "tag": "button",
      "attrs": {
        "bindtap": "onProfileDetails"
      },
      "scopes": [
        {
          "wx:if": "{{profile && profile.status === 'available'}}"
        }
      ]
    },
    {
      "tag": "navigator",
      "attrs": {
        "url": "/pages/school-identity-management/school-identity-management?targetProfileId={{profile.profileId}}"
      },
      "scopes": [
        {
          "wx:if": "{{profile && profile.status === 'available'}}"
        },
        {
          "wx:if": "{{showProfileDetails}}"
        }
      ]
    },
    {
      "tag": "navigator",
      "attrs": {
        "url": "/pages/school-admin-management/school-admin-management?targetProfileId={{profile.profileId}}"
      },
      "scopes": [
        {
          "wx:if": "{{profile && profile.status === 'available'}}"
        },
        {
          "wx:if": "{{showProfileDetails}}"
        }
      ]
    },
    {
      "tag": "button",
      "attrs": {
        "bindtap": "onBlockProfile",
        "disabled": "{{busy || block.busy || block.frozen}}"
      },
      "scopes": [
        {
          "wx:if": "{{profile && profile.status === 'available'}}"
        },
        {
          "wx:if": "{{showProfileDetails}}"
        },
        {
          "wx:if": "{{hasSession && !profile.isOwn}}"
        }
      ]
    },
    {
      "tag": "view",
      "attrs": {
        "data-key": "posts",
        "bindtap": "onTab"
      },
      "scopes": [
        {
          "wx:if": "{{profile && profile.status === 'available'}}"
        },
        {
          "wx:if": "{{!profile.postsHidden}}"
        }
      ]
    },
    {
      "tag": "view",
      "attrs": {
        "data-key": "trading",
        "bindtap": "onTab"
      },
      "scopes": [
        {
          "wx:if": "{{profile && profile.status === 'available'}}"
        },
        {
          "wx:if": "{{!profile.postsHidden}}"
        }
      ]
    },
    {
      "tag": "view",
      "attrs": {
        "data-key": "",
        "bindtap": "onTradingSubtype"
      },
      "scopes": [
        {
          "wx:if": "{{profile && profile.status === 'available'}}"
        },
        {
          "wx:if": "{{!profile.postsHidden}}"
        },
        {
          "wx:if": "{{tab === 'trading'}}"
        }
      ]
    },
    {
      "tag": "view",
      "attrs": {
        "data-key": "{{item.key}}",
        "bindtap": "onTradingSubtype"
      },
      "scopes": [
        {
          "wx:if": "{{profile && profile.status === 'available'}}"
        },
        {
          "wx:if": "{{!profile.postsHidden}}"
        },
        {
          "wx:if": "{{tab === 'trading'}}"
        },
        {
          "wx:for": "{{tradingCategories}}",
          "wx:key": "key"
        }
      ]
    },
    {
      "tag": "button",
      "attrs": {
        "data-id": "{{item.id}}",
        "bindtap": "onPostAvatar",
        "disabled": "{{busy || block.busy || block.frozen}}"
      },
      "scopes": [
        {
          "wx:if": "{{profile && profile.status === 'available'}}"
        },
        {
          "wx:if": "{{!profile.postsHidden}}"
        },
        {
          "wx:for": "{{items}}",
          "wx:key": "id"
        },
        {
          "wx:if": "{{item.author.kind === 'named'}}"
        }
      ]
    },
    {
      "tag": "navigator",
      "attrs": {
        "url": "/pages/community-detail/community-detail?postId={{item.id}}"
      },
      "scopes": [
        {
          "wx:if": "{{profile && profile.status === 'available'}}"
        },
        {
          "wx:if": "{{!profile.postsHidden}}"
        },
        {
          "wx:for": "{{items}}",
          "wx:key": "id"
        },
        {
          "wx:if": "{{hasSession}}"
        }
      ]
    },
    {
      "tag": "navigator",
      "attrs": {
        "url": "/pages/login/login"
      },
      "scopes": [
        {
          "wx:if": "{{profile && profile.status === 'available'}}"
        },
        {
          "wx:if": "{{!profile.postsHidden}}"
        },
        {
          "wx:for": "{{items}}",
          "wx:key": "id"
        },
        {
          "wx:else": ""
        }
      ]
    },
    {
      "tag": "button",
      "attrs": {
        "bindtap": "onPrevious",
        "disabled": "{{busy}}"
      },
      "scopes": [
        {
          "wx:if": "{{profile && profile.status === 'available'}}"
        },
        {
          "wx:if": "{{!profile.postsHidden}}"
        },
        {
          "wx:if": "{{canPrevious}}"
        }
      ]
    },
    {
      "tag": "button",
      "attrs": {
        "bindtap": "onMore",
        "disabled": "{{busy}}"
      },
      "scopes": [
        {
          "wx:if": "{{profile && profile.status === 'available'}}"
        },
        {
          "wx:if": "{{!profile.postsHidden}}"
        },
        {
          "wx:if": "{{canLoadMore}}"
        }
      ]
    }
  ],
  "community-blocks": [
    {
      "tag": "button",
      "attrs": {
        "bindtap": "onReload",
        "disabled": "{{busy || block.busy}}",
        "loading": "{{busy}}"
      },
      "scopes": []
    },
    {
      "tag": "button",
      "attrs": {
        "bindtap": "onCancel"
      },
      "scopes": [
        {
          "wx:if": "{{busy}}"
        }
      ]
    },
    {
      "tag": "navigator",
      "attrs": {
        "url": "/pages/login/login"
      },
      "scopes": [
        {
          "wx:if": "{{!hasSession}}"
        }
      ]
    },
    {
      "tag": "button",
      "attrs": {
        "data-id": "{{item.relationshipId}}",
        "bindtap": "onUnblock",
        "disabled": "{{busy || block.busy || block.frozen || !item.canUnblock}}",
        "loading": "{{block.busy && block.activeRelationshipId === item.relationshipId}}"
      },
      "scopes": [
        {
          "wx:for": "{{items}}",
          "wx:key": "relationshipId"
        }
      ]
    },
    {
      "tag": "button",
      "attrs": {
        "bindtap": "onMore",
        "disabled": "{{busy || block.busy}}"
      },
      "scopes": [
        {
          "wx:if": "{{canLoadMore}}"
        }
      ]
    },
    {
      "tag": "navigator",
      "attrs": {
        "url": "/pages/community-feed/community-feed"
      },
      "scopes": []
    }
  ],
  "browsing-history": [
    {
      "tag": "button",
      "attrs": {
        "bindtap": "onReload",
        "disabled": "{{busy}}",
        "loading": "{{busy}}"
      },
      "scopes": []
    },
    {
      "tag": "button",
      "attrs": {
        "bindtap": "onRequestClear",
        "disabled": "{{busy || !hasSession}}"
      },
      "scopes": []
    },
    {
      "tag": "navigator",
      "attrs": {
        "url": "/pages/login/login"
      },
      "scopes": [
        {
          "wx:if": "{{!hasSession}}"
        }
      ]
    },
    {
      "tag": "button",
      "attrs": {
        "data-id": "{{item.postId}}",
        "bindtap": "onOpen",
        "disabled": "{{busy}}"
      },
      "scopes": [
        {
          "wx:for": "{{items}}",
          "wx:key": "postId"
        }
      ]
    },
    {
      "tag": "button",
      "attrs": {
        "bindtap": "onPrevious",
        "disabled": "{{busy}}"
      },
      "scopes": [
        {
          "wx:if": "{{loaded}}"
        },
        {
          "wx:if": "{{canPrevious}}"
        }
      ]
    },
    {
      "tag": "button",
      "attrs": {
        "bindtap": "onMore",
        "disabled": "{{busy}}"
      },
      "scopes": [
        {
          "wx:if": "{{loaded}}"
        },
        {
          "wx:if": "{{canMore}}"
        }
      ]
    },
    {
      "tag": "button",
      "attrs": {
        "bindtap": "onDismissClear"
      },
      "scopes": [
        {
          "wx:if": "{{confirmClear}}"
        }
      ]
    },
    {
      "tag": "button",
      "attrs": {
        "bindtap": "onConfirmClear"
      },
      "scopes": [
        {
          "wx:if": "{{confirmClear}}"
        }
      ]
    }
  ],
  "experience": [
    {
      "tag": "navigator",
      "attrs": {
        "url": "/pages/experience-ranking/experience-ranking"
      },
      "scopes": [
        {
          "wx:if": "{{!busy}}"
        }
      ]
    },
    {
      "tag": "button",
      "attrs": {
        "bindtap": "onCancel"
      },
      "scopes": [
        {
          "wx:if": "{{busy}}"
        }
      ]
    },
    {
      "tag": "button",
      "attrs": {
        "bindtap": "onReload",
        "disabled": "{{!hasSession || !configured}}"
      },
      "scopes": [
        {
          "wx:else": ""
        }
      ]
    },
    {
      "tag": "navigator",
      "attrs": {
        "url": "/pages/login/login",
        "open-type": "reLaunch"
      },
      "scopes": [
        {
          "wx:if": "{{!hasSession}}"
        }
      ]
    },
    {
      "tag": "button",
      "attrs": {
        "bindtap": "onRecover",
        "data-operation": "sign_in",
        "disabled": "{{busy}}"
      },
      "scopes": [
        {
          "wx:if": "{{signInPending}}"
        }
      ]
    },
    {
      "tag": "button",
      "attrs": {
        "bindtap": "onRecover",
        "data-operation": "sign_in",
        "data-retry": "{{true}}",
        "disabled": "{{busy}}"
      },
      "scopes": [
        {
          "wx:if": "{{signInPending}}"
        }
      ]
    },
    {
      "tag": "button",
      "attrs": {
        "bindtap": "onRecover",
        "data-operation": "appearance",
        "disabled": "{{busy}}"
      },
      "scopes": [
        {
          "wx:if": "{{appearancePending}}"
        }
      ]
    },
    {
      "tag": "button",
      "attrs": {
        "bindtap": "onRecover",
        "data-operation": "appearance",
        "data-retry": "{{true}}",
        "disabled": "{{busy}}"
      },
      "scopes": [
        {
          "wx:if": "{{appearancePending}}"
        }
      ]
    },
    {
      "tag": "input",
      "attrs": {
        "value": "{{redemptionCode}}",
        "bindinput": "onRedemptionInput",
        "password": "{{true}}",
        "maxlength": "128",
        "disabled": "{{busy}}"
      },
      "scopes": [
        {
          "wx:if": "{{hasSession}}"
        },
        {
          "wx:if": "{{redemptionStatus === 'available'}}"
        }
      ]
    },
    {
      "tag": "button",
      "attrs": {
        "bindtap": "onRedeemTitle",
        "disabled": "{{busy || !redemptionCode}}"
      },
      "scopes": [
        {
          "wx:if": "{{hasSession}}"
        },
        {
          "wx:if": "{{redemptionStatus === 'available'}}"
        },
        {
          "wx:if": "{{!redemptionPending}}"
        }
      ]
    },
    {
      "tag": "button",
      "attrs": {
        "bindtap": "onRecoverRedemption",
        "disabled": "{{busy}}"
      },
      "scopes": [
        {
          "wx:if": "{{hasSession}}"
        },
        {
          "wx:if": "{{redemptionPending}}"
        }
      ]
    },
    {
      "tag": "button",
      "attrs": {
        "bindtap": "onRetryRedemption",
        "disabled": "{{busy || !redemptionCode}}"
      },
      "scopes": [
        {
          "wx:if": "{{hasSession}}"
        },
        {
          "wx:if": "{{redemptionPending}}"
        },
        {
          "wx:if": "{{redemptionStatus === 'available'}}"
        }
      ]
    },
    {
      "tag": "button",
      "attrs": {
        "bindtap": "onSignIn",
        "disabled": "{{busy || signInPending || summary.signIn.signedIn === true}}"
      },
      "scopes": [
        {
          "wx:if": "{{loaded}}"
        }
      ]
    },
    {
      "tag": "button",
      "attrs": {
        "bindtap": "onCloseUnlock",
        "data-id": "{{item.noticeId}}",
        "disabled": "{{busy}}"
      },
      "scopes": [
        {
          "wx:if": "{{loaded}}"
        },
        {
          "wx:for": "{{unlocks}}",
          "wx:key": "noticeId"
        }
      ]
    },
    {
      "tag": "button",
      "attrs": {
        "bindtap": "onCloseUnlock",
        "data-id": "{{item}}",
        "disabled": "{{busy}}"
      },
      "scopes": [
        {
          "wx:if": "{{loaded}}"
        },
        {
          "wx:for": "{{acknowledgementIds}}",
          "wx:key": "*this"
        }
      ]
    },
    {
      "tag": "button",
      "attrs": {
        "bindtap": "onToggleTitleRules"
      },
      "scopes": [
        {
          "wx:if": "{{loaded}}"
        }
      ]
    },
    {
      "tag": "button",
      "attrs": {
        "bindtap": "onTitle",
        "data-key": "",
        "disabled": "{{busy || appearancePending}}"
      },
      "scopes": [
        {
          "wx:if": "{{loaded}}"
        }
      ]
    },
    {
      "tag": "button",
      "attrs": {
        "bindtap": "onTitle",
        "data-key": "{{item.key}}",
        "disabled": "{{busy || appearancePending}}"
      },
      "scopes": [
        {
          "wx:if": "{{loaded}}"
        },
        {
          "wx:for": "{{titleGroups}}",
          "wx:key": "label",
          "wx:for-item": "group"
        },
        {
          "wx:for": "{{group.titles}}",
          "wx:key": "key"
        }
      ]
    },
    {
      "tag": "button",
      "attrs": {
        "bindtap": "onColor",
        "data-id": "",
        "disabled": "{{busy || appearancePending}}"
      },
      "scopes": [
        {
          "wx:if": "{{loaded}}"
        }
      ]
    },
    {
      "tag": "button",
      "attrs": {
        "bindtap": "onColor",
        "data-id": "{{item.id}}",
        "disabled": "{{busy || appearancePending || !item.selectable}}"
      },
      "scopes": [
        {
          "wx:if": "{{loaded}}"
        },
        {
          "wx:for": "{{colors}}",
          "wx:key": "id"
        }
      ]
    },
    {
      "tag": "button",
      "attrs": {
        "bindtap": "onSave",
        "disabled": "{{busy || appearancePending || !appearanceDirty}}"
      },
      "scopes": [
        {
          "wx:if": "{{loaded}}"
        }
      ]
    },
    {
      "tag": "button",
      "attrs": {
        "bindtap": "onCancelSelection",
        "disabled": "{{busy || appearancePending || !appearanceDirty}}"
      },
      "scopes": [
        {
          "wx:if": "{{loaded}}"
        }
      ]
    },
    {
      "tag": "button",
      "attrs": {
        "bindtap": "onMore",
        "disabled": "{{busy}}"
      },
      "scopes": [
        {
          "wx:if": "{{loaded}}"
        },
        {
          "wx:if": "{{hasMore}}"
        }
      ]
    }
  ],
  "experience-ranking": [
    {
      "tag": "button",
      "attrs": {
        "bindtap": "onRefresh"
      },
      "scopes": []
    },
    {
      "tag": "button",
      "attrs": {
        "bindtap": "onCancel"
      },
      "scopes": [
