        }
      ]
    },
    {
      "tag": "button",
      "attrs": {
        "bindtap": "onProfile",
        "data-profile-id": "{{item.profileId}}",
        "disabled": "{{busy || !loaded}}"
      },
      "scopes": [
        {
          "wx:for": "{{items}}",
          "wx:key": "profileId"
        }
      ]
    }
  ],
  "wallet": []
}
