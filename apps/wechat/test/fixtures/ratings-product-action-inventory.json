      "tag": "button",
      "attrs": {
        "bindtap": "onConfirmScore",
        "disabled": "{{busy || frozen}}",
        "loading": "{{busy}}"
      }
    },
    {
      "tag": "button",
      "attrs": {
        "bindtap": "onDismissScore"
      }
    },
    {
      "tag": "button",
      "attrs": {
        "wx:for": "{{detail.allowedActions.authorModes}}",
        "wx:key": "*this",
        "data-mode": "{{item}}",
