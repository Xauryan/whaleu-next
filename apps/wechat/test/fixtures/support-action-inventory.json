        "ancestors": [
          {
            "tag": "template",
            "name": "account-moderation"
          },
          {
            "tag": "view",
            "wx:for": "{{punishments}}",
            "wx:key": "punishmentId"
          }
        ]
      },
      {
        "tag": "button",
        "attrs": {
          "data-id": "{{item.appealId}}",
          "bindtap": "onSelectAppeal",
          "disabled": "{{busy || frozen}}"
        },
        "ancestors": [
          {
            "tag": "template",
            "name": "account-moderation"
          },
          {
            "tag": "view",
            "wx:for": "{{appeals}}",
            "wx:key": "appealId"
          }
        ]
      },
      {
        "tag": "button",
        "attrs": {
          "wx:if": "{{nextCursor}}",
          "bindtap": "onMore",
          "disabled": "{{busy || frozen}}"
        },
        "ancestors": [
          {
            "tag": "template",
            "name": "account-moderation"
          }
        ]
      },
      {
        "tag": "textarea",
        "attrs": {
          "maxlength": "4000",
          "bindinput": "onText",
          "disabled": "{{busy || frozen}}"
        },
        "ancestors": [
          {
            "tag": "template",
            "name": "account-moderation"
          },
          {
            "tag": "view",
            "wx:if": "{{selectedPunishment}}"
          },
          {
            "tag": "view",
            "wx:if": "{{mode === 'appeal' && selectedPunishment.canAppeal}}"
          }
        ]
      },
      {
        "tag": "button",
        "attrs": {
          "bindtap": "onRequestAppeal",
          "disabled": "{{busy || frozen || !text}}"
        },
        "ancestors": [
          {
            "tag": "template",
            "name": "account-moderation"
          },
          {
            "tag": "view",
            "wx:if": "{{selectedPunishment}}"
          },
          {
            "tag": "view",
            "wx:if": "{{mode === 'appeal' && selectedPunishment.canAppeal}}"
