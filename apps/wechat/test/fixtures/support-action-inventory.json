    "account-moderation/screen.wxml": [
      {
        "tag": "navigator",
        "attrs": {
          "wx:if": "{{!hasSession}}",
          "url": "/pages/login/login"
        },
        "ancestors": [
          {
            "tag": "template",
            "name": "account-moderation"
          }
        ]
      },
      {
        "tag": "button",
        "attrs": {
          "bindtap": "onReload",
