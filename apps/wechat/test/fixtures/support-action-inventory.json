      {
        "tag": "navigator",
        "attrs": {
          "url": "/pages/verification/verification"
        },
        "ancestors": []
      }
    ],
    "community/report-progress.wxml": [
      {
        "tag": "button",
        "attrs": {
          "bindtap": "onReloadReportProgress",
          "disabled": "{{reportProgress.busy}}"
        },
        "ancestors": [
          {
            "tag": "template",
            "name": "report-progress"
          }
        ]
      },
      {
        "tag": "button",
        "attrs": {
          "wx:if": "{{reportProgress.busy}}",
          "bindtap": "onCancelReportProgress"
        },
        "ancestors": [
          {
            "tag": "template",
            "name": "report-progress"
          }
        ]
      },
      {
        "tag": "button",
        "attrs": {
          "data-vote": "keep",
          "bindtap": "onJuryChoice",
          "disabled": "{{juryVote.busy || juryVote.frozen}}"
        },
        "ancestors": [
          {
            "tag": "template",
            "name": "report-progress"
          },
          {
            "tag": "view",
            "wx:if": "{{reportProgress.loaded && reportProgress.progress}}"
          },
          {
            "tag": "view",
            "wx:if": "{{reportProgress.progress.kind === 'post'}}"
          },
          {
            "tag": "view",
            "wx:else": ""
          },
          {
            "tag": "view",
            "wx:if": "{{reportProgress.canVote}}"
          }
        ]
      },
      {
        "tag": "button",
        "attrs": {
          "data-vote": "remove",
          "bindtap": "onJuryChoice",
          "disabled": "{{juryVote.busy || juryVote.frozen}}"
        },
        "ancestors": [
          {
            "tag": "template",
            "name": "report-progress"
          },
          {
            "tag": "view",
            "wx:if": "{{reportProgress.loaded && reportProgress.progress}}"
          },
          {
            "tag": "view",
            "wx:if": "{{reportProgress.progress.kind === 'post'}}"
          },
          {
            "tag": "view",
            "wx:else": ""
          },
          {
            "tag": "view",
            "wx:if": "{{reportProgress.canVote}}"
          }
        ]
      }
    ],
