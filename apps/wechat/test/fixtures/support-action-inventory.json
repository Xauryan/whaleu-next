          {
            "tag": "template",
            "name": "account-moderation"
          },
          {
            "tag": "view",
            "wx:if": "{{selectedPunishment}}"
          }
        ]
      },
      {
        "tag": "button",
        "attrs": {
          "bindtap": "onHistory",
          "disabled": "{{busy || frozen}}"
        },
        "ancestors": [
          {
            "tag": "template",
            "name": "account-moderation"
          },
          {
            "tag": "view",
            "wx:if": "{{selectedPunishment}}"
          },
          {
            "tag": "view",
            "wx:if": "{{mode === 'punishment-management'}}"
          }
        ]
      },
      {
        "tag": "textarea",
        "attrs": {
          "maxlength": "255",
          "bindinput": "onReason",
          "disabled": "{{busy || frozen}}"
        },
        "ancestors": [
          {
            "tag": "template",
            "name": "account-moderation"
          },
          {
            "tag": "view",
            "wx:if": "{{selectedPunishment}}"
          },
          {
            "tag": "view",
            "wx:if": "{{mode === 'punishment-management'}}"
          },
          {
            "tag": "view",
            "wx:if": "{{canRelease}}"
          }
        ]
      },
      {
        "tag": "button",
        "attrs": {
          "bindtap": "onRequestRelease",
          "disabled": "{{busy || frozen || !reason}}"
        },
        "ancestors": [
          {
            "tag": "template",
            "name": "account-moderation"
          },
          {
            "tag": "view",
            "wx:if": "{{selectedPunishment}}"
          },
          {
            "tag": "view",
            "wx:if": "{{mode === 'punishment-management'}}"
          },
          {
            "tag": "view",
            "wx:if": "{{canRelease}}"
          }
        ]
      },
      {
        "tag": "textarea",
        "attrs": {
          "maxlength": "255",
          "bindinput": "onReason",
          "disabled": "{{busy || frozen}}"
        },
        "ancestors": [
          {
            "tag": "template",
            "name": "account-moderation"
          },
          {
            "tag": "view",
            "wx:if": "{{selectedAppeal}}"
