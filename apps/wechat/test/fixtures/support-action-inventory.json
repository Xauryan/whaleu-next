{
  "note": "Before redesign. Shared moderation admin branches are recorded for evidence, but not moved into user pages. Existing shared templates/controllers remain unchanged. Feedback admin-only notices navigation is intentionally removed from the consumer page.",
  "before": {
    "pages/feedback/feedback.wxml": [
      {
        "tag": "navigator",
        "attrs": {
          "wx:if": "{{space && hasSession}}",
          "url": "/pages/community-compose/community-compose?spaceId={{space.id}}&category=feedback"
        },
        "ancestors": []
      },
      {
        "tag": "navigator",
        "attrs": {
          "wx:if": "{{hasSession}}",
          "url": "/pages/feedback-notices/feedback-notices"
        },
        "ancestors": []
      },
      {
        "tag": "navigator",
        "attrs": {
          "wx:if": "{{!hasSession}}",
          "url": "/pages/login/login"
        },
        "ancestors": []
      },
      {
        "tag": "button",
        "attrs": {
          "bindtap": "onRefresh",
          "disabled": "{{busy}}"
        },
        "ancestors": []
      },
      {
        "tag": "button",
        "attrs": {
          "wx:if": "{{busy}}",
          "bindtap": "onCancel"
        },
        "ancestors": []
      },
      {
        "tag": "navigator",
        "attrs": {
          "wx:if": "{{hasSession}}",
          "url": "/pages/community-detail/community-detail?postId={{item.id}}"
        },
        "ancestors": [
          {
            "tag": "view",
            "wx:for": "{{posts}}",
            "wx:key": "id"
          }
        ]
      },
      {
        "tag": "button",
        "attrs": {
          "wx:if": "{{canLoadMore}}",
          "bindtap": "onMore",
          "disabled": "{{busy}}"
        },
        "ancestors": []
      },
      {
        "tag": "navigator",
        "attrs": {
          "wx:if": "{{continuation === 'phone_verification_required'}}",
          "url": "/pages/phone-binding/phone-binding"
        },
        "ancestors": []
      }
    ],
    "pages/feedback-contacts/feedback-contacts.wxml": [
      {
        "tag": "button",
        "attrs": {
          "bindtap": "onReveal",
          "disabled": "{{busy || contacts.busy || !contacts.enabled}}"
        },
        "ancestors": []
      },
      {
        "tag": "button",
        "attrs": {
          "bindtap": "onCopy",
          "data-field": "wechat",
          "disabled": "{{contacts.busy}}"
        },
        "ancestors": [
          {
            "tag": "view",
            "wx:if": "{{contacts.contacts && contacts.contacts.wechat}}"
          }
        ]
      },
      {
        "tag": "button",
        "attrs": {
          "bindtap": "onCopy",
          "data-field": "qq",
          "disabled": "{{contacts.busy}}"
        },
        "ancestors": [
          {
            "tag": "view",
            "wx:if": "{{contacts.contacts && contacts.contacts.qq}}"
          }
        ]
      },
      {
        "tag": "button",
        "attrs": {
          "bindtap": "onCopy",
          "data-field": "phone",
          "disabled": "{{contacts.busy}}"
        },
        "ancestors": [
          {
            "tag": "view",
            "wx:if": "{{contacts.contacts && contacts.contacts.phone}}"
          }
        ]
      },
      {
        "tag": "button",
        "attrs": {
          "bindtap": "onReload",
          "disabled": "{{busy || contacts.busy}}"
        },
        "ancestors": []
      }
    ],
    "pages/report-progress/report-progress.wxml": [
      {
        "tag": "button",
        "attrs": {
          "bindtap": "onReloadRecovery",
          "disabled": "{{report.busy || juryVote.busy}}"
        },
        "ancestors": []
      },
      {
        "tag": "button",
        "attrs": {
          "wx:if": "{{reportProgress.loaded && !reportProgress.progress.isSelf}}",
          "bindtap": "onReport",
          "disabled": "{{!reportProgress.canReport || report.busy || report.frozen}}"
        },
        "ancestors": [
          {
            "tag": "block",
            "wx:if": "{{hasTarget}}"
          }
        ]
      },
      {
        "tag": "navigator",
        "attrs": {
          "wx:if": "{{!report.hasSession}}",
          "url": "/pages/login/login"
        },
        "ancestors": []
      },
      {
        "tag": "navigator",
        "attrs": {
          "url": "/pages/system-notices/system-notices"
        },
        "ancestors": []
      },
      {
        "tag": "navigator",
        "attrs": {
          "url": "/pages/community-feed/community-feed"
        },
        "ancestors": []
      }
    ],
    "pages/account-status/account-status.wxml": [],
    "pages/safety-appeal/safety-appeal.wxml": [],
    "pages/status/status.wxml": [
      {
        "tag": "navigator",
        "attrs": {
          "url": "/pages/announcements/announcements"
