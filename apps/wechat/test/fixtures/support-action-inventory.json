          "bindtap": "onHistory",
          "disabled": "{{busy || frozen}}"
        },
        "ancestors": [
          {
            "tag": "template",
            "name": "account-moderation"
          },
          {
            "tag": "view",
            "wx:if": "{{mode === 'status' && accountStatus}}"
