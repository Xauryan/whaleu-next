{
  "components": {
    "schemas": {},
    "securitySchemes": {
      "accessToken": {
        "description": "Current opaque WhaleU access token. Management and new commands require exact content-bound authority; recovery and cancellation belong to the original actor. Caller-supplied account/profile identifiers and display role labels never grant authority.",
        "scheme": "bearer",
        "type": "http"
      }
    }
  },
  "info": {
    "contact": {},
    "description": "Remove one currently readable native-origin root comment or reply in its original regional scope with sync:none. Named and anonymous content remains content targets only; private authors never become public account locators. Exact school-admin or super-admin grant, phone, Safety, Review, source version and current Media remain required. The selected child alone is tombstoned; a root releases its own comment pin and hides its thread by ancestry, while a reply preserves siblings and references. The canonical component capture and bounded media-cleanup obligation remain independent. No notification is sent. No owner-deletion Experience, jury verdict, ban, role grant or provider is created. Actor-owned recovery and cancellation need only the same active account and current session token.",
    "title": "WhaleU scoped administrator discussion removal",
    "version": "1"
  },
