{
  "components": {
    "schemas": {
      "SafeErrorResponse": {
        "additionalProperties": false,
        "properties": {
          "error": {
            "additionalProperties": false,
            "properties": {
              "code": {
                "type": "string"
              },
              "message": {
                "type": "string"
              },
              "requestId": {
                "type": "string"
              }
            },
            "required": ["code", "message", "requestId"],
            "type": "object"
          }
        },
        "required": ["error"],
        "type": "object"
      }
    },
    "securitySchemes": {
      "accessToken": {
        "description": "Current opaque WhaleU access token. Status and cancellation remain restricted self-service; new issuance requires current private self-service authority. Campus selection never authenticates affiliation.",
        "scheme": "bearer",
        "type": "http"
      }
    }
  },
  "info": {
    "contact": {},
    "description": "Actor-owned original institutional verification requests, one-use opaque response admission, independent facts and distinct UID outcomes. The shipping institutional provider/native binding is unavailable; synthetic composition does not activate a real provider.",
    "title": "WhaleU private institutional verification",
    "version": "1"
  },
  "openapi": "3.0.3",
  "paths": {
    "/v1/me/institutional-sso/capability": {
      "get": {
        "description": "Current safe capability; this read is not authorization.",
        "operationId": "institutionalSsoCapability",
        "parameters": [
          {
            "in": "query",
            "name": "campusId",
            "required": true,
            "schema": {
              "format": "uuid",
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "additionalProperties": false,
                  "properties": {
                    "campusId": {
                      "format": "uuid",
                      "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$",
                      "type": "string"
                    },
                    "capabilityVersion": {
                      "nullable": true,
                      "pattern": "^[a-f0-9]{64}$",
                      "type": "string"
                    },
                    "consent": {
                      "enum": ["institutional-verification-link/v1"],
                      "nullable": true,
                      "type": "string"
                    },
                    "purpose": {
                      "enum": ["institutional_verification"],
                      "type": "string"
                    },
                    "schoolName": {
                      "nullable": true,
                      "type": "string"
                    },
                    "state": {
                      "enum": [
                        "eligible",
                        "not_applicable",
                        "provider_unconfigured",
                        "provider_unavailable",
                        "account_restricted",
                        "verification_conflict"
                      ],
                      "type": "string"
                    },
                    "supportedFacts": {
                      "items": {
                        "enum": ["affiliation", "student_number"],
                        "type": "string"
                      },
                      "maxItems": 2,
                      "type": "array"
                    }
                  },
                  "required": [
                    "campusId",
                    "state",
                    "schoolName",
                    "capabilityVersion",
                    "consent",
                    "purpose",
                    "supportedFacts"
                  ],
                  "type": "object"
                }
              }
            },
            "description": "",
            "headers": {
              "Cache-Control": {
                "schema": {
                  "enum": ["no-store"],
                  "type": "string"
                }
              },
              "Vary": {
                "schema": {
                  "enum": ["Authorization"],
                  "type": "string"
                }
              }
            }
          },
          "400": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/SafeErrorResponse"
                }
              }
            },
            "description": "Strict bounded JSON and explicit consent are required."
          },
          "401": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/SafeErrorResponse"
                }
              }
            },
            "description": "Current owner authentication is required."
          },
          "409": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/SafeErrorResponse"
                }
              }
            },
            "description": "The original request identity conflicts."
          },
          "503": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/SafeErrorResponse"
                }
              }
            },
            "description": "Institutional verification is unavailable. No real provider is configured by default."
          }
        },
        "security": [
          {
            "accessToken": []
          }
        ],
        "summary": "",
        "tags": ["Institutional verification"]
      }
    },
