{
  "openapi": "3.0.3",
  "info": {
    "title": "WhaleU account-private manual timetable",
    "version": "1",
    "description": "Manual private account data only. No academic login/import, grades, notifications, sharing or public profiles. Up to 32 live terms and 200 live entries per term. Tombstones scrub all schedule fields and reserve IDs permanently within the account. Every mutation CASes the aggregate term revision under one account lock. Read and commit proofs require current sessions; interaction mute alone does not block private self service."
  },
  "paths": {
    "/v1/me/timetable/terms": {
      "get": {
        "operationId": "PersonalTimetableController_list",
        "security": [{ "accessToken": [] }],
        "responses": {
          "200": {
            "description": "PersonalTimetableTerms",
            "headers": {
              "Cache-Control": {
                "schema": { "type": "string" },
                "description": "private, no-store"
              }
            },
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/PersonalTimetableTerms"
                }
              }
            }
          },
          "400": { "description": "Strict DTO rejected. No request recorded." },
          "401": {
            "description": "Current presented session required, including recovery; revocation and precise expiry are never bypassed."
          },
          "403": {
            "description": "Current access suspension denies private reads."
          },
          "503": {
            "description": "TIMETABLE_UNAVAILABLE: retain original intent and request key; recover before deciding outcome."
          }
        }
      }
    },
    "/v1/me/timetable/terms/{termId}": {
      "get": {
        "operationId": "PersonalTimetableController_detail",
        "security": [{ "accessToken": [] }],
        "parameters": [
          {
            "name": "termId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid",
              "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-4[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "PersonalTimetableDetail",
            "headers": {
              "Cache-Control": {
                "schema": { "type": "string" },
                "description": "private, no-store"
              }
            },
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/PersonalTimetableDetail"
                }
              }
            }
          },
          "400": { "description": "Strict DTO rejected. No request recorded." },
          "401": {
            "description": "Current presented session required, including recovery; revocation and precise expiry are never bypassed."
          },
          "404": {
            "description": "TIMETABLE_NOT_FOUND; absent, deleted and other-account targets are indistinguishable."
          },
          "503": {
            "description": "TIMETABLE_UNAVAILABLE: retain original intent and request key; recover before deciding outcome."
          }
        }
      }
    },
    "/v1/me/timetable/commands": {
      "post": {
        "operationId": "PersonalTimetableController_execute",
        "security": [{ "accessToken": [] }],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/PersonalTimetableCommand"
              }
            }
          }
        },
        "description": "Full replacement payloads, strict version 1 discriminated union. Term.create expectedRevision=0; all other operations use current aggregate positive term revision. Exact same request key + SHA256 canonical full command replays original receipt without effects. A rejected receipt is durable and requires a new key after explicit edit/rebase. New writes enforce private_self_service after historical recovery. Changing Monday shifts the series; shortening weekCount rejects existing out-of-range weeks, never trims. Half-open same-day minutes, end > start, explicit strictly increasing unique weeks in 1..term.weekCount. Monday is a validated civil date in years1900..2199, Asia/Shanghai only. Text values must be canonical before freezing, never server-trimmed.",
        "responses": {
          "200": {
            "description": "PersonalTimetableReceipt",
            "headers": {
              "Cache-Control": {
                "schema": { "type": "string" },
                "description": "private, no-store"
              }
            },
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/PersonalTimetableReceipt"
                }
              }
            }
          },
          "400": { "description": "Strict DTO rejected. No request recorded." },
          "401": {
            "description": "Current presented session required, including recovery; revocation and precise expiry are never bypassed."
          },
          "409": {
            "description": "TIMETABLE_REQUEST_CONFLICT: key reused with a different full-command intent."
          },
          "503": {
            "description": "TIMETABLE_UNAVAILABLE: retain original intent and request key; recover before deciding outcome."
          }
        }
      }
    },
    "/v1/me/timetable/requests/{requestId}": {
      "get": {
        "operationId": "PersonalTimetableController_recover",
        "security": [{ "accessToken": [] }],
        "parameters": [
          {
            "name": "requestId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid",
              "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-4[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
            }
          }
        ],
        "description": "Minimal private receipt recovery remains available under account punishment with a current authenticated session. Unknown is not evidence of failure, cancellation or rollback; retain original key and intent. Cross-account receipts return unknown.",
        "responses": {
          "200": {
            "description": "PersonalTimetableRecovery",
            "headers": {
              "Cache-Control": {
                "schema": { "type": "string" },
                "description": "private, no-store"
              }
            },
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/PersonalTimetableRecovery"
                }
              }
            }
          },
          "400": { "description": "Strict DTO rejected. No request recorded." },
          "401": {
            "description": "Current presented session required, including recovery; revocation and precise expiry are never bypassed."
          },
          "503": {
            "description": "TIMETABLE_UNAVAILABLE: retain original intent and request key; recover before deciding outcome."
          }
        }
      }
    },
    "/v1/me/timetable/requests/{requestId}/cancel": {
      "post": {
        "operationId": "PersonalTimetableController_cancel",
        "security": [{ "accessToken": [] }],
        "parameters": [
          {
            "name": "requestId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid",
              "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-4[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/PersonalTimetableCommand"
              }
            }
          }
        },
        "description": "Send the entire original frozen command and matching path requestId. If unrecorded, atomically seal its exact hash as cancelled. If already settled, return original historical receipt, including an applied receipt; cancellation never rolls back or undoes a committed effect. A cancelled key can never later execute. No private schedule text is returned or retained in receipts.",
        "responses": {
          "200": {
            "description": "PersonalTimetableReceipt",
            "headers": {
              "Cache-Control": {
                "schema": { "type": "string" },
                "description": "private, no-store"
              }
            },
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/PersonalTimetableReceipt"
                }
              }
            }
          },
          "400": { "description": "Strict DTO rejected. No request recorded." },
          "401": {
            "description": "Current presented session required, including recovery; revocation and precise expiry are never bypassed."
          },
          "409": {
            "description": "TIMETABLE_REQUEST_CONFLICT: path/key or original intent mismatch."
          },
          "503": {
            "description": "TIMETABLE_UNAVAILABLE: retain original intent and request key; recover before deciding outcome."
          }
        }
      }
    }
  },
