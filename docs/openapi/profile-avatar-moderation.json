{
  "components": {
    "schemas": {},
    "securitySchemes": {
      "accessToken": {
        "description": "Current opaque WhaleU access token. Management and new commands require exact content-bound authority; recovery and cancellation belong to the original actor. Caller-supplied account/profile identifiers and display role labels never grant authority.",
        "scheme": "bearer",
        "type": "http"
      }
    }
  },
  "info": {
    "contact": {},
    "description": "Clear only the current custom avatar from a named post, comment or reply in the fixed original regional scope. The shared Profile revision and current appearance must match. This removes the account-wide non-anonymous custom image and shows the existing unselected placeholder. No replacement bytes, fake Review, production catalog or provider is created. The subject receives a private notice. A readable named related-sync source with current content-management authority instead returns only target, canClearCustomAvatar:false, availability:unavailable and blocker:related_sync_unsupported, including at its original campus; no display, revision, appearance or subject identity is exposed. Fresh related-source commands cannot clear an avatar. New requests and storage opens awaiting final authorization reject the old appearance; already authorized streams and downloaded bytes are not recalled. Actor-owned recovery and cancellation require only the original session and key.",
    "title": "WhaleU scoped profile custom avatar clear",
    "version": "1"
  },
  "openapi": "3.0.3",
