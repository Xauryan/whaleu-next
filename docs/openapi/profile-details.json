{
  "openapi": "3.0.3",
  "info": {
    "title": "WhaleU optional profile details",
    "version": "1",
    "description": "Private-by-default optional self-reported fields. Does not modify the existing strict profile DTO; no backfill from identity data. Public reads expose only fields explicitly enabled by their owner and honor current named-profile access."
  },
  "paths": {
    "/v1/me/profile-stats": {
      "get": {
        "operationId": "ProfileStatsController_own",
        "security": [{ "accessToken": [] }],
        "description": "Current recorded relationships with active existing profiles visible to the owner under both block directions. Not lifetime totals. Bounded current-source reads; lock contention, incomplete coverage or exhausted budget is unavailable, not zero. Received interactions has no complete safe aggregate and remains unavailable.",
        "responses": {
          "200": {
            "description": "OwnProfileStats",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/OwnProfileStats" }
              }
            }
          }
        }
      }
    },
    "/v1/me/profile-details": {
      "get": {
        "operationId": "ProfileDetailsController_own",
        "security": [{ "accessToken": [] }],
        "responses": {
          "200": {
            "description": "OwnProfileDetails",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/OwnProfileDetails" }
              }
            }
          }
        }
      },
      "patch": {
        "operationId": "ProfileDetailsController_update",
        "security": [{ "accessToken": [] }],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": { "$ref": "#/components/schemas/ProfileDetailsPatch" }
            }
          }
        },
        "responses": {
          "200": {
            "description": "OwnProfileDetails",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/OwnProfileDetails" }
              }
            }
          },
          "409": {
            "description": "PROFILE_DETAILS_REVISION_CONFLICT; reload before editing. The rejected write is not applied."
          }
        }
      }
    },
    "/v1/profiles/{profileId}/details": {
      "get": {
        "operationId": "ProfileDetailsController_public",
        "security": [{}, { "accessToken": [] }],
        "parameters": [
          {
            "name": "profileId",
            "in": "path",
            "required": true,
            "schema": { "type": "string", "format": "uuid" }
          }
        ],
        "responses": {
          "200": {
            "description": "PublicProfileDetails",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/PublicProfileDetails"
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "securitySchemes": {
      "accessToken": { "type": "http", "scheme": "bearer" }
    },
    "schemas": {
      "ProfileSocialCount": {
        "oneOf": [
          {
            "type": "object",
            "additionalProperties": false,
            "required": ["status", "value"],
            "properties": {
              "status": { "type": "string", "enum": ["known"] },
              "value": { "type": "integer", "minimum": 0, "maximum": 1024 }
            }
          },
          {
            "type": "object",
            "additionalProperties": false,
            "required": ["status", "value"],
            "properties": {
              "status": { "type": "string", "enum": ["unavailable"] },
              "value": { "nullable": true, "enum": [null] }
            }
          }
        ]
      },
      "OwnProfileStats": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "accountId",
          "following",
          "followers",
          "receivedInteractions"
        ],
        "properties": {
          "accountId": { "type": "string", "format": "uuid" },
          "following": { "$ref": "#/components/schemas/ProfileSocialCount" },
          "followers": { "$ref": "#/components/schemas/ProfileSocialCount" },
          "receivedInteractions": {
            "type": "object",
            "additionalProperties": false,
            "required": ["status", "value"],
            "properties": {
              "status": { "type": "string", "enum": ["unavailable"] },
              "value": { "nullable": true, "enum": [null] }
            }
          }
        }
      },
      "OwnProfileDetails": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "accountId",
          "revision",
          "region",
          "gender",
          "age",
          "showRegion",
          "showGender",
          "showAge"
        ],
        "properties": {
          "accountId": { "type": "string", "format": "uuid" },
          "revision": {
            "type": "integer",
            "minimum": 0,
            "maximum": 2147483647
          },
          "region": {
            "type": "string",
            "nullable": true,
            "maxLength": 80,
            "description": "Self-reported area label; never inferred from location."
          },
          "gender": {
            "type": "string",
            "nullable": true,
            "enum": ["female", "male"]
          },
          "age": {
            "type": "integer",
            "nullable": true,
            "minimum": 0,
            "maximum": 120,
            "description": "Self-reported current age, not derived from birth date."
          },
          "showRegion": { "type": "boolean", "default": false },
          "showGender": { "type": "boolean", "default": false },
          "showAge": { "type": "boolean", "default": false }
        }
      },
      "ProfileDetailsPatch": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "expectedRevision",
          "region",
          "gender",
          "age",
          "showRegion",
          "showGender",
          "showAge"
        ],
        "properties": {
          "expectedRevision": {
            "type": "integer",
            "minimum": 0,
            "maximum": 2147483646
          },
          "region": {
            "type": "string",
            "nullable": true,
            "maxLength": 80,
            "description": "Self-reported area label; never inferred from location."
          },
          "gender": {
            "type": "string",
            "nullable": true,
            "enum": ["female", "male"]
          },
          "age": {
            "type": "integer",
            "nullable": true,
            "minimum": 0,
            "maximum": 120,
            "description": "Self-reported current age, not derived from birth date."
          },
          "showRegion": { "type": "boolean", "default": false },
          "showGender": { "type": "boolean", "default": false },
          "showAge": { "type": "boolean", "default": false }
        }
      },
      "PublicProfileDetails": {
        "oneOf": [
          {
            "type": "object",
            "additionalProperties": false,
            "required": ["status", "profileId"],
            "properties": {
              "status": { "type": "string", "enum": ["unavailable"] },
              "profileId": { "type": "string", "format": "uuid" }
            }
          },
          {
            "type": "object",
            "additionalProperties": false,
            "required": ["status", "profileId", "region", "gender", "age"],
            "properties": {
              "status": { "type": "string", "enum": ["available"] },
              "profileId": { "type": "string", "format": "uuid" },
              "region": {
                "type": "string",
                "nullable": true,
                "maxLength": 80,
                "description": "Self-reported area label; never inferred from location."
              },
              "gender": {
                "type": "string",
                "nullable": true,
                "enum": ["female", "male"]
              },
              "age": {
                "type": "integer",
                "nullable": true,
                "minimum": 0,
                "maximum": 120,
                "description": "Self-reported current age, not derived from birth date."
              }
            }
          }
        ]
      }
    }
  }
}
