{
  "openapi": "3.0.3",
  "info": {
    "title": "WhaleU real account deletion preparation foundation",
    "version": "1",
    "description": "Disabled by default. Preparation/status are non-destructive and do not reserve generation or revoke sessions. Acceptance, cancellation, fresh-provider cooling recovery and erasure are NOT enabled by0181. Recovery secret is generated and persisted by the native client before prepare, sent only in body and retained server-side only as a purpose/account/intent/generation-bound hash. No environment value can enable acceptance. No ordinary-account deletion availability is claimed."
  },
  "paths": {
    "/v1/account-deletion/prepare": {
      "post": {
        "operationId": "RealDeletionController_prepare",
        "security": [{ "accessToken": [] }],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": { "$ref": "#/components/schemas/RealDeletionPrepare" }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Only this exact preparation. No account, session, provider identity or secret.",
            "headers": {
              "Cache-Control": {
                "schema": { "type": "string" },
                "description": "private, no-store"
              }
            },
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/RealDeletionPreparationReceipt"
                }
              }
            }
          },
          "400": {
            "description": "Strict bounded command rejected; no authority granted."
          },
          "401": { "description": "Current ordinary access token required." },
          "404": {
            "description": "Scope unavailable; unknown request, wrong secret and cross-account target are indistinguishable."
          },
          "409": {
            "description": "Exact original intent conflicts; no secret replacement or expiry extension."
          },
          "429": { "description": "Bounded request rate exhausted." },
          "503": {
            "description": "Real deletion unavailable. Missing schema/configuration or unproven authority never activates deletion."
          }
        }
      }
    },
    "/v1/account-deletion/status": {
      "post": {
        "operationId": "RealDeletionController_status",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": { "$ref": "#/components/schemas/RealDeletionStatus" }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Only this exact preparation. No account, session, provider identity or secret.",
            "headers": {
              "Cache-Control": {
                "schema": { "type": "string" },
                "description": "private, no-store"
              }
            },
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/RealDeletionPreparationReceipt"
                }
              }
            }
          },
          "400": {
            "description": "Strict bounded command rejected; no authority granted."
          },
          "404": {
            "description": "Scope unavailable; unknown request, wrong secret and cross-account target are indistinguishable."
          },
          "409": {
            "description": "Exact original intent conflicts; no secret replacement or expiry extension."
          },
          "429": { "description": "Bounded request rate exhausted." },
          "503": {
            "description": "Real deletion unavailable. Missing schema/configuration or unproven authority never activates deletion."
          }
        }
      }
    },
    "/v1/account-deletion/accept": {
      "post": {
        "operationId": "RealDeletionController_accept",
        "description": "Reserved non-activated protocol. Always unavailable in0181, before any provider code dispatch or lifecycle/epoch mutation.",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": { "$ref": "#/components/schemas/RealDeletionAccept" }
            }
          }
        },
        "responses": {
          "400": {
            "description": "Strict bounded command rejected; no authority granted."
          },
          "404": {
            "description": "Scope unavailable; unknown request, wrong secret and cross-account target are indistinguishable."
          },
          "409": {
            "description": "Exact original intent conflicts; no secret replacement or expiry extension."
          },
          "429": { "description": "Bounded request rate exhausted." },
          "503": {
            "description": "Real deletion unavailable. Missing schema/configuration or unproven authority never activates deletion."
          }
        }
      }
    },
    "/v1/account-deletion/cancel": {
      "post": {
        "operationId": "RealDeletionController_cancel",
        "description": "Reserved non-activated protocol. Never reports a preparation as successfully cancelled.",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": { "$ref": "#/components/schemas/RealDeletionCancel" }
            }
          }
        },
        "responses": {
          "400": {
            "description": "Strict bounded command rejected; no authority granted."
          },
          "404": {
            "description": "Scope unavailable; unknown request, wrong secret and cross-account target are indistinguishable."
          },
          "409": {
            "description": "Exact original intent conflicts; no secret replacement or expiry extension."
          },
          "429": { "description": "Bounded request rate exhausted." },
          "503": {
            "description": "Real deletion unavailable. Missing schema/configuration or unproven authority never activates deletion."
          }
        }
      }
    }
  },
  "components": {
    "securitySchemes": {
      "accessToken": { "type": "http", "scheme": "bearer" }
    },
    "schemas": {
      "RealDeletionPrepare": {
        "type": "object",
        "properties": {
          "version": { "type": "number", "enum": [1] },
          "intentId": {
            "type": "string",
            "format": "uuid",
            "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$"
          },
          "expectedGeneration": {
            "type": "string",
            "pattern": "^(0|[1-9][0-9]{0,18})$"
          },
          "consent": {
            "type": "string",
            "enum": ["explicit-real-account-deletion-v1"]
          },
          "recoverySecret": {
            "type": "string",
            "pattern": "^wu_dr_[A-Za-z0-9_-]{43}$",
            "writeOnly": true,
            "description": "Private purpose-specific32-byte canonical base64url capability; body only, never retained raw or returned."
          }
        },
        "required": [
          "version",
          "intentId",
          "expectedGeneration",
          "consent",
          "recoverySecret"
        ],
        "additionalProperties": false
      },
      "RealDeletionStatus": {
        "type": "object",
        "properties": {
          "intentId": {
            "type": "string",
            "format": "uuid",
            "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$"
          },
          "recoverySecret": {
            "type": "string",
            "pattern": "^wu_dr_[A-Za-z0-9_-]{43}$",
            "writeOnly": true,
            "description": "Private purpose-specific32-byte canonical base64url capability; body only, never retained raw or returned."
          }
        },
        "required": ["intentId", "recoverySecret"],
        "additionalProperties": false
      },
      "RealDeletionAccept": {
        "type": "object",
        "properties": {
          "version": { "type": "number", "enum": [1] },
          "intentId": {
            "type": "string",
            "format": "uuid",
            "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$"
          },
          "expectedGeneration": {
            "type": "string",
            "pattern": "^(0|[1-9][0-9]{0,18})$"
          },
          "consent": {
            "type": "string",
            "enum": ["explicit-real-account-deletion-v1"]
          },
          "recoverySecret": {
            "type": "string",
            "pattern": "^wu_dr_[A-Za-z0-9_-]{43}$",
            "writeOnly": true,
            "description": "Private purpose-specific32-byte canonical base64url capability; body only, never retained raw or returned."
          },
          "code": {
            "type": "string",
            "minLength": 1,
            "maxLength": 256,
            "pattern": "^[A-Za-z0-9_-]+$"
          }
        },
        "required": [
          "version",
          "intentId",
          "expectedGeneration",
          "consent",
          "recoverySecret",
          "code"
        ],
        "additionalProperties": false
      },
      "RealDeletionCancel": {
        "type": "object",
        "properties": {
          "intentId": {
            "type": "string",
            "format": "uuid",
            "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$"
          },
          "recoverySecret": {
            "type": "string",
            "pattern": "^wu_dr_[A-Za-z0-9_-]{43}$",
            "writeOnly": true,
            "description": "Private purpose-specific32-byte canonical base64url capability; body only, never retained raw or returned."
          },
          "commandId": {
            "type": "string",
            "format": "uuid",
            "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$"
          },
          "expectedRevision": {
            "type": "string",
            "pattern": "^(0|[1-9][0-9]{0,18})$"
          },
          "action": {
            "type": "string",
            "enum": ["explicitly-cancel-real-account-deletion-v1"]
          }
        },
        "required": [
          "intentId",
          "recoverySecret",
          "commandId",
          "expectedRevision",
          "action"
        ],
        "additionalProperties": false
      },
      "RealDeletionPreparationReceipt": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "protocol",
          "intentId",
          "phase",
          "revision",
          "preparedAt",
          "preparationExpiresAt",
          "acceptedAt",
          "cancelBefore",
          "completedAt"
        ],
        "properties": {
          "protocol": {
            "type": "string",
            "enum": ["real-account-deletion-v1"]
          },
          "intentId": { "type": "string", "format": "uuid" },
          "phase": { "type": "string", "enum": ["prepared"] },
          "revision": { "type": "string", "enum": ["0"] },
          "preparedAt": { "type": "string", "format": "date-time" },
          "preparationExpiresAt": { "type": "string", "format": "date-time" },
          "acceptedAt": { "type": "string", "nullable": true, "enum": [null] },
          "cancelBefore": {
            "type": "string",
            "nullable": true,
            "enum": [null]
          },
          "completedAt": { "type": "string", "nullable": true, "enum": [null] }
        }
      }
    }
  }
}
