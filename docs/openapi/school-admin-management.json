{
  "components": {
    "schemas": {},
    "securitySchemes": {
      "accessToken": {
        "description": "Current opaque WhaleU access token. Management and new commands require a current super_admin grant, independently of a developer display label. Recovery and cancellation belong to the original actor.",
        "scheme": "bearer",
        "type": "http"
      }
    }
  },
  "info": {
    "contact": {},
    "description": "Strict current super-admin management of one existing public profile. Appointment requires accepted current school affiliation and reconciled linked-region inventory. Reassignment revokes the exact old fixed grant and issues a new immutable grant. role_admin is a retained optional cosmetic title and never authority or automatic appearance. Original-key recovery and cancellation require only the same active account and current presented session token. No global-role issuance, verification changes, provider identity, student-number lookup or notifications.",
    "title": "WhaleU school administrator management",
    "version": "1"
  },
