{
  "components": {
    "schemas": {},
    "securitySchemes": {
      "accessToken": {
        "description": "Current opaque WhaleU access token; school management checks true current grants.",
        "scheme": "bearer",
        "type": "http"
      }
    }
  },
  "info": {
    "contact": {},
    "description": "Unversioned settings commands retain their original strict policy and hashes. Version 2 explicitly includes policy.relatedSyncEnabled and atomically saves the related-sync control with the existing posting policy under one revision CAS. Management may expose the current relatedSyncEnabled value; old writers cannot silently downgrade an enabled v2 policy and receive related_sync_unsupported. The setting governs new publication admission, not the current distribution of an existing canonical related-sync post. Recovery and cancellation preserve the original key and hash.",
    "title": "WhaleU school posting policy",
    "version": "1"
  },
  "openapi": "3.0.3",
  "paths": {
    "/v1/me/school-posting-policy": {
      "get": {
        "description": "Current original regional ledger; missing and expired evidence remain distinct. True school-admin fixed scope or explicit active super-admin target only. Unknown provenance is read-only. Updated clients may explicitly edit related-campus synchronization through v2 commands.",
        "operationId": "readSchoolPostingPolicy",
        "parameters": [
          {
            "in": "query",
            "name": "regionId",
            "required": false,
            "schema": {
              "format": "uuid",
              "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$",
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "additionalProperties": false,
