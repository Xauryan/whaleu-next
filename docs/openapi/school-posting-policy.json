                        },
                        "regionName": {
                          "type": "string"
                        }
                      },
                      "required": ["regionId", "regionName", "management"],
                      "type": "object"
                    },
                    "editable": {
                      "type": "boolean"
                    },
                    "policy": {
                      "additionalProperties": false,
                      "nullable": true,
                      "properties": {
                        "effectiveAt": {
                          "format": "date-time",
                          "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d(?:\\.\\d+)?(?:Z))$",
                          "type": "string"
                        },
                        "expiry": {
                          "oneOf": [
                            {
                              "additionalProperties": false,
                              "properties": {
                                "kind": {
                                  "enum": ["policy_exempt"],
                                  "type": "string"
                                }
                              },
                              "required": ["kind"],
                              "type": "object"
                            },
                            {
                              "additionalProperties": false,
                              "properties": {
                                "kind": {
                                  "enum": ["at"],
                                  "type": "string"
                                },
                                "validUntil": {
                                  "format": "date-time",
                                  "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d(?:\\.\\d+)?(?:Z))$",
                                  "type": "string"
                                }
                              },
                              "required": ["kind", "validUntil"],
                              "type": "object"
                            }
                          ]
                        },
                        "relatedSyncEnabled": {
                          "type": "boolean"
                        },
                        "unverifiedCategories": {
                          "items": {
                            "enum": [
                              "discussion",
                              "confession",
                              "companions",
                              "pets",
                              "internships",
                              "scenery",
                              "dorms",
                              "research",
                              "deep_sea"
                            ],
                            "type": "string"
                          },
                          "maxItems": 9,
                          "type": "array"
                        },
                        "unverifiedCommentEnabled": {
                          "type": "boolean"
                        },
                        "unverifiedPostEnabled": {
                          "type": "boolean"
