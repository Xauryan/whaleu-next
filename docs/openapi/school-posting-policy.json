                        "unverifiedCommentEnabled",
                        "unverifiedCategories",
                        "expiry",
                        "effectiveAt"
                      ],
                      "type": "object"
                    },
                    "revision": {
                      "maximum": 2147483647,
                      "minimum": 0,
                      "type": "integer"
                    },
                    "revisionId": {
                      "format": "uuid",
                      "nullable": true,
                      "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$",
                      "type": "string"
                    },
                    "state": {
                      "enum": [
                        "unconfigured",
                        "active",
                        "expired",
                        "unavailable"
                      ],
                      "type": "string"
                    }
                  },
                  "required": [
                    "context",
                    "revision",
                    "revisionId",
                    "state",
                    "editable",
                    "blocker",
                    "policy"
                  ],
                  "type": "object"
                }
              }
            },
            "description": ""
          }
        },
        "security": [
          {
            "accessToken": []
          }
        ],
        "summary": "",
        "tags": ["School posting policy"]
      }
