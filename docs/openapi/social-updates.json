{
  "openapi": "3.0.3",
  "info": {
    "title": "WhaleU local received social updates",
    "version": "1",
    "description": "Fresh local like/save/follow sources only; no historical backfill or external delivery. Likes/saves never identify the actor. Unavailable notices contain metadata only. Lists and target opening never acknowledge a notice. Current-readable unread is exact only when bounded complete coverage is proved; unknown or pending source coverage is null, never a partial total or zero substitute."
  },
  "paths": {
    "/v1/me/social-updates": {
      "get": {
        "operationId": "SocialUpdatesController_list",
        "security": [{ "accessToken": [] }],
        "parameters": [
          {
            "name": "category",
            "in": "query",
            "required": true,
            "schema": {
              "type": "string",
              "enum": ["likes", "saves", "followers"]
            },
            "description": "Required immutable reader category. Every item and target must match this category."
          },
          {
            "name": "limit",
            "in": "query",
            "schema": {
              "type": "integer",
              "minimum": 1,
              "maximum": 20,
              "default": 20
            }
          },
          {
            "name": "cursor",
            "in": "query",
            "schema": {
              "type": "string",
              "minLength": 1,
              "maxLength": 1024,
              "pattern": "^[A-Za-z0-9_-]+$"
            },
            "description": "Opaque account/session/category/limit-bound continuation; not a target or offset."
          }
        ],
        "responses": {
          "200": {
            "description": "SocialUpdatesPage",
            "headers": {
              "Cache-Control": {
                "schema": { "type": "string" },
                "description": "no-store"
              },
              "Vary": {
                "schema": { "type": "string" },
                "description": "Authorization"
              }
            },
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/SocialUpdatesPage" }
              }
            }
          },
          "400": { "description": "Strict input or scoped cursor rejected." },
          "401": {
            "description": "Current presented account/session required."
          },
          "403": {
            "description": "Current safety policy denied the operation."
          },
          "404": {
            "description": "No notice belonging to this account and category."
          },
          "503": {
            "description": "Mandatory authority or source proof unavailable; no private projection is returned."
          }
        }
      }
    },
    "/v1/me/social-updates/unread-count": {
      "get": {
        "operationId": "SocialUpdatesController_count",
        "security": [{ "accessToken": [] }],
        "parameters": [
          {
            "name": "category",
            "in": "query",
            "required": true,
            "schema": {
              "type": "string",
              "enum": ["likes", "saves", "followers"]
            },
            "description": "Required immutable reader category. Every item and target must match this category."
          }
        ],
        "responses": {
          "200": {
            "description": "SocialUnread",
            "headers": {
              "Cache-Control": {
                "schema": { "type": "string" },
                "description": "no-store"
              },
              "Vary": {
                "schema": { "type": "string" },
                "description": "Authorization"
              }
            },
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/SocialUnread" }
              }
            }
          },
          "400": { "description": "Strict input or scoped cursor rejected." },
          "401": {
            "description": "Current presented account/session required."
          },
          "403": {
            "description": "Current safety policy denied the operation."
          },
          "404": {
            "description": "No notice belonging to this account and category."
          },
          "503": {
            "description": "Mandatory authority or source proof unavailable; no private projection is returned."
          }
        }
      }
    },
    "/v1/me/social-updates/{noticeId}/target": {
      "get": {
        "operationId": "SocialUpdatesController_target",
        "security": [{ "accessToken": [] }],
        "parameters": [
          {
            "name": "noticeId",
            "in": "path",
            "required": true,
            "schema": { "type": "string", "format": "uuid" }
          },
          {
            "name": "category",
            "in": "query",
            "required": true,
