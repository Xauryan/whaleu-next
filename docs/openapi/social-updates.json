          "200": {
            "description": "SocialNoticeTarget",
            "headers": {
              "Cache-Control": {
                "schema": { "type": "string" },
                "description": "no-store"
              },
              "Vary": {
                "schema": { "type": "string" },
                "description": "Authorization"
              }
            },
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/SocialNoticeTarget" }
              }
            }
          },
          "400": { "description": "Strict input or scoped cursor rejected." },
          "401": {
            "description": "Current presented account/session required."
          },
          "403": {
            "description": "Current safety policy denied the operation."
          },
          "404": {
            "description": "No notice belonging to this account and category."
          },
          "503": {
            "description": "Mandatory authority or source proof unavailable; no private projection is returned."
          }
        }
      }
    },
    "/v1/me/social-updates/{noticeId}/read": {
      "put": {
        "operationId": "SocialUpdatesController_read",
        "security": [{ "accessToken": [] }],
        "parameters": [
          {
            "name": "noticeId",
            "in": "path",
            "required": true,
            "schema": { "type": "string", "format": "uuid" }
          },
          {
            "name": "category",
            "in": "query",
            "required": true,
            "schema": {
              "type": "string",
              "enum": ["likes", "saves", "followers"]
            },
            "description": "Required immutable reader category. Every item and target must match this category."
          }
        ],
        "description": "Explicit owner acknowledgment only. Retries preserve the exact original read timestamp. The response conveys no target permission.",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {},
                "additionalProperties": false
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "SocialNoticeRead",
            "headers": {
              "Cache-Control": {
                "schema": { "type": "string" },
                "description": "no-store"
              },
              "Vary": {
                "schema": { "type": "string" },
                "description": "Authorization"
              }
            },
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/SocialNoticeRead" }
              }
            }
          },
          "400": { "description": "Strict input or scoped cursor rejected." },
          "401": {
            "description": "Current presented account/session required."
          },
          "403": {
            "description": "Current safety policy denied the operation."
          },
          "404": {
            "description": "No notice belonging to this account and category."
          },
          "503": {
            "description": "Mandatory authority or source proof unavailable; no private projection is returned."
