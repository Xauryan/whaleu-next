              "type": "string",
              "enum": ["likes", "saves", "followers"]
            },
            "description": "Required immutable reader category. Every item and target must match this category."
          }
        ],
        "description": "Reauthorizes the current target. No read acknowledgment and no unavailable reason/locator disclosure.",
