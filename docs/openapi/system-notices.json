{
  "components": {
    "schemas": {},
    "securitySchemes": {
      "accessToken": {
        "description": "Current opaque WhaleU access token. Each request authenticates the recipient owner independently. A notice ID or cursor is not an authorization grant; callers cannot select another account or override ownership with an administrator role.",
        "scheme": "bearer",
        "type": "http"
      }
    }
  },
  "info": {
    "contact": {},
    "description": "Authenticated owner-only list, unread count and idempotent first-read acknowledgement for three strict notice kinds: post_jury_removed, profile_nickname_reset and profile_custom_avatar_cleared. Custom avatar clear notices expose only noticeId, kind, createdAt and readAt, without identity, old image, source links or replacement-image claims. Equal-time pagination uses createdAt, global notice ID and kind; old v1 jury and v2 nickname cursors remain readable. Reading a list never marks notices read. No content visibility or profile lookup is required to read a historical notice.",
    "title": "WhaleU owner system notices",
    "version": "1"
  },
  "openapi": "3.0.3",
  "paths": {
    "/v1/me/system-notices": {
      "get": {
        "operationId": "systemNoticesList",
        "parameters": [
          {
            "in": "query",
            "name": "cursor",
            "required": false,
            "schema": {
              "maxLength": 1024,
              "minLength": 1,
              "pattern": "^[A-Za-z0-9_-]+$",
              "type": "string"
            }
          },
          {
            "in": "query",
            "name": "limit",
            "required": false,
            "schema": {
              "default": "20",
              "pattern": "^(?:[1-9]|[1-4][0-9]|50)$",
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "additionalProperties": false,
                  "properties": {
                    "items": {
                      "items": {
                        "oneOf": [
                          {
                            "additionalProperties": false,
                            "properties": {
                              "createdAt": {
                                "format": "date-time",
                                "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d\\.\\d{3}(?:Z))$",
                                "type": "string"
                              },
                              "keepVotes": {
                                "maximum": 5,
                                "minimum": 0,
                                "type": "integer"
                              },
                              "kind": {
                                "enum": ["post_jury_removed"],
                                "type": "string"
                              },
                              "noticeId": {
                                "format": "uuid",
                                "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$",
                                "type": "string"
                              },
                              "readAt": {
                                "format": "date-time",
                                "nullable": true,
                                "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d\\.\\d{3}(?:Z))$",
                                "type": "string"
                              },
                              "removeVotes": {
                                "maximum": 6,
                                "minimum": 1,
                                "type": "integer"
                              }
                            },
                            "required": [
                              "noticeId",
                              "createdAt",
                              "readAt",
                              "kind",
                              "keepVotes",
                              "removeVotes"
                            ],
                            "type": "object"
                          },
                          {
                            "additionalProperties": false,
                            "properties": {
                              "createdAt": {
                                "format": "date-time",
                                "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d\\.\\d{3}(?:Z))$",
                                "type": "string"
                              },
                              "kind": {
                                "enum": ["profile_nickname_reset"],
                                "type": "string"
                              },
                              "nickname": {
                                "pattern": "^违规昵称[A-Za-z0-9]{6}$",
                                "type": "string"
                              },
                              "noticeId": {
                                "format": "uuid",
                                "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$",
                                "type": "string"
                              },
                              "readAt": {
                                "format": "date-time",
                                "nullable": true,
                                "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d\\.\\d{3}(?:Z))$",
                                "type": "string"
                              }
                            },
                            "required": [
                              "noticeId",
                              "createdAt",
                              "readAt",
                              "kind",
                              "nickname"
                            ],
                            "type": "object"
                          },
                          {
                            "additionalProperties": false,
                            "properties": {
                              "createdAt": {
                                "format": "date-time",
                                "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d\\.\\d{3}(?:Z))$",
                                "type": "string"
                              },
                              "kind": {
                                "enum": ["profile_custom_avatar_cleared"],
                                "type": "string"
                              },
                              "noticeId": {
                                "format": "uuid",
                                "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$",
                                "type": "string"
                              },
                              "readAt": {
                                "format": "date-time",
                                "nullable": true,
                                "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d\\.\\d{3}(?:Z))$",
                                "type": "string"
                              }
                            },
                            "required": [
                              "noticeId",
                              "createdAt",
                              "readAt",
                              "kind"
                            ],
                            "type": "object"
                          },
                          {
                            "additionalProperties": false,
                            "properties": {
                              "createdAt": {
                                "format": "date-time",
                                "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d\\.\\d{3}(?:Z))$",
                                "type": "string"
                              },
                              "kind": {
                                "enum": ["admin_post_removed"],
                                "type": "string"
                              },
                              "noticeId": {
                                "format": "uuid",
                                "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$",
                                "type": "string"
                              },
                              "readAt": {
                                "format": "date-time",
                                "nullable": true,
                                "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d\\.\\d{3}(?:Z))$",
                                "type": "string"
                              }
                            },
                            "required": [
                              "noticeId",
                              "createdAt",
                              "readAt",
                              "kind"
                            ],
                            "type": "object"
                          }
                        ]
                      },
                      "maxItems": 50,
                      "type": "array"
                    },
                    "nextCursor": {
                      "maxLength": 1024,
                      "minLength": 1,
                      "nullable": true,
                      "pattern": "^[A-Za-z0-9_-]+$",
                      "type": "string"
                    },
                    "unreadCount": {
                      "maximum": 2147483647,
                      "minimum": 0,
                      "type": "integer"
                    }
                  },
                  "required": ["items", "nextCursor", "unreadCount"],
                  "type": "object"
                }
              }
            },
            "description": ""
          }
        },
        "security": [
          {
            "accessToken": []
          }
        ],
        "summary": "",
        "tags": ["Owner system notices"]
      }
    },
    "/v1/me/system-notices/unread-count": {
      "get": {
        "operationId": "systemNoticesUnreadCount",
        "parameters": [],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "additionalProperties": false,
                  "properties": {
                    "unreadCount": {
                      "maximum": 2147483647,
                      "minimum": 0,
                      "type": "integer"
                    }
                  },
                  "required": ["unreadCount"],
                  "type": "object"
                }
              }
            },
            "description": ""
          }
        },
        "security": [
          {
            "accessToken": []
          }
        ],
        "summary": "",
        "tags": ["Owner system notices"]
      }
    },
    "/v1/me/system-notices/{id}/read": {
      "put": {
        "operationId": "systemNoticeMarkRead",
        "parameters": [
          {
            "in": "path",
            "name": "id",
            "required": true,
            "schema": {
              "format": "uuid",
              "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$",
              "type": "string"
            }
          }
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "additionalProperties": false,
                "properties": {},
                "type": "object"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "additionalProperties": false,
                  "properties": {
                    "noticeId": {
                      "format": "uuid",
                      "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$",
                      "type": "string"
                    },
                    "readAt": {
                      "format": "date-time",
                      "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d\\.\\d{3}(?:Z))$",
                      "type": "string"
                    },
                    "unreadCount": {
                      "maximum": 2147483647,
                      "minimum": 0,
                      "type": "integer"
                    }
                  },
                  "required": ["noticeId", "readAt", "unreadCount"],
                  "type": "object"
                }
              }
            },
            "description": ""
          }
        },
        "security": [
          {
            "accessToken": []
          }
        ],
        "summary": "",
        "tags": ["Owner system notices"]
      }
    }
  },
  "servers": [],
  "tags": []
}
